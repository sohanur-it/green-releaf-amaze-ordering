// INSTANT CART REMOVE - Frontend only
async function removeItem(lineItemId, batchId) {
    const cart = getCartManager();
    if (!cart) {
        console.error('Cart manager not initialized');
        return;
    }

    if (!ensureCartOnline('remove items from the cart')) {
        return;
    }
    
    // Verify item exists
    const item = cart.cart.items.find(i => {
        return String(i.line_item_id) === String(lineItemId) || i.batch_id === batchId;
    });
    
    if (!item) {
        console.error('Item not found in cart:', { lineItemId, batchId, items: cart.cart.items });
        return;
    }
    
    if (!confirm('Are you sure you want to remove this item?')) {
        return;
    }
    
    // Check if this is the last item (cart will be empty after removal)
    const willBeEmpty = cart.cart.items.length === 1;
    
    // Set loading state and disable add-to-cart buttons
    cartOperationInProgress = true;
    setAddToCartButtonsEnabled(false);
    
    // Show loader if this is the last item (cart will be empty)
    if (willBeEmpty) {
        showCartOperationLoader(true);
    }
    
    // Track user action timestamp to prevent unnecessary WebSocket reloads
    lastUserActionTime = Date.now();
    
    // Remove instantly (frontend only) - use batch_id as that's what the cart manager uses
    cart.removeItem(batchId || item.batch_id);
    renderCart();
    
    try {
        // Sync to backend in real-time
        if (lineItemId && !String(lineItemId).startsWith('temp_')) {
            try {
                const response = await fetch(`/api/portal/${cart.uuid}/cart/remove`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        line_item_id: lineItemId,
                        batch_id: batchId || item.batch_id,
                        client_session_id: portalClientSessionId
                    })
                });
                
                let data = {};
                try {
                    data = await response.json();
                } catch (parseError) {
                    console.error('Failed to parse remove item response:', parseError);
                }
                
                if (!response.ok || !data.success) {
                    const errorMessage = data.error || data.details || data.message || 'Failed to remove item from cart';
                    throw new Error(errorMessage);
                }

                const availabilityRecords = [];
                if (data.batch_availability) {
                    availabilityRecords.push(data.batch_availability);
                } else if (Array.isArray(data.affected_batches)) {
                    availabilityRecords.push(...data.affected_batches);
                }

                availabilityRecords.forEach(record => {
                    if (!record) return;
                    const recordBatchId = record.batch_id ?? batchId ?? item.batch_id;
                    const recordQuantity = record.quantity_available ?? record.remaining_available ?? record.available;
                    if (recordBatchId === undefined || recordQuantity === undefined) {
                        return;
                    }
                    const parsedQuantity = parseInt(recordQuantity, 10);
                    if (!Number.isNaN(parsedQuantity)) {
                        updateProductAvailability(recordBatchId, parsedQuantity);
                    }
                });
                
                // CRITICAL: After successful backend removal, reload from backend to get accurate state
                // Force reload (ignore the frontend-has-items check) since we just removed an item
                await cart.loadFromBackend(true); // Pass true to force reload
                renderCart();
                
                if (typeof showNotification !== 'undefined') {
                    showNotification('Item removed from cart', 'success');
                } else {
                    console.log('Item removed from cart');
                }
            } catch (err) {
                console.error('Error syncing item removal:', err);
                // Revert frontend change on error
                cart.addItem(item.batch_id, item.quantity, {
                    product_id: item.product_id,
                    batch_id: item.batch_id,
                    product_name: item.product_name,
                    batch_name: item.batch_name,
                    brand_name: item.brand_name,
                    cultivar_name: item.cultivar_name,
                    category_name: item.category_name,
                    product_type: item.product_type,
                    unit_size: item.unit_size,
                    unit_measurement_name: item.unit_measurement_name,
                    units_per_case: item.units_per_case,
                    unit_price: item.unit_price,
                    quantity_available: item.quantity_available,
                    image_url: item.image_url
                });
                renderCart();
                
                if (typeof showNotification !== 'undefined') {
                    showNotification(err.message || 'Failed to remove cart item. Reverting changes.', 'error');
                }
                return;
            }
        } else {
            // Item hasn't been fully synced yet; just refresh from backend
            await cart.loadFromBackend(true); // Force reload
            renderCart();
        }
    } finally {
        // Always clear loading state and re-enable buttons
        cartOperationInProgress = false;
        setAddToCartButtonsEnabled(true);
        showCartOperationLoader(false);
    }
}

// Show loading overlay (shared function - check if already exists)
if (typeof window.showLoader !== 'function') {
    window.showLoader = function(message = 'Processing...', subtext = 'Please wait') {
        let loaderOverlay = document.getElementById('loader-overlay');
        if (!loaderOverlay) {
            loaderOverlay = document.createElement('div');
            loaderOverlay.id = 'loader-overlay';
            loaderOverlay.className = 'loader-overlay';
            loaderOverlay.innerHTML = `
                <div class="loader-container">
                    <div class="loader-spinner"></div>
                    <p class="loader-text">${message}</p>
                    <p class="loader-subtext">${subtext}</p>
                </div>
            `;
            document.body.appendChild(loaderOverlay);
        }
        
        const loaderText = loaderOverlay.querySelector('.loader-text');
        const loaderSubtext = loaderOverlay.querySelector('.loader-subtext');
        if (loaderText) loaderText.textContent = message;
        if (loaderSubtext) loaderSubtext.textContent = subtext;
        
        // Trigger reflow and show
        loaderOverlay.offsetHeight;
        loaderOverlay.classList.add('show');
    };
}

// Hide loading overlay (if not already defined)
if (typeof window.hideLoader !== 'function') {
    window.hideLoader = function() {
        const loaderOverlay = document.getElementById('loader-overlay');
        if (loaderOverlay) {
            loaderOverlay.classList.remove('show');
            setTimeout(() => {
                if (loaderOverlay.parentNode) {
                    loaderOverlay.parentNode.removeChild(loaderOverlay);
                }
            }, 300);
        }
    };
}

async function goToCheckout() {
    const cart = getCartManager();
    if (!cart) {
        alert('Cart not initialized');
        return;
    }

    if (!ensureCartOnline('proceed to checkout')) {
        return;
    }

    if (cart.cart.items.length === 0) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Your cart is empty', 'warning');
        } else {
            alert('Your cart is empty');
        }
        return;
    }
    
    // Show loader
    if (typeof window.showLoader === 'function') {
        window.showLoader('Preparing Checkout', 'Syncing your cart...');
    }
    
    // Sync cart to backend before checkout
    const uuid = '<%= uuid %>';
    try {
        const syncResult = await cart.syncToBackend();
        if (!syncResult.success) {
            if (typeof window.hideLoader === 'function') {
                window.hideLoader();
            }
            if (typeof showNotification !== 'undefined') {
                showNotification(syncResult.error || 'Failed to sync cart', 'error');
            } else {
                alert(syncResult.error || 'Failed to sync cart');
            }
            return;
        }
        
        // Update loader message before redirect
        if (typeof window.showLoader === 'function') {
            window.showLoader('Loading Checkout', 'Redirecting to checkout page...');
        }
        
        // Small delay to show message, then redirect
        setTimeout(() => {
            window.location.href = `/external/store/${uuid}/checkout`;
        }, 300);
    } catch (error) {
        console.error('Error syncing cart:', error);
        if (typeof window.hideLoader === 'function') {
            window.hideLoader();
        }
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to sync cart. Please try again.', 'error');
        } else {
            alert('Failed to sync cart. Please try again.');
        }
    }
}

