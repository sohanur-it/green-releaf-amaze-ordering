<script>
// Set initial view state IMMEDIATELY to prevent flickering
// This runs before DOMContentLoaded to set view before page renders
(function() {
    const params = new URLSearchParams(window.location.search);
    const paramView = params.get('view');
    const savedView = paramView || localStorage.getItem('preferredView') || 'grid';
    const initialView = savedView === 'table' ? 'table' : 'grid';
    
    // Store view preference for later use
    window.__initialViewPreference = initialView;
    
    // Set view immediately - use a function that runs as soon as possible
    function setInitialView() {
        const gridView = document.getElementById('grid-view');
        const tableView = document.getElementById('table-view');
        
        if (!gridView || !tableView) {
            // Elements not ready yet, try again
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', setInitialView);
            } else {
                setTimeout(setInitialView, 10);
            }
            return;
        }
        
        if (initialView === 'grid') {
            gridView.style.display = 'grid';
            tableView.classList.remove('active');
            tableView.style.display = 'none';
        } else {
            gridView.style.display = 'none';
            tableView.classList.add('active');
            tableView.style.display = 'block';
        }
    }
    
    // Try to set view immediately
    setInitialView();
    
    // Also set on DOMContentLoaded as backup
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setInitialView);
    }
})();

// Cart management functions
// Initialize cart manager on page load
document.addEventListener('DOMContentLoaded', function() {
    const uuid = '<%= uuid %>';
    initCartManager(uuid);
    const cart = getCartManager();
    if (cart) {
        renderCart();
    }
    setCartControlsEnabled(false);
    setCartConnectionStatus('connecting');
    
    // Add click handler for cart dropdown arrow to close cart
    const cartDropdown = document.querySelector('.cart-dropdown');
    if (cartDropdown) {
        cartDropdown.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (typeof window.toggleCart === 'function') {
                window.toggleCart(false); // Close the cart
            }
        });
    }
    
    // Load saved view preference (URL param overrides localStorage)
    const params = new URLSearchParams(window.location.search);
    const paramView = params.get('view');
    const savedView = paramView || localStorage.getItem('preferredView') || 'grid';
    
    // Load sidebar state
    const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
    if (sidebarCollapsed) {
        const sidebar = document.querySelector('.filter-sidebar');
        if (sidebar) sidebar.classList.add('collapsed');
    }
    
    // Switch view first (before initializing products)
    switchView(savedView === 'table' ? 'table' : 'grid');
    
    // Then initialize products after a small delay to ensure DOM is ready
    setTimeout(() => {
        initProducts();
        updateProductCount();
        subscribeToVisibleBatches();
    }, 200);

    initPortalWebSocket();
    
    // Populate brand filters dynamically
    const brands = new Set();
    document.querySelectorAll('.product-card-clickable').forEach(card => {
        const brand = card.dataset.brandName;
        if (brand && brand.trim()) {
            brands.add(brand);
        }
    });
    
    const brandFilters = document.getElementById('brand-filters');
    if (brandFilters) {
        brands.forEach(brand => {
            const label = document.createElement('label');
            label.className = 'filter-checkbox';
            label.innerHTML = `
                <input type="checkbox" name="brand" value="${brand}">
                <span>${brand}</span>
            `;
            brandFilters.appendChild(label);
        });
    }
    
    // Add click handlers to product cards (grid view)
    document.querySelectorAll('.product-card-clickable').forEach(card => {
        card.addEventListener('click', function(e) {
            // Don't trigger if clicking on quantity input or add to cart button
            if (e.target.closest('.quantity-selector-container') || e.target.closest('.add-to-cart-btn')) {
                return;
            }
            
            // Get image URL from data attribute or from image element
            let imageUrl = this.dataset.imageUrl || '/public/images/placeholder.jpg';
            if (!imageUrl || imageUrl === '') {
                const imgEl = this.querySelector('.product-image');
                imageUrl = imgEl ? (imgEl.getAttribute('src') || '/public/images/placeholder.jpg') : '/public/images/placeholder.jpg';
            }
            
            const productData = {
                productId: this.dataset.productId,
                productName: this.dataset.productName,
                cultivarName: this.dataset.cultivarName,
                brandName: this.dataset.brandName,
                categoryName: this.dataset.categoryName,
                productType: this.dataset.productType,
                description: this.dataset.description,
                unitSize: this.dataset.unitSize,
                soldAs: this.dataset.soldAs,
                unitsPerCase: parseInt(this.dataset.unitsPerCase || 24),
                batchId: this.dataset.batchId,
                batchName: this.dataset.batchName,
                productionDate: this.dataset.productionDate,
                bestByDate: this.dataset.bestByDate,
                thcPercentage: parseFloat(this.dataset.thcPercentage || 0),
                unitPrice: parseFloat(this.dataset.unitPrice || 0),
                quantityAvailable: parseInt(this.dataset.quantityAvailable || 0),
                metrcItemName: this.dataset.metrcItemName,
                imageUrl: imageUrl
            };
            
            openProductModal(productData);
        });
    });
    
    // Add click handlers to table rows
    document.querySelectorAll('.product-row').forEach(row => {
        row.addEventListener('click', function(e) {
            // Don't trigger if clicking on input or button
            if (e.target.closest('.table-actions')) {
                return;
            }
            
            // Get image URL from data attribute
            let imageUrl = this.dataset.imageUrl || '/public/images/placeholder.jpg';
            if (!imageUrl || imageUrl === '') {
                const imgEl = this.querySelector('.product-image');
                imageUrl = imgEl ? (imgEl.getAttribute('src') || '/public/images/placeholder.jpg') : '/public/images/placeholder.jpg';
            }
            
            const productData = {
                productId: this.dataset.productId,
                productName: this.dataset.productName,
                cultivarName: this.dataset.cultivarName,
                brandName: this.dataset.brandName,
                categoryName: this.dataset.categoryName,
                productType: this.dataset.productType,
                description: this.dataset.description,
                unitSize: this.dataset.unitSize,
                soldAs: this.dataset.soldAs,
                unitsPerCase: parseInt(this.dataset.unitsPerCase || 24),
                batchId: this.dataset.batchId,
                batchName: this.dataset.batchName,
                productionDate: this.dataset.productionDate,
                bestByDate: this.dataset.bestByDate,
                thcPercentage: parseFloat(this.dataset.thcPercentage || 0),
                unitPrice: parseFloat(this.dataset.unitPrice || 0),
                quantityAvailable: parseInt(this.dataset.quantityAvailable || 0),
                metrcItemName: this.dataset.metrcItemName,
                imageUrl: imageUrl
            };
            
            openProductModal(productData);
        });
    });

    // Inline sidebar toggle button in catalog header
    const inlineToggle = document.getElementById('inline-sidebar-toggle');
    if (inlineToggle) {
        inlineToggle.addEventListener('click', toggleSidebar);
    }

    // Cart toggle is now handled by shared cart-toggle.js
    // No need to duplicate the logic here
    
    // Note: initProducts() is called earlier, before switchView, to ensure all products are found
    
    // Add hover event listeners for table product images
    setupTableImageHover();
    
    // Add event listeners to all filter checkboxes
    document.querySelectorAll('.filter-checkbox input').forEach(input => {
        input.addEventListener('change', applyFilters);
    });
    
    // Add event listeners to potency inputs
    const potencyInputs = document.querySelectorAll('#min-potency, #max-potency, #potency-range');
    potencyInputs.forEach(input => {
        if (input) {
            input.addEventListener('input', applyFilters);
        }
    });
    
    // Add event listener to search input
    const searchInput = document.getElementById('portal-search-input');
    if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
    }
    
    // Sync pending cart updates before page unload
    window.addEventListener('beforeunload', async (e) => {
        if (pendingCartUpdates.size > 0) {
            // Sync synchronously before page unload
            await syncCartUpdates();
        }
    });
    
    // Sync when page becomes visible (user returns to tab)
    document.addEventListener('visibilitychange', async () => {
        if (!document.hidden && pendingCartUpdates.size > 0) {
            await syncCartUpdates();
        }
    });
});

const portalWebSocketConfigEl = document.getElementById('portal-websocket-config');
let portalContext = { buyerId: null, locationId: null, websocketPort: 8080 };

if (portalWebSocketConfigEl && portalWebSocketConfigEl.textContent) {
    try {
        portalContext = JSON.parse(portalWebSocketConfigEl.textContent);
    } catch (error) {
        console.error('Failed to parse portal WebSocket config:', error);
    }
}

const portalClientSessionId = (() => {
    const key = 'portal_client_session_id';
    let id = sessionStorage.getItem(key);
    if (!id) {
        id = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
        sessionStorage.setItem(key, id);
    }
    return id;
})();

const outOfStockTimers = new Map();
const subscribedBatchIds = new Set();
const pendingBatchSubscriptions = new Set();

let portalWebSocket = null;
let portalWebSocketReconnectTimer = null;
let portalWebSocketAttempts = 0;
let portalWebSocketConnected = false;
let portalWebSocketEverConnected = false;
let cartInteractionsEnabled = false;
let cartOfflineClearApplied = false;
window.portalWebSocketConnected = portalWebSocketConnected;

function getPortalWebSocketUrl() {
    const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
    const host = window.location.hostname;
    const port = portalContext.websocketPort || 8080;
    return `${protocol}://${host}:${port}`;
}

function schedulePortalWebSocketReconnect() {
    if (portalWebSocketReconnectTimer) {
        return;
    }

    portalWebSocketAttempts = Math.min(portalWebSocketAttempts + 1, 6);
    const delay = Math.min(15000, 1000 * Math.pow(2, portalWebSocketAttempts));

    setCartConnectionStatus('connecting');
    setCartControlsEnabled(false);

    portalWebSocketReconnectTimer = setTimeout(() => {
        portalWebSocketReconnectTimer = null;
        initPortalWebSocket();
    }, delay);
}

function setCartConnectionStatus(state, options = {}) {
    const statusEl = document.getElementById('cart-connection-status');
    const statusTextEl = document.getElementById('cart-connection-status-text');
    if (!statusEl || !statusTextEl) {
        return;
    }

    statusEl.classList.remove('cart-status-online', 'cart-status-offline', 'cart-status-connecting');

    let message = '';
    switch (state) {
        case 'online':
            statusEl.classList.add('cart-status-online');
            message = 'Live cart connected';
            break;
        case 'offline':
            statusEl.classList.add('cart-status-offline');
            message = options.reason || 'Live connection lost. Waiting to reconnect…';
            break;
        default:
            statusEl.classList.add('cart-status-connecting');
            message = 'Connecting to live cart…';
            break;
    }

    statusTextEl.textContent = message;
}

function setCartControlsEnabled(enabled) {
    cartInteractionsEnabled = enabled;
    setAddToCartButtonsEnabled(enabled);

    const quantityButtons = document.querySelectorAll('.quantity-btn, .remove-item-btn');
    quantityButtons.forEach(btn => {
        btn.disabled = !enabled;
        if (!enabled) {
            btn.classList.add('disabled');
        } else {
            btn.classList.remove('disabled');
        }
    });

    const cartContainer = document.querySelector('.portal-cart .cart-container');
    if (cartContainer) {
        cartContainer.classList.toggle('cart-actions-disabled', !enabled);
    }

    const checkoutBtn = document.getElementById('checkout-btn');
    if (checkoutBtn) {
        if (!enabled) {
            checkoutBtn.dataset.offlineDisabled = 'true';
            checkoutBtn.disabled = true;
        } else {
            delete checkoutBtn.dataset.offlineDisabled;
            // renderCart will handle enabling/disabling based on cart contents
        }
    }
}

function handlePortalSocketConnected() {
    portalWebSocketConnected = true;
    window.portalWebSocketConnected = portalWebSocketConnected;
    portalWebSocketEverConnected = true;
    cartOfflineClearApplied = false;

    setCartConnectionStatus('online');
    setCartControlsEnabled(false);
    flushPendingBatchSubscriptions();
    subscribeToVisibleBatches();

    const cart = getCartManager();
    if (cart) {
        cart.loadFromBackend(true, 0)
            .then(() => {
                renderCart();
                setCartControlsEnabled(true);
            })
            .catch(error => {
                console.error('Failed to sync cart after reconnect:', error);
                renderCart();
                setCartControlsEnabled(false);
                if (typeof showNotification === 'function') {
                    showNotification('Reconnected, but failed to verify cart. Trying again shortly…', 'warning');
                }
            });
    } else {
        renderCart();
        setCartControlsEnabled(false);
    }
}

function handlePortalSocketDisconnected(reason) {
    if (!portalWebSocketConnected && cartOfflineClearApplied) {
        // Already handled
        setCartConnectionStatus('offline', { reason });
        setCartControlsEnabled(false);
        return;
    }

    portalWebSocketConnected = false;
    window.portalWebSocketConnected = portalWebSocketConnected;
    setCartConnectionStatus('offline', { reason });
    setCartControlsEnabled(false);
    subscribedBatchIds.clear();
    pendingBatchSubscriptions.clear();
    collectVisibleBatchIds().forEach(batchId => pendingBatchSubscriptions.add(String(batchId)));

    const cart = getCartManager();
    if (cart && !cartOfflineClearApplied) {
        cartOfflineClearApplied = true;
        cart.clearCart();
    }

    renderCart();
}

function ensureCartOnline(actionDescription) {
    if (!portalWebSocketConnected) {
        const message = actionDescription
            ? `Cannot ${actionDescription} while the live cart connection is offline.`
            : 'Live cart connection is currently offline.';
        if (typeof showNotification === 'function') {
            showNotification(message, 'error');
        } else {
            alert(message);
        }
        return false;
    }
    return true;
}

function collectVisibleBatchIds() {
    const nodes = document.querySelectorAll('.product-card[data-batch-id], .product-row[data-batch-id]');
    const ids = new Set();
    nodes.forEach(node => {
        const datasetId = node.dataset.batchId || node.getAttribute('data-batch-id');
        if (datasetId !== undefined && datasetId !== null && datasetId !== '') {
            ids.add(String(datasetId));
        }
    });
    return Array.from(ids);
}

function queueBatchSubscription(batchId) {
    if (batchId === undefined || batchId === null) {
        return;
    }

    const normalized = String(batchId);
    if (!normalized) {
        return;
    }

    if (subscribedBatchIds.has(normalized)) {
        return;
    }

    if (portalWebSocket && portalWebSocket.readyState === WebSocket.OPEN) {
        try {
            const numericBatchId = parseInt(normalized, 10);
            const payloadBatchId = Number.isNaN(numericBatchId) ? normalized : numericBatchId;
            portalWebSocket.send(JSON.stringify({
                type: 'subscribe_batch',
                batch_id: payloadBatchId
            }));
            subscribedBatchIds.add(normalized);
        } catch (error) {
            console.error('Failed to subscribe to batch via WebSocket:', normalized, error);
            if (!pendingBatchSubscriptions.has(normalized)) {
                pendingBatchSubscriptions.add(normalized);
            }
        }
    } else if (!pendingBatchSubscriptions.has(normalized)) {
        pendingBatchSubscriptions.add(normalized);
    }
}

function flushPendingBatchSubscriptions() {
    if (!portalWebSocket || portalWebSocket.readyState !== WebSocket.OPEN) {
        return;
    }
    const pending = Array.from(pendingBatchSubscriptions);
    pendingBatchSubscriptions.clear();
    pending.forEach(batchId => {
        subscribedBatchIds.delete(batchId);
        queueBatchSubscription(batchId);
    });
}

function subscribeToVisibleBatches() {
    const batchIds = collectVisibleBatchIds();
    batchIds.forEach(queueBatchSubscription);
    flushPendingBatchSubscriptions();
}

function updateProductAvailability(batchId, quantityAvailable) {
    if (batchId === undefined || batchId === null) {
        return;
    }

    const normalizedBatchId = String(batchId);
    const parsedQuantity = Math.max(0, parseInt(quantityAvailable, 10) || 0);
    const isOutOfStock = parsedQuantity <= 0;

    const productSelectors = [
        `.product-card[data-batch-id="${normalizedBatchId}"]`,
        `.product-row[data-batch-id="${normalizedBatchId}"]`
    ];

    const productElements = document.querySelectorAll(productSelectors.join(', '));
    const ensureOriginalDisplay = (element) => {
        if (!element.dataset.originalDisplay) {
            element.dataset.originalDisplay = getComputedStyle(element).display || '';
        }
    };

    const toggleRowOutOfStockLabel = (element, show) => {
        const quantityCell = element.querySelector('.table-quantity');
        if (!quantityCell) {
            return;
        }
        let label = quantityCell.querySelector('.out-of-stock-label');
        if (show) {
            if (!label) {
                label = document.createElement('span');
                label.className = 'out-of-stock-label';
                label.textContent = 'OUT OF STOCK';
                quantityCell.appendChild(label);
            }
            label.style.display = 'inline-block';
        } else if (label) {
            label.remove();
        }
    };

    productElements.forEach(element => {
        ensureOriginalDisplay(element);
        element.dataset.quantityAvailable = parsedQuantity;

        element.querySelectorAll('.available-count').forEach(span => {
            span.textContent = parsedQuantity;
        });

        element.querySelectorAll('.quantity-input, .table-qty-input').forEach(input => {
            input.max = parsedQuantity;
            const currentValue = parseInt(input.value, 10) || 1;
            if (parsedQuantity > 0) {
                if (currentValue > parsedQuantity) {
                    input.value = parsedQuantity;
                } else if (currentValue < 1) {
                    input.value = 1;
                }
            } else {
                input.value = 0;
            }
        });

        const addButton = element.querySelector('.add-to-cart-btn');
        if (addButton) {
            addButton.disabled = isOutOfStock;
            addButton.classList.toggle('disabled', isOutOfStock);
        }

        const tableAddButton = element.querySelector('.table-add-btn');
        if (tableAddButton) {
            tableAddButton.disabled = isOutOfStock;
            tableAddButton.classList.toggle('disabled', isOutOfStock);
        }

        if (element.classList.contains('product-card')) {
            element.classList.toggle('out-of-stock', isOutOfStock);
            if (!isOutOfStock) {
                element.classList.remove('out-of-stock-hidden');
            }
        }

        if (element.classList.contains('product-row')) {
            element.classList.toggle('out-of-stock', isOutOfStock);
            toggleRowOutOfStockLabel(element, isOutOfStock);
            if (!isOutOfStock) {
                element.classList.remove('out-of-stock-hidden');
            }
        }
    });

    const timerKey = normalizedBatchId;

    if (isOutOfStock) {
        if (!outOfStockTimers.has(timerKey)) {
            const timerId = setTimeout(() => {
                const elementsToHide = document.querySelectorAll(productSelectors.join(', '));
                elementsToHide.forEach(el => {
                    ensureOriginalDisplay(el);
                    el.style.display = 'none';
                    el.dataset.hiddenDueToStock = 'true';
                    el.classList.add('out-of-stock-hidden');
                });
                outOfStockTimers.delete(timerKey);
                updateProductCount();
            }, 30000);
            outOfStockTimers.set(timerKey, timerId);
        }
    } else {
        if (outOfStockTimers.has(timerKey)) {
            clearTimeout(outOfStockTimers.get(timerKey));
            outOfStockTimers.delete(timerKey);
        }

        const elementsToRestore = document.querySelectorAll(productSelectors.join(', '));
        elementsToRestore.forEach(element => {
            const originalDisplay = element.dataset.originalDisplay || '';
            element.style.display = originalDisplay === 'none' ? '' : originalDisplay;
            element.dataset.hiddenDueToStock = 'false';
            element.classList.remove('out-of-stock-hidden');

            element.querySelectorAll('.quantity-input, .table-qty-input').forEach(input => {
                const currentValue = parseInt(input.value, 10) || 0;
                if (currentValue < 1) {
                    input.value = 1;
                }
            });
        });
    }

    if (currentModalBatchId && String(currentModalBatchId) === normalizedBatchId) {
        const modalAvailableEl = document.getElementById('modal-available');
        if (modalAvailableEl) {
            modalAvailableEl.textContent = `${parsedQuantity} Cases`;
        }

        const modalTotalUnitsEl = document.getElementById('modal-total-units');
        if (modalTotalUnitsEl) {
            const totalUnits = parsedQuantity * (currentModalUnitsPerCase || 0);
            modalTotalUnitsEl.textContent = Number.isFinite(totalUnits) && totalUnits >= 0
                ? totalUnits.toLocaleString()
                : '0';
        }

        const modalQuantityInput = document.getElementById('modal-quantity');
        if (modalQuantityInput) {
            modalQuantityInput.max = parsedQuantity;
            const modalCurrentValue = parseInt(modalQuantityInput.value, 10) || 1;
            if (parsedQuantity > 0) {
                const adjustedValue = Math.min(parsedQuantity, Math.max(modalCurrentValue, 1));
                if (adjustedValue !== modalCurrentValue) {
                    modalQuantityInput.value = adjustedValue;
                    updateModalTotalCost();
                }
            } else {
                modalQuantityInput.value = 1;
                updateModalTotalCost();
            }
        }
    }

    updateProductCount();
}

// Track last user action timestamp to prevent unnecessary reloads
let lastUserActionTime = 0;
const USER_ACTION_DEBOUNCE_MS = 3000; // Ignore WebSocket events within 3 seconds of user action

// Track cart operation state to prevent adding items during removal
let cartOperationInProgress = false;

function handlePortalWebSocketMessage(event) {
    let payload;
    try {
        payload = JSON.parse(event.data);
    } catch (error) {
        console.error('Failed to parse WebSocket message:', error);
        return;
    }

    if (payload.type === 'batch_inventory_update') {
        if (payload.batch_id !== undefined && payload.available_quantity !== undefined) {
            updateProductAvailability(payload.batch_id, payload.available_quantity);
        }
        return;
    }

    if (payload.type === 'batch_current_state') {
        if (payload.batch_id !== undefined && payload.available_quantity !== undefined) {
            updateProductAvailability(payload.batch_id, payload.available_quantity);
        }
        return;
    }

    if (payload.type === 'new_inventory_available') {
        if (payload.data && Array.isArray(payload.data.batches)) {
            payload.data.batches.forEach(batch => {
                if (batch && batch.id !== undefined) {
                    queueBatchSubscription(batch.id);
                }
            });
        }
        return;
    }

    if (payload.type !== 'invoice_sync') {
        return;
    }

    if (!portalWebSocketConnected) {
        // Ignore messages while offline; we'll resync once connection is restored
        return;
    }

    const targetBuyerId = payload.buyer_id ?? (payload.invoice ? payload.invoice.buyer_id : null);
    const targetLocationId = payload.location_id ?? (payload.invoice ? payload.invoice.location_id : null);

    if (portalContext.buyerId && targetBuyerId && Number(portalContext.buyerId) !== Number(targetBuyerId)) {
        return;
    }

    if (portalContext.locationId && targetLocationId && Number(portalContext.locationId) !== Number(targetLocationId)) {
        return;
    }

    // CRITICAL: Ignore events triggered by external portal (we already have the latest state)
    // These events are from our own actions, so we don't need to reload
    if (payload.triggered_by === 'external_portal') {
        if (payload.triggered_by_session_id && payload.triggered_by_session_id === portalClientSessionId) {
            console.log('Ignoring WebSocket event triggered by this session');
            return;
        }
    }

    const affectedBatches = [];
    if (payload.metadata) {
        if (Array.isArray(payload.metadata.affected_batches)) {
            affectedBatches.push(...payload.metadata.affected_batches);
        } else if (payload.metadata.batch_availability) {
            affectedBatches.push(payload.metadata.batch_availability);
        }
    }
    if (Array.isArray(payload.affected_batches)) {
        affectedBatches.push(...payload.affected_batches);
    }

    affectedBatches.forEach(batchInfo => {
        if (!batchInfo) return;
        const batchId = batchInfo.batch_id ?? batchInfo.id;
        if (batchId === undefined || batchId === null) {
            return;
        }
        const quantityAvailable = batchInfo.quantity_available ?? batchInfo.available ?? batchInfo.remaining_available;
        if (quantityAvailable !== undefined) {
            updateProductAvailability(batchId, quantityAvailable);
        }
    });

    // CRITICAL: Don't reload if user just made an action (within debounce window)
    // This prevents the cart from refreshing immediately after user adds/removes items
    const timeSinceLastAction = Date.now() - lastUserActionTime;
    if (timeSinceLastAction < USER_ACTION_DEBOUNCE_MS) {
        console.log(`Ignoring WebSocket event (user action ${timeSinceLastAction}ms ago, debounce: ${USER_ACTION_DEBOUNCE_MS}ms)`);
        return;
    }

    const cart = getCartManager();
    if (!cart) {
        return;
    }

    // Only reload for critical events or if enough time has passed since last user action
    const criticalEvents = ['invoice_cancelled', 'invoice_deleted', 'invoice_status_changed'];
    const isCriticalEvent = criticalEvents.includes(payload.event);
    
    // For non-critical events, only reload if it's been a while since last user action
    if (!isCriticalEvent && timeSinceLastAction < 5000) {
        console.log('Ignoring non-critical WebSocket event (recent user activity)');
        return;
    }

    // Force reload from backend on WebSocket events (backend is source of truth)
    cart.loadFromBackend(true, 0)
        .then(() => {
            // CRITICAL: If invoice was cancelled or deleted, explicitly clear the frontend cart
            if (payload.event === 'invoice_cancelled' || payload.event === 'invoice_deleted') {
                // Clear frontend cart immediately (silent for expired carts)
                if (cart && typeof cart.clearCart === 'function') {
                    cart.clearCart();
                }
                // Only show notification for cancelled (not expired - expired is silent)
                if (typeof showNotification === 'function' && !payload.metadata?.cart_expired) {
                    showNotification('Your cart was cleared because the invoice was cancelled.', 'info');
                }
            }
            renderCart();
        })
        .catch(error => {
            console.error('Failed to sync cart after WebSocket event:', error);
        });
}

function initPortalWebSocket() {
    if (typeof WebSocket === 'undefined') {
        console.warn('WebSocket not supported in this browser.');
        return;
    }

    if (portalWebSocket && (portalWebSocket.readyState === WebSocket.OPEN || portalWebSocket.readyState === WebSocket.CONNECTING)) {
        return;
    }

    setCartConnectionStatus('connecting');
    setCartControlsEnabled(false);

    try {
        portalWebSocket = new WebSocket(getPortalWebSocketUrl());
    } catch (error) {
        console.error('Failed to establish WebSocket connection:', error);
        handlePortalSocketDisconnected('Unable to reach live cart. Retrying…');
        schedulePortalWebSocketReconnect();
        return;
    }

    portalWebSocket.addEventListener('open', () => {
        portalWebSocketAttempts = 0;
        if (portalWebSocketReconnectTimer) {
            clearTimeout(portalWebSocketReconnectTimer);
            portalWebSocketReconnectTimer = null;
        }
        handlePortalSocketConnected();
    });

    portalWebSocket.addEventListener('message', handlePortalWebSocketMessage);

    portalWebSocket.addEventListener('close', () => {
        handlePortalSocketDisconnected('Connection lost. Reconnecting…');
        schedulePortalWebSocketReconnect();
    });

    portalWebSocket.addEventListener('error', (error) => {
        console.error('WebSocket connection error:', error);
        console.error('Failed to connect to:', getPortalWebSocketUrl());
        handlePortalSocketDisconnected('Unable to reach live cart. Retrying…');
        schedulePortalWebSocketReconnect();
    });
}

window.addEventListener('cartSidebarOpened', async () => {
    const cart = getCartManager();
    if (!cart) {
        return;
    }
    
    if (!portalWebSocketConnected) {
        renderCart();
        return;
    }
    
    // OPTIMISTIC UI: Show cached cart immediately (no waiting for API)
    renderCart();
    
    // CRITICAL: If user just added items (within last 3 seconds), sync frontend to backend first
    // This prevents the cart from appearing empty if backend hasn't finished syncing yet
    const timeSinceLastAction = Date.now() - lastUserActionTime;
    const recentlyAddedItems = timeSinceLastAction < 3000; // 3 seconds
    
    try {
        if (recentlyAddedItems && cart.cart.items.length > 0) {
            // User just added items - sync frontend cart to backend first
            console.log('Cart opened shortly after adding items - syncing frontend to backend first');
            // Wait a moment for any pending backend syncs to complete
            await new Promise(resolve => setTimeout(resolve, 500));
        }
        
        // Then reload from backend to get latest data (line_item_ids, totals, etc.)
        // Pass lastActionTime to allow keeping frontend cart if items were just added
        await cart.loadFromBackend(false, lastUserActionTime);
        
        // Update cart UI with backend data once sync completes
        renderCart();
    } catch (error) {
        console.error('Failed to refresh cart after opening sidebar:', error);
        // If backend reload fails, keep showing cached cart (don't clear it)
    }
});

async function loadCart() {
    try {
        const cart = getCartManager();
        if (!cart) {
            console.warn('loadCart called before cart manager initialized');
            return;
        }

        if (!portalWebSocketConnected) {
            renderCart();
            return;
        }

        // Show current cart while fetching updated data
        renderCart();

        // Force reload from backend (backend is source of truth)
        const synced = await cart.loadFromBackend(true, 0);
        if (!synced) {
            console.warn('loadCart - Failed to sync cart from backend');
        }
        
        // Update cart UI with backend data once sync completes
        renderCart();
    } catch (error) {
        console.error('Error loading cart:', error);
        // If sync fails, keep showing cached cart (better than empty)
    }
}

// INSTANT CART - Frontend only, no backend API call
async function addToCart(event, batchId) {
    event.preventDefault();
    
    // Prevent adding items while cart operations are in progress
    if (cartOperationInProgress) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please wait while cart items are being removed...', 'info');
        }
        return;
    }
    
    // Get cart manager
    const cart = getCartManager();
    if (!cart) {
        console.error('Cart manager not initialized');
        return;
    }

    if (!ensureCartOnline('add items to the cart')) {
        return;
    }
    
    // Get quantity
    let quantity = 1;
    const container = event.target.closest('.quantity-selector-container');
    if (container) {
        const quantityInput = container.querySelector('.quantity-input');
        const inputValue = quantityInput?.value || '1';
        quantity = parseInt(inputValue, 10);
    } else {
        // Table view
        const td = event.target.closest('td');
        const tableInput = td ? td.querySelector('.table-qty-input') : null;
        const inputValue = tableInput?.value || '1';
        quantity = parseInt(inputValue, 10);
    }
    
    if (!quantity || isNaN(quantity) || quantity <= 0) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please enter a valid quantity', 'warning');
        } else {
            alert('Please enter a valid quantity');
        }
        return;
    }
    
    // Get product data from DOM
    const card = event.target.closest('.product-card');
    const row = event.target.closest('.product-row');
    const element = card || row;
    
    if (!element) {
        console.error('Could not find product element');
        return;
    }
    
    // Extract product data from data attributes
    const productData = {
        product_id: element.dataset.productId,
        batch_id: batchId,
        product_name: element.dataset.productName || 'Product',
        batch_name: element.dataset.batchName || '',
        brand_name: element.dataset.brandName || 'AMAZE',
        cultivar_name: element.dataset.cultivarName || '',
        category_name: element.dataset.categoryName || '',
        product_type: element.dataset.productType || '',
        unit_size: element.dataset.unitSize || '',
        unit_measurement_name: element.dataset.unitMeasurementName || '',
        units_per_case: parseInt(element.dataset.unitsPerCase || '24', 10),
        unit_price: parseFloat(element.dataset.unitPrice || '0'),
        quantity_available: parseInt(element.dataset.quantityAvailable || '0', 10),
        image_url: element.dataset.imageUrl || '/public/images/placeholder.jpg'
    };
    
    // Check inventory limit
    const currentQuantity = cart.cart.items.find(item => item.batch_id === batchId)?.quantity || 0;
    const totalRequested = currentQuantity + quantity;
    
    if (totalRequested > productData.quantity_available) {
        const available = productData.quantity_available - currentQuantity;
        if (available <= 0) {
            if (typeof showNotification !== 'undefined') {
                showNotification('This item is out of stock', 'error');
            } else {
                alert('This item is out of stock');
            }
            return;
        } else {
            quantity = available; // Adjust to max available
            if (typeof showNotification !== 'undefined') {
                showNotification(`Only ${available} cases available. Adjusted quantity.`, 'warning');
            }
        }
    }
    
    // Track user action timestamp to prevent unnecessary WebSocket reloads
    lastUserActionTime = Date.now();
    
    // Add to cart instantly (frontend only)
    cart.addItem(batchId, quantity, productData);
    
    // CRITICAL: Render cart IMMEDIATELY after adding item (before backend sync)
    // This ensures the user sees the item right away
    renderCart();
    
    // Sync to backend in real-time
    fetch(`/api/portal/${cart.uuid}/cart/add`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            batch_id: batchId,
            quantity: quantity,
            client_session_id: portalClientSessionId
        })
    }).then(async response => {
        let data = {};
        try {
            data = await response.json();
        } catch (parseError) {
            console.error('Failed to parse add-to-cart response:', parseError);
        }
        
        if (!response.ok || !data.success) {
            const errorMessage = data.error || data.details || data.message || 'Failed to sync item to backend';
            throw new Error(errorMessage);
        }
        
        return data;
    }).then(data => {
        const backendItem = data.line_item || null;
        let cartItem = cart.cart.items.find(item => String(item.batch_id) === String(batchId));

        if (backendItem && cartItem) {
            cartItem.line_item_id = backendItem.id;
            cartItem.quantity = parseInt(backendItem.quantity_ordered, 10) || cartItem.quantity;
            cartItem.unit_price = parseFloat(backendItem.unit_price ?? cartItem.unit_price);
            cartItem.line_total = parseFloat(backendItem.line_total ?? (cartItem.unit_price * cartItem.quantity));
            cartItem.quantity_allocated = parseInt(backendItem.quantity_allocated ?? cartItem.quantity_allocated ?? 0, 10);
        }
        
        if (data.totals) {
            cart.cart.subtotal = parseFloat(data.totals.subtotal ?? cart.cart.subtotal ?? 0);
            cart.cart.total = parseFloat(data.totals.total ?? cart.cart.total ?? 0);
        }

        const availabilityRecords = [];
        if (data.batch_availability) {
            availabilityRecords.push(data.batch_availability);
        } else if (Array.isArray(data.affected_batches)) {
            availabilityRecords.push(...data.affected_batches);
        }

        availabilityRecords.forEach(record => {
            if (!record) return;
            const recordBatchId = record.batch_id ?? backendItem?.batch_id ?? batchId;
            const recordQuantity = record.quantity_available ?? record.remaining_available ?? record.available;
            if (recordBatchId === undefined || recordQuantity === undefined) {
                return;
            }

            const parsedQuantity = parseInt(recordQuantity, 10);
            if (!Number.isNaN(parsedQuantity)) {
                updateProductAvailability(recordBatchId, parsedQuantity);

                const targetItem = cart.cart.items.find(item => String(item.batch_id) === String(recordBatchId));
                if (targetItem) {
                    targetItem.quantity_available = parsedQuantity;
                }
            }
        });
        
        cart.saveCart();
        renderCart();
    }).catch(async err => {
        console.error('Error syncing item to backend:', err);
        
        if (typeof showNotification !== 'undefined') {
            showNotification(err.message || 'Failed to sync cart item. Reverting changes.', 'error');
        }
        
        // Reload cart state from backend to ensure consistency
        try {
            await cart.loadFromBackend();
        } catch (syncError) {
            console.error('Failed to reload cart from backend after error:', syncError);
        }
        renderCart();
    });
    
    // Show success notification
    const itemText = quantity === 1 ? '1 item' : `${quantity} items`;
    if (typeof showNotification !== 'undefined') {
        showNotification(`${itemText} added to cart`, 'success');
    }
    
    // Note: renderCart() was already called immediately after addItem() above
    // This ensures the cart updates instantly, even before backend sync completes
}

function renderCart() {
    const cart = getCartManager();
    if (!cart) {
        console.warn('renderCart: Cart manager not initialized');
        return;
    }

    if (!renderCart.listenerBound) {
        window.addEventListener('cartChanged', renderCart);
        window.addEventListener('cartExpired', () => {
            // Silent expiration - just update UI (cart will appear empty)
            renderCart();
        });
        renderCart.listenerBound = true;
    }
    
    // Update expiration warning display
    if (cart && typeof cart.updateExpirationWarning === 'function') {
        cart.updateExpirationWarning();
    }
    
    const cartData = cart.getCart();
    const cartItemsDiv = document.getElementById('cart-items');
    const cartCountSpan = document.getElementById('cart-count');
    const cartSubtotalSpan = document.getElementById('cart-subtotal');
    const cartTotalSpan = document.getElementById('cart-total');
    const checkoutBtn = document.getElementById('checkout-btn');
    
    // Validate required DOM elements exist
    if (!cartItemsDiv || !cartCountSpan || !cartSubtotalSpan || !cartTotalSpan) {
        console.error('renderCart: Required DOM elements not found', {
            cartItemsDiv: !!cartItemsDiv,
            cartCountSpan: !!cartCountSpan,
            cartSubtotalSpan: !!cartSubtotalSpan,
            cartTotalSpan: !!cartTotalSpan
        });
        return;
    }

    if (!portalWebSocketConnected) {
        const isInitialConnect = !portalWebSocketEverConnected;
        const offlineIcon = isInitialConnect ? '🔄' : '⚠️';
        const offlineLine1 = isInitialConnect
            ? 'Connecting to your live cart…'
            : 'Live cart connection lost.';
        const offlineLine2 = isInitialConnect
            ? 'Verifying availability before displaying your cart.'
            : 'We’re reconnecting to verify current availability.';

        cartItemsDiv.innerHTML = `
            <div class="cart-offline-message">
                <div class="cart-offline-icon">${offlineIcon}</div>
                <p>${offlineLine1}</p>
                <p>${offlineLine2}</p>
            </div>
        `;
        if (cartCountSpan) {
            cartCountSpan.textContent = '--';
        }
        const headerBadge = document.getElementById('cart-count-badge');
        if (headerBadge) {
            headerBadge.textContent = '!';
            headerBadge.style.display = 'inline-block';
        }
        if (cartSubtotalSpan) {
            cartSubtotalSpan.textContent = '—';
        }
        if (cartTotalSpan) {
            cartTotalSpan.textContent = '—';
        }
        if (checkoutBtn) {
            checkoutBtn.dataset.offlineDisabled = 'true';
            checkoutBtn.disabled = true;
        }
        setCartControlsEnabled(false);
        return;
    }
    
    setCartControlsEnabled(true);
    
    if (cartData.items && cartData.items.length > 0) {
        cartItemsDiv.innerHTML = cartData.items.map(item => {
            const imageUrl = (item.image_url && item.image_url !== '') 
                ? item.image_url 
                : '/public/images/placeholder.jpg';
            return `
            <div class="cart-item" data-line-item-id="${item.line_item_id}">
                <div class="cart-item-header">
                    <img src="${imageUrl}" 
                         alt="${item.product_name}" 
                         class="cart-item-image"
                         onerror="if(this.src.indexOf('placeholder.jpg')===-1){this.src='/public/images/placeholder.jpg';}else{this.onerror=null;this.style.display='none';}">
                    <div class="cart-item-info">
                        <h4 class="cart-item-name">${item.product_name}</h4>
                        <div class="cart-item-attributes">
                            ${item.batch_name}<br>
                            Vendor: AMAZE Cannabis<br>
                            Brand: AMAZE<br>
                            Category: Extract
                        </div>
                    </div>
                </div>
                <div class="cart-item-price">
                    <span class="price-label">$${item.unit_price.toFixed(2)} / Case</span>
                </div>
                <div class="cart-quantity-controls">
                    <button class="quantity-btn" onclick="updateQuantity('${String(item.line_item_id)}', -1)">-</button>
                    <span>${item.quantity}</span>
                    <button class="quantity-btn" onclick="updateQuantity('${String(item.line_item_id)}', 1)">+</button>
                </div>
                <div class="cart-item-total">
                    <span>Total: $${item.line_total.toFixed(2)}</span>
                    <button class="remove-item-btn" onclick="removeItem('${String(item.line_item_id)}', ${item.batch_id})">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        `;
        }).join('');
        
        const itemCount = cart.getItemCount();
        if (cartCountSpan) {
            cartCountSpan.textContent = itemCount;
        }
        const headerBadge = document.getElementById('cart-count-badge');
        if (headerBadge) {
            headerBadge.textContent = itemCount;
            headerBadge.style.display = itemCount > 0 ? 'inline-block' : 'none';
        }
        // Also update cart icon count via cart manager
        if (cart && typeof cart.updateCartIcon === 'function') {
            cart.updateCartIcon();
        }
        if (checkoutBtn) {
            delete checkoutBtn.dataset.offlineDisabled;
            checkoutBtn.disabled = false;
        }
    } else {
        cartItemsDiv.innerHTML = `
            <div class="empty-cart">
                <div class="empty-cart-icon">🛒</div>
                <p>Your cart is empty</p>
            </div>
        `;
        if (cartCountSpan) {
            cartCountSpan.textContent = '0';
        }
        const headerBadge = document.getElementById('cart-count-badge');
        if (headerBadge) {
            headerBadge.textContent = '0';
            headerBadge.style.display = 'none';
        }
        // Also update cart icon count via cart manager
        if (cart && typeof cart.updateCartIcon === 'function') {
            cart.updateCartIcon();
        }
        if (checkoutBtn) {
            delete checkoutBtn.dataset.offlineDisabled;
            checkoutBtn.disabled = true;
        }
    }
    
    // Compute and display discounts and credits using portal pricing API
    (async () => {
        try {
            const cfgEl = document.getElementById('portal-websocket-config');
            const cfg = cfgEl ? JSON.parse(cfgEl.textContent || '{}') : {};
            const buyerId = cfg?.buyerId || null;
            const hasItems = Array.isArray(cartData.items) && cartData.items.length > 0;
            let subtotalVal = Number(cartData.subtotal || 0);
            let discountsVal = 0;
            let creditsVal = 0;
            let totalVal = Number(cartData.total || subtotalVal);
            
            if (buyerId && hasItems) {
                // Get pricing (discounts)
                const payload = {
                    cartItems: cartData.items.map(i => ({
                        product_id: i.product_id,
                        category_name: i.category_name || null,
                        unit_price: i.unit_price,
                        quantity: i.quantity
                    }))
                };
                const pricingRes = await fetch(`/api/portal/<%= portalAccess.uuid %>/cart/pricing`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (pricingRes.ok) {
                    const pricingData = await pricingRes.json();
                    subtotalVal = Number(pricingData.subtotal || subtotalVal);
                    discountsVal = Number(pricingData.discounts || 0);
                    totalVal = Number(pricingData.total != null ? pricingData.total : (subtotalVal - discountsVal));
                }
                
                // Get available credits
                const creditsRes = await fetch(`/api/portal/<%= portalAccess.uuid %>/credits/available`);
                if (creditsRes.ok) {
                    const creditsData = await creditsRes.json();
                    const availableCredits = Number(creditsData?.credits?.available_total || creditsData?.credits?.available || 0);
                    // Credits apply up to remaining after discounts
                    creditsVal = Math.min(availableCredits, Math.max(0, subtotalVal - discountsVal));
                }
                
                // Final total: subtotal - discounts - credits
                totalVal = Math.max(0, subtotalVal - discountsVal - creditsVal);
            }
            
            // Update DOM
            if (cartSubtotalSpan) cartSubtotalSpan.textContent = `$${subtotalVal.toFixed(2)}`;
            const cartDiscountsSpan = document.getElementById('cart-discounts');
            if (cartDiscountsSpan) cartDiscountsSpan.textContent = `-$${discountsVal.toFixed(2)}`;
            const cartCreditsSpan = document.getElementById('cart-credits');
            const cartCreditsRow = document.getElementById('cart-credits-row');
            if (cartCreditsSpan) {
                cartCreditsSpan.textContent = creditsVal > 0 ? `-$${creditsVal.toFixed(2)}` : '$0.00';
            }
            if (cartCreditsRow) {
                cartCreditsRow.style.display = creditsVal > 0 ? 'flex' : 'flex'; // Always show, even if $0.00
            }
            if (cartTotalSpan) cartTotalSpan.textContent = `$${totalVal.toFixed(2)}`;
        } catch (e) {
            // Fallback to existing values
            if (cartSubtotalSpan) cartSubtotalSpan.textContent = `$${cartData.subtotal.toFixed(2)}`;
            if (cartTotalSpan) cartTotalSpan.textContent = `$${cartData.total.toFixed(2)}`;
            const cartDiscountsSpan = document.getElementById('cart-discounts');
            if (cartDiscountsSpan) cartDiscountsSpan.textContent = '-$0.00';
            const cartCreditsSpan = document.getElementById('cart-credits');
            const cartCreditsRow = document.getElementById('cart-credits-row');
            if (cartCreditsSpan) cartCreditsSpan.textContent = '$0.00';
            if (cartCreditsRow) cartCreditsRow.style.display = 'flex'; // Always show
            console.warn('Failed to compute portal discounts/credits:', e);
        }
    })();
}
renderCart.listenerBound = false;

// Debounce timer for cart updates
let cartUpdateTimer = null;
let pendingCartUpdates = new Map();
let updateQuantityInProgress = false;
let pendingUpdateRequest = null; // AbortController for cancelling pending requests

// INSTANT CART UPDATE - Frontend only
async function updateQuantity(lineItemId, delta) {
    // CRITICAL: Prevent concurrent updates to avoid race conditions and freezing
    if (updateQuantityInProgress) {
        console.log('Update already in progress, skipping...');
        return;
    }

    if (!ensureCartOnline('update cart quantities')) {
        return;
    }
    
    // Track user action timestamp to prevent unnecessary WebSocket reloads
    lastUserActionTime = Date.now();
    
    const cart = getCartManager();
    if (!cart) {
        console.error('Cart manager not initialized');
        return;
    }
    
    // Find item by line_item_id (could be temp_* or actual ID)
    const item = cart.cart.items.find(i => {
        // Handle both string and number comparisons
        return String(i.line_item_id) === String(lineItemId);
    });
    
    if (!item) {
        console.error('Item not found in cart:', lineItemId, cart.cart.items);
        return;
    }
    
    const newQuantity = item.quantity + delta;
    if (newQuantity <= 0) {
        // Remove item if quantity goes to 0 or below
        removeItem(lineItemId, item.batch_id);
        return;
    }
    
    // Check inventory limit
    if (item.quantity_available && newQuantity > item.quantity_available) {
        if (typeof showNotification !== 'undefined') {
            showNotification(`Maximum available: ${item.quantity_available} cases`, 'warning');
        } else {
            alert(`Maximum available: ${item.quantity_available} cases`);
        }
        return;
    }
    
    // Update instantly (frontend only)
    const updated = cart.updateQuantity(item.batch_id, newQuantity);
    if (!updated) {
        console.error('Failed to update quantity for batch:', item.batch_id);
        return;
    }

    // Render immediately for instant feedback
    renderCart();

    // CRITICAL: Cancel any pending update request to prevent race conditions
    if (pendingUpdateRequest) {
        pendingUpdateRequest.abort();
        pendingUpdateRequest = null;
    }

    // Set flag to prevent concurrent updates
    updateQuantityInProgress = true;

    try {
        // Sync to backend in real-time (only if item has real line_item_id)
        if (item.line_item_id && !String(item.line_item_id).startsWith('temp_')) {
            // Create AbortController for this request
            const abortController = new AbortController();
            pendingUpdateRequest = abortController;

            try {
                const response = await fetch(`/api/portal/${cart.uuid}/cart/update`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        line_item_id: item.line_item_id,
                        quantity: newQuantity,
                        client_session_id: portalClientSessionId
                    }),
                    signal: abortController.signal // Allow cancellation
                });

                // Check if request was aborted
                if (abortController.signal.aborted) {
                    console.log('Update request was cancelled');
                    return;
                }

                let data = {};
                try {
                    data = await response.json();
                } catch (parseError) {
                    console.error('Failed to parse update quantity response:', parseError);
                }

                if (!response.ok || !data.success) {
                    const errorMessage = data.error || data.details || data.message || 'Failed to update cart item';
                    throw new Error(errorMessage);
                }

                // Update frontend cart with backend response data
                let cartItemRef = cart.cart.items.find(i => String(i.batch_id) === String(item.batch_id));

                if (data.line_item && cartItemRef) {
                    cartItemRef.line_item_id = data.line_item.id;
                    cartItemRef.quantity = parseInt(data.line_item.quantity_ordered, 10) || cartItemRef.quantity;
                    cartItemRef.unit_price = parseFloat(data.line_item.unit_price ?? cartItemRef.unit_price);
                    cartItemRef.line_total = parseFloat(data.line_item.line_total ?? (cartItemRef.unit_price * cartItemRef.quantity));
                    cartItemRef.quantity_allocated = parseInt(data.line_item.quantity_allocated ?? cartItemRef.quantity_allocated ?? 0, 10);
                }

                // Update totals from backend response
                if (data.totals) {
                    cart.cart.subtotal = parseFloat(data.totals.subtotal ?? cart.cart.subtotal ?? 0);
                    cart.cart.total = parseFloat(data.totals.total ?? cart.cart.total ?? 0);
                }

                const availabilityRecords = [];
                if (data.batch_availability) {
                    availabilityRecords.push(data.batch_availability);
                } else if (Array.isArray(data.affected_batches)) {
                    availabilityRecords.push(...data.affected_batches);
                }

                availabilityRecords.forEach(record => {
                    if (!record) return;
                    const recordBatchId = record.batch_id ?? item.batch_id;
                    const recordQuantity = record.quantity_available ?? record.remaining_available ?? record.available;
                    if (recordBatchId === undefined || recordQuantity === undefined) {
                        return;
                    }
                    const parsedQuantity = parseInt(recordQuantity, 10);
                    if (!Number.isNaN(parsedQuantity)) {
                        updateProductAvailability(recordBatchId, parsedQuantity);
                        const targetItem = cart.cart.items.find(i => String(i.batch_id) === String(recordBatchId));
                        if (targetItem) {
                            targetItem.quantity_available = parsedQuantity;
                        }
                    }
                });

                cart.saveCart();
                renderCart(); // Final render with backend data

            } catch (err) {
                // Ignore abort errors
                if (err.name === 'AbortError') {
                    console.log('Update request was aborted');
                    return;
                }

                console.error('Error syncing quantity update:', err);
                if (typeof showNotification !== 'undefined') {
                    showNotification(err.message || 'Failed to update cart item. Reverting changes.', 'error');
                }
                // Reload from backend to get correct state
                await cart.loadFromBackend();
                renderCart();
            } finally {
                pendingUpdateRequest = null;
            }
        } else {
            // Item hasn't been fully synced yet; refresh from backend to grab real IDs/totals
            await cart.loadFromBackend();
            renderCart();
        }
    } finally {
        // Always clear the flag
        updateQuantityInProgress = false;
    }
}

async function syncCartUpdates() {
    if (pendingCartUpdates.size === 0) return;
    
    if (!ensureCartOnline('synchronize cart changes')) {
        pendingCartUpdates.clear();
        return;
    }
    
    const uuid = '<%= uuid %>';
    const updates = Array.from(pendingCartUpdates.values());
    pendingCartUpdates.clear();
    
    // Sync all pending updates
    for (const update of updates) {
        try {
            const response = await fetch(`/api/portal/${uuid}/cart/update`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(update)
            });
            
            const data = await response.json();
            if (!data.success) {
                console.error('Cart sync failed:', data.error);
                // Reload cart to revert to server state
                await loadCart();
                if (typeof showNotification !== 'undefined') {
                    showNotification(data.error || 'Failed to sync cart', 'error');
                }
                return;
            }
        } catch (error) {
            console.error('Error syncing cart:', error);
            // Reload cart to revert to server state
            await loadCart();
            if (typeof showNotification !== 'undefined') {
                showNotification('Failed to sync cart', 'error');
            }
            return;
        }
    }
    
    // After successful sync, reload cart to ensure consistency
    await loadCart();
}

// Function to enable/disable add-to-cart buttons
function setAddToCartButtonsEnabled(enabled) {
    const addButtons = document.querySelectorAll('.add-to-cart-btn, .table-add-btn, .btn-add-to-cart-modal');
    addButtons.forEach(btn => {
        btn.disabled = !enabled;
        if (!enabled) {
            btn.style.opacity = '0.5';
