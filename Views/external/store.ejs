        productTypeTags.push(productData.categoryName);
    }
    if (productData.cultivarName) {
        productTypeTags.push(productData.cultivarName);
    }
    document.getElementById('modal-product-type-tags').textContent = productTypeTags.join(' | ') + ' |';
    
