    thcMarker.style.left = `${thcPercentValue}%`;
    
    // Set availability
    document.getElementById('modal-available').textContent = `${productData.quantityAvailable} Cases`;
    
    // Calculate and set units info
    const totalUnits = productData.quantityAvailable * unitsPerCase;
    document.getElementById('modal-total-units').textContent = totalUnits.toLocaleString();
    document.getElementById('modal-units-per-case').textContent = unitsPerCase;
    
    // Set pricing
    const unitPrice = productData.unitPrice || 0;
    document.getElementById('modal-price').textContent = `$${unitPrice.toFixed(0)}`;
    document.getElementById('modal-price-per-unit').textContent = 
        `$${(unitPrice / unitsPerCase).toFixed(2)}/unit`;
    
    // Set quantity input max
    const qtyInput = document.getElementById('modal-quantity');
    qtyInput.max = productData.quantityAvailable;
    qtyInput.value = 1;
    
    // Update total cost
    updateModalTotalCost();
    
    // Add quantity change listener
    qtyInput.oninput = updateModalTotalCost;
    
    // Show modal
    document.getElementById('productDetailsModal').style.display = 'flex';
}

function updateModalTotalCost() {
    const quantity = parseInt(document.getElementById('modal-quantity').value) || 1;
    const total = quantity * currentModalUnitPrice;
    document.getElementById('modal-total-cost').textContent = `$${total.toFixed(2)}`;
}

async function addToCartFromModal() {
    // Prevent adding items while cart operations are in progress
    if (cartOperationInProgress) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please wait while cart items are being removed...', 'info');
        }
        return;
    }

    if (!ensureCartOnline('add items to the cart')) {
        return;
    }

    const quantity = parseInt(document.getElementById('modal-quantity').value) || 1;
    
    if (!currentModalBatchId) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Error: No batch selected', 'error');
        } else {
            alert('Error: No batch selected');
        }
        return;
    }
    
    const parsedQty = parseInt(quantity, 10);
    if (parsedQty <= 0 || isNaN(parsedQty)) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please enter a valid quantity', 'warning');
        } else {
            alert('Please enter a valid quantity');
        }
        return;
    }
    
    await addToCartFromBatch(currentModalBatchId, parsedQty);
    closeProductModal();
}

async function addToCartFromBatch(batchId, quantity) {
    // Prevent adding items while cart operations are in progress
    if (cartOperationInProgress) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please wait while cart items are being removed...', 'info');
        }
        return;
    }

    if (!ensureCartOnline('add items to the cart')) {
        return;
    }
    
    const uuid = '<%= uuid %>';
    const parsedQuantity = parseInt(quantity, 10);
    console.log('addToCartFromBatch - Sending:', { batchId, quantity, parsedQuantity });
    try {
        const response = await fetch(`/api/portal/${uuid}/cart/add`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                batch_id: batchId,
                quantity: parsedQuantity,
                client_session_id: portalClientSessionId
            })
        });
        
        const data = await response.json();
        if (data.success) {
            const availabilityRecords = [];
            if (data.batch_availability) {
                availabilityRecords.push(data.batch_availability);
            } else if (Array.isArray(data.affected_batches)) {
                availabilityRecords.push(...data.affected_batches);
            }

            availabilityRecords.forEach(record => {
                if (!record) return;
                const recordBatchId = record.batch_id ?? batchId;
                const recordQuantity = record.quantity_available ?? record.remaining_available ?? record.available;
                if (recordBatchId === undefined || recordQuantity === undefined) {
                    return;
                }
                const parsedQuantity = parseInt(recordQuantity, 10);
                if (!Number.isNaN(parsedQuantity)) {
                    updateProductAvailability(recordBatchId, parsedQuantity);
                }
            });

            await loadCart();
            // Show success notification with item count
            const itemText = parsedQuantity === 1 ? '1 item' : `${parsedQuantity} items`;
            if (typeof showNotification !== 'undefined') {
                showNotification(`${itemText} added to cart`, 'success');
            } else {
                alert(`${itemText} added to cart successfully!`);
            }
        } else {
            if (typeof showNotification !== 'undefined') {
                showNotification(data.error || 'Failed to add item to cart', 'error');
            } else {
                alert(data.error || 'Failed to add item to cart');
            }
        }
    } catch (error) {
        console.error('Error adding to cart:', error);
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to add item to cart', 'error');
        } else {
            alert('Failed to add item to cart');
        }
    }
}

