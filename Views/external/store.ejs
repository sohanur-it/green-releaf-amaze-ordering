// Pagination and Filtering
let currentPage = 1;
// Load itemsPerPage from localStorage or default to 24
// Don't use localStorage initially - start with default to show all products
let itemsPerPage = 24;
// After page loads, check localStorage
if (typeof Storage !== 'undefined') {
    const saved = localStorage.getItem('itemsPerPage');
    if (saved && !isNaN(parseInt(saved))) {
        itemsPerPage = parseInt(saved);
    }
}
let filteredProducts = [];
let totalPages = 1;

// Initialize products and pagination
function initProducts() {
    const gridView = document.getElementById('grid-view');
    const tableView = document.getElementById('table-view');
    
    // Get the current view preference
    const params = new URLSearchParams(window.location.search);
    const paramView = params.get('view');
    const savedView = paramView || localStorage.getItem('preferredView') || 'grid';
    const currentViewType = savedView === 'table' ? 'table' : 'grid';
    
    // Query products from both views WITHOUT showing them
    // querySelector works on hidden elements, so we don't need to show both views
    // This prevents the flickering/lag issue
    const gridProducts = Array.from(document.querySelectorAll('.product-card-clickable'));
    const tableProducts = Array.from(document.querySelectorAll('tbody .product-row'));
    
    console.log('initProducts: Found', gridProducts.length, 'grid products');
    console.log('initProducts: Found', tableProducts.length, 'table products');
    
    // For grid view, use grid products
    // For table view, use table products
    // Since they represent the same data, we should use the appropriate one based on current view
    // But we need both to ensure pagination works in both views
    
    if (currentViewType === 'table') {
        // In table view, use table products
        filteredProducts = tableProducts;
        console.log('initProducts: Using table products, count:', filteredProducts.length);
    } else {
        // In grid view, use grid products
        filteredProducts = gridProducts;
        console.log('initProducts: Using grid products, count:', filteredProducts.length);
    }
    
    // Only retry if we found 0 products initially (suggests batches are being promoted)
    // If we found some products, proceed normally - they might just be the actual count
    if (filteredProducts.length === 0) {
        console.log('initProducts: Found 0 products, retrying to catch auto-promoted batches...');
        
        // Try multiple times with increasing delays to catch products that are being promoted
        const retryDelays = [500, 1000, 2000];
        let retryAttempt = 0;
        
        const retryFindProducts = () => {
            if (retryAttempt >= retryDelays.length) {
                // After all retries, if still 0, that's a real issue
                if (filteredProducts.length === 0) {
                    console.warn('initProducts: No products found after retries. Catalog may be empty or batches not yet promoted.');
                } else {
                    console.log('initProducts: Found', filteredProducts.length, 'products after retries');
                }
                initializeProductsData();
                return;
            }
            
            setTimeout(() => {
                const retryGrid = Array.from(document.querySelectorAll('.product-card-clickable'));
                const retryTable = Array.from(document.querySelectorAll('tbody .product-row'));
                
                let updated = false;
                if (currentViewType === 'table' && retryTable.length > filteredProducts.length) {
                    filteredProducts = retryTable;
                    updated = true;
                    console.log('initProducts: Found', filteredProducts.length, 'table products on retry', retryAttempt + 1);
                } else if (currentViewType === 'grid' && retryGrid.length > filteredProducts.length) {
                    filteredProducts = retryGrid;
                    updated = true;
                    console.log('initProducts: Found', filteredProducts.length, 'grid products on retry', retryAttempt + 1);
                }
                
                // If we found products, initialize immediately
                if (updated && filteredProducts.length > 0) {
                    initializeProductsData();
                } else {
                    // Still no products, try again
                    retryAttempt++;
                    retryFindProducts();
                }
            }, retryDelays[retryAttempt]);
        };
        
        retryFindProducts();
    } else {
        // Found products, proceed normally
        console.log('initProducts: Found', filteredProducts.length, 'products, proceeding normally');
        initializeProductsData();
    }
    
    function initializeProductsData() {
    
    // Ensure correct view is displayed (should already be set, but double-check)
    // This prevents any flickering by ensuring view state is correct
    if (currentViewType === 'grid') {
        // Show grid, hide table
        if (gridView && gridView.style.display !== 'grid') {
            gridView.style.display = 'grid';
        }
        if (tableView && tableView.style.display !== 'none') {
            tableView.classList.remove('active');
            tableView.style.display = 'none';
        }
    } else {
        // Show table, hide grid
        if (gridView && gridView.style.display !== 'none') {
            gridView.style.display = 'none';
        }
        if (tableView && tableView.style.display !== 'block') {
            tableView.classList.add('active');
            tableView.style.display = 'block';
        }
    }
    
        // Set dropdown to match current itemsPerPage
        const itemsPerPageSelect = document.getElementById('items-per-page');
        if (itemsPerPageSelect) {
            itemsPerPageSelect.value = itemsPerPage;
        }
        
        // Set initial product count to total products (before filtering)
        const totalProducts = filteredProducts.length;
        updateProductCount(totalProducts);
        console.log('initProducts: Total products count:', totalProducts);
        
        // Initially, mark all products as visible (no filters applied yet)
        filteredProducts.forEach(item => {
            item.dataset.filteredVisible = 'true';
        });
        
        // Show all products initially (no filtering or pagination)
        // This ensures all products are visible before pagination kicks in
        filteredProducts.forEach(item => {
            if (item.tagName === 'TR') {
                item.style.display = 'table-row';
            } else {
                item.style.display = '';
            }
        });
        
        totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
        console.log('initProducts: Total pages:', totalPages, 'Items per page:', itemsPerPage);
        renderPagination();
        
        // Apply pagination to show first page
        const allVisibleProducts = filteredProducts.filter(item => item.dataset.filteredVisible !== 'false');
        showPageFiltered(1, allVisibleProducts);
        
        // Then apply filters (which will re-paginate)
        // Use setTimeout to ensure DOM is ready
        setTimeout(() => {
            applyFilters();
        }, 100);
    }
}

function applyFilters() {
    // Get filter values
    const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(cb => cb.value);
    const selectedStrains = Array.from(document.querySelectorAll('input[name="strain"]:checked')).map(cb => cb.value);
    const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(cb => cb.value);
    const minPotency = parseFloat(document.getElementById('min-potency')?.value || 0);
    const maxPotency = parseFloat(document.getElementById('max-potency')?.value || 100);
    const searchTerm = document.getElementById('portal-search-input')?.value.toLowerCase() || '';
    
    // Filter products - mark which ones should be visible
    const visibleProducts = [];
    filteredProducts.forEach(item => {
        let shouldShow = true;
        
        // Search filter (search in product name, cultivar name, brand name, batch name)
        if (searchTerm) {
            const searchableText = [
                item.dataset.productName || '',
                item.dataset.cultivarName || '',
                item.dataset.brandName || '',
                item.dataset.batchName || ''
            ].join(' ').toLowerCase();
            
            if (!searchableText.includes(searchTerm)) {
                shouldShow = false;
            }
        }
        
        // Category filter
        if (selectedCategories.length > 0 && shouldShow) {
            const category = item.dataset.categoryName || '';
            if (!selectedCategories.some(cat => category.includes(cat))) {
                shouldShow = false;
            }
        }
        
        // Strain filter (use cultivar_type_name from database)
        if (selectedStrains.length > 0 && shouldShow) {
            const strain = item.dataset.cultivarTypeName || '';
            if (!selectedStrains.some(s => strain.includes(s))) {
                shouldShow = false;
            }
        }
        
        // Brand filter
        if (selectedBrands.length > 0 && shouldShow) {
            const brand = item.dataset.brandName || '';
            if (!selectedBrands.includes(brand)) {
                shouldShow = false;
            }
        }
        
        // Potency filter
        if (shouldShow) {
            const thc = parseFloat(item.dataset.thcPercentage || 0);
            if (thc < minPotency || thc > maxPotency) {
                shouldShow = false;
            }
        }
        
        // Store visibility flag in data attribute instead of setting display immediately
        item.dataset.filteredVisible = shouldShow ? 'true' : 'false';
        if (shouldShow) {
            visibleProducts.push(item);
        }
    });
    
    // Update pagination based on visible products
    totalPages = Math.ceil(visibleProducts.length / itemsPerPage);
    currentPage = 1;
    renderPagination();
    
    // Show page 1 of filtered products
    showPageFiltered(1, visibleProducts);
    
    // Update product count - show total filtered products, not just visible on current page
    updateProductCount(visibleProducts.length);
    subscribeToVisibleBatches();
    
    // Re-setup hover previews after filtering (in case new products were shown)
    if (document.getElementById('table-view')?.classList.contains('active')) {
        setTimeout(() => {
            setupTableImageHover();
        }, 50);
    }
}

// Show page with filtered products
function showPageFiltered(page, visibleProducts) {
    const start = (page - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    
    console.log('showPageFiltered: Page', page, 'showing', start, 'to', end, 'of', visibleProducts.length, 'visible products');
    
    // First, hide all products
    filteredProducts.forEach(item => {
        item.style.display = 'none';
    });
    
    // Then show only visible products on current page
    visibleProducts.forEach((item, index) => {
        if (index >= start && index < end) {
            if (item.tagName === 'TR') {
                item.style.display = 'table-row';
            } else {
                item.style.display = '';
            }
        } else {
            // Hide items not on current page
            item.style.display = 'none';
        }
    });
    
    console.log('showPageFiltered: Showing', Math.min(end - start, visibleProducts.length - start), 'products on page', page);
    
    currentPage = page;
    renderPagination(); // Re-render pagination to update active state
    updatePaginationButtons();
    
    // Re-setup hover previews if in table view
    const tableView = document.getElementById('table-view');
    if (tableView && tableView.classList.contains('active')) {
        setTimeout(() => {
            setupTableImageHover();
        }, 50);
    }
}

function updateProductCount(count) {
    const countElement = document.getElementById('product-count');
    if (!countElement) {
        return;
    }

    let value = count;
    if (value === undefined || value === null) {
        const visibleCards = Array.from(document.querySelectorAll('.product-card[data-batch-id]')).filter(card => {
            if (card.dataset.hiddenDueToStock === 'true') {
                return false;
            }
            if (card.classList.contains('out-of-stock-hidden')) {
                return false;
            }
            return card.style.display !== 'none';
        });
        value = visibleCards.length;
    }

    countElement.textContent = value;
}

function showPage(page) {
    // Get all products (not filtered by display status, since we're controlling that here)
    const allProducts = filteredProducts;
    const start = (page - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    
    console.log('showPage: Showing page', page, 'from', start, 'to', end, 'of', allProducts.length);
    
    allProducts.forEach((item, index) => {
        if (index >= start && index < end) {
            // Show item - handle both grid cards and table rows
            if (item.tagName === 'TR') {
                item.style.display = 'table-row';
            } else {
                item.style.display = '';
            }
        } else {
            // Hide item
            item.style.display = 'none';
        }
    });
    
    currentPage = page;
    renderPagination(); // Re-render pagination to update active state
    updatePaginationButtons();
    
    // Re-setup hover previews if in table view
    const tableView = document.getElementById('table-view');
    if (tableView && tableView.classList.contains('active')) {
        setTimeout(() => {
            setupTableImageHover();
        }, 50);
    }
}

function goToPage(page) {
    // Get visible products based on filter status
    const visibleProducts = filteredProducts.filter(item => item.dataset.filteredVisible !== 'false');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    if (page >= 1 && page <= maxPage) {
        showPageFiltered(page, visibleProducts);
    }
}

function changeItemsPerPage() {
    itemsPerPage = parseInt(document.getElementById('items-per-page').value);
    // Save to localStorage
    localStorage.setItem('itemsPerPage', itemsPerPage);
    
    // Get visible products based on filter status
    const visibleProducts = filteredProducts.filter(item => item.dataset.filteredVisible !== 'false');
    totalPages = Math.ceil(visibleProducts.length / itemsPerPage);
    renderPagination();
    showPageFiltered(1, visibleProducts);
    
    // Re-setup hover previews after pagination change (in case we're in table view)
    if (document.getElementById('table-view')?.classList.contains('active')) {
        setTimeout(() => {
            setupTableImageHover();
        }, 50);
    }
}

function renderPagination() {
    // Get visible products based on filter status
    const visibleProducts = filteredProducts.filter(item => item.dataset.filteredVisible !== 'false');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    const paginationNumbers = document.getElementById('pagination-numbers');
    if (!paginationNumbers) return;
    
    paginationNumbers.innerHTML = '';
    
    // Calculate page range to show
    const maxVisible = 4;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(maxPage, startPage + maxVisible - 1);
    
    if (endPage - startPage < maxVisible - 1) {
        startPage = Math.max(1, endPage - maxVisible + 1);
    }
    
    for (let i = startPage; i <= endPage; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = 'pagination-number' + (i === currentPage ? ' active' : '');
        pageBtn.textContent = i;
        pageBtn.onclick = () => goToPage(i);
        paginationNumbers.appendChild(pageBtn);
    }
    
    // Update pagination button states
    updatePaginationButtons();
}

function updatePaginationButtons() {
    // Get visible products based on filter status
    const visibleProducts = filteredProducts.filter(item => item.dataset.filteredVisible !== 'false');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    const buttons = document.querySelectorAll('.pagination-btn');
    
    // Enable/disable first/previous buttons
    const firstBtn = buttons[0];
    const prevBtn = buttons[1];
    const nextBtn = buttons[2];
    const lastBtn = buttons[3];
    
    if (firstBtn) firstBtn.disabled = currentPage === 1;
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage >= maxPage;
    if (lastBtn) lastBtn.disabled = currentPage >= maxPage;
    
    buttons.forEach(btn => btn.style.display = '');
}

// Setup hover preview for table product images
function setupTableImageHover() {
    // Remove old event listeners by cloning (clean slate)
    const tableImages = document.querySelectorAll('.table-product-thumbnail');
    
    // Create or get global hover preview element
    let previewEl = document.querySelector('.table-image-hover-preview-global');
    if (!previewEl) {
        previewEl = document.createElement('div');
        previewEl.className = 'table-image-hover-preview table-image-hover-preview-global';
        previewEl.style.display = 'none';
        document.body.appendChild(previewEl);
    }
    
    // Remove existing listeners by replacing elements (simpler approach)
    tableImages.forEach(img => {
        // Clone to remove old listeners
        const newImg = img.cloneNode(true);
        img.parentNode.replaceChild(newImg, img);
        
        // Add new event listeners
        newImg.addEventListener('mouseenter', function(e) {
            const fullImageUrl = this.dataset.fullImage || this.src || '/public/images/placeholder.jpg';
            previewEl.innerHTML = `<img src="${fullImageUrl}" alt="${this.alt || 'Product'}" onerror="if(this.src.indexOf('placeholder.jpg')===-1){this.onerror=null;this.src='/public/images/placeholder.jpg';}else{this.onerror=null;this.style.display='none';}">`;
            previewEl.style.display = 'block';
            
            // Position preview near mouse cursor
            updatePreviewPosition(e, previewEl);
        });
        
        newImg.addEventListener('mousemove', function(e) {
            if (previewEl.style.display === 'block') {
                updatePreviewPosition(e, previewEl);
            }
        });
        
        newImg.addEventListener('mouseleave', function() {
            previewEl.style.display = 'none';
        });
    });
}

function updatePreviewPosition(e, previewEl) {
    const x = e.clientX + 15;
    const y = e.clientY + 15;
    const maxX = window.innerWidth - previewEl.offsetWidth - 20;
    const maxY = window.innerHeight - previewEl.offsetHeight - 20;
    
    previewEl.style.left = Math.min(x, maxX) + 'px';
    previewEl.style.top = Math.min(y, maxY) + 'px';
}


