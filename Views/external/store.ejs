    buttons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}

// Pagination and Filtering
let currentPage = 1;
let itemsPerPage = 24;
let filteredProducts = [];
let totalPages = 1;

// Initialize products and pagination
function initProducts() {
    filteredProducts = Array.from(document.querySelectorAll('.product-card-clickable, .product-row'));
    totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
    renderPagination();
    applyFilters();
}

function applyFilters() {
    // Get filter values
    const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(cb => cb.value);
    const selectedStrains = Array.from(document.querySelectorAll('input[name="strain"]:checked')).map(cb => cb.value);
    const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(cb => cb.value);
    const minPotency = parseFloat(document.getElementById('min-potency')?.value || 0);
    const maxPotency = parseFloat(document.getElementById('max-potency')?.value || 100);
    const searchTerm = document.getElementById('portal-search-input')?.value.toLowerCase() || '';
    
    // Filter products
    filteredProducts.forEach(item => {
        let shouldShow = true;
        
        // Search filter (search in product name, cultivar name, brand name, batch name)
        if (searchTerm) {
            const searchableText = [
                item.dataset.productName,
                item.dataset.cultivarName,
                item.dataset.brandName,
                item.dataset.batchName
            ].join(' ').toLowerCase();
            
            if (!searchableText.includes(searchTerm)) {
                shouldShow = false;
            }
        }
        
        // Category filter
        if (selectedCategories.length > 0) {
            const category = item.dataset.categoryName || '';
            if (!selectedCategories.some(cat => category.includes(cat))) {
                shouldShow = false;
            }
        }
        
        // Strain filter (use cultivar_type_name from database)
        if (selectedStrains.length > 0 && shouldShow) {
            const strain = item.dataset.cultivarTypeName || '';
            if (!selectedStrains.some(s => strain.includes(s))) {
                shouldShow = false;
            }
        }
        
        // Brand filter
        if (selectedBrands.length > 0 && shouldShow) {
            const brand = item.dataset.brandName || '';
            if (!selectedBrands.includes(brand)) {
                shouldShow = false;
            }
        }
        
        // Potency filter
        if (shouldShow) {
            const thc = parseFloat(item.dataset.thcPercentage || 0);
            if (thc < minPotency || thc > maxPotency) {
                shouldShow = false;
            }
        }
        
        item.style.display = shouldShow ? '' : 'none';
    });
    
    // Update pagination
    const visibleProducts = filteredProducts.filter(item => item.style.display !== 'none');
    totalPages = Math.ceil(visibleProducts.length / itemsPerPage);
    currentPage = 1;
    renderPagination();
    showPage(1);
    
    // Update product count
    updateProductCount(visibleProducts.length);
}

function updateProductCount(count) {
    const countElement = document.getElementById('product-count');
    if (countElement) {
        countElement.textContent = count;
    }
}

function showPage(page) {
    const visibleProducts = filteredProducts.filter(item => item.style.display !== 'none');
    const start = (page - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    
    visibleProducts.forEach((item, index) => {
        if (index >= start && index < end) {
            item.style.display = '';
        } else {
            item.style.display = 'none';
        }
    });
    
    currentPage = page;
    updatePaginationButtons();
}

function goToPage(page) {
    const visibleProducts = filteredProducts.filter(item => item.style.display !== 'none');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    if (page >= 1 && page <= maxPage) {
        showPage(page);
    }
}

function changeItemsPerPage() {
    itemsPerPage = parseInt(document.getElementById('items-per-page').value);
    totalPages = Math.ceil(filteredProducts.filter(item => item.style.display !== 'none').length / itemsPerPage);
    renderPagination();
    showPage(1);
}

function renderPagination() {
    const visibleProducts = filteredProducts.filter(item => item.style.display !== 'none');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    const paginationNumbers = document.getElementById('pagination-numbers');
    if (!paginationNumbers) return;
    
    paginationNumbers.innerHTML = '';
    
    // Calculate page range to show
    const maxVisible = 4;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(maxPage, startPage + maxVisible - 1);
    
    if (endPage - startPage < maxVisible - 1) {
        startPage = Math.max(1, endPage - maxVisible + 1);
    }
    
    for (let i = startPage; i <= endPage; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = 'pagination-number' + (i === currentPage ? ' active' : '');
        pageBtn.textContent = i;
        pageBtn.onclick = () => goToPage(i);
        paginationNumbers.appendChild(pageBtn);
    }
}

function updatePaginationButtons() {
    const visibleProducts = filteredProducts.filter(item => item.style.display !== 'none');
    const maxPage = Math.ceil(visibleProducts.length / itemsPerPage);
    const buttons = document.querySelectorAll('.pagination-btn');
    buttons.forEach(btn => btn.style.display = '');
}


</script>

