<link rel="stylesheet" href="/public/css/checkout-inventory-warnings.css">
<div class="checkout-container">
    <div class="checkout-header">
        <h1>Checkout</h1>
        <button class="back-to-store-btn" onclick="window.location.href='/external/store/<%= uuid %>'">
            <i class="fas fa-arrow-left"></i> Back to Store
        </button>
    </div>
    
    <div class="checkout-content">
        <!-- Inventory Warning Bar (hidden by default) -->
        <div id="inventory-warning-bar" class="inventory-warning-bar" style="display: none;">
            <i class="fas fa-exclamation-triangle"></i>
            <span>Inventory Update Required</span>
            <p>Some items in your cart have limited availability. Please review the highlighted products below and adjust quantities as needed.</p>
        </div>
        
        <!-- Order Summary Table -->
        <div class="checkout-section order-summary-section">
            <h2>Order Summary</h2>
            <div class="order-summary-table-container">
                <table class="order-summary-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Line</th>
                        </tr>
                    </thead>
                    <tbody id="checkout-items">
                        <% if (cart && cart.items && cart.items.length > 0) { %>
                            <% cart.items.forEach((item, index) => { %>
                                <tr class="checkout-item-row" data-line-item-id="<%= item.line_item_id %>" data-batch-id="<%= item.batch_id %>">
                                    <td class="item-name-cell">
                                        <div class="product-name-with-logo">
                                            <div class="amaze-logo-small">A</div>
                                            <div class="product-name-details">
                                                <div class="product-main-name">
                                                    <%= item.brand_name || 'AMAZE' %> <%= item.product_name %>
                                                    <% if (item.unit_size) { %> - <%= item.unit_size %><% } %>
                                                </div>
                                                <div class="product-sub-info">
                                                    <% if (item.cultivar_name) { %>
                                                        (<%= item.cultivar_name %>)
                                                    <% } %>
                                                    <% if (item.category_name || item.product_type) { %>
                                                        (<%= item.category_name || '' %><% if (item.category_name && item.product_type) { %> - <% } %><%= item.product_type || '' %>)
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="item-price-cell">
                                        $<%= item.unit_price ? parseFloat(item.unit_price).toFixed(2) : '0.00' %>
                                    </td>
                                    <td class="item-quantity-cell">
                                        <div class="quantity-info">
                                            <div class="quantity-display">
                                                <span class="quantity-value"><%= item.quantity %></span> <%= item.quantity === 1 ? 'Case' : 'Cases' %>
                                            </div>
                                            <% 
                                                const totalUnits = (item.quantity || 0) * (item.units_per_case || 24);
                                                const quantityAvailable = item.quantity_available || 0;
                                                const quantityExceeded = item.quantity > quantityAvailable;
                                            %>
                                            <div class="units-info"><%= totalUnits %> Units total</div>
                                            <% if (item.unit_size) { %>
                                                <div class="package-size">Package Size: <%= item.unit_size %></div>
                                            <% } %>
                                            
                                            <!-- Inventory Warning (shown when quantity exceeds available) -->
                                            <% if (quantityExceeded && quantityAvailable > 0) { %>
                                                <div class="inventory-warning">
                                                    <div class="warning-banner">
                                                        <i class="fas fa-exclamation-triangle"></i>
                                                        <span>Limited Inventory Available</span>
                                                    </div>
                                                    <div class="warning-details">
                                                        Maximum available quantity: <strong><%= quantityAvailable %></strong> <%= quantityAvailable === 1 ? 'unit' : 'units' %>
                                                    </div>
                                                </div>
                                            <% } %>
                                            
                                            <!-- Edit Quantity Button -->
                                            <div class="quantity-edit-control">
                                                <button class="edit-quantity-btn" 
                                                        onclick="openQuantityModal('<%= String(item.line_item_id) %>', <%= item.quantity %>, '<%= String(item.batch_id) %>', <%= quantityAvailable %>)" 
                                                        title="Edit Quantity"
                                                        aria-label="Edit Quantity">
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="item-line-cell">
                                        <div class="line-total-actions">
                                            <span class="line-total">$<%= item.line_total ? parseFloat(item.line_total).toFixed(2) : '0.00' %></span>
                                            <button class="remove-item-btn" onclick="removeLineItem('<%= String(item.line_item_id) %>')" title="Remove Item">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="empty-cart-message">
                                    <div class="empty-cart-container">
                                        <div class="empty-cart-icon">
                                            <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <!-- Cart body -->
                                                <rect x="20" y="40" width="80" height="60" rx="4" stroke="#4ade80" stroke-width="3" fill="none"/>
                                                <!-- Cart handle -->
                                                <path d="M 35 40 Q 35 30, 45 30 Q 55 30, 55 40" stroke="#4ade80" stroke-width="3" fill="none" stroke-linecap="round"/>
                                                <!-- Sad eyes -->
                                                <circle cx="40" cy="60" r="6" fill="#64748b"/>
                                                <circle cx="80" cy="60" r="6" fill="#64748b"/>
                                                <path d="M 38 58 Q 40 55, 42 58" stroke="#64748b" stroke-width="2" fill="none" stroke-linecap="round"/>
                                                <path d="M 78 58 Q 80 55, 82 58" stroke="#64748b" stroke-width="2" fill="none" stroke-linecap="round"/>
                                                <!-- Wheels -->
                                                <circle cx="35" cy="95" r="8" stroke="#64748b" stroke-width="3" fill="none"/>
                                                <circle cx="85" cy="95" r="8" stroke="#64748b" stroke-width="3" fill="none"/>
                                            </svg>
                                        </div>
                                        <h3 class="empty-cart-title">This Cart Is Empty</h3>
                                        <a href="/external/store/<%= uuid %>" class="add-items-btn">Add Items</a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
                <% if (cart && cart.items && cart.items.length > 0) { %>
                    <div class="order-total-row">
                        <span>Total: $<%= cart.total ? parseFloat(cart.total).toFixed(2) : '0.00' %></span>
                    </div>
                <% } %>
            </div>
            
            <!-- Order Notes -->
            <div class="order-notes-section">
                <label for="order-notes">Order Notes / Requests for Seller</label>
                <textarea id="order-notes" name="order_notes" rows="5" placeholder="Enter any special requests or notes for the seller..."></textarea>
            </div>
        </div>
        
        <!-- Shipping and Payment Section -->
        <div class="checkout-bottom-section" id="checkout-bottom-section">
            <!-- Left: Shipping Information -->
            <div class="shipping-section">
                <h3 class="section-header purple-header">Select Location</h3>
                <select id="location-select" class="location-dropdown" onchange="handleLocationChange(this.value)">
                    <option value="">Select a location...</option>
                    <% if (locations && locations.length > 0) { %>
                        <% locations.forEach(loc => { %>
                            <option value="<%= loc.location_id %>" 
                                    data-line-one="<%= loc.line_one || '' %>"
                                    data-line-two="<%= loc.line_two || '' %>"
                                    data-city="<%= loc.city || '' %>"
                                    data-state="<%= loc.state || '' %>"
                                    data-zip="<%= loc.zip || '' %>"
                                    <%= (portalAccess && portalAccess.locationId == loc.location_id) ? 'selected' : '' %>>
                                <%= loc.name %><% if (loc.state_license) { %> | <%= loc.state_license %><% } %>
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option value="" disabled>No locations available</option>
                    <% } %>
                </select>
                
                <div class="shipping-form-grid">
                    <div class="form-group">
                        <label for="ship-to">Ship To</label>
                        <input type="text" id="ship-to" name="ship_to" value="Green Releaf">
                    </div>
                    <div class="form-group">
                        <label for="state-license">State License Number</label>
                        <input type="text" id="state-license" name="state_license">
                    </div>
                    <div class="form-group full-width">
                        <label for="address-line-one">Address Line One</label>
                        <input type="text" id="address-line-one" name="address_line_one" value="<%= shippingAddress.address || '' %>">
                    </div>
                    <div class="form-group full-width">
                        <label for="address-line-two">Address Line Two</label>
                        <input type="text" id="address-line-two" name="address_line_two" value="<%= shippingAddress.line_two || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="city">City</label>
                        <input type="text" id="city" name="city" value="<%= shippingAddress.city || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="state">State</label>
                        <input type="text" id="state" name="state" value="<%= shippingAddress.state || 'Missouri' %>">
                    </div>
                    <div class="form-group">
                        <label for="postal-code">Postal Code</label>
                        <input type="text" id="postal-code" name="postal_code" value="<%= shippingAddress.zip_code || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="country">Country</label>
                        <input type="text" id="country" name="country" value="US">
                    </div>
                </div>
            </div>
            
            <!-- Right: Payment and Actions -->
            <div class="payment-section">
                <div class="payment-illustration">
                    <div class="illustration-icon">🏪</div>
                </div>
                <div class="terms-text">Terms: Net 15</div>
                <button class="sign-in-btn">Sign In</button>
                <div class="final-total">
                    Final Total: <span class="final-total-amount">$<%= cart && cart.total ? parseFloat(cart.total).toFixed(2) : '0.00' %></span>
                </div>
                <button id="place-order-btn" class="place-order-guest-btn" onclick="placeOrder()" <%= (!cart || !cart.items || cart.items.length === 0) ? 'disabled' : '' %>>
                    <span class="button-text">Place Order As Guest</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Quantity Edit Modal -->
<div id="quantityModal" class="quantity-modal" style="display: none;">
    <div class="modal-overlay" onclick="closeQuantityModal()"></div>
    <div class="modal-content-small">
        <button class="modal-close" onclick="closeQuantityModal()">
            <i class="fas fa-times"></i>
        </button>
        <h3>Edit Quantity</h3>
        <div class="quantity-modal-body">
            <label for="modal-quantity-input">Quantity (Cases):</label>
            <input type="number" id="modal-quantity-input" min="1" value="1">
            <div class="modal-actions">
                <button class="btn-cancel" onclick="closeQuantityModal()">Cancel</button>
                <button class="btn-save" onclick="saveQuantity()">Update</button>
            </div>
        </div>
    </div>
</div>

<script>
const uuid = '<%= uuid %>';
let currentEditingLineItemId = null;
let currentEditingBatchId = null;
let currentEditingMaxAvailable = 999;

// Update cart badge count in header
function updateCartBadge() {
    // Use cart manager if available, otherwise use server data
    const cartMgr = getCartManager();
    let itemCount = 0;
    
    if (cartMgr) {
        itemCount = cartMgr.getItemCount();
    } else {
        // Fallback to server cart data
        itemCount = <%= (cart && cart.items) ? cart.items.length : 0 %>;
    }
    
    const badge = document.getElementById('cart-count-badge');
    if (badge) {
        badge.textContent = itemCount;
        badge.style.display = itemCount > 0 ? 'inline-block' : 'none';
    }
}

// Initialize cart badge on page load
document.addEventListener('DOMContentLoaded', function() {
    updateCartBadge();
});

function openQuantityModal(lineItemId, currentQuantity, batchId, maxAvailable) {
    currentEditingLineItemId = lineItemId;
    currentEditingBatchId = batchId;
    currentEditingMaxAvailable = maxAvailable || 999;
    
    const modalInput = document.getElementById('modal-quantity-input');
    modalInput.value = currentQuantity;
    modalInput.min = 1;
    modalInput.max = currentEditingMaxAvailable;
    
    // Show availability message
    const modalBody = document.querySelector('.quantity-modal-body');
    let availabilityMsg = modalBody.querySelector('.availability-message');
    if (!availabilityMsg) {
        availabilityMsg = document.createElement('div');
        availabilityMsg.className = 'availability-message';
        modalBody.insertBefore(availabilityMsg, modalBody.querySelector('.modal-actions'));
    }
    availabilityMsg.textContent = `Maximum available: ${currentEditingMaxAvailable} cases`;
    if (currentQuantity > currentEditingMaxAvailable) {
        availabilityMsg.style.color = '#ef4444';
        availabilityMsg.style.fontWeight = 'bold';
    } else {
        availabilityMsg.style.color = '#6b7280';
        availabilityMsg.style.fontWeight = 'normal';
    }
    
    document.getElementById('quantityModal').style.display = 'flex';
}

function closeQuantityModal() {
    document.getElementById('quantityModal').style.display = 'none';
    currentEditingLineItemId = null;
    currentEditingBatchId = null;
    currentEditingMaxAvailable = 999;
}

async function saveQuantity() {
    const newQuantity = parseInt(document.getElementById('modal-quantity-input').value);
    if (!newQuantity || newQuantity <= 0) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Please enter a valid quantity', 'warning');
        } else {
            alert('Please enter a valid quantity');
        }
        return;
    }
    
    // Check inventory limit
    if (newQuantity > currentEditingMaxAvailable) {
        if (typeof showNotification !== 'undefined') {
            showNotification(`Maximum available: ${currentEditingMaxAvailable} cases`, 'warning');
        } else {
            alert(`Maximum available: ${currentEditingMaxAvailable} cases`);
        }
        document.getElementById('modal-quantity-input').value = currentEditingMaxAvailable;
        return;
    }
    
    if (!currentEditingLineItemId || !currentEditingBatchId) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Error: Missing item information', 'error');
        } else {
            alert('Error: Missing item information');
        }
        return;
    }
    
    const cart = getCartManager();
    if (!cart) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Cart manager not initialized', 'error');
        } else {
            alert('Cart manager not initialized');
        }
        return;
    }
    
    // Get old quantity for potential revert
    const oldItem = cart.cart.items.find(i => String(i.batch_id) === String(currentEditingBatchId));
    if (!oldItem) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Item not found in cart', 'error');
        } else {
            alert('Item not found in cart');
        }
        return;
    }
    const oldQuantity = oldItem.quantity;
    
    // Update cart quantity in frontend first (instant update)
    cart.updateQuantity(currentEditingBatchId, newQuantity);
    const updatedItem = cart.cart.items.find(i => String(i.batch_id) === String(currentEditingBatchId));
    
    if (updatedItem) {
        // Update DOM immediately
        const row = document.querySelector(`tr[data-line-item-id="${currentEditingLineItemId}"]`);
        if (row) {
            // Update quantity display
            const quantityDisplay = row.querySelector('.quantity-value');
            if (quantityDisplay) {
                quantityDisplay.textContent = newQuantity;
            }
            
            // Update units total
            const unitsInfo = row.querySelector('.units-info');
            if (unitsInfo && updatedItem.units_per_case) {
                const totalUnits = newQuantity * updatedItem.units_per_case;
                unitsInfo.textContent = `${totalUnits} Units total`;
            }
            
            // Update line total
            const lineTotal = row.querySelector('.line-total');
            if (lineTotal) {
                lineTotal.textContent = `$${updatedItem.line_total.toFixed(2)}`;
            }
        }
        
        // Update checkout total
        updateCheckoutTotal();
        
        // Update cart icon
        cart.updateCartIcon();
    }
    
    // Sync to backend
    try {
        const response = await fetch(`/api/portal/${uuid}/cart/update`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                line_item_id: currentEditingLineItemId,
                quantity: newQuantity
            })
        });
        
        const data = await response.json();
        if (data.success) {
            // Reload cart from backend to get updated line_item_ids and totals
            await cart.loadFromBackend();
            
            // Update DOM with fresh data
            location.reload();
            
            closeQuantityModal();
            // Check inventory and toggle checkout section visibility
            checkInventoryAndToggleCheckout();
            if (typeof showNotification !== 'undefined') {
                showNotification('Quantity updated successfully', 'success');
            }
        } else {
            // Revert frontend change if backend fails
            cart.updateQuantity(currentEditingBatchId, oldQuantity);
            updateCheckoutTotal();
            if (typeof showNotification !== 'undefined') {
                showNotification('Error updating quantity: ' + (data.error || 'Unknown error'), 'error');
            } else {
                alert('Error updating quantity: ' + (data.error || 'Unknown error'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        // Revert frontend change if sync fails
        cart.updateQuantity(currentEditingBatchId, oldQuantity);
        updateCheckoutTotal();
        
        // Reload page to ensure consistency
        location.reload();
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to sync quantity. Please try again.', 'error');
        } else {
            alert('Failed to sync quantity. Please try again.');
        }
    }
}

async function removeLineItem(lineItemId, reload = false) {
    if (!confirm('Are you sure you want to remove this item?')) {
        return;
    }
    
    const cart = getCartManager();
    if (!cart) {
        if (typeof showNotification !== 'undefined') {
            showNotification('Cart manager not initialized', 'error');
        } else {
            alert('Cart manager not initialized');
        }
        return;
    }
    
    // First, reload cart from backend to ensure we have latest data with real line_item_ids
    await cart.loadFromBackend();
    
    // Find item by line_item_id (should match what's in the DOM)
    let item = cart.cart.items.find(i => String(i.line_item_id) === String(lineItemId));
    
    // If still not found, try finding by row's batch_id attribute
    if (!item) {
        const row = document.querySelector(`tr[data-line-item-id="${lineItemId}"]`);
        if (row) {
            const batchId = row.getAttribute('data-batch-id');
            if (batchId) {
                item = cart.cart.items.find(i => String(i.batch_id) === String(batchId));
            }
        }
    }
    
    if (!item) {
        console.error('Item not found in cart:', { 
            lineItemId, 
            cartItems: cart.cart.items.map(i => ({ 
                line_item_id: i.line_item_id, 
                batch_id: i.batch_id 
            })) 
        });
        
        // Reload page to get fresh data
        if (typeof showNotification !== 'undefined') {
            showNotification('Item not found. Refreshing page...', 'warning');
        }
        setTimeout(() => location.reload(), 1000);
        return;
    }
    
    // Remove from frontend cart first
    cart.removeItem(item.batch_id);
    
    // Check if cart is now empty
    if (cart.cart.items.length === 0) {
        // Show empty cart UI
        showEmptyCart();
        // Hide checkout bottom section
        hideCheckoutBottomSection();
        // Sync to backend
        try {
            await fetch(`/api/portal/${uuid}/cart/remove`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    line_item_id: lineItemId
                })
            });
        } catch (error) {
            console.error('Error syncing removal:', error);
        }
        return;
    }
    
    // Cart still has items - remove from backend and update UI
    try {
        const response = await fetch(`/api/portal/${uuid}/cart/remove`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                line_item_id: lineItemId
            })
        });
        
        const data = await response.json();
        if (data.success) {
            // Update cart icon
            cart.updateCartIcon();
            
            // Remove row from table
            const row = document.querySelector(`tr[data-line-item-id="${lineItemId}"]`);
            if (row) {
                row.remove();
            }
            
            // Update totals
            updateCheckoutTotal();
            
            // Reload cart from backend to ensure line_item_ids are correct
            await cart.loadFromBackend();
            
            // Check inventory issues and show/hide checkout section
            checkInventoryAndToggleCheckout();
            
            if (typeof showNotification !== 'undefined') {
                showNotification('Item removed from cart', 'success');
            } else {
                alert('Item removed from cart');
            }
            
            // Reload page to show updated cart with correct line_item_ids
            setTimeout(() => location.reload(), 500);
        } else {
            // Revert frontend change - restore item
            // Item already has all necessary fields from cart, so we can add it back directly
            cart.cart.items.push(item);
            cart.recalculateTotals();
            cart.saveCart();
            cart.updateCartIcon();
            location.reload(); // Reload to show correct state
            if (typeof showNotification !== 'undefined') {
                showNotification('Error removing item: ' + (data.error || 'Unknown error'), 'error');
            } else {
                alert('Error removing item: ' + (data.error || 'Unknown error'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        // Revert frontend change - restore item
        cart.cart.items.push(item);
        cart.recalculateTotals();
        cart.saveCart();
        cart.updateCartIcon();
        location.reload(); // Reload to show correct state
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to remove item. Please try again.', 'error');
        } else {
            alert('Failed to remove item. Please try again.');
        }
    }
}

// Show empty cart state
function showEmptyCart() {
    const tableBody = document.querySelector('#checkout-items');
    if (tableBody) {
        tableBody.innerHTML = `
            <tr>
                <td colspan="4" class="empty-cart-message">
                    <div class="empty-cart-container">
                        <div class="empty-cart-icon">
                            <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Cart body -->
                                <rect x="20" y="40" width="80" height="60" rx="4" stroke="#4ade80" stroke-width="3" fill="none"/>
                                <!-- Cart handle -->
                                <path d="M 35 40 Q 35 30, 45 30 Q 55 30, 55 40" stroke="#4ade80" stroke-width="3" fill="none" stroke-linecap="round"/>
                                <!-- Sad eyes -->
                                <circle cx="40" cy="60" r="6" fill="#64748b"/>
                                <circle cx="80" cy="60" r="6" fill="#64748b"/>
                                <path d="M 38 58 Q 40 55, 42 58" stroke="#64748b" stroke-width="2" fill="none" stroke-linecap="round"/>
                                <path d="M 78 58 Q 80 55, 82 58" stroke="#64748b" stroke-width="2" fill="none" stroke-linecap="round"/>
                                <!-- Wheels -->
                                <circle cx="35" cy="95" r="8" stroke="#64748b" stroke-width="3" fill="none"/>
                                <circle cx="85" cy="95" r="8" stroke="#64748b" stroke-width="3" fill="none"/>
                            </svg>
                        </div>
                        <h3 class="empty-cart-title">This Cart Is Empty</h3>
                        <a href="/external/store/${uuid}" class="add-items-btn">Add Items</a>
                    </div>
                </td>
            </tr>
        `;
    }
    
    // Hide order total row
    const totalRow = document.querySelector('.order-total-row');
    if (totalRow) {
        totalRow.style.display = 'none';
    }
    
    // Update cart icon
    const cart = getCartManager();
    if (cart) {
        cart.updateCartIcon();
    }
}

// Hide checkout bottom section (shipping, payment, place order)
function hideCheckoutBottomSection() {
    const bottomSection = document.getElementById('checkout-bottom-section');
    if (bottomSection) {
        bottomSection.style.display = 'none';
    }
    
    // Also hide order notes
    const orderNotesSection = document.querySelector('.order-notes-section');
    if (orderNotesSection) {
        orderNotesSection.style.display = 'none';
    }
}

// Show checkout bottom section
function showCheckoutBottomSection() {
    const bottomSection = document.getElementById('checkout-bottom-section');
    if (bottomSection) {
        bottomSection.style.display = '';
    }
    
    const orderNotesSection = document.querySelector('.order-notes-section');
    if (orderNotesSection) {
        orderNotesSection.style.display = '';
    }
}

// Check inventory issues and hide/show checkout section
function checkInventoryAndToggleCheckout() {
    const cart = getCartManager();
    if (!cart) return;
    
    // Check if cart is empty
    if (cart.cart.items.length === 0) {
        hideCheckoutBottomSection();
        return;
    }
    
    // Check for inventory issues
    const issues = cart.validateCartAgainstInventory();
    if (issues.length > 0) {
        // Hide checkout section if inventory is exceeded
        hideCheckoutBottomSection();
    } else {
        // Show checkout section if no issues
        showCheckoutBottomSection();
    }
}

function handleLocationChange(locationId) {
