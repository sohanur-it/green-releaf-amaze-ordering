// Initialize checkout page
document.addEventListener('DOMContentLoaded', async function() {
    const uuid = '<%= uuid %>';
    
    // Initialize cart manager
    initCartManager(uuid);
    const cart = getCartManager();
    
    // The cart data is already rendered from server-side (EJS template)
    // But we also need to sync it to localStorage for frontend management
    // and ensure we have real line_item_ids
    
    // Always load/refresh cart from backend to ensure we have latest data with real IDs
    const loaded = await cart.loadFromBackend();
    
    if (!loaded || cart.cart.items.length === 0) {
        // Check if server-side cart has items (from EJS template)
        const serverCartCount = <%= (cart && cart.items) ? cart.items.length : 0 %>;
        if (serverCartCount === 0) {
            // Cart is empty, redirect to store
            window.location.href = `/external/store/${uuid}`;
            return;
        } else {
            // Server has cart but backend API doesn't - sync it
            await cart.syncToBackend();
            await cart.loadFromBackend();
        }
    }
    
    // Fetch latest inventory data and update quantity_available
    if (cart) {
        await cart.fetchInventoryData();
        
        // Validate cart and show warnings
        const issues = cart.validateCartAgainstInventory();
        if (issues.length > 0) {
            // Show warning bar
            const warningBar = document.getElementById('inventory-warning-bar');
            if (warningBar) {
                warningBar.style.display = 'block';
            }
            
            // Hide checkout section when inventory is exceeded
            hideCheckoutBottomSection();
            
            // Highlight rows and disable controls
            issues.forEach(issue => {
                const row = document.querySelector(`tr[data-line-item-id="${issue.line_item_id}"]`);
                if (row) {
                    row.classList.add('inventory-exceeded');
                }
            });
        } else {
            // Show checkout section if no inventory issues
            showCheckoutBottomSection();
        }
        
        cart.updateCartIcon();
    }
    
    // Initialize checkout validator
    if (typeof initCheckoutValidator !== 'undefined') {
        initCheckoutValidator(uuid);
    }
});

// Update quantity on checkout page (frontend only, then sync to backend)
async function updateCheckoutQuantity(batchId, delta) {
    const cart = getCartManager();
    if (!cart) return;
    
    const item = cart.cart.items.find(i => String(i.batch_id) === String(batchId));
    if (!item) {
        console.error('Item not found:', batchId);
        return;
    }
    
    const newQuantity = item.quantity + delta;
    const maxAvailable = item.quantity_available || 999;
    
    if (newQuantity <= 0) {
        if (confirm('Remove this item from cart?')) {
            cart.removeItem(batchId);
            location.reload(); // Reload to update page
        }
        return;
    }
    
    if (newQuantity > maxAvailable) {
        if (typeof showNotification !== 'undefined') {
            showNotification(`Maximum available: ${maxAvailable} cases`, 'warning');
        }
        return;
    }
    
    // Update cart quantity (this also updates line_total)
    cart.updateQuantity(batchId, newQuantity);
    
    // Get updated item from cart
    const updatedItem = cart.cart.items.find(i => String(i.batch_id) === String(batchId));
    if (!updatedItem) return;
    
    // Find the row by batch_id
    const row = document.querySelector(`input[data-batch-id="${batchId}"]`)?.closest('tr');
    if (row) {
        // Update quantity display
        const quantityDisplay = row.querySelector('.quantity-value');
        if (quantityDisplay) {
            quantityDisplay.textContent = newQuantity;
        }
        
        // Update units total
        const unitsInfo = row.querySelector('.units-info');
        if (unitsInfo && updatedItem.units_per_case) {
            const totalUnits = newQuantity * updatedItem.units_per_case;
            unitsInfo.textContent = `${totalUnits} Units total`;
        }
        
        // Update line total
        const lineTotal = row.querySelector('.line-total');
        if (lineTotal) {
            lineTotal.textContent = `$${updatedItem.line_total.toFixed(2)}`;
        }
        
        // Update input field
        const input = row.querySelector('.quantity-input-checkout');
        if (input) {
            input.value = newQuantity;
            input.classList.toggle('quantity-exceeded', newQuantity > maxAvailable);
        }
        
        // Update +/- buttons
        const minusBtn = row.querySelector('.quantity-btn-minus');
        const plusBtn = row.querySelector('.quantity-btn-plus');
        if (minusBtn) {
            minusBtn.disabled = (newQuantity <= 1);
        }
        if (plusBtn) {
            plusBtn.disabled = (newQuantity >= maxAvailable);
        }
        
        // Update order total
        updateCheckoutTotal();
    }
    
    // Sync to backend (async, don't wait)
    cart.syncToBackend().catch(err => {
        console.error('Failed to sync cart:', err);
    });
}

function updateCheckoutQuantityInput(batchId, value) {
