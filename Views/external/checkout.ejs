// Check inventory issues and hide/show checkout section
function checkInventoryAndToggleCheckout() {
    const cart = getCartManager();
    if (!cart) return;
    
    // Check if cart is empty
    if (cart.cart.items.length === 0) {
        hideCheckoutBottomSection();
        return;
    }
    
    // Check for inventory issues
    const issues = cart.validateCartAgainstInventory();
    if (issues.length > 0) {
        // Hide checkout section if inventory is exceeded
        hideCheckoutBottomSection();
    } else {
        // Show checkout section if no issues
        showCheckoutBottomSection();
    }
        
    // Always update summary with discounts/credits after cart load and validation
    try {
        console.log('[checkout] calling updateCheckoutTotal with items:', cart.getCart().items);
        updateCheckoutTotal();
    } catch (e) {
        console.warn('Failed to update checkout totals on init:', e);
    }
    
    // Safety net: trigger totals again after a short delay
    setTimeout(() => {
        try {
            console.log('[checkout] fallback updateCheckoutTotal() timer fired');
            updateCheckoutTotal();
        } catch (e) {
            console.warn('Fallback totals update failed:', e);
        }
    }, 500);
    
    // Recompute totals whenever the cart changes (quantity updates, item add/remove)
    window.addEventListener('cartChanged', () => {
        try {
            console.log('[checkout] cartChanged -> updateCheckoutTotal()');
            updateCheckoutTotal();
        } catch (e) {
            console.warn('cartChanged totals update failed:', e);
        }
    });
}

async function handleLocationChange(locationId) {
    const select = document.getElementById('location-select');
    const selectedOption = select.options[select.selectedIndex];
    
    if (selectedOption && selectedOption.value) {
        // Update address fields when location is selected
        document.getElementById('address-line-one').value = selectedOption.getAttribute('data-line-one') || '';
        document.getElementById('address-line-two').value = selectedOption.getAttribute('data-line-two') || '';
        document.getElementById('city').value = selectedOption.getAttribute('data-city') || '';
        document.getElementById('state').value = selectedOption.getAttribute('data-state') || 'Missouri';
        document.getElementById('postal-code').value = selectedOption.getAttribute('data-zip') || '';
        
        // Update invoice location in the database
        try {
            const uuid = '<%= uuid %>';
            const response = await fetch(`/api/portal/${uuid}/update-location`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ location_id: locationId })
            });
            
            const data = await response.json();
            if (data.success) {
                console.log('Invoice location updated successfully');
            } else {
                console.error('Failed to update invoice location:', data.error);
            }
        } catch (error) {
            console.error('Error updating invoice location:', error);
        }
    }
}

// Initialize checkout page
document.addEventListener('DOMContentLoaded', async function() {
    const uuid = '<%= uuid %>';
    
    // Initialize cart manager
    initCartManager(uuid);
    const cart = getCartManager();
    
    // The cart data is already rendered from server-side (EJS template)
    // But we also need to sync it to localStorage for frontend management
    // and ensure we have real line_item_ids
    
    // Always load/refresh cart from backend to ensure we have latest data with real IDs
    const loaded = await cart.loadFromBackend();
    
    if (!loaded || cart.cart.items.length === 0) {
        // Check if server-side cart has items (from EJS template)
        const serverCartCount = <%= (cart && cart.items) ? cart.items.length : 0 %>;
        if (serverCartCount === 0) {
            // Cart is empty, redirect to store
            window.location.href = `/external/store/${uuid}`;
            return;
        } else {
            // Server has cart but backend API doesn't - sync it
            await cart.syncToBackend();
            await cart.loadFromBackend();
        }
    }
    
    // Fetch latest inventory data and update quantity_available
    if (cart) {
        await cart.fetchInventoryData();
        
        // Validate cart and show warnings
        const issues = cart.validateCartAgainstInventory();
        if (issues.length > 0) {
            // Show warning bar
            const warningBar = document.getElementById('inventory-warning-bar');
            if (warningBar) {
                warningBar.style.display = 'block';
            }
            
            // Hide checkout section when inventory is exceeded
            hideCheckoutBottomSection();
            
            // Highlight rows and disable controls
            issues.forEach(issue => {
                const row = document.querySelector(`tr[data-line-item-id="${issue.line_item_id}"]`);
                if (row) {
                    row.classList.add('inventory-exceeded');
                }
            });
        } else {
            // Show checkout section if no inventory issues
            showCheckoutBottomSection();
        }
        
        cart.updateCartIcon();
        
        // Render cart in sidebar if it exists
        if (typeof renderCart === 'function') {
            renderCart();
        }
        
        // Update checkout totals with discounts and credits after cart is fully loaded
        console.log('[checkout] DOMContentLoaded: cart loaded, calling updateCheckoutTotal()');
        updateCheckoutTotal();
    }
    
    // Initialize checkout validator
    if (typeof initCheckoutValidator !== 'undefined') {
        initCheckoutValidator(uuid);
    }
});

// Render cart function for checkout page (similar to store.ejs)
function renderCart() {
    const cart = getCartManager();
    if (!cart) {
        console.warn('renderCart: Cart manager not initialized');
        return;
    }
    
    const cartData = cart.getCart();
    const cartItemsDiv = document.getElementById('cart-items');
    const cartCountSpan = document.getElementById('cart-count');
    const cartSubtotalSpan = document.getElementById('cart-subtotal');
    const cartTotalSpan = document.getElementById('cart-total');
    
    // Validate required DOM elements exist
    if (!cartItemsDiv || !cartCountSpan || !cartSubtotalSpan || !cartTotalSpan) {
        // Cart sidebar might not be visible yet, that's okay
        return;
    }
    
    if (cartData.items && cartData.items.length > 0) {
        cartItemsDiv.innerHTML = cartData.items.map(item => {
            const imageUrl = (item.image_url && item.image_url !== '') 
                ? item.image_url 
                : '/public/images/placeholder.jpg';
            return `
            <div class="cart-item" data-line-item-id="${item.line_item_id}">
                <div class="cart-item-header">
                    <img src="${imageUrl}" 
                         alt="${item.product_name}" 
                         class="cart-item-image"
                         onerror="this.src='/public/images/placeholder.jpg'; this.onerror=null;">
                    <div class="cart-item-info">
                        <div class="cart-item-name">${item.product_name || 'Product'}</div>
                        <div class="cart-item-details">
                            ${item.batch_name ? `Batch: ${item.batch_name}` : ''}
                        </div>
                    </div>
                </div>
                <div class="cart-item-body">
                    <div class="cart-item-quantity">
                        <span>Qty: ${item.quantity}</span>
                    </div>
                    <div class="cart-item-price">
                        $${(item.unit_price || 0).toFixed(2)} each
                    </div>
                    <div class="cart-item-total">
                        $${(item.line_total || 0).toFixed(2)}
                    </div>
                </div>
                <div class="cart-item-actions">
                    <button class="remove-item-btn" onclick="removeCartItemFromSidebar('${item.line_item_id}')" title="Remove Item">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        `;
        }).join('');
        
        const itemCount = cart.getItemCount();
        if (cartCountSpan) {
            cartCountSpan.textContent = itemCount;
        }
        const headerBadge = document.getElementById('cart-count-badge');
        if (headerBadge) {
            headerBadge.textContent = itemCount;
            headerBadge.style.display = itemCount > 0 ? 'inline-block' : 'none';
        }
        if (cart && typeof cart.updateCartIcon === 'function') {
            cart.updateCartIcon();
        }
    } else {
        cartItemsDiv.innerHTML = `
            <div class="empty-cart">
                <div class="empty-cart-icon">🛒</div>
                <p>Your cart is empty</p>
            </div>
        `;
        if (cartCountSpan) {
            cartCountSpan.textContent = '0';
        }
        const headerBadge = document.getElementById('cart-count-badge');
        if (headerBadge) {
            headerBadge.textContent = '0';
            headerBadge.style.display = 'none';
        }
        if (cart && typeof cart.updateCartIcon === 'function') {
            cart.updateCartIcon();
        }
    }
    
    if (cartSubtotalSpan) {
        cartSubtotalSpan.textContent = `$${cartData.subtotal.toFixed(2)}`;
    }
    if (cartTotalSpan) {
        cartTotalSpan.textContent = `$${cartData.total.toFixed(2)}`;
    }
}

// Remove item from cart sidebar
async function removeCartItemFromSidebar(lineItemId) {
    const uuid = '<%= uuid %>';
    try {
        const response = await fetch(`/api/portal/${uuid}/cart/remove`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ line_item_id: lineItemId })
        });
        
        const data = await response.json();
        if (data.success) {
            const cart = getCartManager();
            if (cart) {
                await cart.loadFromBackend(true, 0);
                renderCart();
                // Reload page to update checkout table
                window.location.reload();
            }
        } else {
            if (typeof showNotification !== 'undefined') {
                showNotification(data.error || 'Failed to remove item', 'error');
            }
        }
    } catch (error) {
        console.error('Error removing item:', error);
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to remove item. Please try again.', 'error');
        }
    }
}

