// Update checkout total from cart
function updateCheckoutTotal() {
    console.log('[checkout] ========================================');
    console.log('[checkout] 🔥 updateCheckoutTotal() FUNCTION CALLED');
    console.log('[checkout] ========================================');
    const cart = getCartManager();
    if (!cart) {
        console.warn('[checkout] updateCheckoutTotal() - cart manager not found');
        return;
    }
    
    const cartData = cart.getCart();
    console.log('[checkout] updateCheckoutTotal() - cart data:', {
        itemCount: cartData?.items?.length || 0,
        subtotal: cartData?.subtotal,
        total: cartData?.total,
        items: cartData?.items?.map(i => ({
            line_item_id: i.line_item_id,
            product_id: i.product_id,
            quantity: i.quantity
        }))
    });
    
    // Wrap everything in async to ensure credits are fetched before DOM updates
    (async () => {
        console.log('[checkout] ========== updateCheckoutTotal ASYNC FUNCTION START ==========');
        console.log('[checkout] Cart data:', {
            itemCount: cartData?.items?.length || 0,
            hasItems: Array.isArray(cartData?.items) && cartData.items.length > 0
        });
        
        // Calculate subtotal from actual line items (sum of line_total which already includes discounts)
        const lineItemsSubtotal = (cartData.items || []).reduce((sum, item) => {
            return sum + Number(item.line_total || 0);
        }, 0);
        
        let subtotalVal = Number(cartData.subtotal || lineItemsSubtotal);
        let discountsVal = 0;
        let creditsVal = 0;
        // Total should be sum of all line_total values (already discounted) minus credits
        let totalVal = lineItemsSubtotal;
        let pricingResult = null;
        
        console.log('[checkout] Initial values:', { subtotalVal, discountsVal, creditsVal, totalVal });
        
        try {
            console.error('🔥🔥🔥 TRY BLOCK STARTED - About to compute discounts and credits 🔥🔥🔥');
            // Compute discounts
            if (Array.isArray(cartData.items) && cartData.items.length > 0) {
                const pricingPayload = {
                    cartItems: cartData.items.map(i => ({
                        product_id: i.product_id,
                        category_name: i.category_name || null,
                        unit_price: i.unit_price,
                        quantity: i.quantity
                    }))
                };
                console.log('[checkout] preparing pricing payload for', cartData.items.length, 'items');
                console.log('[checkout] pricing payload:', JSON.stringify(pricingPayload, null, 2));
                console.log('[checkout] cart items for matching:', cartData.items.map(i => ({
                    line_item_id: i.line_item_id,
                    product_id: i.product_id,
                    category_name: i.category_name,
                    unit_price: i.unit_price,
                    quantity: i.quantity
                })));
                const pricingRes = await fetch(`/api/portal/<%= uuid %>/cart/pricing`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(pricingPayload)
                });
                console.log('[checkout] pricing response status:', pricingRes.status);
                if (pricingRes.ok) {
                    const pricing = await pricingRes.json();
                    console.log('[checkout] pricing API full response:', JSON.stringify(pricing, null, 2));
                    pricingResult = pricing?.result || null;
                    console.log('[checkout] pricingResult extracted:', pricingResult);
                    
                    // Use pricing API values - these are the correct discounted totals
                    subtotalVal = Number(pricing.subtotal || subtotalVal);
                    discountsVal = Number(pricing.discounts || 0);
                    // Use the pricing API total which is: subtotal - discounts
                    // Credits will be subtracted later
                    const pricingTotal = Number(pricing.total != null ? pricing.total : (subtotalVal - discountsVal));
                    totalVal = pricingTotal;
                    console.log('[checkout] pricing API values:', {
                        pricingSubtotal: pricing.subtotal,
                        pricingDiscounts: pricing.discounts,
                        pricingTotal: pricing.total,
                        calculatedTotal: pricingTotal
                    });
                    
                    console.log('[checkout] pricing parsed:', { 
                        subtotalVal, 
                        discountsVal, 
                        totalVal, 
                        lineItemsSubtotal,
                        lineItemsCount: cartData.items?.length || 0,
                        hasItemNotes: !!(pricingResult && pricingResult.itemNotes), 
                        hasItems: !!(pricingResult && pricingResult.items) 
                    });
                } else {
                    const txt = await pricingRes.text().catch(() => '');
                    console.warn('[checkout] pricing request failed:', pricingRes.status, txt);
                }
            } else {
                console.log('[checkout] No cart items, skipping pricing API');
            }
            
            console.error('🔥🔥🔥 ABOUT TO START CREDITS FETCH - LINE 1250 🔥🔥🔥');
            console.error('🔥 Current creditsVal before fetch:', creditsVal);
            
            // Get available credits for current location
            // This should ALWAYS run, regardless of pricing API result or cart items
            console.error('🔥🔥🔥 CREDITS FETCH STARTING NOW 🔥🔥🔥');
            console.log('[checkout] ========== CREDITS FETCH START ==========');
            console.log('[checkout] ✅ REACHED CREDITS FETCH CODE - About to fetch credits');
            console.log('[checkout] UUID for credits API:', '<%= uuid %>');
            console.log('[checkout] Credits API URL will be:', `/api/portal/<%= uuid %>/credits/available`);
            
            // Force credits fetch to execute - wrap in try-catch to ensure it runs
            console.error('🔥 ABOUT TO CALL FETCH FOR CREDITS API 🔥');
            console.log('[checkout] 🔄 EXECUTING FETCH NOW...');
            console.log('[checkout] Current values before credits fetch:', {
                subtotalVal,
                discountsVal,
                creditsVal,
                totalVal
            });
            
            try {
                console.error('🔥 CALLING FETCH() FOR CREDITS NOW 🔥');
                console.log('[checkout] About to call fetch() for credits API...');
                const url = `/api/portal/<%= uuid %>/credits/available`;
                console.error('🔥 Credits API URL:', url);
                const creditsRes = await fetch(url);
                console.error('🔥 FETCH COMPLETED! Status:', creditsRes.status);
                console.log('[checkout] ✅ Fetch call completed, got response');
                console.log('[checkout] Credits API response status:', creditsRes.status);
                console.log('[checkout] Credits API response ok:', creditsRes.ok);
                console.log('[checkout] Credits API response headers:', Object.fromEntries(creditsRes.headers.entries()));
                
                if (creditsRes.ok) {
                    const creditsData = await creditsRes.json();
                    console.log('[checkout] Credits API full response:', JSON.stringify(creditsData, null, 2));
                    console.log('[checkout] Credits data structure:', {
                        hasCredits: !!creditsData.credits,
                        creditsType: typeof creditsData.credits,
                        creditsKeys: creditsData.credits ? Object.keys(creditsData.credits) : 'N/A',
                        available_total: creditsData?.credits?.available_total,
                        available: creditsData?.credits?.available
                    });
                    
                    const availableCredits = Number(creditsData?.credits?.available_total || creditsData?.credits?.available || 0);
                    console.log('[checkout] Parsed availableCredits:', availableCredits);
                    
                    // Credits apply up to remaining after discounts
                    const remainingAfterDiscounts = Math.max(0, subtotalVal - discountsVal);
                    console.log('[checkout] Remaining after discounts:', remainingAfterDiscounts);
                    
                    creditsVal = Math.min(availableCredits, remainingAfterDiscounts);
                    console.log('[checkout] Final creditsVal calculated:', creditsVal);
                    console.log('[checkout] Credits calculation:', {
                        availableCredits,
                        remainingAfterDiscounts,
                        creditsVal,
                        formula: `Math.min(${availableCredits}, ${remainingAfterDiscounts})`
                    });
                } else {
                    const txt = await creditsRes.text().catch(() => '');
                    console.error('[checkout] Credits request FAILED:', {
                        status: creditsRes.status,
                        statusText: creditsRes.statusText,
                        responseText: txt
                    });
                }
            } catch (creditsError) {
                console.error('[checkout] ❌ Credits fetch ERROR:', creditsError);
                console.error('[checkout] Credits fetch error message:', creditsError.message);
                console.error('[checkout] Credits fetch error stack:', creditsError.stack);
            } finally {
                console.log('[checkout] Credits fetch try-catch block completed');
            }
            
            console.log('[checkout] ========== CREDITS FETCH END ==========');
            console.log('[checkout] Final creditsVal after fetch:', creditsVal);
            console.log('[checkout] Credits fetch completed successfully, creditsVal =', creditsVal);
            
            // Compute final total using consistent formula: subtotal - discounts - credits
            // This ensures all pages (cart, checkout, confirmation, orders) use the same calculation
            if (pricingResult) {
                // Pricing API was called successfully
                // Pricing API total is: subtotal - discounts
                // Final total should be: subtotal - discounts - credits
                totalVal = Math.max(0, subtotalVal - discountsVal - creditsVal);
            } else {
                // Fallback: if pricing API failed, use sum of line items
                // Line items already have discounts applied in their line_total
                const finalLineItemsTotal = (cartData.items || []).reduce((sum, item) => {
                    return sum + Number(item.line_total || 0);
                }, 0);
                // For fallback, we need to estimate discounts and credits
                // But since line_total already has discounts, we can use it directly
                // Credits still need to be subtracted
                totalVal = Math.max(0, finalLineItemsTotal - creditsVal);
                // Update subtotal and discounts for display consistency
                if (subtotalVal === lineItemsSubtotal) {
                    // If we're using line items, we don't have separate discount info
                    // So discountsVal stays 0, and subtotalVal is the sum of line items
                }
            }
            console.log('[checkout] final total calculation:', {
                totalVal,
                creditsVal,
                subtotalVal,
                discountsVal,
                hasPricingResult: !!pricingResult,
                lineItemsCount: cartData.items?.length || 0
            });
        } catch (e) {
            console.error('[checkout] ❌❌❌ ERROR in try block:', e);
            console.error('[checkout] Error message:', e.message);
            console.error('[checkout] Error stack:', e.stack);
            console.warn('Checkout pricing/credits fetch failed, falling back to client totals:', e);
        }
        
        console.error('🔥🔥🔥 TRY-CATCH BLOCK COMPLETED - creditsVal =', creditsVal, '🔥🔥🔥');
        console.log('[checkout] ========== ASYNC FUNCTION COMPLETED ==========');
        console.log('[checkout] Final values before DOM update:', { subtotalVal, discountsVal, creditsVal, totalVal });
        
        // Update DOM - This must happen AFTER async operations complete
        console.log('[checkout] ========== DOM UPDATE START ==========');
        console.log('[checkout] Values to display:', {
            subtotalVal,
            discountsVal,
            creditsVal,
            totalVal
        });
        
        const subtotalSpan = document.getElementById('cart-subtotal');
        const discountsSpan = document.getElementById('cart-discounts');
        const creditsSpan = document.getElementById('cart-credits');
        const totalSpan = document.getElementById('cart-total');
        
        console.log('[checkout] DOM elements found:', {
            hasSubtotalEl: !!subtotalSpan,
            hasDiscountsEl: !!discountsSpan,
            hasCreditsEl: !!creditsSpan,
            hasTotalEl: !!totalSpan,
            subtotalElId: subtotalSpan?.id,
            discountsElId: discountsSpan?.id,
            creditsElId: creditsSpan?.id,
            totalElId: totalSpan?.id
        });
        
        // Search for credits element with different selectors if not found
        if (!creditsSpan) {
            console.warn('[checkout] cart-credits element not found by ID, searching alternatives...');
            const altCredits = document.querySelector('#cart-credits') || 
                              document.querySelector('[id*="credits"]') ||
                              document.querySelector('.summary-value[id*="credits"]');
            console.log('[checkout] Alternative credits element search:', {
                found: !!altCredits,
                element: altCredits
            });
        }
        
        if (subtotalSpan) {
            subtotalSpan.textContent = `$${subtotalVal.toFixed(2)}`;
            console.log('[checkout] Updated subtotal span to:', `$${subtotalVal.toFixed(2)}`);
        } else {
            console.warn('[checkout] subtotalSpan element not found!');
        }
        
        if (discountsSpan) {
            discountsSpan.textContent = `-$${discountsVal.toFixed(2)}`;
            console.log('[checkout] Updated discounts span to:', `-$${discountsVal.toFixed(2)}`);
        } else {
            console.warn('[checkout] discountsSpan element not found!');
        }
        
        if (creditsSpan) {
            const creditsDisplayValue = creditsVal > 0 ? `-$${creditsVal.toFixed(2)}` : '$0.00';
            creditsSpan.textContent = creditsDisplayValue;
            console.log('[checkout] ✅ Updated credits span to:', creditsDisplayValue);
            console.log('[checkout] Credits span current textContent:', creditsSpan.textContent);
            console.log('[checkout] Credits span computed style:', window.getComputedStyle(creditsSpan));
        } else {
            console.error('[checkout] ❌ creditsSpan element not found!');
            console.error('[checkout] Searching for credits element in DOM...');
            const allElements = document.querySelectorAll('*');
            const creditsElements = Array.from(allElements).filter(el => 
                el.id && el.id.toLowerCase().includes('credit')
            );
            console.log('[checkout] Found elements with "credit" in ID:', creditsElements.map(el => ({
                id: el.id,
                tagName: el.tagName,
                textContent: el.textContent?.substring(0, 50)
            })));
        }
        
        const cartCreditsRow = document.getElementById('cart-credits-row');
        if (cartCreditsRow) {
            cartCreditsRow.style.display = 'flex'; // Always show credits row
            console.log('[checkout] ✅ Credits row is visible');
            console.log('[checkout] Credits row computed style:', window.getComputedStyle(cartCreditsRow));
        } else {
            console.error('[checkout] ❌ cart-credits-row element not found!');
            console.error('[checkout] Searching for credits row in DOM...');
            const allRows = document.querySelectorAll('.summary-row, [class*="credits"], [id*="credits"]');
            console.log('[checkout] Found potential credit rows:', Array.from(allRows).map(el => ({
                id: el.id,
                className: el.className,
                textContent: el.textContent?.substring(0, 100)
            })));
        }
        
        if (totalSpan) {
            totalSpan.textContent = `$${totalVal.toFixed(2)}`;
            console.log('[checkout] Updated total span to:', `$${totalVal.toFixed(2)}`);
        } else {
            console.warn('[checkout] totalSpan element not found!');
        }
        
        console.log('[checkout] ========== DOM UPDATE END ==========');
        
        // Update the checkout table summary footer (subtotal, discounts, credits, total)
        const updateCheckoutTableSummary = () => {
            const footer = document.getElementById('checkout-summary-footer');
            if (!footer) {
                console.warn('[checkout] checkout-summary-footer not found');
                return false;
            }
            
            // Show the footer
            footer.style.display = 'table-footer-group';
            
            // Update subtotal
            const subtotalCell = footer.querySelector('.summary-value-subtotal');
            if (subtotalCell) {
                subtotalCell.textContent = `$${subtotalVal.toFixed(2)}`;
            }
            
            // Update discounts
            const discountsCell = footer.querySelector('.summary-value-discounts');
            if (discountsCell) {
                discountsCell.textContent = `-$${discountsVal.toFixed(2)}`;
            }
            
            // Update credits
            const creditsRow = footer.querySelector('#checkout-credits-row');
            const creditsCell = footer.querySelector('.summary-value-credits');
            if (creditsRow && creditsCell) {
                creditsRow.style.display = 'table-row'; // Always show
                creditsCell.textContent = creditsVal > 0 ? `-$${creditsVal.toFixed(2)}` : '$0.00';
                console.log('[checkout] ✅ Updated credits row in table:', creditsVal > 0 ? `-$${creditsVal.toFixed(2)}` : '$0.00');
            } else {
                console.warn('[checkout] Credits row or cell not found in footer');
            }
            
            // Update total
            const totalCell = footer.querySelector('.summary-value-total');
            if (totalCell) {
                totalCell.textContent = `$${totalVal.toFixed(2)}`;
                console.log('[checkout] ✅ Updated total in table footer:', `$${totalVal.toFixed(2)}`);
            }
            
            return true;
        };
        
        // Update the order-total-row (legacy, for backward compatibility)
        const updateOrderTotalRow = () => {
            const orderTotalRow = document.querySelector('.order-total-row');
            if (orderTotalRow) {
                const orderTotalRowSpan = orderTotalRow.querySelector('span');
                if (orderTotalRowSpan) {
                    orderTotalRowSpan.textContent = `Total: $${totalVal.toFixed(2)}`;
                    console.log('[checkout] updated order-total-row to:', totalVal, '(includes credits:', creditsVal, ')');
                    return true;
                }
            }
            return false;
        };
        
        // Update both the table footer and legacy total row
        if (!updateCheckoutTableSummary()) {
            setTimeout(updateCheckoutTableSummary, 100);
            setTimeout(updateCheckoutTableSummary, 500);
        }
        
        if (!updateOrderTotalRow()) {
            setTimeout(updateOrderTotalRow, 100);
            setTimeout(updateOrderTotalRow, 500);
        }
        
        // Also update payment section totals
        document.querySelectorAll('[data-total-display]').forEach(el => el.textContent = `$${totalVal.toFixed(2)}`);
        const finalTotalAmount = document.querySelector('.final-total-amount');
        if (finalTotalAmount) {
            finalTotalAmount.textContent = `$${totalVal.toFixed(2)}`;
        } else {
            const finalTotalSection = document.querySelector('.final-total');
            if (finalTotalSection) {
                finalTotalSection.innerHTML = `Final Total: <span class="final-total-amount">$${totalVal.toFixed(2)}</span>`;
            }
        }
        
        // Per-item discounted totals in checkout table
        // This must also be inside the async IIFE to access pricingResult
        try {
            console.log('[checkout] starting per-item discount update, pricingResult:', pricingResult);
            if (pricingResult && Array.isArray(pricingResult.items)) {
                console.log('[checkout] pricingResult.items array length:', pricingResult.items.length);
                // Map product_id -> {running_total, original_total, quantity}
                const itemMap = new Map();
                pricingResult.items.forEach(pi => {
                    if (pi && pi.product_id) {
                        const key = Number(pi.product_id);
                        const value = {
                            running_total: Number(pi.running_total || 0),
                            original_total: Number(pi.original_total || 0),
                            quantity: Number(pi.quantity || 0)
                        };
                        itemMap.set(key, value);
                        console.log('[checkout] mapped product_id', key, '->', value);
                    } else {
                        console.warn('[checkout] skipping pricing item (missing product_id):', pi);
                    }
                });
                console.log('[checkout] itemMap size:', itemMap.size, 'entries:', Array.from(itemMap.entries()));
                // Iterate cart items to update each row
                const cartItems = cartData.items || [];
                console.log('[checkout] processing', cartItems.length, 'cart items');
                cartItems.forEach((ci, idx) => {
                    console.log(`[checkout] processing cart item ${idx + 1}:`, {
                        line_item_id: ci.line_item_id,
                        product_id: ci.product_id,
                        product_id_num: Number(ci.product_id),
                        hasMatch: itemMap.has(Number(ci.product_id))
                    });
                    const m = itemMap.get(Number(ci.product_id));
                    if (!m) {
                        console.warn(`[checkout] no pricing match for product_id ${ci.product_id} (line_item_id: ${ci.line_item_id})`);
                        return;
                    }
                    const lineItem = (ci.line_item_id) ? String(ci.line_item_id) : null;
                    if (!lineItem) {
                        console.warn(`[checkout] missing line_item_id for product_id ${ci.product_id}`);
                        return;
                    }
                    const rowSelector = `tr[data-line-item-id="${lineItem}"]`;
                    console.log(`[checkout] looking for row with selector: ${rowSelector}`);
                    const row = document.querySelector(rowSelector);
                    if (!row) {
                        console.warn(`[checkout] row not found for line_item_id: ${lineItem}`);
                        return;
                    }
                    console.log(`[checkout] found row for line_item_id: ${lineItem}`);
                    const cell = row.querySelector('.line-total');
                    const discountCell = row.querySelector('.line-discount');
                    console.log(`[checkout] DOM elements found:`, {
                        hasLineTotal: !!cell,
                        hasDiscountCell: !!discountCell,
                        lineTotalText: cell?.textContent,
                        discountCellText: discountCell?.textContent
                    });
                    if (!cell) {
                        console.warn(`[checkout] .line-total cell not found in row for line_item_id: ${lineItem}`);
                        return;
                    }
                    const discounted = m.running_total;
                    const original = m.original_total;
                    const discountAmt = Math.max(0, original - discounted);
                    console.log(`[checkout] discount calculation for line_item_id ${lineItem}:`, {
                        original,
                        discounted,
                        discountAmt,
                        quantity: m.quantity
                    });
                    if (discounted < original) {
                        const perUnit = (m.quantity > 0) ? discounted / m.quantity : discounted;
                        cell.innerHTML = `<span class="price-strike">$${original.toFixed(2)}</span>
                                          <span class="price-discounted" title="Discounted line total">$${discounted.toFixed(2)}</span>
                                          <div class="price-note">($${perUnit.toFixed(2)} each)</div>`;
                        if (discountCell) {
                            discountCell.textContent = `-$${discountAmt.toFixed(2)}`;
                            console.log(`[checkout] updated discount cell to: -$${discountAmt.toFixed(2)}`);
                        } else {
                            console.warn(`[checkout] discount cell not found, cannot update`);
                        }
                    } else {
                        cell.textContent = `$${original.toFixed(2)}`;
                        if (discountCell) {
                            discountCell.textContent = '-$0.00';
                            console.log(`[checkout] no discount, set to -$0.00`);
                        } else {
                            console.warn(`[checkout] discount cell not found, cannot set to -$0.00`);
                        }
                    }
                });
                console.log('[checkout] finished processing all cart items');
            } else {
                console.warn('[checkout] pricingResult.items is not an array:', pricingResult);
            }
        } catch (e) {
            console.error('[checkout] error in per-item discounted totals:', e);
            console.error('[checkout] error stack:', e.stack);
        }
    })(); // End of async IIFE - All async operations (pricing, credits, DOM updates) complete here
}

// Show loading overlay
function showLoader(message = 'Processing...', subtext = 'Please wait') {
    let loaderOverlay = document.getElementById('loader-overlay');
    if (!loaderOverlay) {
        loaderOverlay = document.createElement('div');
        loaderOverlay.id = 'loader-overlay';
        loaderOverlay.className = 'loader-overlay';
        loaderOverlay.innerHTML = `
            <div class="loader-container">
                <div class="loader-spinner"></div>
                <p class="loader-text">${message}</p>
                <p class="loader-subtext">${subtext}</p>
            </div>
        `;
        document.body.appendChild(loaderOverlay);
    }
    
    const loaderText = loaderOverlay.querySelector('.loader-text');
    const loaderSubtext = loaderOverlay.querySelector('.loader-subtext');
    if (loaderText) loaderText.textContent = message;
    if (loaderSubtext) loaderSubtext.textContent = subtext;
    
    // Trigger reflow and show
    loaderOverlay.offsetHeight;
    loaderOverlay.classList.add('show');
}

// Hide loading overlay
function hideLoader() {
    const loaderOverlay = document.getElementById('loader-overlay');
    if (loaderOverlay) {
        loaderOverlay.classList.remove('show');
        setTimeout(() => {
            if (loaderOverlay.parentNode) {
                loaderOverlay.parentNode.removeChild(loaderOverlay);
            }
        }, 300);
    }
}

async function placeOrder() {
    const placeOrderBtn = document.getElementById('place-order-btn');
    
    // Disable button and show loading state
    if (placeOrderBtn) {
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('loading');
    }
    
    // Show loader
    showLoader('Submitting Order', 'Please wait while we process your order...');
    
    const orderNotes = document.getElementById('order-notes').value;
    const locationSelect = document.getElementById('location-select');
    const selectedLocationId = locationSelect ? locationSelect.value : null;
    
    const orderData = {
        notes: orderNotes,
        location_id: selectedLocationId
    };
    
    try {
        const response = await fetch(`/api/portal/${uuid}/checkout`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(orderData)
        });
        
        const data = await response.json();
        if (data.success) {
            // Update loader message
            showLoader('Order Submitted Successfully', 'Redirecting to confirmation page...');
            
            // Clear cart after successful order placement
            const cart = getCartManager();
            if (cart) {
                cart.clearCart();
                // Update cart icon immediately
                cart.updateCartIcon();
            }
            
            // Also clear localStorage directly as backup
            try {
                const storageKey = `portal_cart_${uuid}`;
                localStorage.removeItem(storageKey);
            } catch (e) {
                console.error('Error clearing localStorage:', e);
            }
            
            if (typeof showNotification !== 'undefined') {
                showNotification('Order submitted successfully! Pending approval.', 'success');
            }
            
            // Redirect to confirmation page
            setTimeout(() => {
                window.location.href = `/external/store/${uuid}/confirmation/${data.invoice_id}`;
            }, 1500);
        } else {
            hideLoader();
            
            // Re-enable button
            if (placeOrderBtn) {
                placeOrderBtn.disabled = false;
                placeOrderBtn.classList.remove('loading');
            }
            
            if (typeof showNotification !== 'undefined') {
                showNotification('Error: ' + (data.error || 'Unknown error'), 'error');
            } else {
                alert('Error placing order: ' + (data.error || 'Unknown error'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        hideLoader();
        
        // Re-enable button
        if (placeOrderBtn) {
            placeOrderBtn.disabled = false;
            placeOrderBtn.classList.remove('loading');
        }
        
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to place order. Please try again.', 'error');
        } else {
            alert('Failed to place order. Please try again.');
        }
    }
}
