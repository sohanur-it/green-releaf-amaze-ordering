// Update quantity on checkout page (frontend only, then sync to backend)
async function updateCheckoutQuantity(batchId, delta) {
    const cart = getCartManager();
    if (!cart) return;
    
    const item = cart.cart.items.find(i => String(i.batch_id) === String(batchId));
    if (!item) {
        console.error('Item not found:', batchId);
        return;
    }
    
    const newQuantity = item.quantity + delta;
    const maxAvailable = item.quantity_available || 999;
    
    if (newQuantity <= 0) {
        if (confirm('Remove this item from cart?')) {
            cart.removeItem(batchId);
            location.reload(); // Reload to update page
        }
        return;
    }
    
    if (newQuantity > maxAvailable) {
        if (typeof showNotification !== 'undefined') {
            showNotification(`Maximum available: ${maxAvailable} cases`, 'warning');
        }
        return;
    }
    
    // Update cart quantity (this also updates line_total)
    cart.updateQuantity(batchId, newQuantity);
    
    // Get updated item from cart
    const updatedItem = cart.cart.items.find(i => String(i.batch_id) === String(batchId));
    if (!updatedItem) return;
    
    // Find the row by batch_id
    const row = document.querySelector(`input[data-batch-id="${batchId}"]`)?.closest('tr');
    if (row) {
        // Update quantity display
        const quantityDisplay = row.querySelector('.quantity-value');
        if (quantityDisplay) {
            quantityDisplay.textContent = newQuantity;
        }
        
        // Update units total
        const unitsInfo = row.querySelector('.units-info');
        if (unitsInfo && updatedItem.units_per_case) {
            const totalUnits = newQuantity * updatedItem.units_per_case;
            unitsInfo.textContent = `${totalUnits} Units total`;
        }
        
        // Update line total
        const lineTotal = row.querySelector('.line-total');
        if (lineTotal) {
            lineTotal.textContent = `$${updatedItem.line_total.toFixed(2)}`;
        }
        
        // Update input field
        const input = row.querySelector('.quantity-input-checkout');
        if (input) {
            input.value = newQuantity;
            input.classList.toggle('quantity-exceeded', newQuantity > maxAvailable);
        }
        
        // Update +/- buttons
        const minusBtn = row.querySelector('.quantity-btn-minus');
        const plusBtn = row.querySelector('.quantity-btn-plus');
        if (minusBtn) {
            minusBtn.disabled = (newQuantity <= 1);
        }
        if (plusBtn) {
            plusBtn.disabled = (newQuantity >= maxAvailable);
        }
        
        // Update order total
        updateCheckoutTotal();
    }
    
    // Sync to backend (async, don't wait)
    cart.syncToBackend().catch(err => {
        console.error('Failed to sync cart:', err);
    });
}

