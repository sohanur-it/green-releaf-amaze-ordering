// Update checkout total from cart
function updateCheckoutTotal() {
    const cart = getCartManager();
    if (!cart) return;
    
    const cartData = cart.getCart();
    
    // Update order summary total
    const totalRow = document.querySelector('.order-total-row span');
    if (totalRow) {
        totalRow.textContent = `Total: $${cartData.total.toFixed(2)}`;
    }
    
    // Update final total in payment section if it exists
    const finalTotalElements = document.querySelectorAll('[data-total-display]');
    finalTotalElements.forEach(el => {
        el.textContent = `$${cartData.total.toFixed(2)}`;
    });
    
    // Update final total in payment section
    const finalTotalAmount = document.querySelector('.final-total-amount');
    if (finalTotalAmount) {
        finalTotalAmount.textContent = `$${cartData.total.toFixed(2)}`;
    } else {
        // Fallback: update entire final-total section
        const finalTotalSection = document.querySelector('.final-total');
        if (finalTotalSection) {
            finalTotalSection.innerHTML = `Final Total: <span class="final-total-amount">$${cartData.total.toFixed(2)}</span>`;
        }
    }
}

// Show loading overlay
function showLoader(message = 'Processing...', subtext = 'Please wait') {
    let loaderOverlay = document.getElementById('loader-overlay');
    if (!loaderOverlay) {
        loaderOverlay = document.createElement('div');
        loaderOverlay.id = 'loader-overlay';
        loaderOverlay.className = 'loader-overlay';
        loaderOverlay.innerHTML = `
            <div class="loader-container">
                <div class="loader-spinner"></div>
                <p class="loader-text">${message}</p>
                <p class="loader-subtext">${subtext}</p>
            </div>
        `;
        document.body.appendChild(loaderOverlay);
    }
    
    const loaderText = loaderOverlay.querySelector('.loader-text');
    const loaderSubtext = loaderOverlay.querySelector('.loader-subtext');
    if (loaderText) loaderText.textContent = message;
    if (loaderSubtext) loaderSubtext.textContent = subtext;
    
    // Trigger reflow and show
    loaderOverlay.offsetHeight;
    loaderOverlay.classList.add('show');
}

// Hide loading overlay
function hideLoader() {
    const loaderOverlay = document.getElementById('loader-overlay');
    if (loaderOverlay) {
        loaderOverlay.classList.remove('show');
        setTimeout(() => {
            if (loaderOverlay.parentNode) {
                loaderOverlay.parentNode.removeChild(loaderOverlay);
            }
        }, 300);
    }
}

async function placeOrder() {
    const placeOrderBtn = document.getElementById('place-order-btn');
    
    // Disable button and show loading state
    if (placeOrderBtn) {
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('loading');
    }
    
    // Show loader
    showLoader('Submitting Order', 'Please wait while we process your order...');
    
    const orderNotes = document.getElementById('order-notes').value;
    
    const orderData = {
        notes: orderNotes
    };
    
    try {
        const response = await fetch(`/api/portal/${uuid}/checkout`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(orderData)
        });
        
        const data = await response.json();
        if (data.success) {
            // Update loader message
            showLoader('Order Submitted Successfully', 'Redirecting to confirmation page...');
            
            // Clear cart after successful order placement
            const cart = getCartManager();
            if (cart) {
                cart.clearCart();
                // Update cart icon immediately
                cart.updateCartIcon();
            }
            
            // Also clear localStorage directly as backup
            try {
                const storageKey = `portal_cart_${uuid}`;
                localStorage.removeItem(storageKey);
            } catch (e) {
                console.error('Error clearing localStorage:', e);
            }
            
            if (typeof showNotification !== 'undefined') {
                showNotification('Order submitted successfully! Pending approval.', 'success');
            }
            
            // Redirect to confirmation page
            setTimeout(() => {
                window.location.href = `/external/store/${uuid}/confirmation/${data.invoice_id}`;
            }, 1500);
        } else {
            hideLoader();
            
            // Re-enable button
            if (placeOrderBtn) {
                placeOrderBtn.disabled = false;
                placeOrderBtn.classList.remove('loading');
            }
            
            if (typeof showNotification !== 'undefined') {
                showNotification('Error: ' + (data.error || 'Unknown error'), 'error');
            } else {
                alert('Error placing order: ' + (data.error || 'Unknown error'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        hideLoader();
        
        // Re-enable button
        if (placeOrderBtn) {
            placeOrderBtn.disabled = false;
            placeOrderBtn.classList.remove('loading');
        }
        
        if (typeof showNotification !== 'undefined') {
            showNotification('Failed to place order. Please try again.', 'error');
        } else {
            alert('Failed to place order. Please try again.');
        }
    }
}
