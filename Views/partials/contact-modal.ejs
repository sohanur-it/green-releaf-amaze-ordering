<!-- Views/partials/contact-modal.ejs -->
<div class="modal-overlay" id="contactModal" aria-hidden="true" onclick="handleModalOverlayClick(event)">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle" onclick="event.stopPropagation()">
        <!-- The form will be manipulated by our JavaScript -->
        <form id="contactForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="contactModalTitle">Add Contact</h3>
                <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <!-- A hidden input for the buyer ID -->
                <input type="hidden" id="buyerId" name="buyerId">
                <!-- A hidden input for the contact ID (will be used for editing) -->
                <input type="hidden" id="contactId" name="contactId">

                <div class="row" style="margin: 0;">
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="contactName" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Name <span class="required">*</span></label>
                            <input type="text" id="contactName" name="name" class="form-input-modern" required placeholder="Enter contact name" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Full name of the contact person</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="contactTitle" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Title</label>
                            <input type="text" id="contactTitle" name="title" class="form-input-modern" placeholder="e.g., Sales Manager" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Job title or position (optional)</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="contactEmail" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Email</label>
                            <input type="email" id="contactEmail" name="email" class="form-input-modern" placeholder="contact@example.com" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Email address (optional)</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="contactPhone" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Primary Phone</label>
                            <input type="tel" id="contactPhone" name="primary_phone" class="form-input-modern" placeholder="(555) 123-4567" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Phone number (optional)</small>
                        </div>
                    </div>
                </div>
                <div id="contactFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Contact
                </button>
            </div>
        </form>
    </div>
</div>