<!-- Views/partials/confirmation-modal.ejs -->
<div class="modal-overlay" id="confirmationModal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-header">
            <h3 class="modal-title" id="modalTitle">Confirm Action</h3>
            <button class="modal-close-btn" data-close-modal>&times;</button>
        </div>
        <div class="modal-body">
            <p id="modalText">Are you sure you want to proceed with this action?</p>
        </div>
        <div class="modal-footer">
            <!-- The form that will handle the actual delete POST request -->
            <form id="modalConfirmForm" method="POST">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-danger">Confirm</button>
            </form>
        </div>
    </div>
</div>