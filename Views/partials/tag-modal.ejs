<!-- Views/partials/tag-modal.ejs -->
<div class="modal-overlay" id="tagModal" aria-hidden="true" onclick="handleModalOverlayClick(event)">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="tagModalTitle" onclick="event.stopPropagation()">
        <form id="tagForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="tagModalTitle">Add New Tag</h3>
                <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <input type="hidden" id="tagId" name="tagId">
                <div class="row" style="margin: 0;">
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="tagName" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Tag Name <span class="required">*</span></label>
                            <input type="text" id="tagName" name="name" class="form-input-modern" required placeholder="Enter tag name" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">A short name for this tag</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="tagBackgroundColor" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Background Color</label>
                            <input type="color" id="tagBackgroundColor" name="background_color" value="#e1e4e8" style="width: 100%; height: 40px; border: 1px solid var(--border-color); border-radius: 6px; cursor: pointer; box-sizing: border-box;">
                            <small class="form-hint">Tag background color</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="tagColor" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Text Color</label>
                            <input type="color" id="tagColor" name="color" value="#000000" style="width: 100%; height: 40px; border: 1px solid var(--border-color); border-radius: 6px; cursor: pointer; box-sizing: border-box;">
                            <small class="form-hint">Tag text color</small>
                        </div>
                    </div>
                </div>
                <div id="tagFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Tag
                </button>
            </div>
        </form>
    </div>
</div>