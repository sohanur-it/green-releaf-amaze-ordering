<!-- Views/partials/tag-modal.ejs -->
<div class="modal-overlay" id="tagModal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="tagModalTitle">
        <form id="tagForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="tagModalTitle">Add New Tag</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tagId" name="tagId">
                <div class="form-group">
                    <label for="tagName">Tag Name</label>
                    <input type="text" id="tagName" name="name" required>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="tagBackgroundColor">Background Color</label>
                        <input type="color" id="tagBackgroundColor" name="background_color" value="#e1e4e8">
                    </div>
                    <div class="form-group">
                        <label for="tagColor">Text Color</label>
                        <input type="color" id="tagColor" name="color" value="#000000">
                    </div>
                </div>
                <div id="tagFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Save Tag</button>
            </div>
        </form>
    </div>
</div>