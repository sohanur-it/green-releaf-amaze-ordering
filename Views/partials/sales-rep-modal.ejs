<!-- Views/partials/sales-rep-modal.ejs -->
<div class="modal-overlay" id="salesRepModal" aria-hidden="true" data-no-close-on-outside-click="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="salesRepModalTitle" onclick="event.stopPropagation()" style="max-width: 80%; width: 80%; max-height: 80vh; height: auto; overflow-y: auto;">
        <form id="salesRepForm" class="styled-form" novalidate style="width: 100%;">
            <div class="modal-header">
                <h3 class="modal-title" id="salesRepModalTitle">
                    <i class="fas fa-user-plus" style="margin-right: 8px;"></i>
                    Assign Sales Representative to Location
                </h3>
                <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
            </div>
            <div class="modal-body" style="padding: 2rem; width: 100%; box-sizing: border-box;">
                <!-- Location Selection -->
                <div class="row" style="margin: 0; width: 100%;">
                    <div class="col-md-12" style="padding: 0; width: 100%;">
                        <div class="form-group" style="margin-bottom: 1.5rem; width: 100%;">
                            <label for="locationId" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                Select Location <span class="required">*</span>
                            </label>
                            <select id="locationId" name="locationId" required class="form-select-modern" style="width: 100%; box-sizing: border-box;">
                                <option value="" disabled selected>Loading locations...</option>
                            </select>
                            <small class="form-hint">Select a location for this buyer to assign a sales representative</small>
                        </div>
                    </div>
                </div>

                <!-- Sales Representative Selection -->
                <div class="row" style="margin: 0; width: 100%;">
                    <div class="col-md-12" style="padding: 0; width: 100%;">
                        <div class="form-group" style="margin-bottom: 1.5rem; width: 100%;">
                            <label for="salesRepId" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                Select Sales Representative <span class="required">*</span>
                            </label>
                            <select id="salesRepId" name="salesRepId" required class="form-select-modern" style="width: 100%; box-sizing: border-box;">
                                <option value="" disabled selected>Choose a representative...</option>
                                <% if (allSalesReps && allSalesReps.length > 0) { %>
                                    <% allSalesReps.forEach(rep => { %>
                                        <option value="<%= rep.entry_id %>">
                                            <%= rep.name %> <% if (rep.email) { %>(<%= rep.email %>)<% } %>
                                        </option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="" disabled>No sales representatives available</option>
                                <% } %>
                            </select>
                            <small class="form-hint">Select a user with Sales Rep role</small>
                        </div>
                    </div>
                </div>

                <div id="salesRepFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer" style="padding: 1.5rem 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn btn-secondary" data-close-modal style="padding: 10px 20px;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
                    <i class="fas fa-user-plus"></i> Assign to Location
                </button>
            </div>
        </form>
    </div>
</div>
