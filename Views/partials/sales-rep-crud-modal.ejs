<!-- Views/partials/sales-rep-crud-modal.ejs -->
<div class="modal-overlay" id="salesRepCrudModal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="salesRepCrudModalTitle">
        <form id="salesRepCrudForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="salesRepCrudModalTitle">Add New Rep</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <!-- hidden field for editing -->
                <input type="hidden" id="repId" name="repId">
                <div class="form-group">
                    <label for="repName">Full Name</label>
                    <input type="text" id="repName" name="name" required>
                </div>
                <div class="form-group">
                    <label for="repEmail">Email</label>
                    <input type="email" id="repEmail" name="email" required>
                </div>
                <div class="form-group">
                    <label for="repPhone">Phone</label>
                    <input type="tel" id="repPhone" name="phone">
                </div>
                <div id="salesRepCrudFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Save Rep</button>
            </div>
        </form>
    </div>
</div>