<!-- Views/partials/sales-rep-crud-modal.ejs -->
<div class="modal-overlay" id="salesRepCrudModal" aria-hidden="true" data-no-close-on-outside-click="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="salesRepCrudModalTitle" onclick="event.stopPropagation()" style="max-width: 800px; width: 90%;">
        <form id="salesRepCrudForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="salesRepCrudModalTitle">
                    <i class="fas fa-user-plus" style="margin-right: 8px;"></i>
                    <span id="modalTitleText">Add New Rep</span>
                </h3>
                <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <!-- hidden field for editing -->
                <input type="hidden" id="repId" name="repId">
                
                <div class="row" style="margin: 0;">
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="repName" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                Full Name <span class="required">*</span>
                            </label>
                            <input type="text" id="repName" name="name" required class="form-input-modern" placeholder="Enter full name" style="width: 100%; box-sizing: border-box;">
                        </div>
                    </div>
                    
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="repEmail" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                Email <span class="required">*</span>
                            </label>
                            <input type="email" id="repEmail" name="email" required class="form-input-modern" placeholder="Enter email address" style="width: 100%; box-sizing: border-box;">
                        </div>
                    </div>
                    
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="repPhone" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                Phone
                            </label>
                            <input type="tel" id="repPhone" name="phone" class="form-input-modern" placeholder="Enter phone number" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Optional - Phone number for contact</small>
                        </div>
                    </div>

                    <!-- User Account Fields (only show when creating new, not editing) -->
                    <div id="userAccountSection" class="col-md-12" style="padding: 0; margin-top: 1rem; padding-top: 1.5rem; border-top: 2px solid var(--border-color);">
                        <h4 style="font-size: 16px; font-weight: 600; margin-bottom: 1rem; color: var(--text-color);">
                            <i class="fas fa-user-shield" style="margin-right: 8px;"></i>
                            Create User Account (Optional)
                        </h4>
                        <small class="form-hint" style="display: block; margin-bottom: 1rem; color: var(--text-light);">
                            Create a user account with Sales Representative role. Leave blank if you only want to create a sales rep entry.
                        </small>
                        
                        <div class="row" style="margin: 0;">
                            <div class="col-md-6" style="padding: 0; padding-right: 0.75rem; margin-bottom: 1.5rem;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label for="repUsername" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                        Username
                                    </label>
                                    <input type="text" id="repUsername" name="username" class="form-input-modern" placeholder="Enter username" style="width: 100%; box-sizing: border-box;">
                                </div>
                            </div>
                            
                            <div class="col-md-6" style="padding: 0; padding-left: 0.75rem; margin-bottom: 1.5rem;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label for="repPassword" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">
                                        Password
                                    </label>
                                    <input type="password" id="repPassword" name="password" class="form-input-modern" placeholder="Enter password (min 8 chars)" minlength="8" style="width: 100%; box-sizing: border-box;">
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-12" style="padding: 0;">
                            <small class="form-hint">If username and password are provided, a user account will be created with Sales Representative role</small>
                        </div>
                    </div>
                </div>
                
                <div id="salesRepCrudFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer" style="padding: 1.5rem 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn btn-secondary" data-close-modal style="padding: 10px 20px;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
                    <i class="fas fa-save"></i> <span id="saveButtonText">Save Rep</span>
                </button>
            </div>
        </form>
    </div>
</div>