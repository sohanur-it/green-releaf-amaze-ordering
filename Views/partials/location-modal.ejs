<!-- Views/partials/location-modal.ejs -->
<div class="modal-overlay" id="locationModal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="locationModalTitle">
        <form id="locationForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="locationModalTitle">Add Location</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="locationId" name="locationId">

                <div class="form-group span-2">
                    <label for="locationName">Location Name (e.g., Downtown Branch)</label>
                    <input type="text" id="locationName" name="name" required>
                </div>
                <div class="form-group span-2">
                    <label for="locationLineOne">Address Line 1</label>
                    <input type="text" id="locationLineOne" name="line_one" required>
                </div>
                <div class="form-group span-2">
                    <label for="locationLineTwo">Address Line 2</label>
                    <input type="text" id="locationLineTwo" name="line_two">
                </div>

                <div class="form-group">
                    <label for="locationCity">City</label>
                    <input type="text" id="locationCity" name="city" required>
                </div>
                <div class="form-group">
                    <label for="locationState">State</label>
                    <input type="text" id="locationState" name="state" required>
                </div>
                <div class="form-group span-2">
                    <label for="locationZip">Zip Code</label>
                    <input type="text" id="locationZip" name="zip" required>
                </div>
                <div class="form-group span-2">
                    <label for="locationLicense">State License #</label>
                    <input type="text" id="locationLicense" name="state_license">
                </div>

                <div id="locationFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Save Location</button>
            </div>
        </form>
    </div>
</div>