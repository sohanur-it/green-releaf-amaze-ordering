<!-- Views/partials/location-modal.ejs -->
<div class="modal-overlay" id="locationModal" aria-hidden="true" onclick="handleModalOverlayClick(event)">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="locationModalTitle" onclick="event.stopPropagation()">
        <form id="locationForm" class="styled-form" novalidate>
            <div class="modal-header">
                <h3 class="modal-title" id="locationModalTitle">Add Location</h3>
                <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <input type="hidden" id="locationId" name="locationId">

                <div class="row" style="margin: 0;">
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationName" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Location Name <span class="required">*</span></label>
                            <input type="text" id="locationName" name="name" class="form-input-modern" required placeholder="e.g., Downtown Branch" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">A descriptive name for this location</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationLineOne" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Address Line 1 <span class="required">*</span></label>
                            <input type="text" id="locationLineOne" name="line_one" class="form-input-modern" required placeholder="Street address" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Street number and name</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationLineTwo" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Address Line 2</label>
                            <input type="text" id="locationLineTwo" name="line_two" class="form-input-modern" placeholder="Suite, Unit, etc. (optional)" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Additional address information (optional)</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationCity" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">City <span class="required">*</span></label>
                            <input type="text" id="locationCity" name="city" class="form-input-modern" required placeholder="City name" style="width: 100%; box-sizing: border-box;">
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationState" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">State <span class="required">*</span></label>
                            <input type="text" id="locationState" name="state" class="form-input-modern" required placeholder="State abbreviation" style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Two-letter state code (e.g., CA, NY)</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationZip" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Zip Code <span class="required">*</span></label>
                            <input type="text" id="locationZip" name="zip" class="form-input-modern" required placeholder="12345" style="width: 100%; box-sizing: border-box;">
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationLicense" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Store ID (State License / DIS Number) <span class="required">*</span></label>
                            <input type="text" id="locationLicense" name="state_license" class="form-input-modern" required placeholder="e.g., DIS000085" style="width: 100%; box-sizing: border-box; color: #000000 !important;">
                            <small class="form-hint">State-issued store identifier (e.g., DIS000085). Used for display and identification. Different from METRC license number.</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationMetrcLicense" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">METRC License Number</label>
                            <input type="text" id="locationMetrcLicense" name="metrc_license_number" class="form-input-modern" placeholder="e.g., CUL000027" style="width: 100%; box-sizing: border-box; color: #000000 !important;">
                            <small class="form-hint">METRC facility license number (e.g., CUL000027) used for API calls to find recipientId. Required for manifest creation. Different from Store ID (DIS000085).</small>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 0; margin-bottom: 1.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="locationDeliveryZone" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Delivery Zone</label>
                            <input type="text" id="locationDeliveryZone" name="delivery_zone" class="form-input-modern" placeholder="e.g., North Zone, Downtown, etc." style="width: 100%; box-sizing: border-box;">
                            <small class="form-hint">Internal tracking field for delivery zone assignment. Used for filtering and sorting in fulfillment queue.</small>
                        </div>
                    </div>
                </div>

                <!-- Delivery Windows Section (only show when editing existing location) -->
                <div id="deliveryWindowsSection" style="display: none; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #e0e0e0;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <h4 style="margin: 0; color: var(--text-color);">Delivery Windows</h4>
                        <button type="button" id="manageDeliveryWindowsBtn" class="btn btn-secondary" style="font-size: 0.875rem;">
                            <i class="fas fa-clock"></i> Manage Windows
                        </button>
                    </div>
                    <div id="deliveryWindowsPreview" style="color: var(--text-light); font-size: 0.875rem;">
                        <em>No delivery windows configured</em>
                    </div>
                </div>

                <div id="locationFormWarning" class="alert alert-warning" style="display: none; margin-top: 1rem;">
                    <strong>Warning:</strong> <span id="locationFormWarningText"></span>
                </div>
                <div id="locationFormError" class="form-error-message" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Location
                </button>
            </div>
        </form>
    </div>
</div>