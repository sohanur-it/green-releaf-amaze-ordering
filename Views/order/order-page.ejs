<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/main.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main class="order-container">
        <!-- filters sidebar -->
        <aside class="filters-sidebar">
            <div class="filters-header">
                <h2>Filters</h2>
                <button class="btn-clear-filters" onclick="clearAllFilters()">Clear All</button>
            </div>

            <!-- active filters display -->
            <div id="active-filters" class="active-filters">
                <!-- populated by JS -->
            </div>

            <!-- category filter -->
            <div class="filter-section">
                <h3 class="filter-title">Category</h3>
                <div id="category-filters" class="filter-options">
                    <!-- populated by JS -->
                </div>
            </div>

            <!-- brand filter -->
            <div class="filter-section">
                <h3 class="filter-title">Brand</h3>
                <div id="brand-filters" class="filter-options">
                    <!-- populated by JS -->
                </div>
            </div>

            <!-- strain type filter -->
            <div class="filter-section">
                <h3 class="filter-title">Strain Type</h3>
                <div id="strain-type-filters" class="filter-options">
                    <!-- populated by JS -->
                </div>
            </div>
        </aside>

        <!-- main product area -->
        <div class="products-main">
            <!-- header with cart button -->
            <div class="products-header">
                <h1>Order Products</h1>
                <button class="btn-cart" onclick="toggleCart()">
                    🛒 Cart <span id="cart-count" class="cart-badge">0</span>
                </button>
            </div>

            <!-- search bar -->
            <div class="search-container">
                <input type="text" id="product-search" placeholder="Search products..." class="search-input">
            </div>

            <!-- loading indicator -->
            <div id="products-loading" class="loading-container" style="display: none;">
                <div class="loader"></div>
                <p>Loading products...</p>
            </div>

            <!-- products grid - in stock -->
            <div class="products-section">
                <h2 class="section-heading">In Stock</h2>
                <div id="products-grid" class="products-grid">
                    <!-- populated by JS -->
                </div>
            </div>

            <!-- out of stock products -->
            <div class="products-section out-of-stock-section">
                <h2 class="section-heading">Out of Stock</h2>
                <div id="out-of-stock-grid" class="products-grid">
                    <!-- populated by JS -->
                </div>
            </div>
        </div>
    </main>

    <!-- cart sidebar (slides in from right) -->
    <div id="cart-sidebar" class="cart-sidebar">
        <div class="cart-header">
            <h2>Shopping Cart</h2>
            <button class="btn-close-cart" onclick="toggleCart()">×</button>
        </div>

        <div class="cart-items" id="cart-items">
            <!-- populated by JS -->
        </div>

        <div class="cart-footer">
            <div class="cart-totals">
                <div class="total-row">
                    <span>Subtotal:</span>
                    <span id="cart-subtotal">$0.00</span>
                </div>
                <div class="total-row total-final">
                    <span>Total:</span>
                    <span id="cart-total">$0.00</span>
                </div>
            </div>

            <button class="btn btn-checkout" onclick="proceedToCheckout()">
                Proceed to Checkout
            </button>

            <p class="cart-note">⚠️ This is a mockup - no actual orders are placed</p>
        </div>
    </div>

    <!-- cart overlay -->
    <div id="cart-overlay" class="cart-overlay" onclick="toggleCart()" style="display: none;"></div>

    <!-- product detail modal -->
    <div id="product-modal" class="modal" style="display: none;">
        <div class="modal-content">
            <button class="btn-close-modal" onclick="closeProductModal()">×</button>
            <div id="product-modal-body">
                <!-- populated by JS -->
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts') %>

    <script src="/public/js/order-page.js"></script>
</body>
</html>