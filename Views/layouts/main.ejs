                    <span class="nav-link-text">API Docs</span>
                </a>
                <% } %>
            <% } %>
        </nav>
    </aside>
    <% } %>

    <main class="main-content <%= hideSidebarFlag ? 'main-content--full' : '' %>">
        <% if (!hideSidebarFlag) { %>
        <div class="top-bar">
            <div class="top-bar-left">
                <h1 class="page-title"><%= title %></h1>
            </div>
            <div class="top-bar-right">
                <!-- Theme Toggle -->
                <button class="top-bar-icon theme-toggle-btn" id="themeToggleBtn" title="Toggle Theme">
                    <i class="fas fa-lightbulb" id="themeIcon"></i>
                </button>
                <!-- Notifications -->
                <div class="top-bar-icon notification-dropdown" id="notificationDropdown">
                    <button class="notification-btn" title="Notifications" id="notificationBellBtn">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                    </button>
                    <div class="notification-menu" id="notificationMenu">
                        <div class="notification-menu-header">
                            <h4 style="margin: 0; color: var(--text-color);">Notifications</h4>
                            <button class="notification-mark-all-read" id="markAllReadBtn" style="display: none; padding: 0.25rem 0.5rem; font-size: 0.875rem; border: none; background: transparent; color: var(--primary-color, #007bff); cursor: pointer;">
                                Mark all read
                            </button>
                        </div>
                        <div class="notification-menu-divider"></div>
                        <div class="notification-list" id="notificationList">
                            <div class="notification-loading" style="padding: 1rem; text-align: center; color: var(--text-light, #666);">
                                <i class="fas fa-spinner fa-spin"></i> Loading...
                            </div>
                        </div>
                        <div class="notification-menu-footer">
                            <a href="/admin/notifications" style="display: block; padding: 0.75rem; text-align: center; color: var(--primary-color, #007bff); text-decoration: none; border-top: 1px solid var(--border-color, #dee2e6);">
                                View all notifications
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Settings -->
                <a href="/admin/settings" class="top-bar-icon settings-btn <%= title === 'Settings' ? 'active' : '' %>" title="Settings">
                    <i class="fas fa-cog"></i>
                </a>
                <!-- Profile -->
                <div class="top-bar-icon profile-dropdown" id="profileDropdown">
                    <button class="profile-btn" title="Profile">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <div class="profile-menu" id="profileMenu">
                        <div class="profile-menu-header">
                            <div class="profile-menu-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="profile-menu-info">
                                <div class="profile-menu-name"><%= username || 'User' %></div>
                                <div class="profile-menu-email"><%= userEmail || 'No email' %></div>
                                <div class="profile-menu-role" style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                                    <% if (userRoles && userRoles.length > 0) { %>
                                        <% userRoles.forEach(role => { %>
                                            <span class="role-badge-small role-<%= role.toLowerCase().replace(/\s+/g, '-') %>">
                                                <%= role %>
                                            </span>
                                        <% }); %>
                                    <% } else { %>
                                        <span class="role-badge-small role-user">
                                            <%= primaryRole %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="profile-menu-divider"></div>
                        <a href="/admin/settings" class="profile-menu-item">
                            <i class="fas fa-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="/auth/logout" class="profile-menu-item" onclick="event.preventDefault(); window.location.href='/auth/logout'; return false;">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        
        <div class="content-body <%= hideSidebarFlag ? 'content-body--full' : '' %>">
            <%- body %>
        </div>
    </main>
</div>

<%- include('../partials/confirmation-modal') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/public/js/shared/notifications.js"></script>
<script src="/public/js/shared/modal.js"></script>
<script src="/public/js/shared/main.js"></script>
<script>
// Theme toggle functionality - must run after DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    // Ensure theme is applied to body element (it may not exist when head script runs)
    const savedTheme = localStorage.getItem('theme') || 'light';
    if (window.applyTheme) {
        window.applyTheme(savedTheme);
    }
    
    // Update theme icon on page load
    if (window.updateThemeIcon) {
        window.updateThemeIcon(savedTheme);
    }
    
    // Theme toggle button
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const currentTheme = document.body.classList.contains('dark-theme') ? 'dark' : 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            // Save to localStorage
            localStorage.setItem('theme', newTheme);
            
            // Apply theme immediately
            if (window.applyTheme) {
                window.applyTheme(newTheme);
            }
            
            // Update icon
            if (window.updateThemeIcon) {
                window.updateThemeIcon(newTheme);
            }
        });
    }
    
    // Profile dropdown toggle
    const profileDropdown = document.getElementById('profileDropdown');
    const profileMenu = document.getElementById('profileMenu');
    if (profileDropdown && profileMenu) {
        profileDropdown.addEventListener('click', function(e) {
            e.stopPropagation();
            profileMenu.classList.toggle('active');
            // Close notification menu if open
            const notificationMenu = document.getElementById('notificationMenu');
            if (notificationMenu) notificationMenu.classList.remove('active');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!profileDropdown.contains(e.target)) {
                profileMenu.classList.remove('active');
            }
        });
    }
    
    // Notification dropdown toggle
    const notificationDropdown = document.getElementById('notificationDropdown');
    const notificationMenu = document.getElementById('notificationMenu');
    const notificationBellBtn = document.getElementById('notificationBellBtn');
    
    if (notificationDropdown && notificationMenu && notificationBellBtn) {
        notificationBellBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = notificationMenu.classList.contains('active');
            notificationMenu.classList.toggle('active');
            // Close profile menu if open
            if (profileMenu) profileMenu.classList.remove('active');
            
            // Load notifications when opening (not when closing)
            if (!isActive) {
                loadNotifications();
            }
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!notificationDropdown.contains(e.target)) {
                notificationMenu.classList.remove('active');
            }
        });
        
        // Load unread count on page load
        updateNotificationBadge();
    } else {
        console.warn('Notification elements not found:', {
            dropdown: !!notificationDropdown,
            menu: !!notificationMenu,
            button: !!notificationBellBtn
        });
    }
});

// Notification management functions
async function loadNotifications() {
    const notificationList = document.getElementById('notificationList');
    if (!notificationList) {
        console.error('Notification list element not found');
        return;
    }
    
    try {
        notificationList.innerHTML = '<div class="notification-loading"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
        
        const response = await fetch('/api/v1/notifications?limit=10');
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        const data = await response.json();
        
        console.log('Notifications API response:', data);
        
        if (data.success && data.notifications && data.notifications.length > 0) {
            notificationList.innerHTML = data.notifications.map(notif => {
                const timeAgo = formatTimeAgo(new Date(notif.created_at));
                const invoiceLink = notif.payload && notif.payload.invoice_id 
                    ? `<a href="/admin/invoices/${notif.payload.invoice_id}" class="notification-item-link">View Invoice</a>`
                    : '';
                
                return `
                    <div class="notification-item ${notif.is_read ? '' : 'unread'}" data-notification-id="${notif.id}">
                        <div class="notification-item-title">${escapeHtml(notif.title || 'Notification')}</div>
                        <div class="notification-item-message">${escapeHtml(notif.message || '')}</div>
                        <div class="notification-item-time">${timeAgo}</div>
                        ${invoiceLink}
                    </div>
                `;
            }).join('');
            
            // Add click handlers
            notificationList.querySelectorAll('.notification-item').forEach(item => {
                item.addEventListener('click', function() {
                    const notificationId = this.dataset.notificationId;
                    markNotificationRead(notificationId);
                    
                    // Navigate to invoice if link exists
                    const link = this.querySelector('.notification-item-link');
                    if (link) {
                        window.location.href = link.href;
                    }
                });
            });
            
            // Show mark all read button if there are unread
            const unreadCount = data.notifications.filter(n => !n.is_read).length;
            const markAllReadBtn = document.getElementById('markAllReadBtn');
            if (markAllReadBtn) {
                if (unreadCount > 0) {
                    markAllReadBtn.style.display = 'block';
                    markAllReadBtn.onclick = markAllNotificationsRead;
                } else {
                    markAllReadBtn.style.display = 'none';
                }
            }
        } else {
            notificationList.innerHTML = '<div class="notification-empty">No notifications</div>';
            const markAllReadBtn = document.getElementById('markAllReadBtn');
            if (markAllReadBtn) markAllReadBtn.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading notifications:', error);
        notificationList.innerHTML = '<div class="notification-empty">Error loading notifications: ' + escapeHtml(error.message) + '</div>';
    }
}

async function updateNotificationBadge() {
    const badge = document.getElementById('notificationBadge');
    if (!badge) return;
    
    try {
        // Fetch with limit=1 to get total count without loading all data
        const response = await fetch('/api/v1/notifications?limit=1&unread=true');
        
        // Check if response is OK before parsing
        if (!response.ok) {
            console.warn(`[Notifications] Badge update failed: HTTP ${response.status} ${response.statusText}`);
            return; // Silently fail - don't show error to user
        }
        
        const data = await response.json();
        
        if (data.success) {
            // Use the total count from API response, not the array length
            const unreadCount = data.total || 0;
            if (unreadCount > 0) {
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
    } catch (error) {
        // Silently fail - don't spam console with network errors
        // Only log if it's not a network error (which is common during page transitions)
        if (error.name !== 'TypeError' || !error.message.includes('Failed to fetch')) {
            console.error('Error updating notification badge:', error);
        }
        // Don't show error to user - badge will just not update
    }
}

async function markNotificationRead(notificationId) {
    try {
        await fetch(`/api/v1/notifications/${notificationId}/read`, {
            method: 'POST'
        });
        
        // Update UI
        const item = document.querySelector(`[data-notification-id="${notificationId}"]`);
        if (item) {
            item.classList.remove('unread');
        }
        
        // Update badge
        updateNotificationBadge();
    } catch (error) {
        console.error('Error marking notification as read:', error);
    }
}

async function markAllNotificationsRead() {
    try {
        // Get all unread notifications
        const response = await fetch('/api/v1/notifications?unread=true&limit=100');
        const data = await response.json();
        
        if (data.success && data.notifications) {
            // Mark all as read
            for (const notif of data.notifications) {
                await fetch(`/api/v1/notifications/${notif.id}/read`, {
                    method: 'POST'
                });
            }
            
            // Reload notifications
            loadNotifications();
            updateNotificationBadge();
        }
    } catch (error) {
        console.error('Error marking all notifications as read:', error);
    }
}

function formatTimeAgo(date) {
    const now = new Date();
    const diff = now - date;
    const seconds = Math.floor(diff / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    
    if (days > 0) return `${days} day${days > 1 ? 's' : ''} ago`;
    if (hours > 0) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
    if (minutes > 0) return `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
    return 'Just now';
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Poll for new notifications every 30 seconds
setInterval(updateNotificationBadge, 30000);
</script>
</body>
</html>