<!-- Views/layouts/main.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Releaf - <%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/admin-style.css">
    <link rel="stylesheet" href="/public/css/notifications.css">
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script>
        (function() {
            try {
                // Apply sidebar state
                if (localStorage.getItem('sidebarState') === 'collapsed') {
                    document.documentElement.classList.add('sidebar-is-collapsed');
                }
                
                // Apply theme immediately on page load (before body renders to avoid flash)
                function applyTheme(theme) {
                    const html = document.documentElement;
                    const body = document.body;
                    
                    if (theme === 'dark') {
                        html.classList.add('dark-theme');
                        if (body) {
                            body.classList.add('dark-theme');
                        }
                    } else {
                        html.classList.remove('dark-theme');
                        if (body) {
                            body.classList.remove('dark-theme');
                        }
                    }
                }
                
                // Update theme icon (called after DOM is loaded)
                function updateThemeIcon(theme) {
                    const themeIcon = document.getElementById('themeIcon');
                    if (themeIcon) {
                        if (theme === 'dark') {
                            themeIcon.className = 'fas fa-moon';
                        } else {
                            themeIcon.className = 'fas fa-lightbulb';
                        }
                    }
                }
                
                // Get saved theme and apply it immediately to html element
                const savedTheme = localStorage.getItem('theme') || 'light';
                const html = document.documentElement;
                if (savedTheme === 'dark') {
                    html.classList.add('dark-theme');
                } else {
                    html.classList.remove('dark-theme');
                }
                
                // Make functions available globally
                window.applyTheme = applyTheme;
                window.updateThemeIcon = updateThemeIcon;
            } catch (e) {
                console.error('Error initializing theme:', e);
            }
        })();
    </script>
</head>
<body>
<% 
const hideSidebarFlag = typeof hideSidebar !== 'undefined' && hideSidebar;
const hasRole = (roleName) => userRoles && userRoles.includes(roleName);
const isAdmin = isSuperuser || hasRole('Administrator');
const isSalesAdmin = hasRole('Sales Admin');
const isSalesRep = hasRole('Sales Representative');
let primaryRole = 'User';
if (isSuperuser) {
    primaryRole = 'Superuser';
    
} else if (hasRole('Administrator')) {
    primaryRole = 'Administrator';
} else if (isSalesAdmin) {
    primaryRole = 'Sales Admin';
} else if (isSalesRep) {
    primaryRole = 'Sales Representative';
} else if (hasRole('Inventory Manager')) {
    primaryRole = 'Inventory Manager';
} else if (hasRole('Fulfillment Team')) {
    primaryRole = 'Fulfillment Team';
} else if (hasRole('Accounting/Finance')) {
    primaryRole = 'Accounting/Finance';
} else if (userRoles && userRoles.length > 0) {
    primaryRole = userRoles[0];
}
%>
<div class="app-container <%= hideSidebarFlag ? 'app-container--full' : '' %>" id="app-container">
