<!-- Views/layouts/main.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Releaf - <%= title %></title>
    <!-- lil bit of Google Fonts for that clean look. Lol -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Grid.js CSS for the fancy table -->
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
    <!-- Our custom stylesheet -->
    <link rel="stylesheet" href="/public/css/admin-style.css">

    <!-- Grid.js for the table magic - MOVED TO HEAD -->
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
</head>
<body>
<div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <h2 class="sidebar-title">Green Releaf</h2>
        </div>
        <nav class="sidebar-nav">
            <!-- This logic was slightly off, corrected to use a variable -->
            <a href="/admin" class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
            <a href="/admin/crm" class="nav-link <%= title.startsWith('CRM') ? 'active' : '' %>">CRM</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="main-header">
            <h1><%= title %></h1>
        </header>
        <div class="content-body">
            <%- body %> <!-- This is where the actual page content gets injected -->
        </div>
    </main>
</div>
<%- include('../partials/confirmation-modal') %>

<script src="/public/js/shared/modal.js"></script>
</body>
</html>