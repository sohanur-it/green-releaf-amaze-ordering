<div class="page-header">
    <div>
        <!-- <h1>Portal Access Management</h1> -->
        <p>Manage access links for external buyer portal</p>
    </div>
    <button class="btn btn-primary" onclick="showCreateModal()" type="button">
        <i class="fas fa-plus"></i> Create Access Link
    </button>
</div>

<div class="info-card">
    <div class="card-header">
        <h3>Portal Access Links</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div id="portal-access-table-wrapper">
            <table class="portal-access-table">
                <thead>
                    <tr>
                        <th>Buyer</th>
                        <th>Access UUID</th>
                        <th>Status</th>
                        <th>Expires</th>
                        <th>Access Count</th>
                        <th>Last Accessed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (portalAccesses && portalAccesses.length > 0) { %>
                        <% portalAccesses.forEach(access => { %>
                            <tr data-access-id="<%= access.id %>">
                                <td><strong><%= access.buyer_name %></strong></td>
                                <td>
                                    <code style="font-size: 11px;"><%= access.access_uuid.substring(0, 20) %>...</code>
                                </td>
                                <td>
                                    <span class="badge <%= access.is_active ? 'badge-success' : 'badge-warning' %>">
                                        <%= access.is_active ? 'Active' : 'Inactive' %>
                                    </span>
                                </td>
                                <td>
                                    <%= access.expires_at ? new Date(access.expires_at).toLocaleDateString() : 'Never' %>
                                </td>
                                <td><%= access.access_count || 0 %></td>
                                <td>
                                    <%= access.last_accessed_at ? new Date(access.last_accessed_at).toLocaleString() : 'Never' %>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-sm btn-info" onclick="getPortalUrl(<%= access.id %>)" title="Get URL">
                                            <i class="fas fa-link"></i> Get URL
                                        </button>
                                        <button class="btn-sm btn-secondary" onclick="regenerateUuid(<%= access.id %>)" title="Regenerate UUID">
                                            <i class="fas fa-key"></i> Regenerate
                                        </button>
                                        <button class="btn-sm btn-warning" onclick="toggleActive(<%= access.id %>)" title="Toggle Status">
                                            <i class="fas fa-toggle-<%= access.is_active ? 'on' : 'off' %>"></i>
                                        </button>
                                        <button class="btn-sm btn-danger" onclick="deleteAccess(<%= access.id %>)" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-light);">
                                No portal access links found. Create one to get started.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Access Modal -->
<div class="modal-overlay" id="createModal" aria-hidden="true" onclick="handleModalOverlayClick(event)">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="createModalTitle" onclick="event.stopPropagation()">
        <form id="createForm" class="styled-form" onsubmit="createAccess(event)">
            <div class="modal-header">
                <h3 class="modal-title" id="createModalTitle">Create Portal Access</h3>
                <button type="button" class="modal-close-btn" onclick="hideCreateModal()" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="buyer_id">Buyer</label>
                    <select id="buyer_id" name="buyer_id" required onchange="loadLocations(this.value)" class="form-select-modern">
                        <option value="">Select a buyer...</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="location_id">Location</label>
                    <select id="location_id" name="location_id" required class="form-select-modern">
                        <option value="">Select a location...</option>
                    </select>
                    <small class="form-hint">Please select a buyer first to load available locations</small>
                </div>
                <div class="form-group">
                    <label for="expires_at">Expiration Date <span style="color: var(--text-light); font-weight: normal;">(Optional)</span></label>
                    <input type="date" id="expires_at" name="expires_at" class="form-select-modern">
                    <small class="form-hint">Leave empty for no expiration</small>
                </div>
                <div class="form-group">
                    <label for="notes">Notes <span style="color: var(--text-light); font-weight: normal;">(Optional)</span></label>
                    <textarea id="notes" name="notes" rows="3" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 16px; font-family: inherit; resize: vertical;"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideCreateModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-link"></i> Create Access Link
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.portal-access-table {
    width: 100%;
    border-collapse: collapse;
}

.portal-access-table th {
    background-color: var(--bg-color);
    padding: 12px;
    text-align: left;
    font-weight: 600;
    border-bottom: 1px solid var(--border-color);
}

.portal-access-table td {
    padding: 12px;
    border-bottom: 1px solid var(--border-color);
}

.portal-access-table tr:hover {
    background-color: var(--bg-color);
}

.action-buttons {
    display: flex;
    gap: 8px;
}

.btn-sm {
    padding: 6px 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
}

.btn-info {
    background-color: var(--primary-color);
    color: white;
}

.btn-warning {
    background-color: #f0ad4e;
    color: white;
}

.btn-danger {
    background-color: #d9534f;
    color: white;
}

.btn-secondary {
    background-color: #6c757d;
    color: white;
}

.badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

.badge-success {
    background-color: #d4edda;
    color: #155724;
}

.badge-warning {
    background-color: #fff3cd;
    color: #856404;
}
</style>

<script>
// Load buyers for dropdown
async function loadBuyers() {
    const select = document.getElementById('buyer_id');
    
    try {
        console.log('Fetching buyers from /api/crm/buyers...');
        const response = await fetch('/api/crm/buyers');
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('Buyers API response:', data);
        
        // Clear existing options (except placeholder)
        select.innerHTML = '<option value="">Select a buyer...</option>';
        
        // The API returns an array directly, not wrapped in { buyers: [...] }
        if (Array.isArray(data)) {
            if (data.length === 0) {
                console.warn('No buyers found in database');
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'No buyers found';
                option.disabled = true;
                select.appendChild(option);
            } else {
                console.log(`Loading ${data.length} buyers into dropdown`);
                data.forEach(buyer => {
                    const option = document.createElement('option');
                    option.value = buyer.entry_id;
                    option.textContent = buyer.name;
                    select.appendChild(option);
                });
                console.log('Buyers loaded successfully');
            }
        } else if (data.buyers && Array.isArray(data.buyers)) {
            // Handle case where it's wrapped in { buyers: [...] }
            console.log(`Loading ${data.buyers.length} buyers into dropdown (wrapped format)`);
            data.buyers.forEach(buyer => {
                const option = document.createElement('option');
                option.value = buyer.entry_id;
                option.textContent = buyer.name;
                select.appendChild(option);
            });
        } else {
            console.error('Unexpected data format:', data);
            const option = document.createElement('option');
            option.value = '';
            option.textContent = 'Error loading buyers';
            option.disabled = true;
            select.appendChild(option);
        }
    } catch (error) {
        console.error('Error loading buyers:', error);
        select.innerHTML = '<option value="">Error loading buyers</option>';
        alert('Failed to load buyers. Please check the browser console for details.');
    }
}

async function loadLocations(buyerId) {
    const locationSelect = document.getElementById('location_id');
    locationSelect.innerHTML = '<option value="">Loading locations...</option>';
    locationSelect.disabled = true;
    
    if (!buyerId) {
        locationSelect.innerHTML = '<option value="">Select a location...</option>';
        locationSelect.disabled = true;
        return;
    }
    
    try {
        console.log(`Fetching locations for buyer ${buyerId}...`);
        const response = await fetch(`/admin/api/portal-access/buyers/${buyerId}/locations`);
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('Locations API response:', data);
        
        locationSelect.innerHTML = '<option value="">Select a location...</option>';
        
        if (data.success && data.locations && data.locations.length > 0) {
            console.log(`Loading ${data.locations.length} locations into dropdown`);
            data.locations.forEach(location => {
                const option = document.createElement('option');
                option.value = location.id;
                // Format: "Location Name | License Number" (matching checkout format)
                let displayText = location.name;
                if (location.state_license) {
                    displayText += ` | ${location.state_license}`;
                }
                option.textContent = displayText;
                locationSelect.appendChild(option);
            });
            locationSelect.disabled = false;
            console.log('Locations loaded successfully');
        } else {
            console.warn('No locations found for buyer');
            locationSelect.innerHTML = '<option value="">No locations found for this buyer</option>';
            locationSelect.disabled = true;
        }
    } catch (error) {
        console.error('Error loading locations:', error);
        locationSelect.innerHTML = '<option value="">Error loading locations</option>';
        locationSelect.disabled = true;
        alert('Failed to load locations. Please check the browser console for details.');
    }
}

function handleModalOverlayClick(event) {
    // Close modal if clicking directly on the overlay (not on the dialog)
    if (event.target.id === 'createModal') {
        hideCreateModal();
    }
}

function showCreateModal() {
    const modal = document.getElementById('createModal');
    if (!modal) {
        console.error('Modal element not found');
        return;
    }
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    modal.style.display = 'flex'; // Ensure it's visible
    
    // Reset form and dropdowns
    const form = document.getElementById('createForm');
    if (form) {
        form.reset();
    }
    
    const locationSelect = document.getElementById('location_id');
    if (locationSelect) {
        locationSelect.innerHTML = '<option value="">Select a location...</option>';
        locationSelect.disabled = true;
    }
    
    // Load buyers
    console.log('Loading buyers for portal access form...');
    loadBuyers();
}

function hideCreateModal() {
    const modal = document.getElementById('createModal');
    if (modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        modal.style.display = 'none'; // Hide it completely
    }
    
    const form = document.getElementById('createForm');
    if (form) {
        form.reset();
    }
    
    // Reset location dropdown
    const locationSelect = document.getElementById('location_id');
    if (locationSelect) {
        locationSelect.innerHTML = '<option value="">Select a location...</option>';
        locationSelect.disabled = true;
    }
}

async function createAccess(event) {
    event.preventDefault();
    
    const formData = new FormData(event.target);
    const locationId = formData.get('location_id');
    
    if (!locationId) {
        alert('Please select a location');
        return;
    }
    
    const data = {
        buyer_id: formData.get('buyer_id'),
        location_id: locationId,
        expires_at: formData.get('expires_at') || null,
        notes: formData.get('notes') || null
    };
    
    try {
        const response = await fetch('/admin/api/portal-access', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert('Portal access created successfully!');
            location.reload();
        } else {
            alert('Error creating portal access: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error('Error creating access:', error);
        alert('Error creating portal access');
    }
}

async function getPortalUrl(id) {
    try {
        const response = await fetch(`/admin/api/portal-access/${id}/url`);
        const data = await response.json();
        
        if (data.success) {
            // Copy to clipboard
            navigator.clipboard.writeText(data.url).then(() => {
                alert(`Portal URL copied to clipboard!\n\n${data.url}`);
            });
        } else {
            alert('Error getting portal URL');
        }
    } catch (error) {
        console.error('Error getting URL:', error);
        alert('Error getting portal URL');
    }
}

async function toggleActive(id) {
    try {
        const response = await fetch(`/admin/api/portal-access/${id}/toggle`, {
            method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
            location.reload();
        } else {
            alert('Error updating portal access');
        }
    } catch (error) {
        console.error('Error toggling access:', error);
        alert('Error updating portal access');
    }
}

async function regenerateUuid(id) {
    if (!confirm('Are you sure you want to regenerate the UUID? The old link will stop working immediately.')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/api/portal-access/${id}/regenerate`, {
            method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
            navigator.clipboard.writeText(result.url).then(() => {
                alert(`UUID regenerated successfully!\n\nNew URL copied to clipboard:\n${result.url}\n\nOld link is now invalid.`);
            }).catch(() => {
                alert(`UUID regenerated successfully!\n\nNew URL: ${result.url}\n\nOld link is now invalid.`);
            });
            location.reload();
        } else {
            alert('Error regenerating UUID: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error('Error regenerating UUID:', error);
        alert('Error regenerating UUID');
    }
}

async function deleteAccess(id) {
    if (!confirm('Are you sure you want to delete this portal access link?')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/api/portal-access/${id}`, {
            method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert('Portal access deleted successfully!');
            location.reload();
        } else {
            alert('Error deleting portal access');
        }
    } catch (error) {
        console.error('Error deleting access:', error);
        alert('Error deleting portal access');
    }
}
</script>

