<!-- Views/admin/dashboard.ejs -->
<% 
// Determine dashboard type
const showSimpleDashboard = !showFullDashboard && !showSalesDashboard;
%>
<% if (showSimpleDashboard) { %>
<!-- Simple Dashboard for Sales Admin and Sales Reps -->
<style>
.welcome-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 3rem;
}

.welcome-card {
    background: linear-gradient(135deg, var(--card-bg, #ffffff) 0%, var(--bg-color, #f8f9fa) 100%);
    border-radius: 20px;
    padding: 3.5rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    max-width: 600px;
    width: 100%;
    border: 1px solid var(--border-color, rgba(0,0,0,0.05));
    position: relative;
    overflow: hidden;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.welcome-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.welcome-icon {
    font-size: 4.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 4px 6px rgba(102, 126, 234, 0.2));
}

.welcome-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.5rem;
}

.welcome-subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 2rem;
}

.user-email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.75rem;
    background: var(--bg-color, linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 100%));
    border-radius: 12px;
    font-size: 1rem;
    color: var(--text-color);
    margin-top: 1.5rem;
    border: 1px solid var(--border-color, rgba(74, 144, 226, 0.2));
    font-weight: 500;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.user-email i {
    color: var(--primary-color);
}
</style>

<div class="welcome-container">
    <div class="welcome-card">
        <div class="welcome-icon">
            <i class="fas fa-tachometer-alt"></i>
        </div>
        <h1 class="welcome-title">Welcome to Dashboard</h1>
        <p class="welcome-subtitle">You're logged in as <%= isSalesAdmin ? 'Sales Admin' : isSalesRep ? 'Sales Representative' : 'User' %></p>
        <div class="user-email">
            <i class="fas fa-envelope"></i>
            <span><%= userEmail || 'No email' %></span>
        </div>
    </div>
</div>
<% } else if (showSalesDashboard) { %>
<!-- Sales Dashboard for Sales Admin -->
<style>
.sales-dashboard {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.sales-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.sales-stat-card {
    background: var(--card-bg, #fff);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow, 0 4px 12px rgba(0,0,0,0.08));
    border: 1px solid var(--border-color, rgba(0,0,0,0.05));
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    position: relative;
    overflow: hidden;
}

.sales-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow, 0 8px 24px rgba(0,0,0,0.12));
}

.sales-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.sales-stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.sales-stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.25rem;
    transition: color 0.3s ease;
}

.sales-stat-label {
    font-size: 0.875rem;
    color: var(--text-light);
    font-weight: 500;
    transition: color 0.3s ease;
}

.recent-invoices-card {
    background: var(--card-bg, #fff);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow, 0 4px 12px rgba(0,0,0,0.08));
    border: 1px solid var(--border-color, rgba(0,0,0,0.05));
    transition: background-color 0.3s ease;
}

.recent-invoices-card h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s ease;
}

.recent-invoices-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.recent-invoice-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background: var(--bg-color, #f8f9fa);
    border-radius: 8px;
    border: 1px solid var(--border-color, rgba(0,0,0,0.05));
    transition: background-color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
}

.recent-invoice-item:hover {
    background: var(--bg-color, #e9ecef);
    transform: translateX(4px);
}

.recent-invoice-info {
    flex: 1;
}

.recent-invoice-number {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-color);
    margin-bottom: 0.25rem;
    transition: color 0.3s ease;
}

.recent-invoice-meta {
    font-size: 0.85rem;
    color: var(--text-light);
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: color 0.3s ease;
}

.recent-invoice-amount {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-color);
    transition: color 0.3s ease;
}

.invoice-status-list-card {
    background: var(--card-bg, #fff);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow, 0 4px 12px rgba(0,0,0,0.08));
    border: 1px solid var(--border-color, rgba(0,0,0,0.05));
    transition: background-color 0.3s ease;
}

.invoice-status-list-card h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s ease;
}

.status-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.status-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg-color, #f8f9fa);
    border-radius: 8px;
    border-left: 4px solid;
    transition: background-color 0.3s ease;
}

.status-item-draft { border-left-color: #1976d2; }
.status-item-pending_approval { border-left-color: #e65100; }
.status-item-approved { border-left-color: #2e7d32; }
.status-item-fulfillment_accepted { border-left-color: #7b1fa2; }
.status-item-shipped { border-left-color: #283593; }
.status-item-delivered { border-left-color: #1b5e20; }
.status-item-paid { border-left-color: #4caf50; }
.status-item-partially-rejected { border-left-color: #c62828; }
.status-item-fully-rejected { border-left-color: #c62828; }
.status-item-cancelled { border-left-color: #616161; }
.status-item-cancelled-after-ship { border-left-color: #616161; }
.status-item-fulfillment-issue { border-left-color: #e65100; }
.status-item-manifested { border-left-color: #1976d2; }
.status-item-issue-after-shipped { border-left-color: #d32f2f; }

.status-item-name {
    font-weight: 600;
    color: var(--text-color);
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.status-item-count {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-color);
    transition: color 0.3s ease;
}

.sales-charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}
</style>

<div class="sales-dashboard">
    <!-- Sales Statistics Cards -->
    <% if (invoiceStats && invoiceStats.total_invoices !== undefined) { %>
    <div class="sales-stats-grid">
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div class="sales-stat-value"><%= invoiceStats.total_invoices || 0 %></div>
            <div class="sales-stat-label">Total Invoices</div>
        </div>
        
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="sales-stat-value">$<%= parseFloat(invoiceStats.total_revenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
            <div class="sales-stat-label">Total Revenue</div>
        </div>
        
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="sales-stat-value"><%= invoiceStats.approved_count || 0 %></div>
            <div class="sales-stat-label">Approved</div>
        </div>
        
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="sales-stat-value"><%= invoiceStats.pending_count || 0 %></div>
            <div class="sales-stat-label">Pending Approval</div>
        </div>
        
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-shipping-fast"></i>
            </div>
            <div class="sales-stat-value"><%= invoiceStats.shipped_count || 0 %></div>
            <div class="sales-stat-label">Shipped</div>
        </div>
        
        <div class="sales-stat-card">
            <div class="sales-stat-icon">
                <i class="fas fa-check-double"></i>
            </div>
            <div class="sales-stat-value"><%= invoiceStats.delivered_count || 0 %></div>
            <div class="sales-stat-label">Delivered</div>
        </div>
    </div>
    <% } %>
    
    <!-- Recent Invoices and Status List -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem;">
        <!-- Recent Invoices -->
        <div class="recent-invoices-card">
            <h3>
                <i class="fas fa-clock"></i>
                Recent Invoices
            </h3>
            <% if (typeof recentInvoices !== 'undefined' && recentInvoices && recentInvoices.length > 0) { %>
            <div class="recent-invoices-list">
                <% recentInvoices.forEach(invoice => { %>
                <a href="/admin/invoices/<%= invoice.id %>" class="recent-invoice-item">
                    <div class="recent-invoice-info">
                        <div class="recent-invoice-number">#<%= invoice.invoice_number || invoice.id %></div>
                        <div class="recent-invoice-meta">
                            <span><%= invoice.buyer_name || 'Unknown Buyer' %></span>
                            <span>•</span>
                            <span><%= invoice.created_at ? new Date(invoice.created_at).toLocaleDateString() : 'N/A' %></span>
                        </div>
                    </div>
                    <div class="recent-invoice-amount">
                        $<%= parseFloat(invoice.total || 0).toFixed(2) %>
                    </div>
                </a>
                <% }); %>
            </div>
            <% } else { %>
            <div style="text-align: center; padding: 2rem; color: var(--text-light);">
                <i class="fas fa-file-invoice" style="font-size: 2rem; opacity: 0.5; margin-bottom: 1rem; display: block;"></i>
                <p style="margin: 0;">No recent invoices found</p>
                <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem;">Create your first invoice to see it here</p>
            </div>
            <% } %>
        </div>
        
        <!-- Invoice Status List -->
        <% if (invoiceStats && invoiceStats.statusBreakdown && invoiceStats.statusBreakdown.length > 0) { %>
        <div class="invoice-status-list-card">
            <h3>
                <i class="fas fa-chart-pie"></i>
                Invoice Status Breakdown
            </h3>
            <div class="status-list">
                <% invoiceStats.statusBreakdown.forEach(status => { %>
                <div class="status-item status-item-<%= (status.status || '').toLowerCase().replace(/_/g, '-') %>">
                    <span class="status-item-name"><%= (status.status || 'Unknown').replace(/_/g, ' ') %></span>
                    <span class="status-item-count"><%= status.count || 0 %></span>
                </div>
                <% }); %>
            </div>
        </div>
        <% } else { %>
        <div class="invoice-status-list-card">
            <h3>
                <i class="fas fa-chart-pie"></i>
                Invoice Status Breakdown
            </h3>
            <div style="text-align: center; padding: 2rem; color: var(--text-light);">
                <i class="fas fa-chart-pie" style="font-size: 2rem; opacity: 0.5; margin-bottom: 1rem; display: block;"></i>
                <p style="margin: 0;">No invoice data available</p>
            </div>
        </div>
        <% } %>
    </div>
    
    <!-- Sales Charts -->
    <% if (invoiceStats && (invoiceStats.statusBreakdown || invoiceStats.salesOverTime)) { %>
    <div class="sales-charts-grid">
        <!-- Invoice Status Breakdown Chart -->
        <% if (invoiceStats.statusBreakdown) { %>
        <div class="chart-card">
            <div class="chart-header">
                <h3><i class="fas fa-chart-pie"></i> Invoice Status Breakdown</h3>
            </div>
            <div class="chart-wrapper">
                <canvas id="salesStatusChart"></canvas>
            </div>
        </div>
        <% } %>
        
        <!-- Sales Over Time Chart -->
        <% if (invoiceStats.salesOverTime) { %>
        <div class="chart-card">
            <div class="chart-header">
                <h3><i class="fas fa-chart-line"></i> Sales Over Time (Last 30 Days)</h3>
            </div>
            <div class="chart-wrapper">
                <canvas id="salesOverTimeChart"></canvas>
            </div>
        </div>
        <% } %>
        
        <!-- Revenue by Status Chart -->
        <% if (invoiceStats.statusBreakdown) { %>
        <div class="chart-card">
            <div class="chart-header">
                <h3><i class="fas fa-chart-bar"></i> Revenue by Status</h3>
            </div>
            <div class="chart-wrapper">
                <canvas id="revenueByStatusChart"></canvas>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>
</div>

<script>
<% if (invoiceStats) { %>
// Get current theme and chart colors (same as admin dashboard)
function getChartTheme() {
    const isDark = document.body.classList.contains('dark-theme');
    return {
        isDark: isDark,
        textColor: isDark ? '#e4e6eb' : '#6b7280',
        gridColor: isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)',
        tooltipBg: isDark ? 'rgba(30, 30, 30, 0.95)' : 'rgba(0, 0, 0, 0.8)',
        tooltipText: isDark ? '#e4e6eb' : '#ffffff'
    };
}

// Initialize Sales Charts for Sales Admin
document.addEventListener('DOMContentLoaded', function() {
    const theme = getChartTheme();
    const invoiceStatsData = <%- JSON.stringify(invoiceStats) %>;
    
    // Chart 1: Invoice Status Breakdown (Doughnut Chart)
    <% if (invoiceStats.statusBreakdown) { %>
    const statusCtx = document.getElementById('salesStatusChart');
    if (statusCtx && invoiceStatsData.statusBreakdown) {
        const statusBreakdown = invoiceStatsData.statusBreakdown;
        const statusLabels = statusBreakdown.map(item => (item.status || 'Unknown').replace(/_/g, ' '));
        const statusCounts = statusBreakdown.map(item => parseInt(item.count || 0));
        
        // Color mapping for statuses
        const statusColors = {
            'Draft': 'rgba(25, 118, 210, 0.8)',
            'Pending Approval': 'rgba(230, 81, 0, 0.8)',
            'Approved': 'rgba(46, 125, 50, 0.8)',
            'Fulfillment Accepted': 'rgba(123, 31, 162, 0.8)',
            'Shipped': 'rgba(40, 53, 147, 0.8)',
            'Delivered': 'rgba(27, 94, 32, 0.8)',
            'Paid': 'rgba(76, 175, 80, 0.8)',
            'Partially Rejected': 'rgba(198, 40, 40, 0.8)',
            'Fully Rejected': 'rgba(198, 40, 40, 0.8)',
            'Cancelled': 'rgba(97, 97, 97, 0.8)',
            'Cancelled After Ship': 'rgba(97, 97, 97, 0.8)',
            'Fulfillment Issue': 'rgba(230, 81, 0, 0.8)',
            'Manifested': 'rgba(25, 118, 210, 0.8)',
            'Issue After Shipped': 'rgba(211, 47, 47, 0.8)'
        };
        
        const backgroundColors = statusLabels.map(label => {
            return statusColors[label] || 'rgba(156, 163, 175, 0.8)';
        });
        
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusCounts,
                    backgroundColor: backgroundColors,
                    borderColor: backgroundColors.map(c => c.replace('0.8', '1')),
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            usePointStyle: true,
                            color: theme.textColor
                        }
                    },
                    tooltip: {
                        backgroundColor: theme.tooltipBg,
                        titleColor: theme.tooltipText,
                        bodyColor: theme.tooltipText,
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                return `${label}: ${value} (${percentage}%)`;
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    animateScale: true
                }
            }
        });
    }
    <% } %>
    
    // Chart 2: Sales Over Time (Line Chart)
    <% if (invoiceStats.salesOverTime) { %>
    const salesCtx = document.getElementById('salesOverTimeChart');
    if (salesCtx && invoiceStatsData.salesOverTime) {
        const salesData = invoiceStatsData.salesOverTime;
        const labels = salesData.map(item => {
            const date = new Date(item.date);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });
        const invoiceCounts = salesData.map(item => parseInt(item.invoice_count || 0));
        const revenues = salesData.map(item => parseFloat(item.daily_revenue || 0));
        
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Invoice Count',
                        data: invoiceCounts,
                        borderColor: 'rgba(102, 126, 234, 1)',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        yAxisID: 'y',
                        tension: 0.4,
                        fill: true
                    },
                    {
                        label: 'Revenue ($)',
                        data: revenues,
                        borderColor: 'rgba(16, 185, 129, 1)',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        yAxisID: 'y1',
                        tension: 0.4,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: theme.textColor
                        }
                    },
                    tooltip: {
                        backgroundColor: theme.tooltipBg,
                        titleColor: theme.tooltipText,
                        bodyColor: theme.tooltipText,
                        callbacks: {
                            label: function(context) {
                                if (context.dataset.label === 'Revenue ($)') {
                                    return `${context.dataset.label}: $${parseFloat(context.parsed.y).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                                }
                                return `${context.dataset.label}: ${context.parsed.y}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: theme.gridColor
                        },
                        ticks: {
                            color: theme.textColor
                        }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Invoice Count',
                            color: theme.textColor
                        },
                        grid: {
                            color: theme.gridColor
                        },
                        ticks: {
                            color: theme.textColor
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Revenue ($)',
                            color: theme.textColor
                        },
                        grid: {
                            drawOnChartArea: false,
                        },
                        ticks: {
                            color: theme.textColor
                        }
                    }
                },
                animation: {
                    duration: 1500,
                    easing: 'easeOutQuart'
                }
            }
        });
    }
    <% } %>
    
    // Chart 3: Revenue by Status (Bar Chart)
    <% if (invoiceStats.statusBreakdown) { %>
    const revenueCtx = document.getElementById('revenueByStatusChart');
    if (revenueCtx && invoiceStatsData.statusBreakdown) {
        const statusBreakdown = invoiceStatsData.statusBreakdown;
        const statusLabels = statusBreakdown.map(item => (item.status || 'Unknown').replace(/_/g, ' '));
        const revenueData = statusBreakdown.map(item => parseFloat(item.revenue || 0));
        
        // Color mapping for statuses
        const statusColors = {
            'Draft': 'rgba(25, 118, 210, 0.8)',
            'Pending Approval': 'rgba(230, 81, 0, 0.8)',
            'Approved': 'rgba(46, 125, 50, 0.8)',
            'Fulfillment Accepted': 'rgba(123, 31, 162, 0.8)',
            'Shipped': 'rgba(40, 53, 147, 0.8)',
            'Delivered': 'rgba(27, 94, 32, 0.8)',
            'Paid': 'rgba(76, 175, 80, 0.8)',
            'Partially Rejected': 'rgba(198, 40, 40, 0.8)',
            'Fully Rejected': 'rgba(198, 40, 40, 0.8)',
            'Cancelled': 'rgba(97, 97, 97, 0.8)',
            'Cancelled After Ship': 'rgba(97, 97, 97, 0.8)',
            'Fulfillment Issue': 'rgba(230, 81, 0, 0.8)',
            'Manifested': 'rgba(25, 118, 210, 0.8)',
            'Issue After Shipped': 'rgba(211, 47, 47, 0.8)'
        };
        
        const backgroundColors = statusLabels.map(status => statusColors[status] || 'rgba(156, 163, 175, 0.8)');
        
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: statusLabels,
                datasets: [{
                    label: 'Revenue ($)',
                    data: revenueData,
                    backgroundColor: backgroundColors,
                    borderColor: backgroundColors.map(color => color.replace('0.8', '1')),
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: theme.tooltipBg,
                        titleColor: theme.tooltipText,
                        bodyColor: theme.tooltipText,
                        callbacks: {
                            label: function(context) {
                                return `Revenue: $${parseFloat(context.parsed.y).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: theme.gridColor
                        },
                        ticks: {
                            color: theme.textColor
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Revenue ($)',
                            color: theme.textColor
                        },
                        grid: {
                            color: theme.gridColor
                        },
                        ticks: {
                            color: theme.textColor,
                            callback: function(value) {
                                return '$' + parseFloat(value).toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
                            }
                        }
                    }
                },
                animation: {
                    duration: 1500,
                    easing: 'easeOutQuart'
                }
            }
        });
    }
    <% } %>
});
<% } %>
</script>
