<script>
// Chart instances
let statusChart = null;
let servicesChart = null;
let historyChart = null;
let invoiceStatusChart = null;
let salesOverTimeChart = null;
let revenueByStatusChart = null;

// Get current theme and chart colors
function getChartTheme() {
    const isDark = document.body.classList.contains('dark-theme');
    return {
        isDark: isDark,
        textColor: isDark ? '#e4e6eb' : '#6b7280',
        gridColor: isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)',
        tooltipBg: isDark ? 'rgba(30, 30, 30, 0.95)' : 'rgba(0, 0, 0, 0.8)',
        tooltipText: isDark ? '#e4e6eb' : '#ffffff'
    };
}

// Chart.js default configuration - will be updated based on theme
function updateChartDefaults() {
    const theme = getChartTheme();
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.font.size = 12;
    Chart.defaults.color = theme.textColor;
    Chart.defaults.animation.duration = 1500;
    Chart.defaults.animation.easing = 'easeOutQuart';
    Chart.defaults.plugins.tooltip.backgroundColor = theme.tooltipBg;
    Chart.defaults.plugins.tooltip.titleColor = theme.tooltipText;
    Chart.defaults.plugins.tooltip.bodyColor = theme.tooltipText;
    Chart.defaults.plugins.legend.labels.color = theme.textColor;
}

// Initialize chart defaults
updateChartDefaults();

// Watch for theme changes
const themeObserver = new MutationObserver(() => {
    updateChartDefaults();
    // Re-render all charts with new theme
    // Store current data before destroying charts
    let syncData = null;
    if (statusChart || servicesChart || historyChart) {
        // Try to preserve data from existing charts or reload
        syncData = { allSyncStatuses: [], recentSyncs: [] };
    }
    
    // Re-initialize sync charts if they exist
    if (statusChart || servicesChart || historyChart) {
        // Destroy existing charts
        if (statusChart) statusChart.destroy();
        if (servicesChart) servicesChart.destroy();
        if (historyChart) historyChart.destroy();
        // Reload data to re-render with new theme
        loadSyncHealth();
    }
    
    <% if (invoiceStats) { %>
    // Re-initialize invoice charts
    if (invoiceStatusChart || salesOverTimeChart || revenueByStatusChart) {
        if (invoiceStatusChart) invoiceStatusChart.destroy();
        if (salesOverTimeChart) salesOverTimeChart.destroy();
        if (revenueByStatusChart) revenueByStatusChart.destroy();
        initializeInvoiceCharts();
    }
    <% } %>
});

themeObserver.observe(document.body, {
    attributes: true,
    attributeFilter: ['class']
});

async function loadSyncHealth() {
    try {
        // Add cache-busting query parameter to ensure fresh data
        const cacheBuster = new Date().getTime();
        const response = await fetch(`/admin/api/sync-health?t=${cacheBuster}`, {
            cache: 'no-cache',
            headers: {
                'Cache-Control': 'no-cache'
            }
        });
        const data = await response.json();
        
        if (data.success) {
            updateSyncStatus(data);
            updateCharts(data);
        } else {
            showError('Failed to load sync health');
        }
    } catch (error) {
        console.error('Error loading sync health:', error);
        showError('Error loading sync health status');
    }
}

function updateSyncStatus(data) {
    const badge = document.getElementById('syncStatusBadge');
    const container = document.getElementById('syncAlertsContainer');
    
    // Determine overall status
    const criticalAlerts = data.alerts.filter(a => a.level === 'critical');
    const warningAlerts = data.alerts.filter(a => a.level === 'warning');
    
    let statusClass = 'healthy';
    let statusText = 'All Systems Operational';
    let icon = 'fa-check-circle';
    
    if (criticalAlerts.length > 0) {
        statusClass = 'critical';
        statusText = `${criticalAlerts.length} Critical Issue${criticalAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-circle';
    } else if (warningAlerts.length > 0) {
        statusClass = 'warning';
        statusText = `${warningAlerts.length} Warning${warningAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-triangle';
    }
    
    badge.className = `sync-status ${statusClass}`;
    badge.innerHTML = `<i class="fas ${icon}"></i> ${statusText}`;
    
    // Display all sync statuses
    let allSyncsHTML = '';
    if (data.allSyncStatuses && data.allSyncStatuses.length > 0) {
        allSyncsHTML = `
            <div class="sync-status-grid">
                ${data.allSyncStatuses.map(sync => {
                    const timeAgo = sync.lastSyncTime ? getTimeAgo(new Date(sync.lastSyncTime)) : 'Never';
                    const duration = sync.duration ? `${sync.duration}s` : '';
                    const failureInfo = sync.consecutiveFailures > 0 ? `Failed ${sync.consecutiveFailures} time${sync.consecutiveFailures > 1 ? 's' : ''}` : '';
                    
                    return `
                        <div class="sync-status-item ${sync.statusClass}">
                            <div class="sync-status-item-info">
                                <div class="sync-status-item-name">${sync.syncName}</div>
                                <div class="sync-status-item-details">
                                    ${timeAgo !== 'Never' ? `<span><i class="fas fa-clock me-1"></i>${timeAgo}</span>` : '<span>No sync yet</span>'}
                                    ${duration ? ` <span class="ms-2"><i class="fas fa-stopwatch me-1"></i>${duration}</span>` : ''}
                                    ${failureInfo ? ` <span class="ms-2" style="color: #dc2626;"><i class="fas fa-exclamation-triangle me-1"></i>${failureInfo}</span>` : ''}
                                </div>
                            </div>
                            <div class="sync-status-badge ${sync.statusClass}">
                                <i class="fas ${sync.statusIcon}"></i>
                                ${sync.status === 'success' ? 'Success' : sync.status === 'failed' ? 'Failed' : sync.status === 'running' ? 'Running' : 'Unknown'}
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>
        `;
    }

    // Display critical alerts if any (separate from status grid)
    let alertsHTML = '';
    if (data.alerts && data.alerts.length > 0) {
        alertsHTML = `
            <div style="margin-top: 1.5rem;">
                <div style="font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; color: #dc2626;">
                    <i class="fas fa-exclamation-triangle me-2"></i>Active Alerts
                </div>
                <div class="sync-alerts">
                    ${data.alerts.map(alert => `
                        <div class="alert-item ${alert.level}">
                            <div style="font-weight: 600; margin-bottom: 0.5rem;">
                                ${alert.level === 'critical' ? '<i class="fas fa-exclamation-circle me-1"></i>' : '<i class="fas fa-exclamation-triangle me-1"></i>'}
                                ${alert.scriptName}
                            </div>
                            <div style="font-size: 0.9rem; color: #6b7280;">
                                Failed ${alert.count} time${alert.count > 1 ? 's' : ''} consecutively
                            </div>
                            ${alert.lastError ? `<div style="font-size: 0.85rem; color: #9ca3af; margin-top: 0.5rem;">${alert.lastError.substring(0, 100)}${alert.lastError.length > 100 ? '...' : ''}</div>` : ''}
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
    }

    // Display recent sync history
    let historyHTML = '';
    if (data.recentSyncs && data.recentSyncs.length > 0) {
        historyHTML = `
            <div class="sync-history">
                <div class="sync-history-title">
                    <i class="fas fa-history me-2"></i>Last 5 Sync Operations
                </div>
                <div class="sync-history-list">
                    ${data.recentSyncs.map(sync => {
                        const isSuccess = sync.status === 'completed';
                        const statusClass = isSuccess ? 'success' : 'failed';
                        const statusIcon = isSuccess ? 'fa-check-circle' : 'fa-times-circle';
                        const statusText = isSuccess ? 'Success' : 'Failed';
                        const timeAgo = getTimeAgo(new Date(sync.startTime));
                        const duration = sync.duration ? `${sync.duration}s` : 'N/A';
                        
                        return `
                            <div class="sync-history-item ${statusClass}">
                                <div class="sync-history-item-info">
                                    <div class="sync-history-item-name">${sync.syncName}</div>
                                    <div class="sync-history-item-meta">
                                        <span><i class="fas fa-clock me-1"></i>${timeAgo}</span>
                                        <span><i class="fas fa-stopwatch me-1"></i>${duration}</span>
                                        ${sync.error ? `<span style="color: #dc2626;"><i class="fas fa-exclamation-triangle me-1"></i>Error</span>` : ''}
                                    </div>
                                </div>
                                <div class="sync-history-item-status ${statusClass}">
                                    <i class="fas ${statusIcon}"></i>
                                    ${statusText}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    } else {
        historyHTML = '';
    }

    container.innerHTML = allSyncsHTML + alertsHTML + historyHTML;
    
    // Show alerts card if there are alerts
    const alertsCard = document.getElementById('syncAlertsCard');
    if (data.alerts && data.alerts.length > 0) {
        alertsCard.style.display = 'block';
    } else {
        alertsCard.style.display = 'none';
    }
}

function updateCharts(data) {
    const theme = getChartTheme();
    
    // Chart 1: Sync Status Overview (Pie Chart)
    const statusCtx = document.getElementById('syncStatusChart');
    if (!statusCtx) return;
    
    const statusCounts = {
        success: 0,
        failed: 0,
        running: 0,
        unknown: 0
    };
    
    if (data.allSyncStatuses && data.allSyncStatuses.length > 0) {
        data.allSyncStatuses.forEach(sync => {
            const status = sync.status || 'unknown';
            if (statusCounts.hasOwnProperty(status)) {
                statusCounts[status]++;
            } else {
                statusCounts.unknown++;
            }
        });
    }
    
    if (statusChart) {
        statusChart.destroy();
    }
    
    statusChart = new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: ['Success', 'Failed', 'Running', 'Unknown'],
            datasets: [{
                data: [statusCounts.success, statusCounts.failed, statusCounts.running, statusCounts.unknown],
                backgroundColor: [
                    'rgba(16, 185, 129, 0.8)',
                    'rgba(239, 68, 68, 0.8)',
                    'rgba(59, 130, 246, 0.8)',
                    'rgba(156, 163, 175, 0.8)'
                ],
                borderColor: [
                    'rgba(16, 185, 129, 1)',
                    'rgba(239, 68, 68, 1)',
                    'rgba(59, 130, 246, 1)',
                    'rgba(156, 163, 175, 1)'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 15,
                        usePointStyle: true,
                        font: {
                            size: 11,
                            weight: '500'
                        },
                        color: theme.textColor
                    }
                },
                tooltip: {
                    backgroundColor: theme.tooltipBg,
                    titleColor: theme.tooltipText,
                    bodyColor: theme.tooltipText,
                    padding: 12,
                    titleFont: { size: 13, weight: '600' },
                    bodyFont: { size: 12 },
                    cornerRadius: 8,
                    displayColors: true
                }
            },
            animation: {
                animateRotate: true,
                animateScale: true,
                duration: 1500,
                easing: 'easeOutQuart'
            },
            cutout: '60%'
        }
    });
    
    // Chart 2: Sync Services Status (Bar Chart)
    const servicesCtx = document.getElementById('syncServicesChart');
    if (!servicesCtx) return;
    
    const servicesData = [];
    const servicesLabels = [];
    const servicesColors = [];
    
    if (data.allSyncStatuses && data.allSyncStatuses.length > 0) {
        data.allSyncStatuses.slice(0, 10).forEach(sync => {
            servicesLabels.push(sync.syncName || 'Unknown');
            const status = sync.status || 'unknown';
            let color = 'rgba(156, 163, 175, 0.8)';
            if (status === 'success') color = 'rgba(16, 185, 129, 0.8)';
            else if (status === 'failed') color = 'rgba(239, 68, 68, 0.8)';
            else if (status === 'running') color = 'rgba(59, 130, 246, 0.8)';
            servicesColors.push(color);
            servicesData.push(1);
        });
    }
    
    if (servicesChart) {
        servicesChart.destroy();
    }
    
    servicesChart = new Chart(servicesCtx, {
        type: 'bar',
        data: {
            labels: servicesLabels,
            datasets: [{
                label: 'Services',
                data: servicesData,
                backgroundColor: servicesColors,
                borderColor: servicesColors.map(c => c.replace('0.8', '1')),
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: theme.tooltipBg,
                    titleColor: theme.tooltipText,
                    bodyColor: theme.tooltipText,
                    padding: 12,
                    titleFont: { size: 13, weight: '600' },
                    bodyFont: { size: 12 },
                    cornerRadius: 8,
                    displayColors: false
                }
            },
            scales: {
                x: {
                    display: false,
                    grid: {
                        display: false
                    }
                },
                y: {
                    grid: {
                        display: false,
                        color: theme.gridColor
                    },
                    ticks: {
                        font: {
                            size: 11
                        },
                        color: theme.textColor
                    }
                }
            },
            animation: {
                duration: 1500,
                easing: 'easeOutQuart'
            }
        }
    });
    
    // Chart 3: Sync History (Line Chart)
    const historyCtx = document.getElementById('syncHistoryChart');
    if (!historyCtx) return;
    
    const historyData = [];
    const historyLabels = [];
    const successData = [];
    const failedData = [];
    
    // Process recent syncs for last 24 hours
    if (data.recentSyncs && data.recentSyncs.length > 0) {
        const now = new Date();
        const last24Hours = [];
        
        // Group by hour
        for (let i = 23; i >= 0; i--) {
            const hourTime = new Date(now.getTime() - i * 60 * 60 * 1000);
            const hourKey = hourTime.toISOString().slice(0, 13); // YYYY-MM-DDTHH
            last24Hours.push({
                hour: hourKey,
                time: hourTime,
                success: 0,
                failed: 0
            });
        }
        
        data.recentSyncs.forEach(sync => {
            const syncTime = new Date(sync.startTime);
            const hourKey = syncTime.toISOString().slice(0, 13);
            const hourData = last24Hours.find(h => h.hour === hourKey);
            if (hourData) {
                if (sync.status === 'completed') {
                    hourData.success++;
                } else {
                    hourData.failed++;
                }
            }
        });
        
        last24Hours.forEach(hour => {
            historyLabels.push(hour.time.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }));
            successData.push(hour.success);
            failedData.push(hour.failed);
        });
    }
    
    if (historyChart) {
        historyChart.destroy();
    }
    
    historyChart = new Chart(historyCtx, {
        type: 'line',
        data: {
            labels: historyLabels.length > 0 ? historyLabels : ['No Data'],
            datasets: [
                {
                    label: 'Successful Syncs',
                    data: successData.length > 0 ? successData : [0],
                    borderColor: 'rgba(16, 185, 129, 1)',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: 'rgba(16, 185, 129, 1)',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                },
                {
                    label: 'Failed Syncs',
                    data: failedData.length > 0 ? failedData : [0],
                    borderColor: 'rgba(239, 68, 68, 1)',
                    backgroundColor: 'rgba(239, 68, 68, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: 'rgba(239, 68, 68, 1)',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        padding: 15,
                        usePointStyle: true,
                        font: {
                            size: 11,
                            weight: '500'
                        },
                        color: theme.textColor
                    }
                },
                tooltip: {
                    backgroundColor: theme.tooltipBg,
                    titleColor: theme.tooltipText,
                    bodyColor: theme.tooltipText,
                    padding: 12,
                    titleFont: { size: 13, weight: '600' },
                    bodyFont: { size: 12 },
                    cornerRadius: 8,
                    displayColors: true
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false,
                        color: theme.gridColor
                    },
                    ticks: {
                        font: {
                            size: 10
                        },
                        maxRotation: 45,
                        minRotation: 45,
                        color: theme.textColor
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1,
                        font: {
                            size: 11
                        },
                        color: theme.textColor
                    },
                    grid: {
                        color: theme.gridColor
                    }
                }
            },
            animation: {
                duration: 1500,
                easing: 'easeOutQuart'
            }
        }
    });
}

function showError(message) {
    document.getElementById('syncStatusBadge').className = 'sync-status critical';
    document.getElementById('syncStatusBadge').innerHTML = `<i class="fas fa-times-circle"></i> ${message}`;
}

function getTimeAgo(date) {
    const seconds = Math.floor((new Date() - date) / 1000);
    
    if (seconds < 60) {
        return `${seconds} second${seconds !== 1 ? 's' : ''} ago`;
    }
    
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) {
        return `${minutes} minute${minutes !== 1 ? 's' : ''} ago`;
    }
    
    const hours = Math.floor(minutes / 60);
    if (hours < 24) {
        return `${hours} hour${hours !== 1 ? 's' : ''} ago`;
    }
    
    const days = Math.floor(hours / 24);
    return `${days} day${days !== 1 ? 's' : ''} ago`;
}

