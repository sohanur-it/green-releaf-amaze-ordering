<!-- Views/admin/dashboard.ejs -->
<style>
.sync-health-card {
    grid-column: 1 / -1;
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}
.sync-health-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}
.sync-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
}
.sync-status.healthy { background: #d1fae5; color: #065f46; }
.sync-status.warning { background: #fef3c7; color: #92400e; }
.sync-status.critical { background: #fee2e2; color: #991b1b; }
.sync-alerts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
}
.alert-item {
    background: white;
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid;
}
.alert-item.warning { border-color: #f59e0b; }
.alert-item.critical { border-color: #ef4444; }
.sync-history {
    margin-top: 1.5rem;
}
.sync-history-title {
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #374151;
}
.sync-history-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}
.sync-history-item {
    background: white;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-left: 4px solid;
    transition: transform 0.2s, box-shadow 0.2s;
}
.sync-history-item:hover {
    transform: translateX(4px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.sync-history-item.success {
    border-left-color: #10b981;
    background: #f0fdf4;
}
.sync-history-item.failed {
    border-left-color: #ef4444;
    background: #fef2f2;
}
.sync-history-item-info {
    flex: 1;
}
.sync-history-item-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111827;
    margin-bottom: 0.25rem;
}
.sync-history-item-meta {
    font-size: 0.85rem;
    color: #6b7280;
    display: flex;
    gap: 1rem;
    align-items: center;
}
.sync-history-item-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
}
.sync-history-item-status.success {
    background: #d1fae5;
    color: #065f46;
}
.sync-history-item-status.failed {
    background: #fee2e2;
    color: #991b1b;
}
.sync-status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
}
.sync-status-item {
    background: white;
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.sync-status-item.success {
    border-left-color: #10b981;
    background: #f0fdf4;
}
.sync-status-item.failed {
    border-left-color: #ef4444;
    background: #fef2f2;
}
.sync-status-item.running {
    border-left-color: #3b82f6;
    background: #eff6ff;
}
.sync-status-item.unknown {
    border-left-color: #9ca3af;
    background: #f9fafb;
}
.sync-status-item-info {
    flex: 1;
}
.sync-status-item-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111827;
    margin-bottom: 0.25rem;
}
.sync-status-item-details {
    font-size: 0.85rem;
    color: #6b7280;
}
.sync-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
}
.sync-status-badge.success {
    background: #d1fae5;
    color: #065f46;
}
.sync-status-badge.failed {
    background: #fee2e2;
    color: #991b1b;
}
.sync-status-badge.running {
    background: #dbeafe;
    color: #1e40af;
}
.sync-status-badge.unknown {
    background: #f3f4f6;
    color: #6b7280;
}
</style>

