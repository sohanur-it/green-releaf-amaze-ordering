<!-- Views/admin/dashboard.ejs -->
<style>
.sync-health-card {
    grid-column: 1 / -1;
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}
.sync-health-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}
.sync-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.9rem;
}
.sync-status.healthy { background: #d1fae5; color: #065f46; }
.sync-status.warning { background: #fef3c7; color: #92400e; }
.sync-status.critical { background: #fee2e2; color: #991b1b; }
.sync-alerts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
}
.alert-item {
    background: white;
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid;
}
.alert-item.warning { border-color: #f59e0b; }
.alert-item.critical { border-color: #ef4444; }
</style>

<div class="sync-health-card">
    <div class="sync-health-header">
        <h3 style="margin: 0;"><i class="fas fa-heartbeat me-2"></i>Sync Health Status</h3>
        <div id="syncStatusBadge" class="sync-status healthy">
            <i class="fas fa-circle-notch fa-spin"></i> Loading...
        </div>
    </div>
    <div id="syncAlertsContainer"></div>
</div>

<div class="dashboard-grid">
    <a href="/admin/crm" class="card-link">
        <div class="card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="card-content">
                <h3>CRM</h3>
                <p>Manage Buyers, Contacts, and Deals</p>
            </div>
        </div>
    </a>
    
    <a href="/admin/users" class="card-link">
        <div class="card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="card-content">
                <h3>User Management</h3>
                <p>Manage Users, Roles, and Permissions</p>
            </div>
        </div>
    </a>
    
    <a href="/admin/audit-logs" class="card-link">
        <div class="card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14,2 14,8 20,8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10,9 9,9 8,9"></polyline></svg>
            </div>
            <div class="card-content">
                <h3>Audit Logs</h3>
                <p>View System Activity and User Actions</p>
            </div>
        </div>
    </a>
    
    <a href="/api-docs" class="card-link" target="_blank">
        <div class="card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14,2 14,8 20,8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10,9 9,9 8,9"></polyline></svg>
            </div>
            <div class="card-content">
                <h3>API Documentation</h3>
                <p>View API Endpoints and Test Sync Operations</p>
            </div>
        </div>
    </a>
</div>

<script>
async function loadSyncHealth() {
    try {
        const response = await fetch('/admin/api/sync-health');
        const data = await response.json();
        
        if (data.success) {
            updateSyncStatus(data);
        } else {
            showError('Failed to load sync health');
        }
    } catch (error) {
        console.error('Error loading sync health:', error);
        showError('Error loading sync health status');
    }
}

function updateSyncStatus(data) {
    const badge = document.getElementById('syncStatusBadge');
    const container = document.getElementById('syncAlertsContainer');
    
    // Determine overall status
    const criticalAlerts = data.alerts.filter(a => a.level === 'critical');
    const warningAlerts = data.alerts.filter(a => a.level === 'warning');
    
    let statusClass = 'healthy';
    let statusText = 'All Systems Operational';
    let icon = 'fa-check-circle';
    
    if (criticalAlerts.length > 0) {
        statusClass = 'critical';
        statusText = `${criticalAlerts.length} Critical Issue${criticalAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-circle';
    } else if (warningAlerts.length > 0) {
        statusClass = 'warning';
        statusText = `${warningAlerts.length} Warning${warningAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-triangle';
    }
    
    badge.className = `sync-status ${statusClass}`;
    badge.innerHTML = `<i class="fas ${icon}"></i> ${statusText}`;
    
    // Display alerts if any
    if (data.alerts.length > 0) {
        container.innerHTML = `
            <div class="sync-alerts">
                ${data.alerts.map(alert => `
                    <div class="alert-item ${alert.level}">
                        <div style="font-weight: 600; margin-bottom: 0.5rem;">
                            ${alert.level === 'critical' ? '<i class="fas fa-exclamation-circle me-1"></i>' : '<i class="fas fa-exclamation-triangle me-1"></i>'}
                            ${alert.scriptName}
                        </div>
                        <div style="font-size: 0.9rem; color: #6b7280;">
                            Failed ${alert.count} time${alert.count > 1 ? 's' : ''} consecutively
                        </div>
                        ${alert.lastError ? `<div style="font-size: 0.85rem; color: #9ca3af; margin-top: 0.5rem;">${alert.lastError.substring(0, 100)}${alert.lastError.length > 100 ? '...' : ''}</div>` : ''}
                    </div>
                `).join('')}
            </div>
        `;
    } else {
        container.innerHTML = '<div style="text-align: center; color: #6b7280; padding: 1rem;"><i class="fas fa-check-circle me-2"></i>No issues detected</div>';
    }
}

function showError(message) {
    document.getElementById('syncStatusBadge').className = 'sync-status critical';
    document.getElementById('syncStatusBadge').innerHTML = `<i class="fas fa-times-circle"></i> ${message}`;
}

// Load on page load and refresh every 60 seconds
loadSyncHealth();
setInterval(loadSyncHealth, 60000);
</script>