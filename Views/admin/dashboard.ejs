</div>

<script>
async function loadSyncHealth() {
    try {
        const response = await fetch('/admin/api/sync-health');
        const data = await response.json();
        
        if (data.success) {
            updateSyncStatus(data);
        } else {
            showError('Failed to load sync health');
        }
    } catch (error) {
        console.error('Error loading sync health:', error);
        showError('Error loading sync health status');
    }
}

function updateSyncStatus(data) {
    const badge = document.getElementById('syncStatusBadge');
    const container = document.getElementById('syncAlertsContainer');
    
    // Determine overall status
    const criticalAlerts = data.alerts.filter(a => a.level === 'critical');
    const warningAlerts = data.alerts.filter(a => a.level === 'warning');
    
    let statusClass = 'healthy';
    let statusText = 'All Systems Operational';
    let icon = 'fa-check-circle';
    
    if (criticalAlerts.length > 0) {
        statusClass = 'critical';
        statusText = `${criticalAlerts.length} Critical Issue${criticalAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-circle';
    } else if (warningAlerts.length > 0) {
        statusClass = 'warning';
        statusText = `${warningAlerts.length} Warning${warningAlerts.length > 1 ? 's' : ''}`;
        icon = 'fa-exclamation-triangle';
    }
    
    badge.className = `sync-status ${statusClass}`;
    badge.innerHTML = `<i class="fas ${icon}"></i> ${statusText}`;
    
    // Display all sync statuses
    let allSyncsHTML = '';
    if (data.allSyncStatuses && data.allSyncStatuses.length > 0) {
        allSyncsHTML = `
            <div class="sync-status-grid">
                ${data.allSyncStatuses.map(sync => {
                    const timeAgo = sync.lastSyncTime ? getTimeAgo(new Date(sync.lastSyncTime)) : 'Never';
                    const duration = sync.duration ? `${sync.duration}s` : '';
                    const failureInfo = sync.consecutiveFailures > 0 ? `Failed ${sync.consecutiveFailures} time${sync.consecutiveFailures > 1 ? 's' : ''}` : '';
                    
                    return `
                        <div class="sync-status-item ${sync.statusClass}">
                            <div class="sync-status-item-info">
                                <div class="sync-status-item-name">${sync.syncName}</div>
                                <div class="sync-status-item-details">
                                    ${timeAgo !== 'Never' ? `<span><i class="fas fa-clock me-1"></i>${timeAgo}</span>` : '<span>No sync yet</span>'}
                                    ${duration ? ` <span class="ms-2"><i class="fas fa-stopwatch me-1"></i>${duration}</span>` : ''}
                                    ${failureInfo ? ` <span class="ms-2" style="color: #dc2626;"><i class="fas fa-exclamation-triangle me-1"></i>${failureInfo}</span>` : ''}
                                </div>
                            </div>
                            <div class="sync-status-badge ${sync.statusClass}">
                                <i class="fas ${sync.statusIcon}"></i>
                                ${sync.status === 'success' ? 'Success' : sync.status === 'failed' ? 'Failed' : sync.status === 'running' ? 'Running' : 'Unknown'}
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>
        `;
    }

    // Display critical alerts if any (separate from status grid)
    let alertsHTML = '';
    if (data.alerts && data.alerts.length > 0) {
        alertsHTML = `
            <div style="margin-top: 1.5rem;">
                <div style="font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; color: #dc2626;">
                    <i class="fas fa-exclamation-triangle me-2"></i>Active Alerts
                </div>
                <div class="sync-alerts">
                    ${data.alerts.map(alert => `
                        <div class="alert-item ${alert.level}">
                            <div style="font-weight: 600; margin-bottom: 0.5rem;">
                                ${alert.level === 'critical' ? '<i class="fas fa-exclamation-circle me-1"></i>' : '<i class="fas fa-exclamation-triangle me-1"></i>'}
                                ${alert.scriptName}
                            </div>
                            <div style="font-size: 0.9rem; color: #6b7280;">
                                Failed ${alert.count} time${alert.count > 1 ? 's' : ''} consecutively
                            </div>
                            ${alert.lastError ? `<div style="font-size: 0.85rem; color: #9ca3af; margin-top: 0.5rem;">${alert.lastError.substring(0, 100)}${alert.lastError.length > 100 ? '...' : ''}</div>` : ''}
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
    }

    // Display recent sync history
    let historyHTML = '';
    if (data.recentSyncs && data.recentSyncs.length > 0) {
        historyHTML = `
            <div class="sync-history">
                <div class="sync-history-title">
                    <i class="fas fa-history me-2"></i>Last 5 Sync Operations
                </div>
                <div class="sync-history-list">
                    ${data.recentSyncs.map(sync => {
                        const isSuccess = sync.status === 'completed';
                        const statusClass = isSuccess ? 'success' : 'failed';
                        const statusIcon = isSuccess ? 'fa-check-circle' : 'fa-times-circle';
                        const statusText = isSuccess ? 'Success' : 'Failed';
                        const timeAgo = getTimeAgo(new Date(sync.startTime));
                        const duration = sync.duration ? `${sync.duration}s` : 'N/A';
                        
                        return `
                            <div class="sync-history-item ${statusClass}">
                                <div class="sync-history-item-info">
                                    <div class="sync-history-item-name">${sync.syncName}</div>
                                    <div class="sync-history-item-meta">
                                        <span><i class="fas fa-clock me-1"></i>${timeAgo}</span>
                                        <span><i class="fas fa-stopwatch me-1"></i>${duration}</span>
                                        ${sync.error ? `<span style="color: #dc2626;"><i class="fas fa-exclamation-triangle me-1"></i>Error</span>` : ''}
                                    </div>
                                </div>
                                <div class="sync-history-item-status ${statusClass}">
                                    <i class="fas ${statusIcon}"></i>
                                    ${statusText}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
    } else {
        historyHTML = '';
    }

    container.innerHTML = allSyncsHTML + alertsHTML + historyHTML;
}

function showError(message) {
    document.getElementById('syncStatusBadge').className = 'sync-status critical';
    document.getElementById('syncStatusBadge').innerHTML = `<i class="fas fa-times-circle"></i> ${message}`;
}

function getTimeAgo(date) {
    const seconds = Math.floor((new Date() - date) / 1000);
    
    if (seconds < 60) {
        return `${seconds} second${seconds !== 1 ? 's' : ''} ago`;
    }
    
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) {
        return `${minutes} minute${minutes !== 1 ? 's' : ''} ago`;
    }
    
    const hours = Math.floor(minutes / 60);
    if (hours < 24) {
        return `${hours} hour${hours !== 1 ? 's' : ''} ago`;
    }
    
    const days = Math.floor(hours / 24);
    return `${days} day${days !== 1 ? 's' : ''} ago`;
}

// Load on page load and refresh every 60 seconds
loadSyncHealth();
setInterval(loadSyncHealth, 60000);
</script>