<!-- Views/admin/crm/buyer-profile.ejs -->

<div class="profile-header">
    <div class="profile-title">
        <!-- A back button to return to the main CRM list -->
        <a href="/admin/crm" class="back-link" title="Back to CRM list">&larr;</a>
        <h2><%= buyer.details.name %></h2>
        <span class="buyer-stage" style="background-color: <%= buyer.details.stage_color || '#ccc' %>;">
            <%= buyer.details.stage_name %>
        </span>
    </div>
    <div class="profile-actions">
        <a href="/admin/crm/buyers/<%= buyer.details.entry_id %>/edit" class="btn">Edit Buyer</a>
    </div>
</div>

<div class="profile-grid">
    <!-- Main content column -->
    <div class="profile-main">

        <!-- Contacts Card -->
        <div class="info-card">
            <div class="card-header">
                <h3>Contacts</h3>
                <button class="btn btn-secondary btn-sm" id="addContactBtn"
                        data-modal-target="#contactModal"
                        data-buyer-id="<%= buyer.details.entry_id %>">
                    Add Contact
                </button>
            </div>
            <div class="card-body">
                <table class="info-table">
                    <thead>
                    <tr>
                        <th style="width: 25%;">Name</th>
                        <th style="width: 25%;">Title</th>
                        <th style="width: 25%;">Email</th>
                        <th style="width: 20%;">Phone</th>
                        <th style="width: 5%;"></th> <!-- Empty header for actions -->
                    </tr>
                    </thead>
                    <tbody id="contacts-table-body">
                    <% if (buyer.contacts.length > 0) { %>
                        <% buyer.contacts.forEach(contact => { %>
                            <!-- Add a data-contact-id to the row for easy targeting -->
                            <tr data-contact-id="<%= contact.entry_id %>">
                                <td><%= contact.name %></td>
                                <td><%= contact.title || 'N/A' %></td>
                                <td><%= contact.email || 'N/A' %></td>
                                <td><%= contact.primary_phone || 'N/A' %></td>
                                <td class="table-actions">
                                    <!-- Edit Button -->
                                    <button class="action-btn" data-action="edit"
                                            data-contact-id="<%= contact.entry_id %>"
                                            data-contact-name="<%= contact.name %>"
                                            data-contact-title="<%= contact.title || '' %>"
                                            data-contact-email="<%= contact.email || '' %>"
                                            data-contact-phone="<%= contact.primary_phone || '' %>">
                                        Edit
                                    </button>
                                    <!-- Delete Button -->
                                    <button class="action-btn" data-action="delete"
                                            data-contact-id="<%= contact.entry_id %>"
                                            data-contact-name="<%= contact.name %>">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr id="empty-contacts-message">
                            <td colspan="5" class="empty-state">No contacts found for this buyer.</td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Locations Card -->
        <div class="info-card">
            <div class="card-header">
                <h3>Locations</h3>
                <button class="btn btn-secondary btn-sm" id="addLocationBtn" data-buyer-id="<%= buyer.details.entry_id %>">
                    Add Location
                </button>
            </div>
            <div class="card-body">
                <table class="info-table">
                    <thead>
                    <tr>
                        <th style="width: 25%;">Name</th>
                        <th style="width: 45%;">Address</th>
                        <th style="width: 25%;">License</th>
                        <th style="width: 5%;"></th> <!-- Actions -->
                    </tr>
                    </thead>
                    <tbody id="locations-table-body">
                    <% if (buyer.locations.length > 0) { %>
                        <% buyer.locations.forEach(location => { %>
                            <tr data-location-id="<%= location.entry_id %>">
                                <td><%= location.name %></td>
                                <td><%= `${location.line_one}${location.line_two ? ', ' + location.line_two : ''}, ${location.city}, ${location.state} ${location.zip}` %></td>
                                <td><%= location.state_license || 'N/A' %></td>
                                <td class="table-actions">
                                    <button class="action-btn" data-action="edit-location"
                                            data-location-id="<%= location.entry_id %>"
                                            data-location-name="<%= location.name %>"
                                            data-location-line_one="<%= location.line_one %>"
                                            data-location-line_two="<%= location.line_two || '' %>"
                                            data-location-city="<%= location.city %>"
                                            data-location-state="<%= location.state %>"
                                            data-location-zip="<%= location.zip %>"
                                            data-location-state_license="<%= location.state_license || '' %>">
                                        Edit
                                    </button>
                                    <button class="action-btn" data-action="delete-location"
                                            data-location-id="<%= location.entry_id %>"
                                            data-location-name="<%= location.name %>">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr id="empty-locations-message">
                            <td colspan="4" class="empty-state">No locations found for this buyer.</td>
                        </tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Notes Card -->
        <div class="info-card">
            <div class="card-header">
                <h3>Notes</h3>
                <button class="btn btn-secondary btn-sm">Add Note</button>
            </div>
            <div class="card-body">
                <% if (buyer.notes.length > 0) { %>
                    <ul class="notes-list">
                        <% buyer.notes.forEach(note => { %>
                            <li class="note-item">
                                <div class="note-header">
                                    <strong><%= note.title || 'Note' %></strong>
                                    <span class="note-date"><%= new Date(note.created_at).toLocaleString() %></span>
                                </div>
                                <p class="note-text"><%= note.text %></p>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="empty-state">No notes found for this buyer.</p>
                <% } %>
            </div>
        </div>

    </div>

    <!-- Sidebar / Details column -->
    <div class="profile-sidebar">
        <div class="info-card">
            <div class="card-header">
                <h3>Details</h3>
            </div>
            <div class="card-body">
                <ul class="details-list">
                    <li><strong>Buyer Type:</strong> <span><%= buyer.details.buyer_type || 'N/A' %></span></li>
                    <li><strong>Website:</strong> <span><a href="<%= buyer.details.website_url %>" target="_blank"><%= buyer.details.website_url %></a></span></li>
                    <li><strong>Deal Flow:</strong> <span><%= buyer.details.deal_flow_name || 'N/A' %></span></li>
                    <li><strong>Source:</strong> <span><%= buyer.details.source %></span></li>
                </ul>
            </div>
        </div>
        <div class="info-card">
            <div class="card-header">
                <h3>Tags</h3>
            </div>
            <div class="card-body">
                <% if(buyer.tags.length > 0) { %>
                    <div class="tags-container">
                        <% buyer.tags.forEach(tag => { %>
                            <span class="tag-pill" style="background-color: <%= tag.background_color || '#e1e4e8' %>; color: <%= tag.color || '#000' %>;">
                                <%= tag.name %>
                            </span>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="empty-state">No tags.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Include the contact modal partial -->
<%- include('../../partials/contact-modal') %>

<!-- Include the location modal partial -->
<%- include('../../partials/location-modal') %>

<!-- Include the profile page's specific javascript -->
<script src="/public/js/admin/buyer-profile.js"></script>