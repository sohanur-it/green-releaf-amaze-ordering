<!-- Modern Product Details Page -->
<style>
body {
    overflow-x: hidden;
}

.stats-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.stats-card h3 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
}

.stats-card p {
    margin: 0;
    opacity: 0.9;
}

.dashboard-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    margin-bottom: 1.5rem;
    max-width: 100%;
    overflow-x: hidden;
}

.product-info-wrapper {
    word-wrap: break-word;
    overflow-wrap: break-word;
    width: 100%;
    max-width: 100%;
}

.description-text {
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    line-height: 1.6;
    color: #333;
}

.description-text p {
    margin-bottom: 0.5rem;
}

.description-text strong {
    font-weight: 600;
}

.description-text span {
    display: inline;
}

.container-fluid {
    max-width: 100%;
    overflow-x: hidden;
}

.modern-table {
    margin: 0;
}

.modern-table thead {
    background: #f8f9fa;
}

.modern-table th {
    font-weight: 600;
    color: #4b5563;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 1rem;
    border: none;
}

.modern-table td {
    padding: 1rem;
    vertical-align: middle;
    border-bottom: 1px solid #f3f4f6;
}

.modern-table tbody tr:hover {
    background: #f9fafb;
}

.back-link {
    font-size: 1.5rem;
    color: #667eea;
    text-decoration: none;
    padding: 0.5rem;
    margin-right: 0.5rem;
}

.back-link:hover {
    color: #764ba2;
}

.empty-state-small {
    text-align: center;
    padding: 2rem;
    color: #9ca3af;
}

/* Dark Theme Support */
.dark-theme .container-fluid {
    background-color: var(--bg-color);
    color: var(--text-color);
}

.dark-theme .dashboard-card {
    background: var(--card-bg) !important;
    border: 1px solid var(--border-color);
    color: var(--text-color) !important;
}

.dark-theme .dashboard-card h5,
.dark-theme .dashboard-card h3,
.dark-theme .dashboard-card h2 {
    color: var(--text-color) !important;
}

.dark-theme .dashboard-card label,
.dark-theme .dashboard-card .text-muted {
    color: var(--text-light) !important;
}

.dark-theme .dashboard-card .fw-bold {
    color: var(--text-color) !important;
}

.dark-theme .modern-table thead {
    background: #2d3748 !important;
}

.dark-theme .modern-table th {
    color: var(--text-color) !important;
    border-bottom-color: var(--border-color);
}

.dark-theme .modern-table td {
    color: var(--text-color) !important;
    border-bottom-color: var(--border-color);
}

.dark-theme .modern-table tbody tr {
    background: var(--card-bg);
}

.dark-theme .modern-table tbody tr:hover {
    background: #2d3748 !important;
}

.dark-theme .description-text {
    color: var(--text-color) !important;
}

.dark-theme .description-text p {
    color: var(--text-color);
}

.dark-theme .empty-state-small {
    color: var(--text-light);
}

.dark-theme .back-link {
    color: #4a90e2;
}

.dark-theme .back-link:hover {
    color: #6ba3e6;
}

.dark-theme h2 {
    color: var(--text-color) !important;
}

.dark-theme .badge {
    border: 1px solid var(--border-color);
}
</style>

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a href="/admin/products" class="back-link">&larr; Back</a>
            <div>
                <h2 class="mb-0">
                    <%= product.name %>
                    <% if (product.is_archived) { %>
                        <span class="badge bg-warning text-dark ms-2">
                            <i class="fas fa-archive"></i> ARCHIVED
                        </span>
                    <% } %>
                </h2>
                <% if (product.brand_name) { %>
                    <span class="badge bg-secondary mt-2"><%= product.brand_name %></span>
                <% } %>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/products/<%= product.entry_id %>/link-items" class="btn btn-primary">
                <i class="fas fa-link me-1"></i> Manage Linked Items
            </a>
            <% if (product.is_archived) { %>
                <button class="btn btn-success" onclick="toggleArchiveProduct(false)">
                    <i class="fas fa-box-open me-1"></i> Unarchive
                </button>
            <% } else { %>
                <button class="btn btn-warning text-dark" onclick="toggleArchiveProduct(true)">
                    <i class="fas fa-archive me-1"></i> Archive Product
                </button>
            <% } %>
        </div>
    </div>

    <% 
    // Calculate stats
    const linkedCount = (product.metrc_linked_items || []).length;
    const totalBatches = batches.length;
    const sellableBatches = batches.filter(b => b.status === 'Sellable').length;
    const availableUnits = batches.filter(b => b.status === 'Sellable').reduce((sum, b) => sum + (b.quantity - b.allocated_quantity), 0);
    %>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <p>Linked METRC Items</p>
                <h3><%= linkedCount %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <p>Total Batches</p>
                <h3><%= totalBatches %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <p>Sellable Batches</p>
                <h3><%= sellableBatches %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                <p>Available Units</p>
                <h3><%= Math.round(availableUnits) %></h3>
            </div>
        </div>
    </div>

    <!-- Product Information and Linked Items -->
    <div class="row mb-4">
        <div class="col-md-8 product-info-wrapper">
            <div class="dashboard-card">
                <h5 class="mb-4"><i class="fas fa-info-circle me-2"></i>Product Information</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Category</label>
                        <div class="fw-bold"><%= product.category_name || 'Not specified' %></div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Default Price</label>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="fw-bold">
                                <% if (product.default_price) { %>
                                    $<%= parseFloat(product.default_price).toFixed(2) %>
                                <% } else { %>
                                    <span class="text-muted">Not set</span>
                                <% } %>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" onclick="showEditPriceModal()">
                                <i class="fas fa-edit"></i> Edit Price
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Product Type</label>
                        <div class="fw-bold"><%= product.product_type_name || 'Not specified' %></div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Cultivar/Strain</label>
                        <div class="fw-bold"><%= product.cultivar_name || 'Not specified' %></div>
                    </div>
                    <% if (product.lineage) { %>
                        <div class="col-12 mb-3">
                            <label class="text-muted small">Lineage</label>
                            <div class="fw-bold"><%- product.lineage %></div>
                        </div>
                    <% } %>
                    <% if (product.description) { %>
                        <div class="col-12 mb-3">
                            <label class="text-muted small">Description</label>
                            <div class="description-text"><%- product.description %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="dashboard-card">
                <h5 class="mb-4"><i class="fas fa-link me-2"></i>Linked METRC Items (<%= linkedCount %>)</h5>
                <% if (linkedCount === 0) { %>
                    <div class="empty-state-small">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <p>No METRC items linked yet</p>
                        <a href="/admin/products/<%= product.entry_id %>/link-items" class="btn btn-sm btn-primary">
                            <i class="fas fa-link me-1"></i> Link Items
                        </a>
                    </div>
                <% } else { %>
                    <ul class="list-unstyled">
                        <% (product.metrc_linked_items || []).forEach(item => { %>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <small><%= item %></small>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Batches Table -->
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Batches (<%= totalBatches %>)</h5>
            <div class="d-flex gap-2 align-items-center">
                <% if (linkedCount > 0) { %>
                    <button id="refreshBatchesBtn" class="btn btn-bg btn-outline-primary" title="Refresh batches from METRC">
                        <i class="fas fa-sync-alt me-1"></i> Refresh from METRC
                    </button>
                <% } %>
                <input type="text" id="searchBatches" class="form-control" style="max-width: 300px;" placeholder="Search batches...">
            </div>
        </div>

        <% if (totalBatches === 0) { %>
            <div class="empty-state-small">
                <i class="fas fa-box-open fa-4x mb-3"></i>
                <p>No batches found for this product</p>
                <small class="text-muted">Batches will appear here after running batch sync</small>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover modern-table">
                    <thead>
                        <tr>
                            <th>Batch ID</th>
                            <th>Batch Name</th>
                            <th>Status</th>
                            <th>Quantity</th>
                            <th>Allocated</th>
                            <th>Available</th>
                            <th>Partials</th>
                            <th>THC %</th>
                            <th>Production Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="batchesTableBody">
                        <% batches.forEach(batch => { %>
                            <tr>
                                <td><strong>#<%= batch.id %></strong></td>
                                <td><%= batch.batch_name %></td>
                                <td>
                                    <% 
                                    let statusClass = 'secondary';
                                    if (batch.status === 'Sellable') statusClass = 'success';
                                    else if (batch.status === 'On Deck') statusClass = 'warning';
                                    else if (batch.status === 'On Hold') statusClass = 'secondary';
                                    %>
                                    <span class="badge bg-<%= statusClass %>"><%= batch.status %></span>
                                </td>
                                <td><strong><%= batch.quantity %></strong></td>
                                <td><%= batch.allocated_quantity %></td>
                                <td>
                                    <strong class="text-success"><%= batch.quantity - batch.allocated_quantity %></strong>
                                </td>
                                <td>
                                    <% 
                                        const totalPartialCount = batch.partial_package_count || 0;
                                        const partialList = (batch.partial_package_details && batch.partial_package_details.partial_packages) || [];
                                        const partialTooltip = partialList.length
                                            ? partialList.map(p => `${p.label}${p.quantity ? ' (Qty: ' + p.quantity + ')' : ''}`).join(', ')
                                            : '';
                                    %>
                                    <% if (totalPartialCount > 0) { %>
                                        <span class="badge bg-warning text-dark" title="<%= partialTooltip %>">
                                            Partial packages available
                                        </span>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (batch.thc_percentage) { %>
                                        <%= parseFloat(batch.thc_percentage).toFixed(2) %>%
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (batch.production_date) { %>
                                        <small><%= new Date(batch.production_date).toLocaleDateString() %></small>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="openBatchManagement(<%= batch.id %>, '<%= batch.batch_name %>', '<%= batch.status %>', <%= batch.thc_percentage || 'null' %>, <%= batch.thc_override || 'null' %>, <%= batch.override_price || 'null' %>)">
                                        <i class="fas fa-cog"></i> Manage
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Batch Management Modal -->
<div id="batchManagementModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 700px;">
        <div class="modal-header">
            <h3>Manage Batch: <span id="modalBatchName"></span></h3>
            <button class="modal-close" onclick="closeBatchManagement()">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="modalBatchId">
            
            <!-- Status Management -->
            <div class="mb-4">
                <h6 style="color: #667eea; margin-bottom: 1rem;"><i class="fas fa-info-circle me-2"></i>Batch Status</h6>
                <div class="form-group">
                    <label for="batchStatus">Status</label>
                    <select class="form-control" id="batchStatus" style="padding: 0.75rem;">
                        <option value="Sellable">Sellable</option>
                        <option value="On Deck">On Deck</option>
                        <option value="On Hold">On Hold</option>
                    </select>
                </div>
            </div>

            <hr>

            <!-- THC Override -->
            <div class="mb-4">
                <h6 style="color: #667eea; margin-bottom: 1rem;"><i class="fas fa-cannabis me-2"></i>THC Percentage</h6>
                <div class="row">
                    <div class="col-md-6">
                        <label>Current THC %</label>
                        <input type="text" class="form-control" id="currentTHC" readonly>
                    </div>
                    <div class="col-md-6">
                        <label>Override THC %</label>
                        <input type="number" step="0.01" class="form-control" id="thcOverride" placeholder="Enter new THC %">
                    </div>
                </div>
                <div class="form-group mt-2">
                    <label for="thcReason">Reason for THC Override</label>
                    <textarea class="form-control" id="thcReason" rows="2" placeholder="Why is THC being overridden?"></textarea>
                </div>
            </div>

            <hr>

            <!-- Price Override -->
            <div class="mb-4">
                <h6 style="color: #667eea; margin-bottom: 1rem;"><i class="fas fa-dollar-sign me-2"></i>Pricing</h6>
                <div class="row">
                    <div class="col-md-6">
                        <label>Product Default Price</label>
                        <input type="text" class="form-control" value="$<%= product.default_price || 'Not Set' %>" readonly>
                    </div>
                    <div class="col-md-6">
                        <label>Batch Override Price</label>
                        <input type="number" step="0.01" class="form-control" id="priceOverride" placeholder="Override price">
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeBatchManagement()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="saveBatchChanges()">
                <i class="fas fa-save me-1"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- Edit Price Modal -->
<div id="editPriceModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Edit Product Price</h3>
            <button class="modal-close" onclick="closeEditPriceModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group mb-3">
                <label for="newPrice">New Price ($)</label>
                <input type="number" id="newPrice" class="form-control" step="0.01" min="0" 
                       value="<%= product.default_price || '' %>" placeholder="0.00">
                <small class="text-muted">Enter the new default price for this product</small>
            </div>
            
            <div id="bulkUpdatePrompt" style="display: none;">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <strong>Apply to category?</strong>
                    <p class="mb-0 mt-2">You've changed the price of this product. Would you like to apply this new price to <span id="siblingsCount">0</span> other products in the '<span id="categoryName"></span>' category?</p>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeEditPriceModal()">Cancel</button>
            <button class="btn btn-primary" onclick="updatePrice()">
                <i class="fas fa-save"></i> Update Price
            </button>
            <button id="bulkUpdateBtn" class="btn btn-success" onclick="updateCategoryPrices()" style="display: none;">
                <i class="fas fa-layer-group"></i> Apply to Category
            </button>
        </div>
    </div>
</div>

