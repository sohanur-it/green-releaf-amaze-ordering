<script>
const productId = <%= product.entry_id %>;
let categorySiblings = [];

function showEditPriceModal() {
    document.getElementById('editPriceModal').style.display = 'flex';
}

function closeEditPriceModal() {
    document.getElementById('editPriceModal').style.display = 'none';
}

async function updatePrice() {
    const newPrice = parseFloat(document.getElementById('newPrice').value);
    
    if (!newPrice || newPrice <= 0) {
        notify.warning('Please enter a valid price');
        return;
    }
    
    const loadingNotif = notify.loading('Updating product price...');
    
    try {
        const response = await fetch(`/api/v1/products/master/${productId}/price`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include', // Include cookies for session authentication
            body: JSON.stringify({ default_price: newPrice })
        });
        
        const data = await response.json();
        notify.remove(loadingNotif);
        
        if (data.success) {
            // Check if there are siblings to apply to
            if (data.prompt_bulk_update && data.category_siblings.length > 0) {
                categorySiblings = data.category_siblings;
                showBulkUpdatePrompt(data.category, data.category_siblings.length);
            } else {
                // No siblings, just reload
                notify.success('Price updated successfully!');
                setTimeout(() => location.reload(), 1000);
            }
        } else {
            notify.error('Failed to update price: ' + (data.error || 'Unknown error'));
        }
    } catch (error) {
        console.error('Error:', error);
        notify.remove(loadingNotif);
        notify.error('Error updating price: ' + error.message);
    }
}

function showBulkUpdatePrompt(categoryName, siblingsCount) {
    document.getElementById('categoryName').textContent = categoryName;
    document.getElementById('siblingsCount').textContent = siblingsCount;
    document.getElementById('bulkUpdatePrompt').style.display = 'block';
    document.getElementById('bulkUpdateBtn').style.display = 'inline-block';
}

async function updateCategoryPrices() {
    const categoryName = document.getElementById('categoryName').textContent;
    const newPrice = parseFloat(document.getElementById('newPrice').value);
    
    const loadingNotif = notify.loading(`Updating prices for ${categoryName} category...`);
    
    try {
        const response = await fetch(`/api/v1/products/categories/${encodeURIComponent(categoryName)}/bulk-price-update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include', // Include cookies for session authentication
            body: JSON.stringify({ 
                new_price: newPrice,
                exclude_product_ids: [productId] // Exclude current product as it's already updated
            })
        });
        
        const data = await response.json();
        notify.remove(loadingNotif);
        
        if (data.success) {
            notify.success(`Updated ${data.updated_count} products in '${categoryName}' category`, 5000);
            setTimeout(() => location.reload(), 1500);
        } else {
            notify.error('Failed to bulk update prices: ' + (data.error || 'Unknown error'));
        }
    } catch (error) {
        console.error('Error:', error);
        notify.remove(loadingNotif);
        notify.error('Error bulk updating prices: ' + error.message);
    }
}

// =============================================
// BATCH MANAGEMENT FUNCTIONS
// =============================================
let currentBatchData = {};

function openBatchManagement(batchId, batchName, status, thcPercentage, thcOverride, overridePrice) {
    currentBatchData = {
        id: batchId,
        name: batchName,
        status: status,
        thcPercentage: thcPercentage,
        thcOverride: thcOverride,
        overridePrice: overridePrice
    };
    
    document.getElementById('modalBatchId').value = batchId;
    document.getElementById('modalBatchName').textContent = batchName;
    document.getElementById('batchStatus').value = status;
    document.getElementById('currentTHC').value = thcOverride || thcPercentage || 'Not Available';
    document.getElementById('thcOverride').value = thcOverride || '';
    document.getElementById('priceOverride').value = overridePrice || '';
    document.getElementById('thcReason').value = '';
    
    document.getElementById('batchManagementModal').style.display = 'flex';
}

function closeBatchManagement() {
    document.getElementById('batchManagementModal').style.display = 'none';
}

async function saveBatchChanges() {
    const batchId = document.getElementById('modalBatchId').value;
    const newStatus = document.getElementById('batchStatus').value;
    const thcOverride = document.getElementById('thcOverride').value;
    const thcReason = document.getElementById('thcReason').value;
    const priceOverride = document.getElementById('priceOverride').value;
    
    const updates = [];
    
    // Show loading notification
    const loadingNotif = notify.loading('Saving batch changes...');
    
    try {
        // Update status if changed
        if (newStatus !== currentBatchData.status) {
            const statusResponse = await fetch(`/api/v1/batches/${batchId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    status: newStatus,
                    reason: `Manual status change from batch management`
                })
            });
            
            const statusData = await statusResponse.json();
            if (statusData.success) {
                updates.push(`Status → ${newStatus}`);
            } else {
                notify.remove(loadingNotif);
                notify.error('Failed to update status: ' + (statusData.error || 'Unknown error'));
                return;
            }
        }
        
        // Update THC override if provided and changed
        if (thcOverride && thcOverride != currentBatchData.thcOverride) {
            const thcResponse = await fetch(`/api/v1/batches/${batchId}/thc-override`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    thc_override: parseFloat(thcOverride)
                })
            });
            
            const thcData = await thcResponse.json();
            if (thcData.success) {
                updates.push(`THC → ${thcOverride}%`);
            } else {
                notify.remove(loadingNotif);
                notify.error('Failed to update THC: ' + (thcData.error || 'Unknown error'));
                return;
            }
        }
        
        // Update price override if provided and changed
        if (priceOverride && priceOverride != currentBatchData.overridePrice) {
            const priceResponse = await fetch(`/api/v1/batches/${batchId}/price`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    override_price: parseFloat(priceOverride)
                })
            });
            
            const priceData = await priceResponse.json();
            if (priceData.success) {
                updates.push(`Price → $${priceOverride}`);
            } else {
                notify.remove(loadingNotif);
                notify.error('Failed to update price: ' + (priceData.error || 'Unknown error'));
                return;
            }
        }
        
        // Remove loading notification
        notify.remove(loadingNotif);
        
        if (updates.length > 0) {
            notify.success('Batch updated: ' + updates.join(', '), 4000);
            closeBatchManagement();
            setTimeout(() => location.reload(), 1000);
        } else {
            notify.warning('No changes detected');
        }
        
    } catch (error) {
        console.error('Error updating batch:', error);
        notify.remove(loadingNotif);
        notify.error('Error updating batch: ' + error.message);
    }
}

// Close modal when clicking outside
window.onclick = function(event) {
    const editPriceModal = document.getElementById('editPriceModal');
    const batchModal = document.getElementById('batchManagementModal');
    
    if (event.target === editPriceModal) {
        closeEditPriceModal();
    }
    if (event.target === batchModal) {
        closeBatchManagement();
    }
}

// =============================================
// ARCHIVE/UNARCHIVE PRODUCT FUNCTIONS
// =============================================

async function toggleArchiveProduct(shouldArchive) {
    const action = shouldArchive ? 'archive' : 'unarchive';
    const actionPast = shouldArchive ? 'archived' : 'unarchived';
    
    // Confirm action
    const message = shouldArchive 
        ? 'Are you sure you want to archive this product? It will stop listing externally but batches remain usable internally.'
        : 'Are you sure you want to unarchive this product? It will become visible externally again.';
    
    const confirmed = await notify.confirm(message, `Confirm ${action.charAt(0).toUpperCase() + action.slice(1)}`);
    if (!confirmed) return;
    
    const loadingNotif = notify.loading(`${action.charAt(0).toUpperCase() + action.slice(1)}ing product...`);
    
    try {
        const response = await fetch(`/api/v1/products/master/${productId}/archive`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ is_archived: shouldArchive })
        });
        
        const data = await response.json();
        notify.remove(loadingNotif);
        
        if (data.success) {
            notify.success(`Product ${actionPast} successfully!`, 3000);
            setTimeout(() => location.reload(), 1000);
        } else {
            notify.error(`Failed to ${action} product: ` + (data.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(`Error ${action}ing product:`, error);
        notify.remove(loadingNotif);
        notify.error(`Error ${action}ing product: ` + error.message);
    }
}

// Refresh batches from METRC - then reload page
window.refreshBatchesFromMETRC = async function() {
    const refreshProductId = <%= product.entry_id %>;
    <% 
    // Safely stringify the linked items array
    const linkedItemsJson = JSON.stringify(product.metrc_linked_items || []);
    %>
    const linkedItems = <%- linkedItemsJson %>;
    
    if (!linkedItems || linkedItems.length === 0) {
        alert('No METRC items linked to this product');
        return;
    }
    
    const btn = document.getElementById('refreshBatchesBtn');
    if (!btn) {
        console.error('Refresh button not found');
        return;
    }
    
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Refreshing...';
    
    try {
        const response = await fetch(`/api/v1/products/master/${refreshProductId}/refresh-batches`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ metrc_item_names: linkedItems })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Reload page immediately to show updated batches
            window.location.reload();
        } else {
            if (typeof notify !== 'undefined' && notify.error) {
                notify.error('Failed to refresh batches: ' + (data.error || 'Unknown error'));
            } else {
                alert('Failed to refresh batches: ' + (data.error || 'Unknown error'));
            }
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    } catch (error) {
        console.error('Error refreshing batches:', error);
        if (typeof notify !== 'undefined' && notify.error) {
            notify.error('Error refreshing batches: ' + error.message);
        } else {
            alert('Error refreshing batches: ' + error.message);
        }
        btn.disabled = false;
        btn.innerHTML = originalHtml;
    }
};
</script>

<script>
// Search functionality for batches
document.addEventListener('DOMContentLoaded', function() {
    // HTML entities are already decoded by the server, content will render with styling
    
    // Search functionality for batches
    const searchInput = document.getElementById('searchBatches');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#batchesTableBody tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }
    
    // Attach refresh button event listener
    const refreshBtn = document.getElementById('refreshBatchesBtn');
    if (refreshBtn && typeof window.refreshBatchesFromMETRC === 'function') {
        refreshBtn.addEventListener('click', window.refreshBatchesFromMETRC);
    } else if (refreshBtn) {
        console.warn('refreshBatchesFromMETRC function not found');
    }
});
</script>
