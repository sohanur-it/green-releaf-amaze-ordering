<!-- Views/admin/products/create.ejs -->

<div class="form-container">
    <div class="form-header">
        <a href="/admin/products" class="back-link" title="Back to Products">&larr;</a>
        <h2>Create Master Product</h2>
    </div>

    <form action="/admin/products" method="POST" class="styled-form" id="createProductForm" enctype="multipart/form-data">
        <div class="form-grid">
            <!-- Product Name -->
            <div class="form-group span-2">
                <label for="name">Product Name <span class="required">*</span></label>
                <input type="text" id="name" name="name" required 
                       placeholder="e.g., Amaze Orange 3.5g">
                <small>Customer-facing product name</small>
            </div>

            <!-- Category -->
            <div class="form-group">
                <label for="category_name">Category <span class="required">*</span></label>
                <input list="categories" id="category_name" name="category_name" required 
                       placeholder="e.g., Flower - 3.5g Jars">
                <datalist id="categories">
                    <% categories.forEach(category => { %>
                        <option value="<%= category %>">
                    <% }); %>
                    <option value="Flower - 1g Jars">
                    <option value="Flower - 3.5g Jars">
                    <option value="Flower - 7g Jars">
                    <option value="Flower - 14g Jars">
                    <option value="Flower - 28g Jars">
                    <option value="Concentrates - 1g">
                    <option value="Edibles">
                    <option value="Pre-Rolls">
                    <option value="Vape Cartridges - 0.5g">
                    <option value="Vape Cartridges - 1g">
                </datalist>
                <small>Select existing or type new category</small>
            </div>

            <!-- Default Price -->
            <div class="form-group">
                <label for="default_price">Default Price <span class="required">*</span></label>
                <div class="input-group">
                    <span class="input-prefix">$</span>
                    <input type="number" id="default_price" name="default_price" 
                           step="0.01" min="0" required placeholder="50.00">
                </div>
                <small>Base selling price for this product</small>
            </div>

            <!-- Brand Name -->
            <div class="form-group">
                <label for="brand_name">Brand Name</label>
                <input type="text" id="brand_name" name="brand_name" 
                       placeholder="e.g., Amaze">
            </div>

            <!-- Product Type -->
            <div class="form-group">
                <label for="product_type_name">Product Type</label>
                <select id="product_type_name" name="product_type_name">
                    <option value="">Select type...</option>
                    <option value="Flower">Flower</option>
                    <option value="Concentrate">Concentrate</option>
                    <option value="Edible">Edible</option>
                    <option value="Topical">Topical</option>
                    <option value="Tincture">Tincture</option>
                    <option value="Vape">Vape</option>
                    <option value="Pre-Roll">Pre-Roll</option>
                </select>
            </div>

            <!-- Cultivar Name -->
            <div class="form-group">
                <label for="cultivar_name">Cultivar/Strain Name</label>
                <input type="text" id="cultivar_name" name="cultivar_name" 
                       placeholder="e.g., Orange">
            </div>

            <!-- Lineage -->
            <div class="form-group">
                <label for="lineage">Lineage</label>
                <input type="text" id="lineage" name="lineage" 
                       placeholder="e.g., Orange x Unknown">
                <small>Genetic lineage of the strain</small>
            </div>

            <!-- Description -->
            <div class="form-group span-2">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4" 
                          placeholder="Enter product description..."></textarea>
            </div>

            <!-- Product Images -->
            <div class="form-group span-2">
                <label for="product-images">Product Images</label>
                <div class="image-upload-container">
                    <div class="image-upload-dropzone" id="imageDropzone">
                        <input type="file" id="product-images" name="images" multiple accept="image/*" style="display: none;">
                        <div class="dropzone-content">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Click to upload or drag and drop</p>
                            <small>PNG, JPG, GIF up to 5MB each (max 10 images)</small>
                        </div>
                    </div>
                    <div class="image-preview-grid" id="imagePreviewGrid"></div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/admin/products" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                Create Product & Link Items
            </button>
        </div>
    </form>
</div>

<style>
.form-container {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    max-width: 900px;
    margin: 2rem auto;
}

.form-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f3f4f6;
}

.back-link {
    font-size: 1.5rem;
    color: #667eea;
    text-decoration: none;
    padding: 0.5rem;
    margin-left: -0.5rem;
    transition: color 0.3s;
}

.back-link:hover {
    color: #764ba2;
}

.form-header h2 {
    margin: 0;
}

.styled-form {
    margin-top: 1.5rem;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.span-2 {
    grid-column: span 2;
}

.form-group label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
}

.required {
    color: #dc3545;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
}

.form-group small {
    margin-top: 0.25rem;
    color: #666;
    font-size: 0.875rem;
}

.input-group {
    display: flex;
    align-items: stretch;
}

.input-prefix {
    background: #e9ecef;
    border: 1px solid #ddd;
    border-right: none;
    border-radius: 4px 0 0 4px;
    padding: 0.75rem;
    display: flex;
    align-items: center;
}

.input-group input {
    border-radius: 0 4px 4px 0;
    flex: 1;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
}

.btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 1rem;
    transition: background-color 0.3s;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0056b3;
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #545b62;
}

/* Dark Theme Support */
.dark-theme .form-container {
    background: var(--card-bg) !important;
    border: 1px solid var(--border-color);
    color: var(--text-color);
}

.dark-theme .form-header {
    border-bottom-color: var(--border-color);
}

.dark-theme .form-header h2 {
    color: var(--text-color) !important;
}

.dark-theme .form-group label {
    color: var(--text-color) !important;
}

.dark-theme .form-group small {
    color: var(--text-light) !important;
}

.dark-theme .form-group input,
.dark-theme .form-group select,
.dark-theme .form-group textarea {
    background: var(--input-bg) !important;
    border-color: var(--border-color) !important;
    color: var(--text-color) !important;
}

.dark-theme .form-group input::placeholder,
.dark-theme .form-group textarea::placeholder {
    color: var(--text-light) !important;
}

.dark-theme .form-group input:focus,
.dark-theme .form-group select:focus,
.dark-theme .form-group textarea:focus {
    border-color: #4a90e2 !important;
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1) !important;
}

.dark-theme .input-prefix {
    background: var(--input-bg) !important;
    border-color: var(--border-color) !important;
    border-right: none;
    color: var(--text-color) !important;
}

.dark-theme .form-actions {
    border-top-color: var(--border-color);
}

.dark-theme .back-link {
    color: #4a90e2;
}

.dark-theme .back-link:hover {
    color: #6ba3e6;
}

.dark-theme .required {
    color: #ff6b6b;
}

/* Image Upload Styles */
.image-upload-container {
    margin-top: 0.5rem;
}

.image-upload-dropzone {
    border: 2px dashed #ddd;
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: #f9fafb;
}

.image-upload-dropzone:hover {
    border-color: #667eea;
    background: #f0f4ff;
}

.image-upload-dropzone.dragover {
    border-color: #667eea;
    background: #e8f0fe;
}

.dropzone-content i {
    font-size: 3rem;
    color: #667eea;
    margin-bottom: 1rem;
}

.dropzone-content p {
    margin: 0.5rem 0;
    color: #4b5563;
    font-weight: 500;
}

.dropzone-content small {
    color: #6b7280;
}

.image-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.image-preview-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    background: white;
}

.image-preview-item img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
}

.image-preview-item .remove-image {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: rgba(220, 53, 69, 0.9);
    color: white;
    border: none;
    border-radius: 50%;
    width: 28px;
    height: 28px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    transition: all 0.2s;
}

.image-preview-item .remove-image:hover {
    background: #dc3545;
    transform: scale(1.1);
}

.image-preview-item .image-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 0.5rem;
    font-size: 0.75rem;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.image-preview-item.primary::after {
    content: "Featured";
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: #ffc107;
    color: #000;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
}

/* Dark Theme for Image Upload */
.dark-theme .image-upload-dropzone {
    border-color: var(--border-color);
    background: var(--input-bg);
}

.dark-theme .image-upload-dropzone:hover {
    border-color: #4a90e2;
    background: rgba(74, 144, 226, 0.1);
}

.dark-theme .image-upload-dropzone.dragover {
    border-color: #4a90e2;
    background: rgba(74, 144, 226, 0.2);
}

.dark-theme .dropzone-content p {
    color: var(--text-color);
}

.dark-theme .dropzone-content small {
    color: var(--text-light);
}

.dark-theme .image-preview-item {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dropzone = document.getElementById('imageDropzone');
    const fileInput = document.getElementById('product-images');
    const previewGrid = document.getElementById('imagePreviewGrid');
    const images = [];

    // Click to open file picker
    dropzone.addEventListener('click', () => fileInput.click());

    // File input change
    fileInput.addEventListener('change', handleFiles);

    // Drag and drop
    dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));
        handleFileList(files);
    });

    function handleFiles(e) {
        const files = Array.from(e.target.files);
        handleFileList(files);
    }

    function handleFileList(files) {
        files.forEach(file => {
            if (file.size > 5 * 1024 * 1024) {
                alert(`File ${file.name} is too large. Maximum size is 5MB.`);
                return;
            }
            if (!file.type.startsWith('image/')) {
                alert(`File ${file.name} is not an image.`);
                return;
            }
            if (images.length >= 10) {
                alert('Maximum 10 images allowed.');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                const imageData = {
                    file: file,
                    preview: e.target.result,
                    name: file.name
                };
                images.push(imageData);
                updatePreview();
            };
            reader.readAsDataURL(file);
        });
    }

    function updatePreview() {
        previewGrid.innerHTML = '';
        images.forEach((img, index) => {
            const item = document.createElement('div');
            item.className = `image-preview-item ${index === 0 ? 'primary' : ''}`;
            item.innerHTML = `
                <img src="${img.preview}" alt="${img.name}">
                <button type="button" class="remove-image" data-index="${index}">
                    <i class="fas fa-times"></i>
                </button>
                <div class="image-label">${img.name}</div>
            `;
            previewGrid.appendChild(item);
        });

        // Remove buttons
        previewGrid.querySelectorAll('.remove-image').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const index = parseInt(e.target.closest('.remove-image').dataset.index);
                images.splice(index, 1);
                updatePreview();
                updateFileInput();
            });
        });
    }

    function updateFileInput() {
        // Create new DataTransfer object
        const dataTransfer = new DataTransfer();
        images.forEach(img => {
            dataTransfer.items.add(img.file);
        });
        fileInput.files = dataTransfer.files;
    }

    // Form submission - ensure files are included
    document.getElementById('createProductForm').addEventListener('submit', function(e) {
        updateFileInput();
    });
});
</script>

