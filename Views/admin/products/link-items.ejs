<!-- Views/admin/products/link-items.ejs -->

<div class="link-items-container">
    <div class="page-header">
        <div>
            <a href="/admin/products" class="back-link">&larr;</a>
            <h2>Link METRC Items to "<%= product.name %>"</h2>
            <p class="subtitle">Select METRC items to associate with this master product</p>
        </div>
    </div>

    <div class="link-interface">
        <!-- Left Panel: Available METRC Items -->
        <div class="panel available-panel">
            <div class="panel-header">
                <h3>Available METRC Items</h3>
                <input type="text" id="searchInput" placeholder="Search items..." class="search-input">
                <small><span id="availableCount"><%= availableItems.length %></span> items available</small>
            </div>
            <div class="panel-body" id="availableItems">
                <% availableItems.forEach(itemName => { 
                    if (!linkedItems.includes(itemName)) { %>
                        <div class="item-card available" data-item="<%= itemName %>" draggable="true">
                            <div class="item-name"><%= itemName %></div>
                            <button class="link-btn" onclick="linkItem(this, '<%= itemName %>')">
                                <i class="fas fa-arrow-right"></i> Link
                            </button>
                        </div>
                    <% } 
                }); %>
            </div>
        </div>

        <!-- Right Panel: Linked Items -->
        <div class="panel linked-panel">
            <div class="panel-header">
                <h3>Linked Items</h3>
                <small><span id="linkedCount"><%= linkedItems.length %></span> items linked</small>
            </div>
            <div class="panel-body" id="linkedItems">
                <% if (linkedItems.length === 0) { %>
                    <div class="empty-state">
                        <i class="fas fa-link" style="font-size: 48px; color: #ccc;"></i>
                        <p>No items linked yet</p>
                        <p class="hint">Search and click "Link" to add METRC items</p>
                    </div>
                <% } else { %>
                    <% linkedItems.forEach(itemName => { %>
                        <div class="item-card linked" data-item="<%= itemName %>">
                            <div class="item-name"><%= itemName %></div>
                            <button class="unlink-btn" onclick="unlinkItem(this, '<%= itemName %>')">
                                <i class="fas fa-times"></i> Unlink
                            </button>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Impact Preview Modal -->
    <div id="impactModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Impact Preview</h3>
                <button class="modal-close" onclick="closeImpactModal()">&times;</button>
            </div>
            <div class="modal-body" id="impactPreview">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i> Loading impact...
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeImpactModal()">Cancel</button>
                <button class="btn btn-primary" onclick="confirmLink()">Confirm & Save</button>
            </div>
        </div>
    </div>

    <div class="actions-bar">
        <a href="/admin/products" class="btn btn-secondary">Skip for Now</a>
        <button class="btn btn-primary" onclick="previewImpact()">
            Preview Impact & Save
        </button>
    </div>
</div>

<script>
// Store product ID and current state
const productId = <%= product.entry_id %>;
let linkedItemsList = <%= JSON.stringify(linkedItems) %>;

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const items = document.querySelectorAll('#availableItems .item-card');
    
    let visibleCount = 0;
    items.forEach(item => {
        const itemName = item.dataset.item.toLowerCase();
        if (itemName.includes(searchTerm)) {
            item.style.display = 'flex';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });
    
    document.getElementById('availableCount').textContent = visibleCount;
});

// Link item
function linkItem(button, itemName) {
    const itemCard = button.closest('.item-card');
    const linkedPanel = document.getElementById('linkedItems');
    
    // Remove from available
    itemCard.remove();
    
    // Add to linked
    linkedItemsList.push(itemName);
    
    // Clear empty state if exists
    const emptyState = linkedPanel.querySelector('.empty-state');
    if (emptyState) {
        emptyState.remove();
    }
    
    // Create linked card
    const linkedCard = document.createElement('div');
    linkedCard.className = 'item-card linked';
    linkedCard.dataset.item = itemName;
    linkedCard.innerHTML = `
        <div class="item-name">${itemName}</div>
        <button class="unlink-btn" onclick="unlinkItem(this, '${itemName}')">
            <i class="fas fa-times"></i> Unlink
        </button>
    `;
    linkedPanel.appendChild(linkedCard);
    
    updateCounts();
}

// Unlink item
function unlinkItem(button, itemName) {
    const itemCard = button.closest('.item-card');
    const availablePanel = document.getElementById('availableItems');
    
    // Remove from linked
    itemCard.remove();
    linkedItemsList = linkedItemsList.filter(item => item !== itemName);
    
    // Add back to available
    const availableCard = document.createElement('div');
    availableCard.className = 'item-card available';
    availableCard.dataset.item = itemName;
    availableCard.draggable = true;
    availableCard.innerHTML = `
        <div class="item-name">${itemName}</div>
        <button class="link-btn" onclick="linkItem(this, '${itemName}')">
            <i class="fas fa-arrow-right"></i> Link
        </button>
    `;
    availablePanel.appendChild(availableCard);
    
    // Show empty state if no items linked
    const linkedPanel = document.getElementById('linkedItems');
    if (linkedItemsList.length === 0) {
        linkedPanel.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-link" style="font-size: 48px; color: #ccc;"></i>
                <p>No items linked yet</p>
                <p class="hint">Search and click "Link" to add METRC items</p>
            </div>
        `;
    }
    
    updateCounts();
}

// Update counts
function updateCounts() {
    const availableCount = document.querySelectorAll('#availableItems .item-card').length;
    const linkedCount = linkedItemsList.length;
    
    document.getElementById('availableCount').textContent = availableCount;
    document.getElementById('linkedCount').textContent = linkedCount;
}

// Preview impact
async function previewImpact() {
    if (linkedItemsList.length === 0) {
        alert('Please link at least one METRC item before saving.');
        return;
    }
    
    // Show modal
    document.getElementById('impactModal').style.display = 'flex';
    document.getElementById('impactPreview').innerHTML = `
        <div class="loading">
            <i class="fas fa-spinner fa-spin"></i> Loading impact...
        </div>
    `;
    
    try {
        const response = await fetch(`/api/v1/products/master/${productId}/link-items`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ metrc_item_names: linkedItemsList })
        });
        
        const data = await response.json();
        
        if (data.success) {
            displayImpactPreview(data.preview);
        } else {
            document.getElementById('impactPreview').innerHTML = `
                <div class="error">
                    <i class="fas fa-exclamation-triangle"></i>
                    <p>Error: ${data.error || 'Failed to load impact preview'}</p>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error:', error);
        document.getElementById('impactPreview').innerHTML = `
            <div class="error">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Error: ${error.message}</p>
            </div>
        `;
    }
}

// Display impact preview
function displayImpactPreview(preview) {
    // Check for conflicts (errors)
    const hasErrors = preview.conflicts && preview.conflicts.length > 0;
    const hasWarnings = preview.warning_messages && preview.warning_messages.some(w => w.level === 'WARNING' || w.level === 'ERROR');
    
    // Statistics summary
    let summaryHTML = `
        <div class="impact-summary">
            <div class="impact-item">
                <div class="impact-label">Batches Affected</div>
                <div class="impact-value">${preview.batches_affected || 0}</div>
            </div>
            <div class="impact-item">
                <div class="impact-label">Total Quantity</div>
                <div class="impact-value">${preview.quantity_aggregated || 0} units</div>
            </div>
            <div class="impact-item">
                <div class="impact-label">Allocated</div>
                <div class="impact-value">${preview.allocated_quantity || 0} units</div>
            </div>
            <div class="impact-item">
                <div class="impact-label">Available</div>
                <div class="impact-value">${(preview.quantity_aggregated || 0) - (preview.allocated_quantity || 0)} units</div>
            </div>
        </div>
    `;
    
    // Warning messages
    let warningsHTML = '';
    if (preview.warning_messages && preview.warning_messages.length > 0) {
        warningsHTML = '<div class="warnings-section">';
        preview.warning_messages.forEach(warning => {
            let alertClass = 'info';
            let icon = 'info-circle';
            
            if (warning.level === 'ERROR') {
                alertClass = 'danger';
                icon = 'exclamation-triangle';
            } else if (warning.level === 'WARNING') {
                alertClass = 'warning';
                icon = 'exclamation-circle';
            } else if (warning.level === 'SUCCESS') {
                alertClass = 'success';
                icon = 'check-circle';
            }
            
            warningsHTML += `
                <div class="alert alert-${alertClass}">
                    <i class="fas fa-${icon}"></i>
                    <span>${warning.message}</span>
                </div>
            `;
        });
        warningsHTML += '</div>';
    }
    
    // Items to be linked
    let itemsHTML = `
        <div class="impact-details">
            <h5><i class="fas fa-link me-2"></i>Items to be Linked (${linkedItemsList.length}):</h5>
            <ul class="items-list">
                ${linkedItemsList.map(item => `<li><i class="fas fa-check text-success me-2"></i>${item}</li>`).join('')}
            </ul>
        </div>
    `;
    
    // Batch status breakdown
    let statusHTML = '';
    if (preview.statuses) {
        statusHTML = `
            <div class="status-info">
                <strong>Batch Statuses:</strong> ${preview.statuses}
            </div>
        `;
    }
    
    const html = summaryHTML + warningsHTML + statusHTML + itemsHTML;
    document.getElementById('impactPreview').innerHTML = html;
    
    // Disable confirm button if there are errors
    const confirmButton = document.querySelector('.modal-footer .btn-primary');
    if (hasErrors) {
        confirmButton.disabled = true;
        confirmButton.style.opacity = '0.5';
        confirmButton.style.cursor = 'not-allowed';
    } else {
        confirmButton.disabled = false;
        confirmButton.style.opacity = '1';
        confirmButton.style.cursor = 'pointer';
    }
}

// Confirm link
async function confirmLink() {
    const modalBody = document.getElementById('impactPreview');
    modalBody.innerHTML = `
        <div class="loading">
            <i class="fas fa-spinner fa-spin"></i> Saving changes...
        </div>
    `;
    
    try {
        const response = await fetch(`/api/v1/products/master/${productId}/link-items/confirm`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ metrc_item_names: linkedItemsList })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Show success message
            modalBody.innerHTML = `
                <div class="success-message">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <h4>Successfully Linked!</h4>
                    <p>${data.message || 'METRC items have been linked to this master product'}</p>
                    <div class="success-details">
                        <div><strong>Items Linked:</strong> ${linkedItemsList.length}</div>
                        <div><strong>Batches Updated:</strong> ${data.batches_updated || 0}</div>
                    </div>
                    <p class="text-muted mt-3">Redirecting to products page...</p>
                </div>
            `;
            
            // Hide footer buttons
            document.querySelector('.modal-footer').style.display = 'none';
            
            // Redirect after 2 seconds
            setTimeout(() => {
                window.location.href = '/admin/products';
            }, 2000);
        } else {
            modalBody.innerHTML = `
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                    <h4>Failed to Link Items</h4>
                    <p>${data.error || 'An error occurred while linking items'}</p>
                </div>
            `;
            
            // Show close button
            setTimeout(() => {
                closeImpactModal();
            }, 3000);
        }
    } catch (error) {
        console.error('Error:', error);
        modalBody.innerHTML = `
            <div class="error-message">
                <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                <h4>Error</h4>
                <p>${error.message}</p>
            </div>
        `;
        
        setTimeout(() => {
            closeImpactModal();
        }, 3000);
    }
}

// Close modal
function closeImpactModal() {
    document.getElementById('impactModal').style.display = 'none';
}

// Drag and drop support
document.addEventListener('DOMContentLoaded', function() {
    const availablePanel = document.getElementById('availableItems');
    const linkedPanel = document.getElementById('linkedItems');
    
    // Drag start
    availablePanel.addEventListener('dragstart', function(e) {
        if (e.target.classList.contains('item-card')) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', e.target.dataset.item);
            e.target.style.opacity = '0.5';
        }
    });
    
    // Drag end
    availablePanel.addEventListener('dragend', function(e) {
        if (e.target.classList.contains('item-card')) {
            e.target.style.opacity = '1';
        }
    });
    
    // Allow drop on linked panel
    linkedPanel.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        linkedPanel.style.background = '#f0f8ff';
    });
    
    linkedPanel.addEventListener('dragleave', function(e) {
        linkedPanel.style.background = '';
    });
    
    linkedPanel.addEventListener('drop', function(e) {
        e.preventDefault();
        linkedPanel.style.background = '';
        
        const itemName = e.dataTransfer.getData('text/plain');
        const itemCard = availablePanel.querySelector(`[data-item="${itemName}"]`);
        
        if (itemCard) {
            const linkBtn = itemCard.querySelector('.link-btn');
            linkItem(linkBtn, itemName);
        }
    });
});
</script>

