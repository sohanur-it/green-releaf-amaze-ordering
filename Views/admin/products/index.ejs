<!-- Modern Master Products List -->
<style>
/* Product Thumbnail Styles */
.product-thumbnail {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #ddd;
}

.product-thumbnail-placeholder {
    width: 60px;
    height: 60px;
    background: #f0f0f0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    border: 1px solid #ddd;
}

.dark-theme .product-thumbnail-placeholder {
    background: var(--input-bg);
    border-color: var(--border-color);
    color: var(--text-light);
}

.dark-theme .product-thumbnail {
    border-color: var(--border-color);
}

.stats-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.stats-card h3 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
}

.stats-card p {
    margin: 0;
    opacity: 0.9;
}

.stats-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
}

.stats-card.active {
    border: 3px solid rgba(255,255,255,0.8);
    transform: scale(1.05);
}

.filter-controls {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
}

.filter-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.filter-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #4b5563;
    margin: 0;
}

.filter-group select,
.filter-group input {
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
}

.btn-clear-filters {
    padding: 0.5rem 1rem;
    background: #6c757d;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
}

.btn-clear-filters:hover {
    background: #545b62;
}

.dashboard-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}

.modern-table {
    margin: 0;
}

.modern-table thead {
    background: #f8f9fa;
}

.modern-table th {
    font-weight: 600;
    color: #4b5563;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 1rem;
    border: none;
}

.modern-table td {
    padding: 1rem;
    vertical-align: middle;
    border-bottom: 1px solid #f3f4f6;
}

.modern-table tbody tr:hover {
    background: #f9fafb;
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
}

.empty-state i {
    color: #d1d5db;
    margin-bottom: 1rem;
}

.empty-state h3 {
    color: #6b7280;
    margin-bottom: 0.5rem;
}

.empty-state p {
    color: #9ca3af;
    margin-bottom: 2rem;
}

.search-toggle-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
}

.search-toggle-btn {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
}

.search-toggle-btn:hover {
    background: #764ba2;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.search-toggle-btn.active {
    background: #764ba2;
}

.search-input-container {
    display: none !important;
    position: relative;
    max-width: 300px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.search-input-container.active {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
    width: 300px !important;
    min-width: 200px !important;
    height: auto !important;
    min-height: 38px !important;
    position: relative !important;
    z-index: 10 !important;
    flex-shrink: 0 !important;
}

#searchProducts {
    width: 100%;
    transition: all 0.3s ease;
    border-radius: 8px;
    border: 1px solid #ddd;
    padding: 0.5rem 1rem;
}

#searchProducts:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    outline: none;
}
</style>

<script>
// Define toggleSearch function IMMEDIATELY so it's available for inline onclick
window.toggleSearch = function() {
    console.log('🔧 toggleSearch() function CALLED');
    const btn = document.getElementById('searchToggleBtn');
    const container = document.getElementById('searchInputContainer');
    const input = document.getElementById('searchProducts');
    
    if (!btn) {
        console.error('❌ Search button not found');
        return;
    }
    
    if (!container) {
        console.error('❌ Search container not found');
        return;
    }
    
    if (!input) {
        console.error('❌ Search input not found');
        return;
    }
    
    // Check both class and computed style to determine actual visibility
    const hasActiveClass = container.classList.contains('active');
    const computedStyle = window.getComputedStyle(container);
    // Check actual rendered dimensions - if width/height are 0, it's not visible
    const offsetWidth = container.offsetWidth;
    const offsetHeight = container.offsetHeight;
    const isActuallyVisible = computedStyle.display !== 'none' && 
                              computedStyle.visibility !== 'hidden' && 
                              parseFloat(computedStyle.opacity) > 0 &&
                              offsetWidth > 0 &&
                              offsetHeight > 0;
    
    console.log('🔧 Current state:', {
        hasActiveClass: hasActiveClass,
        isActuallyVisible: isActuallyVisible,
        computedDisplay: computedStyle.display,
        computedVisibility: computedStyle.visibility,
        computedOpacity: computedStyle.opacity,
        computedWidth: computedStyle.width,
        computedHeight: computedStyle.height,
        offsetWidth: offsetWidth,
        offsetHeight: offsetHeight,
        clientWidth: container.clientWidth,
        clientHeight: container.clientHeight
    });
    
    // If it has active class but isn't actually visible (or has zero dimensions), force it to show
    if (hasActiveClass && (!isActuallyVisible || offsetWidth === 0 || offsetHeight === 0)) {
        console.log('⚠️ Container has active class but is not visible - forcing visibility');
        container.classList.add('active'); // Ensure active class
        btn.classList.add('active');
        container.style.setProperty('display', 'flex', 'important');
        container.style.setProperty('opacity', '1', 'important');
        container.style.setProperty('visibility', 'visible', 'important');
        container.style.setProperty('max-width', '300px', 'important');
        container.style.setProperty('width', '300px', 'important');
        container.style.setProperty('min-width', '200px', 'important');
        container.style.setProperty('height', 'auto', 'important');
        container.style.setProperty('min-height', '38px', 'important');
        // Ensure input is also visible
        if (input) {
            input.style.setProperty('display', 'block', 'important');
            input.style.setProperty('width', '100%', 'important');
            input.style.setProperty('opacity', '1', 'important');
            input.style.setProperty('visibility', 'visible', 'important');
        }
        setTimeout(() => {
            try {
                input.focus();
                console.log('✅ Search FORCED visible and focused');
            } catch (e) {
                console.error('Error focusing input:', e);
            }
        }, 50);
        return;
    }
    
    if (hasActiveClass && isActuallyVisible) {
        // Hide search
        console.log('🔧 HIDING search...');
        container.classList.remove('active');
        btn.classList.remove('active');
        input.value = '';
        container.style.display = 'none';
        container.style.opacity = '0';
        container.style.visibility = 'hidden';
        if (typeof applyFilters === 'function') {
            applyFilters();
        }
        console.log('✅ Search HIDDEN');
    } else {
        // Show search
        console.log('🔧 SHOWING search...');
        container.classList.add('active');
        btn.classList.add('active');
        // Use setProperty with important to ensure it stays visible
        container.style.setProperty('display', 'flex', 'important');
        container.style.setProperty('opacity', '1', 'important');
        container.style.setProperty('visibility', 'visible', 'important');
        container.style.setProperty('max-width', '300px', 'important');
        container.style.setProperty('width', '300px', 'important');
        container.style.setProperty('min-width', '200px', 'important');
        container.style.setProperty('height', 'auto', 'important');
        container.style.setProperty('min-height', '38px', 'important');
        // Ensure input is also visible
        if (input) {
            input.style.setProperty('display', 'block', 'important');
            input.style.setProperty('width', '100%', 'important');
            input.style.setProperty('opacity', '1', 'important');
            input.style.setProperty('visibility', 'visible', 'important');
        }
        setTimeout(() => {
            try {
                input.focus();
                console.log('✅ Search SHOWN and focused');
                // Double-check it's still visible after focus
                if (!container.classList.contains('active')) {
                    console.warn('⚠️ Search container lost active class, re-adding...');
                    container.classList.add('active');
                    container.style.setProperty('display', 'flex', 'important');
                }
                // Verify it's actually visible
                const computedStyle = window.getComputedStyle(container);
                const inputComputedStyle = input ? window.getComputedStyle(input) : null;
                // Check parent visibility too
                const parent = container.parentElement;
                const parentStyle = parent ? window.getComputedStyle(parent) : null;
                
                console.log('🔍 Container visibility check:', {
                    containerDisplay: computedStyle.display,
                    containerOpacity: computedStyle.opacity,
                    containerVisibility: computedStyle.visibility,
                    containerWidth: computedStyle.width,
                    containerHeight: computedStyle.height,
                    containerPosition: computedStyle.position,
                    containerTop: computedStyle.top,
                    containerLeft: computedStyle.left,
                    containerZIndex: computedStyle.zIndex,
                    inputDisplay: inputComputedStyle ? inputComputedStyle.display : 'N/A',
                    inputWidth: inputComputedStyle ? inputComputedStyle.width : 'N/A',
                    inputHeight: inputComputedStyle ? inputComputedStyle.height : 'N/A',
                    hasActive: container.classList.contains('active'),
                    parentDisplay: parentStyle ? parentStyle.display : 'N/A',
                    parentVisibility: parentStyle ? parentStyle.visibility : 'N/A',
                    parentOpacity: parentStyle ? parentStyle.opacity : 'N/A',
                    containerOffsetWidth: container.offsetWidth,
                    containerOffsetHeight: container.offsetHeight,
                    containerClientWidth: container.clientWidth,
                    containerClientHeight: container.clientHeight
                });
                if (computedStyle.display === 'none') {
                    console.warn('⚠️ Search container hidden after focus - forcing visible again');
                    container.style.setProperty('display', 'flex', 'important');
                }
            } catch (e) {
                console.error('Error focusing input:', e);
            }
        }, 50);
    }
};

// Define applyFilters function globally (before DOMContentLoaded)
window.applyFilters = function() {
    console.log('🔍 applyFilters() CALLED - This is FRONTEND filtering (no API call)');
    
    // Check if allProducts is populated
    if (!allProducts || allProducts.length === 0) {
        console.warn('⚠️ allProducts not populated yet, skipping filter');
        return;
    }
    
    const categoryFilter = document.getElementById('filterCategory')?.value || '';
    const linkedStatusFilter = document.getElementById('filterLinkedStatus')?.value || '';
    const batchesFilter = document.getElementById('filterBatches')?.value || '';
    const sortBy = document.getElementById('sortBy')?.value || 'created-desc';
    const searchInput = document.getElementById('searchProducts');
    const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
    
    console.log('🔍 Filter params:', {
        searchTerm: searchTerm,
        categoryFilter: categoryFilter,
        allProductsCount: allProducts.length
    });

    let visibleCount = 0;

    // Filter products
    allProducts.forEach(product => {
        let visible = true;

        // Card filter (stats card click)
        if (currentFilter === 'has-batches') {
            visible = visible && product.hasBatches;
        } else if (currentFilter === 'has-linked-items') {
            visible = visible && product.linkedItems > 0;
        } else if (currentFilter === 'no-linked-items') {
            visible = visible && product.linkedItems === 0;
        }

        // Category filter
        if (categoryFilter && product.category !== categoryFilter) {
            visible = false;
        }

        // Linked status filter
        if (linkedStatusFilter === 'linked' && product.linkedItems === 0) {
            visible = false;
        } else if (linkedStatusFilter === 'unlinked' && product.linkedItems > 0) {
            visible = false;
        }

        // Batches filter
        if (batchesFilter === 'yes' && !product.hasBatches) {
            visible = false;
        } else if (batchesFilter === 'no' && product.hasBatches) {
            visible = false;
        }

        // Search filter - search in product name, brand, category, etc.
        if (searchTerm) {
            const productText = (product.element.textContent || '').toLowerCase();
            const productName = (product.name || '').toLowerCase();
            const productCategory = (product.category || '').toLowerCase();
            
            // Search in multiple fields
            const matchesSearch = 
                productText.includes(searchTerm) || 
                productName.includes(searchTerm) ||
                productCategory.includes(searchTerm);
            
            if (!matchesSearch) {
                visible = false;
            }
        }

        // Show/hide row
        product.element.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
    });

    console.log('🔍 Filter results: visibleCount =', visibleCount, 'out of', allProducts.length);

    // Sort visible products
    if (typeof sortProducts === 'function') {
        sortProducts(sortBy);
    }

    // Update count
    const countElement = document.getElementById('filteredCount');
    if (countElement) {
        countElement.textContent = visibleCount;
    }
};

// Define clearFilters function globally
window.clearFilters = function() {
    console.log('🔍 clearFilters() CALLED');
    // Reset all filters
    const categorySelect = document.getElementById('filterCategory');
    const linkedStatusSelect = document.getElementById('filterLinkedStatus');
    const batchesSelect = document.getElementById('filterBatches');
    const sortSelect = document.getElementById('sortBy');
    const searchInput = document.getElementById('searchProducts');
    
    if (categorySelect) categorySelect.value = '';
    if (linkedStatusSelect) linkedStatusSelect.value = '';
    if (batchesSelect) batchesSelect.value = '';
    if (sortSelect) sortSelect.value = 'created-desc';
    if (searchInput) searchInput.value = '';
    
    // Remove active from cards
    document.querySelectorAll('.stats-card').forEach(c => c.classList.remove('active'));
    currentFilter = 'all';
    
    // Apply filters (which will reset everything)
    applyFilters();
};
</script>

<div class="container-fluid p-4">
    <% 
    // Calculate stats FIRST (before using in template)
    const totalProducts = products.length;
    const totalBatches = products.reduce((sum, p) => sum + (parseInt(p.batch_count) || 0), 0);
    const totalAvailable = products.reduce((sum, p) => sum + (parseFloat(p.available_quantity) || 0), 0);
    const linkedItems = products.reduce((sum, p) => sum + ((p.metrc_linked_items || []).length), 0);
    %>
    
    <!-- Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch">
                <input 
                    class="form-check-input" 
                    type="checkbox" 
                    id="showArchivedToggle"
                    <%= showArchived ? 'checked' : '' %>
                    onchange="toggleShowArchived(this.checked)"
                >
                <label class="form-check-label" for="showArchivedToggle">
                    <i class="fas fa-archive me-1"></i> Show Archived Products
                </label>
            </div>
            <!-- Refresh All Batches button removed - use scheduled sync jobs instead -->
        </div>
        <a href="/admin/products/new" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Create Product
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card" id="filter-all" data-filter="all" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <p>Total Products</p>
                <h3><%= totalProducts %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" id="filter-batches" data-filter="has-batches" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <p>Total Batches</p>
                <h3><%= totalBatches %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" id="filter-linked" data-filter="has-linked-items" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <p>Linked METRC Items</p>
                <h3><%= linkedItems %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" id="filter-unlinked" data-filter="no-linked-items" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <p>Unlinked Products</p>
                <h3><%= products.filter(p => (p.metrc_linked_items || []).length === 0).length %></h3>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="dashboard-card">
        <% if (products.length === 0) { %>
            <div class="empty-state">
                <i class="fas fa-box-open fa-4x"></i>
                <h3>No Products Yet</h3>
                <p>Create your first master product to get started</p>
                <a href="/admin/products/new" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Create Product
                </a>
            </div>
        <% } else { %>
            <!-- Filter and Sort Controls -->
            <div class="filter-controls">
                <div class="filter-row">
                    <div class="filter-group">
                        <label>Category:</label>
                        <select id="filterCategory">
                            <option value="">All Categories</option>
                            <% 
                            const categories = [...new Set(products.map(p => p.category_name).filter(Boolean))];
                            categories.sort();
                            categories.forEach(cat => { %>
                                <option value="<%= cat %>"><%= cat %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Linked Status:</label>
                        <select id="filterLinkedStatus">
                            <option value="">All Products</option>
                            <option value="linked">Linked Items Only</option>
                            <option value="unlinked">Unlinked Only</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Has Batches:</label>
                        <select id="filterBatches">
                            <option value="">All Products</option>
                            <option value="yes">Has Batches</option>
                            <option value="no">No Batches</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Sort By:</label>
                        <select id="sortBy">
                            <option value="created-desc">Newest First</option>
                            <option value="created-asc">Oldest First</option>
                            <option value="name-asc">Name (A-Z)</option>
                            <option value="name-desc">Name (Z-A)</option>
                            <option value="price-desc">Price (High-Low)</option>
                            <option value="price-asc">Price (Low-High)</option>
                            <option value="batches-desc">Batches (High-Low)</option>
                            <option value="batches-asc">Batches (Low-High)</option>
                        </select>
                    </div>
                    <button class="btn-clear-filters" onclick="clearFilters()">
                        <i class="fas fa-times"></i> Clear Filters
                    </button>
                </div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">All Products (<span id="filteredCount"><%= totalProducts %></span>)</h5>
                <div class="search-toggle-container">
                    <button class="search-toggle-btn" id="searchToggleBtn" type="button" onclick="toggleSearch(); return false;">
                        <i class="fas fa-search"></i>
                        <span>Search</span>
                    </button>
                    <div class="search-input-container" id="searchInputContainer">
                        <input type="text" id="searchProducts" class="form-control" placeholder="Search products...">
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover modern-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Linked Items</th>
                            <th>Batches</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody">
                        <% products.forEach(product => { %>
                            <% 
                            // Escape all product data to prevent syntax errors
                            const safeName = String(product.name || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/\n/g, ' ').replace(/\r/g, '').replace(/\\/g, '');
                            const safeCategory = String(product.category_name || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/\n/g, ' ').replace(/\r/g, '').replace(/\\/g, '');
                            const safeCreatedAt = String(product.created_at || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/\n/g, ' ').replace(/\r/g, '').replace(/\\/g, '');
                            %>
                            <tr data-product-id="<%= product.entry_id %>"
                                data-category="<%= safeCategory %>"
                                data-linked-items="<%= (product.metrc_linked_items || []).length %>"
                                data-has-batches="<%= (parseInt(product.batch_count) || 0) > 0 ? 'yes' : 'no' %>"
                                data-created-at="<%= safeCreatedAt %>"
                                data-price="<%= product.default_price || 0 %>"
                                data-name="<%= safeName.toLowerCase() %>"
                                data-batches="<%= product.batch_count || 0 %>">
                                <td>
                                    <% if (product.primary_image_url) { %>
                                        <img src="<%= String(product.primary_image_url || '').replace(/"/g, '&quot;') %>" 
                                             alt="<%= String(product.name || '').replace(/"/g, '&quot;') %>" 
                                             class="product-thumbnail"
                                             onerror="this.onerror=null; this.src='/public/images/placeholder.jpg';">
                                    <% } else { %>
                                        <div class="product-thumbnail-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    <% } %>
                                </td>
                                <td><strong>#<%= product.entry_id %></strong></td>
                                <td>
                                    <div>
                                        <div class="fw-bold">
                                            <%- (product.name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>
                                            <% if (product.is_archived) { %>
                                                <span class="badge bg-warning text-dark ms-2">
                                                    <i class="fas fa-archive"></i> ARCHIVED
                                                </span>
                                            <% } %>
                                        </div>
                                        <% if (product.brand_name) { %>
                                            <small class="text-muted"><%= product.brand_name %></small>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary"><%= product.category_name || 'N/A' %></span>
                                </td>
                                <td>
                                    <% if (product.default_price) { %>
                                        <strong>$<%= parseFloat(product.default_price).toFixed(2) %></strong>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark"><%= (product.metrc_linked_items || []).length %></span>
                                </td>
                                <td>
                                    <span class="badge bg-success"><%= product.batch_count || 0 %></span>
                                </td>
                                <td>
                                    <%= Math.round(product.available_quantity || 0) %> units
                                </td>
                                <td>
                                    <a href="/admin/products/<%= product.entry_id %>" class="btn btn-sm btn-outline-primary me-1" title="View Details">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="/admin/products/<%= product.entry_id %>/link-items" class="btn btn-sm btn-outline-success me-1" title="Link METRC Items">
                                        <i class="fas fa-link"></i> Link
                                    </a>
                                    <a href="/admin/products/<%= product.entry_id %>/images/manage" class="btn btn-sm btn-outline-info" title="Manage Images">
                                        <i class="fas fa-images"></i> Images
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
// Escape function for HTML attributes to prevent syntax errors
function escapeHtmlAttr(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\n/g, ' ')
        .replace(/\r/g, '')
        .replace(/\\/g, '\\\\');
}

// Refresh batches for all products with linked METRC items
// DISABLED: Use scheduled sync jobs or individual product refresh buttons instead
async function refreshAllProductBatches() {
    alert('Batch refresh for all products has been disabled. Please use:\n1. Scheduled sync jobs (automatic)\n2. "Refresh from METRC" button on individual product pages');
    return;
}

// Helper functions for batch refresh (currently unused but kept for potential future use)
function updateProgressUI(data, progressText, progressBar, batchesCount, modal, progressModal, ws) {
    if (data.status === 'started') {
        progressText.textContent = data.message || 'Starting refresh...';
        progressBar.style.width = '0%';
        batchesCount.textContent = '0 batches';
    } else if (data.status === 'progress') {
        const productsProcessed = data.products_processed || 0;
        const totalProducts = data.total_products || 0;
        const totalBatchesRefreshed = data.total_batches_refreshed || 0;
        const progress = totalProducts > 0 ? Math.round((productsProcessed / totalProducts) * 100) : 0;
        
        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute('aria-valuenow', progress);
        batchesCount.textContent = `${totalBatchesRefreshed} batches`;
        
        if (data.current_product) {
            const productName = data.current_product.name || 'Unknown';
            const batches = data.current_product.batches_refreshed || 0;
            progressText.textContent = `Updated ${batches} batch(es) for ${productName} (${productsProcessed}/${totalProducts} products)`;
        } else {
            progressText.textContent = data.message || `Processing... (${productsProcessed}/${totalProducts})`;
        }
    } else if (data.status === 'completed') {
        progressBar.style.width = '100%';
        progressBar.setAttribute('aria-valuenow', 100);
        batchesCount.textContent = `${data.total_batches_refreshed || 0} batches`;
        progressText.textContent = data.message || 'Completed!';
        
        setTimeout(() => {
            handleCompletion(data, modal, progressModal, ws);
        }, 1500);
    } else if (data.status === 'error') {
        handleError(data, modal, progressModal, ws);
    }
}

// Poll for progress updates (fallback if WebSocket fails)
async function pollProgress(progressText, progressBar, batchesCount, modal, progressModal, initialData) {
    // Simulate progress updates since we can't get real-time updates without WebSocket
    // Just show the final result
    if (initialData.success) {
        const totalProducts = initialData.products_processed || 0;
        let currentProgress = 0;
        
        // Animate progress bar
        const interval = setInterval(() => {
            currentProgress += 10;
            if (currentProgress > 90) {
                currentProgress = 90; // Don't go to 100% until done
            }
            progressBar.style.width = `${currentProgress}%`;
            progressBar.setAttribute('aria-valuenow', currentProgress);
            progressText.textContent = `Processing ${totalProducts} products...`;
        }, 500);
        
        // Wait a bit then show completion
        setTimeout(() => {
            clearInterval(interval);
            handleCompletion(initialData, modal, progressModal, null);
        }, Math.max(2000, totalProducts * 500)); // At least 2 seconds, or 500ms per product
    } else {
        handleError(initialData, modal, progressModal, null);
    }
}

// Handle completion
function handleCompletion(data, modal, progressModal, ws) {
    if (ws) ws.close();
    
    if (modal && typeof modal.hide === 'function') {
        modal.hide();
    }
    progressModal.remove();
    
    const duration = Math.round((data.duration_ms || 0) / 1000);
    const message = `Refreshed batches for ${data.products_successful || data.products_processed || 0} products (${data.total_batches_refreshed || 0} batches) in ${duration}s`;
    
    if (typeof notify !== 'undefined' && notify.success) {
        notify.success(message, 5000);
    } else {
        alert(message);
    }
    
    // Reload page to show updated batches
    setTimeout(() => window.location.reload(), 1000);
}

// Handle error
function handleError(data, modal, progressModal, ws) {
    if (ws) ws.close();
    
    if (modal && typeof modal.hide === 'function') {
        modal.hide();
    }
    progressModal.remove();
    
    const errorMsg = data.error || 'Unknown error';
    if (typeof notify !== 'undefined' && notify.error) {
        notify.error('Error: ' + errorMsg);
    } else {
        alert('Error: ' + errorMsg);
    }
}

// Create progress modal HTML
function createProgressModal() {
    const modal = document.createElement('div');
    modal.className = 'modal fade';
    modal.id = 'refreshProgressModal';
    modal.setAttribute('tabindex', '-1');
    modal.setAttribute('aria-labelledby', 'refreshProgressModalLabel');
    modal.setAttribute('aria-hidden', 'true');
    modal.innerHTML = `
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="refreshProgressModalLabel">
                        <i class="fas fa-sync-alt fa-spin me-2"></i>Refreshing Batches
                    </h5>
                </div>
                <div class="modal-body">
                    <p id="progressText" class="mb-3">Starting refresh...</p>
                    <div class="progress mb-3" style="height: 25px;">
                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                             role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <div class="text-center">
                        <strong id="batchesCount">0 batches</strong> refreshed
                    </div>
                </div>
            </div>
        </div>
    `;
    return modal;
}

// Store all products data for filtering
// Store all products data for filtering - make it global
window.allProducts = [];
let currentFilter = 'all';

// Toggle search input visibility - define before DOMContentLoaded
function toggleSearch() {
    console.log('🔧 toggleSearch() function CALLED');
    const btn = document.getElementById('searchToggleBtn');
    const container = document.getElementById('searchInputContainer');
    const input = document.getElementById('searchProducts');
    
    console.log('🔧 Elements check:', {
        btn: !!btn,
        container: !!container,
        input: !!input,
        btnElement: btn,
        containerElement: container,
        inputElement: input
    });
    
    if (!btn) {
        console.error('❌ Search button not found');
        alert('Search button not found in DOM');
        return;
    }
    
    if (!container) {
        console.error('❌ Search container not found');
        alert('Search container not found in DOM');
        return;
    }
    
    if (!input) {
        console.error('❌ Search input not found');
        alert('Search input not found in DOM');
        return;
    }
    
    const isActive = container.classList.contains('active');
    console.log('🔧 Current state - isActive:', isActive);
    console.log('🔧 Container classes:', container.className);
    console.log('🔧 Container style.display:', container.style.display);
    console.log('🔧 Container computed display:', window.getComputedStyle(container).display);
    
    if (isActive) {
        // Hide search
        console.log('🔧 HIDING search...');
        container.classList.remove('active');
        btn.classList.remove('active');
        input.value = '';
        container.style.display = 'none';
        container.style.opacity = '0';
        container.style.visibility = 'hidden';
        if (typeof applyFilters === 'function') {
            applyFilters(); // Reset filters when closing
        }
        console.log('✅ Search HIDDEN');
    } else {
        // Show search
        console.log('🔧 SHOWING search...');
        container.classList.add('active');
        btn.classList.add('active');
        container.style.display = 'block';
        container.style.opacity = '1';
        container.style.visibility = 'visible';
        container.style.maxWidth = '300px';
        // Small delay to ensure display is set before focusing
        setTimeout(() => {
            try {
                input.focus();
                console.log('✅ Search SHOWN and focused');
            } catch (e) {
                console.error('Error focusing input:', e);
            }
        }, 50);
    }
}

// Make toggleSearch available globally
window.toggleSearch = toggleSearch;

// Define applyFilters globally (before DOMContentLoaded)
window.applyFilters = function() {
    console.log('🔍 applyFilters() CALLED - This is FRONTEND filtering (no API call)');
    
    // Check if allProducts is populated (use window.allProducts to ensure we get the global)
    const products = window.allProducts || [];
    if (!products || products.length === 0) {
        console.warn('⚠️ allProducts not populated yet, skipping filter');
        return;
    }
    
    const categoryFilter = document.getElementById('filterCategory')?.value || '';
    const linkedStatusFilter = document.getElementById('filterLinkedStatus')?.value || '';
    const batchesFilter = document.getElementById('filterBatches')?.value || '';
    const sortBy = document.getElementById('sortBy')?.value || 'created-desc';
    const searchInput = document.getElementById('searchProducts');
    const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
    
    console.log('🔍 Filter params:', {
        searchTerm: searchTerm,
        categoryFilter: categoryFilter,
        allProductsCount: products.length
    });

    let visibleCount = 0;

    // Filter products
    products.forEach(product => {
        let visible = true;

        // Card filter (stats card click)
        if (currentFilter === 'has-batches') {
            visible = visible && product.hasBatches;
        } else if (currentFilter === 'has-linked-items') {
            visible = visible && product.linkedItems > 0;
        } else if (currentFilter === 'no-linked-items') {
            visible = visible && product.linkedItems === 0;
        }

        // Category filter
        if (categoryFilter && product.category !== categoryFilter) {
            visible = false;
        }

        // Linked status filter
        if (linkedStatusFilter === 'linked' && product.linkedItems === 0) {
            visible = false;
        } else if (linkedStatusFilter === 'unlinked' && product.linkedItems > 0) {
            visible = false;
        }

        // Batches filter
        if (batchesFilter === 'yes' && !product.hasBatches) {
            visible = false;
        } else if (batchesFilter === 'no' && product.hasBatches) {
            visible = false;
        }

        // Search filter - search in product name, brand, category, etc.
        if (searchTerm) {
            const productText = (product.element.textContent || '').toLowerCase();
            const productName = (product.name || '').toLowerCase();
            const productCategory = (product.category || '').toLowerCase();
            
            // Search in multiple fields
            const matchesSearch = 
                productText.includes(searchTerm) || 
                productName.includes(searchTerm) ||
                productCategory.includes(searchTerm);
            
            if (!matchesSearch) {
                visible = false;
            }
        }

        // Show/hide row
        product.element.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
    });

    console.log('🔍 Filter results: visibleCount =', visibleCount, 'out of', products.length);

    // Sort visible products
    if (typeof sortProducts === 'function') {
        sortProducts(sortBy);
    }

    // Update count
    const countElement = document.getElementById('filteredCount');
    if (countElement) {
        countElement.textContent = visibleCount;
    }
};

// Define clearFilters globally (before DOMContentLoaded)
window.clearFilters = function() {
    console.log('🔍 clearFilters() CALLED');
    // Reset all filters
    const categorySelect = document.getElementById('filterCategory');
    const linkedStatusSelect = document.getElementById('filterLinkedStatus');
    const batchesSelect = document.getElementById('filterBatches');
    const sortSelect = document.getElementById('sortBy');
    const searchInput = document.getElementById('searchProducts');
    
    if (categorySelect) categorySelect.value = '';
    if (linkedStatusSelect) linkedStatusSelect.value = '';
    if (batchesSelect) batchesSelect.value = '';
    if (sortSelect) sortSelect.value = 'created-desc';
    if (searchInput) searchInput.value = '';
    
    // Remove active from cards
    document.querySelectorAll('.stats-card').forEach(c => c.classList.remove('active'));
    currentFilter = 'all';
    
    // Apply filters (which will reset everything)
    if (typeof window.applyFilters === 'function') {
        window.applyFilters();
    }
};

// Define toggleShowArchived globally (before DOMContentLoaded)
window.toggleShowArchived = function(show) {
    const url = new URL(window.location);
    if (show) {
        url.searchParams.set('show_archived', 'true');
    } else {
        url.searchParams.delete('show_archived');
    }
    window.location.href = url.toString();
};

document.addEventListener('DOMContentLoaded', function() {
    console.log('✅ DOMContentLoaded fired for products page');
    
    // Store product data
    const rows = document.querySelectorAll('#productsTableBody tr');
    rows.forEach(row => {
        window.allProducts.push({
            element: row,
            category: row.dataset.category || '',
            linkedItems: parseInt(row.dataset.linkedItems) || 0,
            hasBatches: row.dataset.hasBatches === 'yes',
            createdAt: row.dataset.createdAt || '',
            price: parseFloat(row.dataset.price) || 0,
            name: row.dataset.name || '',
            batches: parseInt(row.dataset.batches) || 0
        });
    });

    // Stats card click handlers
    document.querySelectorAll('.stats-card').forEach(card => {
        card.addEventListener('click', function() {
            // Remove active class from all cards
            document.querySelectorAll('.stats-card').forEach(c => c.classList.remove('active'));
            
            // Add active to clicked card
            this.classList.add('active');
            
            // Get filter type
            const filter = this.dataset.filter;
            currentFilter = filter;
            
            // Apply filter
            applyFilters();
        });
    });

    // Category filter
    document.getElementById('filterCategory')?.addEventListener('change', applyFilters);
    
    // Linked status filter
    document.getElementById('filterLinkedStatus')?.addEventListener('change', applyFilters);
    
    // Batches filter
    document.getElementById('filterBatches')?.addEventListener('change', applyFilters);
    
    // Sort
    document.getElementById('sortBy')?.addEventListener('change', applyFilters);
    
    // Search toggle button
    const searchToggleBtn = document.getElementById('searchToggleBtn');
    if (searchToggleBtn) {
        console.log('Attaching click listener to search toggle button');
        searchToggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            console.log('Search toggle button clicked');
            toggleSearch();
        });
    } else {
        console.error('Search toggle button not found');
    }
    
    // Search input
    const searchInput = document.getElementById('searchProducts');
    if (searchInput) {
        console.log('✅ Search input found, attaching event listener');
        searchInput.addEventListener('input', function(e) {
            console.log('🔍 Search input changed:', e.target.value);
            applyFilters();
        });
        searchInput.addEventListener('keyup', function(e) {
            console.log('🔍 Search keyup:', e.target.value);
            applyFilters();
        });
    } else {
        console.error('❌ Search input not found');
    }
});

// applyFilters and clearFilters are now defined globally above, before DOMContentLoaded
// These are just references for backwards compatibility

function sortProducts(sortBy) {
    const tbody = document.getElementById('productsTableBody');
    const rows = Array.from(tbody.querySelectorAll('tr:not([style*="display: none"])'));

    rows.sort((a, b) => {
        switch(sortBy) {
            case 'created-desc':
                return (b.dataset.createdAt || '').localeCompare(a.dataset.createdAt || '');
            case 'created-asc':
                return (a.dataset.createdAt || '').localeCompare(b.dataset.createdAt || '');
            case 'name-asc':
                return a.dataset.name.localeCompare(b.dataset.name);
            case 'name-desc':
                return b.dataset.name.localeCompare(a.dataset.name);
            case 'price-desc':
                return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
            case 'price-asc':
                return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
            case 'batches-desc':
                return parseInt(b.dataset.batches) - parseInt(a.dataset.batches);
            case 'batches-asc':
                return parseInt(a.dataset.batches) - parseInt(b.dataset.batches);
            default:
                return 0;
        }
    });

    // Reorder rows
    rows.forEach(row => tbody.appendChild(row));
}

// clearFilters is already defined globally above (before DOMContentLoaded)

// Toggle show archived products
function toggleShowArchived(show) {
    const url = new URL(window.location);
    if (show) {
        url.searchParams.set('show_archived', 'true');
    } else {
        url.searchParams.delete('show_archived');
    }
    window.location.href = url.toString();
}

// toggleSearch function is defined above, before DOMContentLoaded

// Initial filter setup
document.addEventListener('DOMContentLoaded', function() {
    // Make first card active by default
    document.getElementById('filter-all')?.classList.add('active');
});
</script>