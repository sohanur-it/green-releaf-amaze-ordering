<!-- Invoice List Page -->
<style>
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.page-header h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: var(--text-color);
    transition: color 0.3s ease;
}

.filter-controls {
    background: var(--bg-color, #f8f9fa);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    transition: background-color 0.3s ease;
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.filter-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-color);
    margin: 0;
    white-space: nowrap;
    transition: color 0.3s ease;
}

.filter-group select {
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.9rem;
    min-width: 150px;
    background-color: var(--input-bg, #fff);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}

.btn-clear-filters {
    padding: 0.5rem 1rem;
    background: #6c757d;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background-color 0.2s;
}

.btn-clear-filters:hover {
    background: #545b62;
}

.dashboard-card {
    background: var(--card-bg, white);
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow, 0 5px 15px rgba(0,0,0,0.08));
    margin-bottom: 1.5rem;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    color: var(--text-color);
}

.modern-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
}

.modern-table thead {
    background: var(--bg-color, #f8f9fa);
    transition: background-color 0.3s ease;
}

.modern-table th {
    font-weight: 600;
    color: var(--text-color);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 1rem;
    border: none;
    text-align: left;
    transition: color 0.3s ease;
}

.modern-table td {
    padding: 0.75rem 1rem;
    vertical-align: middle;
    border-bottom: 1px solid var(--border-color, #f3f4f6);
    color: var(--text-color);
    transition: color 0.3s ease, border-color 0.3s ease;
}

.modern-table tbody tr:hover {
    background: var(--bg-color, #f9fafb);
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: capitalize;
    letter-spacing: 0.3px;
    border: 1px solid transparent;
    line-height: 1.2;
}

.status-draft { 
    background: rgba(59, 130, 246, 0.15); 
    color: #3b82f6; 
    border-color: rgba(59, 130, 246, 0.3);
}
.status-pending_approval, .status-pendingapproval { 
    background: rgba(251, 191, 36, 0.15); 
    color: #fbbf24; 
    border-color: rgba(251, 191, 36, 0.3);
}
.status-approved { 
    background: rgba(34, 197, 94, 0.15); 
    color: #22c55e; 
    border-color: rgba(34, 197, 94, 0.3);
}
.status-fulfillment_accepted, .status-fulfillmentaccepted { 
    background: rgba(168, 85, 247, 0.15); 
    color: #a855f7; 
    border-color: rgba(168, 85, 247, 0.3);
}
.status-fulfillment_issue, .status-fulfillmentissue { 
    background: rgba(239, 68, 68, 0.15); 
    color: #ef4444; 
    border-color: rgba(239, 68, 68, 0.3);
}
.status-manifested { 
    background: rgba(20, 184, 166, 0.15); 
    color: #14b8a6; 
    border-color: rgba(20, 184, 166, 0.3);
}
.status-shipped { 
    background: rgba(99, 102, 241, 0.15); 
    color: #6366f1; 
    border-color: rgba(99, 102, 241, 0.3);
}
.status-delivered { 
    background: rgba(16, 185, 129, 0.15); 
    color: #10b981; 
    border-color: rgba(16, 185, 129, 0.3);
}
.status-paid { 
    background: rgba(34, 197, 94, 0.2); 
    color: #16a34a; 
    border-color: rgba(34, 197, 94, 0.4);
}
.status-cancelled { 
    background: rgba(107, 114, 128, 0.15); 
    color: #6b7280; 
    border-color: rgba(107, 114, 128, 0.3);
}

.source-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    border: 1px solid transparent;
    line-height: 1.2;
}

.source-internal { 
    background: rgba(59, 130, 246, 0.15); 
    color: #3b82f6; 
    border-color: rgba(59, 130, 246, 0.3);
}
.source-external { 
    background: rgba(168, 85, 247, 0.15); 
    color: #a855f7; 
    border-color: rgba(168, 85, 247, 0.3);
}

.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-light);
    transition: color 0.3s ease;
}

.empty-state i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.empty-state h3 {
    margin: 0.5rem 0;
    color: var(--text-color);
}

.table-action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    transition: all 0.2s ease;
}

.table-action-link i {
    font-size: 0.9rem;
    opacity: 0.9;
}

.table-action-link:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.4);
    color: #2563eb;
    transform: translateY(-1px);
    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
}

.table-action-link:active {
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(59, 130, 246, 0.2);
}
</style>

<div class="page-header">
    <div>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="/admin" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
            <div>
                <h1 style="margin: 0;">Invoices</h1>
                <p style="margin: 0; color: var(--text-light);">Manage and track all invoices</p>
            </div>
        </div>
    </div>
    <div>
        <% if (typeof isFulfillmentUser === 'undefined' || !isFulfillmentUser) { %>
        <a href="/admin/invoices/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create Invoice
        </a>
        <% } else { %>
        <span style="padding: 8px 16px; background: #e3f2fd; color: #1976d2; border-radius: 4px; font-size: 0.9rem;">
            <i class="fas fa-lock"></i> Read-Only Mode
        </span>
        <% } %>
    </div>
</div>

<!-- Filters -->
<div class="filter-controls">
    <div class="filter-group">
        <label>Status:</label>
        <select onchange="applyFilters()" id="status-filter" class="form-select-modern">
            <option value="">All Statuses</option>
            <option value="Draft" <%= filters.status === 'Draft' ? 'selected' : '' %>>Draft</option>
            <option value="Pending_Approval" <%= filters.status === 'Pending_Approval' ? 'selected' : '' %>>Pending Approval</option>
            <option value="Approved" <%= filters.status === 'Approved' ? 'selected' : '' %>>Approved</option>
            <option value="Fulfillment_Accepted" <%= filters.status === 'Fulfillment_Accepted' ? 'selected' : '' %>>Fulfillment Accepted</option>
            <option value="Manifested" <%= filters.status === 'Manifested' ? 'selected' : '' %>>Manifested</option>
            <option value="Shipped" <%= filters.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="Delivered" <%= filters.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="Paid" <%= filters.status === 'Paid' ? 'selected' : '' %>>Paid</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Source:</label>
        <select onchange="applyFilters()" id="source-filter" class="form-select-modern">
            <option value="">All Sources</option>
            <option value="Internal" <%= filters.source === 'Internal' ? 'selected' : '' %>>Internal</option>
            <option value="External" <%= filters.source === 'External' ? 'selected' : '' %>>External</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Fulfillment:</label>
        <select onchange="applyFilters()" id="fulfillment-filter" class="form-select-modern">
            <option value="all" <%= !filters.fulfillment_status || filters.fulfillment_status === 'all' ? 'selected' : '' %>>All</option>
            <option value="fulfilled" <%= filters.fulfillment_status === 'fulfilled' ? 'selected' : '' %>>Fulfilled</option>
            <option value="not_fulfilled" <%= filters.fulfillment_status === 'not_fulfilled' ? 'selected' : '' %>>Not Fulfilled</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Delivery:</label>
        <select onchange="applyFilters()" id="delivery-filter" class="form-select-modern">
            <option value="all" <%= !filters.delivery_status || filters.delivery_status === 'all' ? 'selected' : '' %>>All</option>
            <option value="delivered" <%= filters.delivery_status === 'delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="not_delivered" <%= filters.delivery_status === 'not_delivered' ? 'selected' : '' %>>Not Delivered</option>
        </select>
    </div>
    <button onclick="clearFilters()" class="btn-clear-filters">
        <i class="fas fa-times"></i> Clear Filters
    </button>
</div>

<!-- Invoice Table -->
<div class="dashboard-card">
    <% if (invoices && invoices.length > 0) { %>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">All Invoices (<span id="invoiceCount"><%= typeof pagination !== 'undefined' ? pagination.total : invoices.length %></span>)</h5>
            <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <label style="margin: 0; font-size: 0.9rem;">Items per page:</label>
                <select onchange="changeItemsPerPage(this.value)" style="padding: 0.25rem 0.5rem; border-radius: 4px;">
                    <option value="25" <%= pagination.limit === 25 ? 'selected' : '' %>>25</option>
                    <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50</option>
                    <option value="100" <%= pagination.limit === 100 ? 'selected' : '' %>>100</option>
                </select>
            </div>
            <% } %>
        </div>
        <div class="table-responsive">
            <table class="table table-hover modern-table">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Buyer</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Total</th>
                        <th>Created</th>
                        <% if (invoices.some(inv => inv.status === 'Draft' && inv.cart_expires_at)) { %>
                        <th>Expires</th>
                        <% } %>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% invoices.forEach(invoice => { %>
                        <tr data-invoice-id="<%= invoice.id %>">
                            <td data-field="invoice-number">
                                <span class="invoice-number-value" style="color: var(--text-color); font-size: 0.875rem; white-space: nowrap; display: block;">
                                    #<%= invoice.invoice_number || invoice.id %>
                                </span>
                            </td>
                            <td data-field="buyer" style="color: var(--text-color);"><%= invoice.buyer_name || 'Unknown Buyer' %></td>
                            <td data-field="location" style="color: var(--text-color);"><%= invoice.location_name || 'Unknown Location' %></td>
                            <td data-field="status">
                                <% const statusClass = (invoice.status || '').toLowerCase().replace(/_/g, ''); %>
                                <span class="status-badge status-<%= statusClass %> status-text">
                                    <%= (invoice.status || 'Unknown').replace(/_/g, ' ') %>
                                </span>
                            </td>
                            <td data-field="source">
                                <span class="source-badge source-<%= (invoice.source || 'internal').toLowerCase() %> source-text">
                                    <%= invoice.source || 'Internal' %>
                                </span>
                            </td>
                            <td data-field="total"><strong style="color: var(--text-color);">$<%= parseFloat(invoice.total || 0).toFixed(2) %></strong></td>
                            <td data-field="created" style="color: var(--text-color);"><%= invoice.created_at ? new Date(invoice.created_at).toLocaleDateString() : 'N/A' %></td>
                            <% if (invoices.some(inv => inv.status === 'Draft' && inv.cart_expires_at)) { %>
                            <td data-field="expires" style="color: var(--text-color);">
                                <% if (invoice.status === 'Draft' && invoice.cart_expires_at) { %>
                                    <span class="cart-expiration" style="<%= new Date(invoice.cart_expires_at) < new Date() ? 'color: #dc3545; font-weight: 600;' : '' %>">
                                        <%= new Date(invoice.cart_expires_at).toLocaleString() %>
                                    </span>
                                <% } else { %>
                                    <span style="color: #999;">—</span>
                                <% } %>
                            </td>
                            <% } %>
                            <td data-field="actions">
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <a href="/admin/invoices/<%= invoice.id %>" class="table-action-link">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <% if (invoice.status === 'Pending_Approval' && (isAdmin || isSalesAdmin) && (typeof isFulfillmentUser === 'undefined' || !isFulfillmentUser)) { %>
                                        <button data-invoice-id="<%= invoice.id %>" class="btn-approve btn btn-sm btn-success" style="background: #28a745; color: white; border: none; padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 0.875rem;">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                        <button data-invoice-id="<%= invoice.id %>" class="btn-reject btn btn-sm btn-danger" style="background: #dc3545; color: white; border: none; padding: 4px 12px; border-radius: 4px; cursor: pointer; font-size: 0.875rem;">
                                            <i class="fas fa-times"></i> Reject
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
        <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <button onclick="goToPage(<%= pagination.page - 1 %>)" 
                    class="btn btn-sm" 
                    style="<%= pagination.page === 1 ? 'opacity: 0.5; cursor: not-allowed;' : '' %>"
                    <%= pagination.page === 1 ? 'disabled' : '' %>>
                <i class="fas fa-chevron-left"></i> Previous
            </button>
            
            <div style="display: flex; gap: 0.25rem;">
                <% 
                const startPage = Math.max(1, pagination.page - 2);
                const endPage = Math.min(pagination.totalPages, pagination.page + 2);
                %>
                <% if (startPage > 1) { %>
                    <button onclick="goToPage(1)" class="btn btn-sm">1</button>
                    <% if (startPage > 2) { %>
                        <span style="padding: 0.5rem;">...</span>
                    <% } %>
                <% } %>
                
                <% for (let i = startPage; i <= endPage; i++) { %>
                    <button onclick="goToPage(<%= i %>)" 
                            class="btn btn-sm <%= i === pagination.page ? 'btn-primary' : '' %>"
                            style="<%= i === pagination.page ? 'background: var(--primary-color); color: white;' : '' %>">
                        <%= i %>
                    </button>
                <% } %>
                
                <% if (endPage < pagination.totalPages) { %>
                    <% if (endPage < pagination.totalPages - 1) { %>
                        <span style="padding: 0.5rem;">...</span>
                    <% } %>
                    <button onclick="goToPage(<%= pagination.totalPages %>)" class="btn btn-sm"><%= pagination.totalPages %></button>
                <% } %>
            </div>
            
            <button onclick="goToPage(<%= pagination.page + 1 %>)" 
                    class="btn btn-sm"
                    style="<%= pagination.page === pagination.totalPages ? 'opacity: 0.5; cursor: not-allowed;' : '' %>"
                    <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>>
                Next <i class="fas fa-chevron-right"></i>
            </button>
            
            <span style="margin-left: 1rem; color: var(--text-light); font-size: 0.9rem;">
                Page <%= pagination.page %> of <%= pagination.totalPages %>
            </span>
        </div>
        <% } %>
    <% } else { %>
        <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <h3>No Invoices Found</h3>
            <% if (typeof isSalesRep !== 'undefined' && isSalesRep) { %>
                <p>You don't have any invoices assigned to your locations yet. Invoices will appear here once they are created for locations you are assigned to.</p>
            <% } else { %>
                <p>There are no invoices matching your filters.<% if (typeof isFulfillmentUser === 'undefined' || !isFulfillmentUser) { %> Try adjusting your filters or create a new invoice.<% } else { %> Try adjusting your filters.<% } %></p>
                <% if (typeof isFulfillmentUser === 'undefined' || !isFulfillmentUser) { %>
                <a href="/admin/invoices/create" class="btn btn-primary" style="margin-top: 1rem;">
                    <i class="fas fa-plus"></i> Create Invoice
                </a>
                <% } %>
            <% } %>
        </div>
    <% } %>
</div>

<script id="invoice-ws-config" type="application/json">
<%- JSON.stringify({
    websocketPort: websocketPort || 8080,
    filters: filters || {}
}) %>
</script>

<script>
function applyFilters(page = 1) {
    const status = document.getElementById('status-filter').value;
    const source = document.getElementById('source-filter').value;
    const fulfillment = document.getElementById('fulfillment-filter').value;
    const delivery = document.getElementById('delivery-filter').value;
    
    const params = new URLSearchParams();
    if (status) params.append('status', status);
    if (source) params.append('source', source);
    if (fulfillment && fulfillment !== 'all') params.append('fulfillment_status', fulfillment);
    if (delivery && delivery !== 'all') params.append('delivery_status', delivery);
    if (page > 1) params.append('page', page);
    
    // Preserve limit if it exists
    const currentLimit = new URLSearchParams(window.location.search).get('limit');
    if (currentLimit) params.append('limit', currentLimit);
    
    window.location.search = params.toString();
}

function clearFilters() {
    window.location.href = '/admin/invoices';
}

function goToPage(page) {
    if (page < 1) return;
    applyFilters(page);
}

function changeItemsPerPage(limit) {
    const params = new URLSearchParams(window.location.search);
    params.set('limit', limit);
    params.set('page', '1'); // Reset to first page
    window.location.search = params.toString();
}

async function approveInvoice(invoiceId) {
    if (!confirm('Are you sure you want to approve this invoice?')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/invoices/${invoiceId}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        if (data.success) {
            if (typeof showNotification === 'function') {
                showNotification('Invoice approved successfully!', 'success');
            } else {
                alert('Invoice approved successfully!');
            }
            setTimeout(() => window.location.reload(), 1000);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('Error: ' + (data.error || 'Failed to approve invoice'), 'error');
            } else {
                alert('Error: ' + (data.error || 'Failed to approve invoice'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to approve invoice. Please try again.', 'error');
        } else {
            alert('Failed to approve invoice. Please try again.');
        }
    }
}

async function rejectInvoice(invoiceId) {
    const reason = prompt('Please provide a reason for rejection:');
    if (!reason) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/invoices/${invoiceId}/reject`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ reason })
        });
        
        const data = await response.json();
        if (data.success) {
            if (typeof showNotification === 'function') {
                showNotification('Invoice rejected successfully!', 'success');
            } else {
                alert('Invoice rejected successfully!');
            }
            setTimeout(() => window.location.reload(), 1000);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('Error: ' + (data.error || 'Failed to reject invoice'), 'error');
            } else {
                alert('Error: ' + (data.error || 'Failed to reject invoice'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to reject invoice. Please try again.', 'error');
        } else {
            alert('Failed to reject invoice. Please try again.');
        }
    }
}

// Add event listeners for approve/reject buttons
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', function() {
            const invoiceId = this.getAttribute('data-invoice-id');
            approveInvoice(parseInt(invoiceId));
        });
    });
    
    document.querySelectorAll('.btn-reject').forEach(btn => {
        btn.addEventListener('click', function() {
            const invoiceId = this.getAttribute('data-invoice-id');
            rejectInvoice(parseInt(invoiceId));
        });
    });
});

// WebSocket real-time updates
(function() {
    const wsConfigEl = document.getElementById('invoice-ws-config');
    let wsConfig = { websocketPort: 8080, filters: {} };

    if (wsConfigEl && wsConfigEl.textContent) {
        try {
            wsConfig = JSON.parse(wsConfigEl.textContent);
        } catch (error) {
            console.error('Failed to parse invoice WebSocket config:', error);
        }
    }

    const wsPort = Number(wsConfig.websocketPort || 8080);
    const invoiceFilters = wsConfig.filters || {};
    let ws;
    let reconnectTimer = null;
    let reloadTimer = null;

    function getWebSocketUrl() {
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const host = window.location.hostname;
        return `${protocol}://${host}:${wsPort}`;
    }

    function scheduleReconnect() {
        if (reconnectTimer) {
            return;
        }
        reconnectTimer = setTimeout(() => {
            reconnectTimer = null;
            connect();
        }, 5000);
    }

    function scheduleTableRefresh(delay = 1500) {
        if (reloadTimer) {
            return;
        }
        reloadTimer = setTimeout(() => {
            reloadTimer = null;
            window.location.reload();
        }, delay);
    }

    function invoicePassesFilters(invoice) {
        if (!invoice) {
            return false;
        }

        if (invoiceFilters.status && invoice.status !== invoiceFilters.status) {
            return false;
        }

        if (invoiceFilters.source && invoice.source !== invoiceFilters.source) {
            return false;
        }

        if (invoiceFilters.fulfillment_status === 'fulfilled') {
            const fulfilledStatuses = ['Fulfillment_Accepted', 'Manifested', 'Shipped', 'Delivered', 'Paid'];
            if (!fulfilledStatuses.includes(invoice.status)) {
                return false;
            }
        } else if (invoiceFilters.fulfillment_status === 'not_fulfilled') {
            const fulfilledStatuses = ['Fulfillment_Accepted', 'Manifested', 'Shipped', 'Delivered', 'Paid'];
            if (fulfilledStatuses.includes(invoice.status)) {
                return false;
            }
        }

        if (invoiceFilters.delivery_status === 'delivered') {
            const deliveredStatuses = ['Delivered', 'Paid'];
            if (!deliveredStatuses.includes(invoice.status)) {
                return false;
            }
        } else if (invoiceFilters.delivery_status === 'not_delivered') {
            const deliveredStatuses = ['Delivered', 'Paid'];
            if (deliveredStatuses.includes(invoice.status)) {
                return false;
            }
        }

        return true;
    }

    function updateInvoiceRow(invoice) {
        const row = document.querySelector(`tr[data-invoice-id="${invoice.id}"]`);
        if (!row) {
            // Row not on current page; safest to refresh once
            scheduleTableRefresh();
            return;
        }

        const numberCell = row.querySelector('[data-field="invoice-number"] .invoice-number-value');
        if (numberCell) {
            numberCell.textContent = `#${invoice.invoice_number || invoice.id}`;
        }

        const buyerCell = row.querySelector('[data-field="buyer"]');
        if (buyerCell) {
            buyerCell.textContent = invoice.buyer_name || 'Unknown Buyer';
        }

        const locationCell = row.querySelector('[data-field="location"]');
        if (locationCell) {
            locationCell.textContent = invoice.location_name || 'Unknown Location';
        }

        const statusCell = row.querySelector('[data-field="status"] .status-text');
        if (statusCell) {
            const statusClass = (invoice.status || '').toLowerCase().replace(/_/g, '');
            statusCell.className = `status-badge status-${statusClass} status-text`;
            statusCell.textContent = (invoice.status || 'Unknown').replace(/_/g, ' ');
        }

        const sourceCell = row.querySelector('[data-field="source"] .source-text');
        if (sourceCell) {
            const sourceClass = (invoice.source || 'internal').toLowerCase();
            sourceCell.className = `source-badge source-${sourceClass} source-text`;
            sourceCell.textContent = invoice.source || 'Internal';
        }

        const totalCell = row.querySelector('[data-field="total"] strong');
        if (totalCell) {
            totalCell.textContent = `$${Number(invoice.total || 0).toFixed(2)}`;
        }

        const createdCell = row.querySelector('[data-field="created"]');
        if (createdCell) {
            createdCell.textContent = invoice.created_at ? new Date(invoice.created_at).toLocaleDateString() : 'N/A';
        }

        const expiresCell = row.querySelector('[data-field="expires"] .cart-expiration');
        if (expiresCell) {
            if (invoice.status === 'Draft' && invoice.cart_expires_at) {
                const expiresAt = new Date(invoice.cart_expires_at);
                expiresCell.textContent = expiresAt.toLocaleString();
                if (expiresAt < new Date()) {
                    expiresCell.style.color = '#dc3545';
                    expiresCell.style.fontWeight = '600';
                } else {
                    expiresCell.style.color = '';
                    expiresCell.style.fontWeight = '';
                }
            } else {
                expiresCell.textContent = '—';
                expiresCell.style.color = '#999';
            }
        }
    }

    function handleInvoiceSync(payload) {
        const invoiceId = payload.invoice_id;
        const invoice = payload.invoice;

        if (!invoice) {
            const row = document.querySelector(`tr[data-invoice-id="${invoiceId}"]`);
            if (row) {
                row.parentElement.removeChild(row);
                scheduleTableRefresh();
            }
            return;
        }

        if (!invoicePassesFilters(invoice)) {
            const row = document.querySelector(`tr[data-invoice-id="${invoice.id}"]`);
            if (row) {
                row.parentElement.removeChild(row);
                scheduleTableRefresh();
            }
            return;
        }

        updateInvoiceRow(invoice);
    }

    function connect() {
        if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
            return;
        }

        try {
            ws = new WebSocket(getWebSocketUrl());
        } catch (error) {
            console.error('Failed to initialize WebSocket:', error);
            scheduleReconnect();
            return;
        }

        ws.addEventListener('open', () => {
            reconnectTimer = null;
        });

        ws.addEventListener('message', (event) => {
            try {
                const payload = JSON.parse(event.data);
                if (payload.type === 'invoice_sync') {
                    handleInvoiceSync(payload);
                }
            } catch (error) {
                console.error('Failed to parse WebSocket message:', error);
            }
        });

        ws.addEventListener('close', () => {
            scheduleReconnect();
        });

        ws.addEventListener('error', () => {
            scheduleReconnect();
        });
    }

    connect();
})();
</script>

