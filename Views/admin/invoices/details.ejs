        <!-- Report Fulfillment Issue Button - Visible when fulfillment has started and sales needs to make changes -->
        <% 
        // Show button when fulfillment has started (even if status is still "Approved")
        // Fulfillment has started when:
        // 1. Status is Fulfillment_Accepted, Manifested, or Partially_Manifested
        // 2. OR fulfillment_accepted_by is set (fulfillment has claimed the order)
        // 3. OR there's an active scanning session (fulfillment is scanning packages)
        const fulfillmentStatuses = ['Fulfillment_Accepted', 'Manifested', 'Partially_Manifested'];
        const hasFulfillmentClaimed = invoice.fulfillment_accepted_by && invoice.fulfillment_accepted_by !== null;
        const hasActiveScanning = invoice.has_active_scanning_session === true;
        const fulfillmentStarted = fulfillmentStatuses.includes(invoice.status) || hasFulfillmentClaimed || hasActiveScanning;
        const canReportIssue = fulfillmentStarted && 
                              invoice.status !== 'Fulfillment_Issue' && 
                              invoice.status !== 'Draft' && 
                              invoice.status !== 'Pending_Approval' &&
                              !isFulfillmentUser && 
                              (isSalesAdmin || isSalesRep || isAdmin);
        %>
        <% if (canReportIssue) { %>
        <div class="fulfillment-issue-alert" style="margin-top: 1.5rem; padding: 1rem; background: #fff3e0; border: 1px solid #ff9800; border-radius: 8px; border-left: 4px solid #ff9800;">
