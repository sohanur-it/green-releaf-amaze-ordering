// Line items editing functions
<% if (typeof invoice !== 'undefined' && invoice.fk_location_id) { %>
const locationId = <%= invoice.fk_location_id %>;
<% } else { %>
const locationId = null;
<% } %>
let productSearchTimeout;
let productCache = [];
const partialPackageCache = {};

function toggleEditMode() {
    isEditMode = !isEditMode;
    if (isEditMode) {
        document.getElementById('line-items-view').style.display = 'none';
        document.getElementById('line-items-edit').style.display = 'block';
        document.getElementById('edit-line-items-btn').innerHTML = '<i class="fas fa-times"></i> Cancel Edit';
        document.getElementById('edit-line-items-btn').classList.remove('btn-primary');
        document.getElementById('edit-line-items-btn').classList.add('btn-secondary');
        document.getElementById('edit-line-items-btn').setAttribute('onclick', 'cancelEditLineItems()');
        
        // Add event listeners for quantity changes
        document.querySelectorAll('.line-item-quantity').forEach(input => {
            input.addEventListener('input', updateLineItemTotal);
        });
        
        // Setup product search
        setupProductSearch();
    } else {
        cancelEditLineItems();
    }
}

function setupProductSearch() {
    const searchInput = document.getElementById('product-search-edit');
    if (!searchInput) return;
    
    // Clear any existing listeners
    searchInput.removeEventListener('input', handleProductSearch);
    searchInput.addEventListener('input', handleProductSearch);
    
    // Close search results on outside click
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#product-search-edit') && !e.target.closest('#product-search-results-edit')) {
            const resultsDiv = document.getElementById('product-search-results-edit');
            if (resultsDiv) resultsDiv.style.display = 'none';
        }
    });
}

function handleProductSearch(e) {
    clearTimeout(productSearchTimeout);
    const query = e.target.value.trim();
    const resultsDiv = document.getElementById('product-search-results-edit');
    
    if (query.length === 0) {
        if (resultsDiv) resultsDiv.style.display = 'none';
        return;
    }
    
    productSearchTimeout = setTimeout(() => {
        searchProductsForEdit(query);
    }, 300);
}

async function searchProductsForEdit(query) {
    if (!locationId) {
        if (typeof showNotification === 'function') {
            showNotification('Location ID not found. Cannot search products.', 'error');
        } else {
            alert('Location ID not found. Cannot search products.');
        }
        return;
    }
    
    try {
        const searchParam = query.trim().length > 0 ? `&search=${encodeURIComponent(query)}` : '';
        const response = await fetch(`/api/v1/invoices/products?location_id=${locationId}${searchParam}`);
        const data = await response.json();
        
        const resultsDiv = document.getElementById('product-search-results-edit');
        if (!resultsDiv) return;
        
        if (data.success && data.products && data.products.length > 0) {
            // Cache products
            productCache = data.products;
            
            resultsDiv.innerHTML = data.products.map(product => {
                // Products don't include batches - we'll fetch them when clicked
                const productName = escapeHtml((product.brand_name || 'AMAZE') + ' ' + product.name);
                return `
                    <div class="product-result-item" onclick="selectProductForEdit(${product.product_id})" style="padding: 0.75rem; border-bottom: 1px solid var(--border-color, #eee); cursor: pointer; transition: background-color 0.2s; color: var(--text-color);" onmouseover="this.style.backgroundColor='var(--bg-hover, #f8f9fa)'" onmouseout="this.style.backgroundColor='var(--card-bg, white)'">
                        <strong>${productName}</strong>
                        <div style="font-size: 0.9rem; color: var(--text-light, #666);">
                            ${product.product_type_name || ''} | $${parseFloat(product.default_price || 0).toFixed(2)}
                        </div>
                    </div>
                `;
            }).join('');
            resultsDiv.style.display = 'block';
        } else {
            resultsDiv.innerHTML = '<div class="product-result-item" style="padding: 0.75rem; color: var(--text-color);">No products found. Try a different search term.</div>';
            resultsDiv.style.display = 'block';
        }
    } catch (error) {
        console.error('Error searching products:', error);
        const resultsDiv = document.getElementById('product-search-results-edit');
        if (resultsDiv) {
            resultsDiv.innerHTML = '<div class="product-result-item" style="padding: 0.75rem; color: var(--error-color, #dc3545);">Error loading products. Please try again.</div>';
            resultsDiv.style.display = 'block';
        }
    }
}

function escapeHtml(str = '') {
    return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

async function selectProductForEdit(productId) {
    // Hide search results
    const resultsDiv = document.getElementById('product-search-results-edit');
    if (resultsDiv) resultsDiv.style.display = 'none';
    
    // Clear search input
    const searchInput = document.getElementById('product-search-edit');
    if (searchInput) searchInput.value = '';
    
    const productInfo = productCache.find(p => p.product_id === productId);
    const productLabel = productInfo
        ? `${productInfo.brand_name || 'AMAZE'} ${productInfo.name}`
        : 'Selected Product';
    
    // Load batches for this product
    try {
        const response = await fetch(`/api/v1/invoices/products/${productId}/batches?location_id=${locationId}`);
        const data = await response.json();
        
        if (data.success && data.batches && data.batches.length > 0) {
            showBatchSelectionModalForEdit(productId, productLabel, data.batches);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('No available batches found for this product', 'warning');
            } else {
                alert('No available batches found for this product');
            }
        }
    } catch (error) {
        console.error('Error loading batches:', error);
        if (typeof showNotification === 'function') {
            showNotification('Error loading batches. Please try again.', 'error');
        } else {
            alert('Error loading batches. Please try again.');
        }
    }
}

async function showBatchSelectionModalForEdit(productId, productLabel, batches) {
    closeBatchModalForEdit();
    
    const overlay = document.createElement('div');
    overlay.id = 'batch-selection-modal-edit';
    overlay.className = 'invoice-modal-overlay';
    overlay.innerHTML = `
        <div class="invoice-modal">
            <div class="modal-header">
                <h3>Select Batch</h3>
                <button type="button" class="btn btn-secondary" id="batch-modal-close-edit">Close</button>
            </div>
            <div class="modal-body">
                <p style="margin-top: 0; margin-bottom: 16px; color: var(--text-light, #6b7280); font-size: 0.95rem;">
                    ${escapeHtml(productLabel)}
                </p>
                <div id="batch-card-container-edit">Loading...</div>
            </div>
        </div>
    `;
    
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    
    const cardContainer = overlay.querySelector('#batch-card-container-edit');
    
    overlay.addEventListener('click', (event) => {
        if (event.target === overlay) {
            closeBatchModalForEdit();
        }
    });
    
    overlay.querySelector('#batch-modal-close-edit').addEventListener('click', closeBatchModalForEdit);
    
    try {
        // Separate batches into full packages and batches with partials
        const fullPackageBatches = batches.filter(batch => (batch.full_package_count || 0) > 0);
        const batchesWithPartials = batches.filter(batch => (batch.partial_package_count || 0) > 0);
        
        // Fetch all partial packages
        let allPartialPackages = [];
        for (const batch of batchesWithPartials) {
            try {
                if (!partialPackageCache[batch.id]) {
                    const response = await fetch(`/api/v1/batches/${batch.id}/partial-packages/available`);
                    const data = await response.json();
                    if (data.success && data.partial_packages) {
                        partialPackageCache[batch.id] = data.partial_packages.filter(pkg => pkg.available);
                    } else {
                        partialPackageCache[batch.id] = [];
                    }
                }
                
                const availablePartials = partialPackageCache[batch.id] || [];
                // Add batch info to each partial package
                availablePartials.forEach(pkg => {
                    allPartialPackages.push({
                        ...pkg,
                        batch_id: batch.id,
                        batch_name: batch.batch_name,
                        unit_price: batch.unit_price
                    });
                });
            } catch (error) {
                console.error(`Error loading partial packages for batch ${batch.id}:`, error);
            }
        }
        
        // Build HTML
        let html = '';
        
        // Full Packages Section
        if (fullPackageBatches.length > 0) {
            html += '<div class="batch-section">';
            html += '<div class="section-title">Full Packages</div>';
            html += fullPackageBatches.map(batch => `
                <div class="batch-card"
                     data-batch-id="${batch.id}"
                     data-batch-name="${escapeHtml(batch.batch_name)}"
                     data-unit-price="${batch.unit_price}"
                     data-available="${batch.available_quantity}">
                    <h4>${escapeHtml(batch.batch_name)}</h4>
                    <div class="batch-meta">
                        Available: ${batch.available_quantity} • Unit Price: $${parseFloat(batch.unit_price || 0).toFixed(2)}
                    </div>
                    <div class="batch-actions">
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <div>
                                <label for="batch-qty-${batch.id}" style="font-weight: 600; display: block; margin-bottom: 4px;">Quantity</label>
                                <input type="number"
                                       id="batch-qty-${batch.id}"
                                       min="1"
                                       value="1"
                                       max="${batch.available_quantity}"
                                       data-qty-input="${batch.id}"
                                       style="width: 80px;">
                            </div>
                            <div>
                                <label for="batch-price-${batch.id}" style="font-weight: 600; display: block; margin-bottom: 4px;">Price Override: $</label>
                                <input type="number"
                                       id="batch-price-${batch.id}"
                                       step="0.01"
                                       min="0"
                                       value="${parseFloat(batch.unit_price || 0).toFixed(2)}"
                                       data-price-input="${batch.id}"
                                       style="width: 100px;"
                                       placeholder="Auto">
                            </div>
                            <div style="align-self: flex-end;">
                                <button type="button" class="btn btn-primary" data-add-batch-edit="${batch.id}" style="margin-top: 0;">
                                    Add Batch
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
            html += '</div>';
        }
        
        // Partial Packages Section
        if (allPartialPackages.length > 0) {
            html += '<div class="batch-section">';
            html += '<div class="section-title">Partial Packages</div>';
            html += allPartialPackages.map((pkg, index) => `
                <div class="partial-package-card">
                    <div class="partial-package-info">
                        <div class="partial-package-label">${escapeHtml(pkg.label)}</div>
                        <div class="partial-package-meta">
                            Batch: ${escapeHtml(pkg.batch_name)} • Quantity: ${parseFloat(pkg.quantity || 0).toFixed(2)}
                        </div>
                    </div>
                    <div class="partial-package-actions">
                        <label style="font-size: 0.9rem; font-weight: 500; white-space: nowrap;">Price: $</label>
                        <input type="number" 
                               step="0.01" 
                               min="0" 
                               value="0.00" 
                               class="partial-price-input" 
                               data-partial-price-input="${pkg.batch_id}-${index}"
                               style="width: 100px; padding: 6px; border: 1px solid #ddd; border-radius: 4px; font-size: 0.9rem;">
                        <button type="button" class="btn btn-primary" data-add-partial-edit="${pkg.batch_id}" data-partial-label="${escapeHtml(pkg.label)}" data-partial-qty="${pkg.quantity}" data-partial-batch-name="${escapeHtml(pkg.batch_name)}" data-partial-index="${index}">
                            Add Package
                        </button>
                    </div>
                </div>
            `).join('');
            html += '</div>';
        }
        
        if (html === '') {
            html = '<div class="empty-state">No packages available.</div>';
        }
        
        cardContainer.innerHTML = html;
        
        // Add event listeners for full package batches
        overlay.querySelectorAll('[data-add-batch-edit]').forEach(button => {
            button.addEventListener('click', () => {
                const batchId = parseInt(button.dataset.addBatchEdit, 10);
                const card = button.closest('.batch-card');
                const available = parseInt(card.dataset.available, 10);
                const defaultUnitPrice = parseFloat(card.dataset.unitPrice);
                const batchName = card.dataset.batchName;
                const qtyInput = overlay.querySelector(`[data-qty-input="${batchId}"]`);
                const priceInput = overlay.querySelector(`[data-price-input="${batchId}"]`);
                const quantity = parseInt(qtyInput.value, 10);
                const manualPrice = priceInput ? parseFloat(priceInput.value) || defaultUnitPrice : defaultUnitPrice;
                
                if (!quantity || quantity <= 0) {
                    alert('Please enter a valid quantity.');
                    return;
                }
                
                if (quantity > available) {
                    alert(`Only ${available} units available for this batch.`);
                    return;
                }
                
                const isPriceOverridden = priceInput && parseFloat(priceInput.value) !== defaultUnitPrice;
                addProductToInvoice(productId, batchId, productLabel, batchName, manualPrice, quantity, [], false, isPriceOverridden);
                closeBatchModalForEdit();
            });
        });
        
        // Add event listeners for partial packages
        overlay.querySelectorAll('[data-add-partial-edit]').forEach(button => {
            button.addEventListener('click', () => {
                const batchId = parseInt(button.dataset.addPartialEdit, 10);
                const partialLabel = button.dataset.partialLabel;
                const partialQty = parseFloat(button.dataset.partialQty || 1);
                const batchName = button.dataset.partialBatchName || `Batch ${batchId}`;
                const partialIndex = button.dataset.partialIndex;
                
                // Get manual price from input (default 0)
                const priceInput = overlay.querySelector(`[data-partial-price-input="${batchId}-${partialIndex}"]`);
                const manualPrice = parseFloat(priceInput?.value || 0);
                
                // Add as individual line item with the partial package label
                addProductToInvoice(productId, batchId, productLabel, batchName, manualPrice, partialQty, [partialLabel], true);
                closeBatchModalForEdit();
            });
        });
    } catch (error) {
        console.error('Error loading batch data:', error);
        cardContainer.innerHTML = '<div class="empty-state">Error loading batches. Please try again.</div>';
    }
}

function closeBatchModalForEdit() {
    const existing = document.getElementById('batch-selection-modal-edit');
    if (existing) {
        existing.remove();
        document.body.style.overflow = '';
    }
}

async function addProductToInvoice(productId, batchId, productName, batchName, unitPrice, quantity = null, partialPackagesSelected = [], isPartialPackage = false, isPriceOverridden = false) {
    // Close batch modal
    closeBatchModalForEdit();
    
    // Use provided quantity or prompt
    let finalQuantity = quantity;
    if (!finalQuantity || finalQuantity <= 0) {
        const qtyInput = prompt(`Enter quantity for ${productName} (Batch: ${batchName}):`, '1');
        if (!qtyInput || isNaN(qtyInput) || parseInt(qtyInput) <= 0) {
            return;
        }
        finalQuantity = parseInt(qtyInput);
    }
    
    // Build request body
    const requestBody = {
        fk_batch_id: batchId,
        quantity: finalQuantity
    };
    
    // Add partial packages if provided
    if (isPartialPackage && partialPackagesSelected && partialPackagesSelected.length > 0) {
        requestBody.partial_packages_selected = partialPackagesSelected;
    }
    
    // For partial packages, always send manual_line_total (even if 0)
    // For price-overridden full packages, send manual_line_total if price was changed
    if (isPartialPackage) {
        // For partial packages, use the provided unitPrice directly as the total (not multiplied by quantity)
        // unitPrice is the manual price entered in the input (default 0)
        requestBody.manual_line_total = parseFloat(unitPrice) || 0;
    } else if (isPriceOverridden) {
        // For price-overridden full packages, calculate: unitPrice * quantity
        requestBody.manual_line_total = parseFloat(unitPrice) * finalQuantity;
    }
    
    try {
        const response = await fetch(`/api/v1/invoices/${invoiceId}/line-items`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestBody)
        });
        
