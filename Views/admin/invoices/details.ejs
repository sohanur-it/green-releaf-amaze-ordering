    overlay.innerHTML = `
        <div class="invoice-modal" style="background: var(--card-bg, white); border-radius: 8px; padding: 1.5rem; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color, #dee2e6); padding-bottom: 0.75rem;">
                <h3 style="margin: 0; color: var(--text-color);">Select Batch</h3>
                <button type="button" class="btn btn-secondary" id="batch-modal-close-edit" style="padding: 0.5rem 1rem; border-radius: 4px; border: 1px solid var(--border-color); background: var(--bg-color, #f8f9fa); color: var(--text-color); cursor: pointer;">Close</button>
            </div>
