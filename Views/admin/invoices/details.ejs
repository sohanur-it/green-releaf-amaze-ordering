    <div id="line-items-edit" style="display: none;">
            <!-- Product Search Section (only shown in edit mode) -->
            <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--bg-color, #f8f9fa); border-radius: 8px; border: 1px solid var(--border-color, #dee2e6);">
                <h4 style="margin-bottom: 0.75rem; color: var(--text-color);">Add New Products</h4>
                <div class="form-group" style="margin-bottom: 0; position: relative;">
                    <label for="product-search-edit" style="display: block; margin-bottom: 0.5rem; color: var(--text-color);">Search Products</label>
                    <input type="text" 
                           id="product-search-edit" 
                           placeholder="Search by product name, brand, or batch..." 
                           autocomplete="off"
                           style="width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid var(--border-color, #dee2e6); background: var(--card-bg, white); color: var(--text-color);">
                    <div id="product-search-results-edit" class="product-search-results" style="display: none; position: absolute; z-index: 1000; background: var(--card-bg, white); border: 1px solid var(--border-color, #dee2e6); border-radius: 4px; max-height: 300px; overflow-y: auto; width: 100%; margin-top: 0.25rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
                </div>
            </div>
            
            <table class="line-items-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Batch</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="editable-line-items-tbody">
                    <% if (lineItems && lineItems.length > 0) { %>
                        <% for (let i = 0; i < lineItems.length; i++) { 
                            const item = lineItems[i]; %>
                            <tr data-line-item-id="<%= item.id %>" data-batch-id="<%= item.fk_batch_id %>" data-product-name="<%= (item.brand_name || 'AMAZE') + ' ' + item.product_name %>">
                                <td>
                                    <strong style="color: var(--text-color);"><%= item.brand_name || 'AMAZE' %> <%= item.product_name %></strong>
                                </td>
                                <td style="color: var(--text-color);"><%= item.batch_name %></td>
                                <td>
                                    <input type="number" 
                                           class="line-item-quantity" 
