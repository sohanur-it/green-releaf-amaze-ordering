    const cardContainer = overlay.querySelector('#batch-card-container-edit');
    cardContainer.innerHTML = batches.map(batch => `
        <div class="batch-card" style="border: 1px solid var(--border-color, #dee2e6); border-radius: 8px; padding: 1rem; margin-bottom: 1rem; background: var(--card-bg, white);">
            <h4 style="margin: 0 0 0.5rem 0; color: var(--text-color);">${escapeHtml(batch.batch_name)}</h4>
            <div class="batch-meta" style="font-size: 0.9rem; color: var(--text-light, #666); margin-bottom: 1rem;">
                Available: ${batch.available_quantity} • Unit Price: $${parseFloat(batch.unit_price || 0).toFixed(2)}
            </div>
            <div class="batch-actions" style="display: flex; gap: 0.5rem; align-items: center;">
                <label for="batch-qty-${batch.id}" style="font-weight: 600; color: var(--text-color);">Quantity:</label>
                <input type="number"
                       id="batch-qty-${batch.id}"
                       min="1"
                       value="1"
                       max="${batch.available_quantity}"
                       style="width: 80px; padding: 0.5rem; border-radius: 4px; border: 1px solid var(--border-color); background: var(--card-bg, white); color: var(--text-color);">
                <button type="button" class="btn btn-primary" data-add-batch-edit="${batch.id}" style="padding: 0.5rem 1rem; border-radius: 4px; border: none; background: #007bff; color: white; cursor: pointer;">
                    Add Batch
                </button>
            </div>
        </div>
    `).join('');
    
    // Add event listeners
    overlay.querySelector('#batch-modal-close-edit').addEventListener('click', closeBatchModalForEdit);
    
    cardContainer.querySelectorAll('[data-add-batch-edit]').forEach(btn => {
        btn.addEventListener('click', function() {
            const batchId = parseInt(this.dataset.addBatchEdit);
