async function loadInvoicePreview() {
    try {
        console.log('Loading invoice preview for invoice:', invoiceId);
        const response = await fetch(`/api/v1/admin/override/invoice/${invoiceId}/preview`);
        
        if (!response.ok) {
            const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
            console.error('API error:', response.status, errorData);
            alert('Error loading invoice data: ' + (errorData.error || errorData.message || 'Unknown error'));
            return;
        }
        
        const data = await response.json();
        console.log('API response:', data);
        
        if (data.success && data.invoice) {
            const inv = data.invoice;
            console.log('Invoice data:', inv);
            
            // Populate current values
            const statusEl = document.getElementById('override-status');
            if (statusEl && inv.status) {
                statusEl.value = inv.status;
            }
            
            const manifestNumsEl = document.getElementById('override-manifest-numbers');
            if (manifestNumsEl && inv.metrc_manifest_numbers) {
                const manifestNums = Array.isArray(inv.metrc_manifest_numbers) 
                    ? inv.metrc_manifest_numbers 
                    : JSON.parse(inv.metrc_manifest_numbers || '[]');
                manifestNumsEl.value = JSON.stringify(manifestNums, null, 2);
            }
            
            const transportationEl = document.getElementById('override-transportation');
            if (transportationEl && inv.transportation_details) {
                const trans = typeof inv.transportation_details === 'string'
                    ? JSON.parse(inv.transportation_details)
                    : inv.transportation_details;
                transportationEl.value = JSON.stringify(trans, null, 2);
            }
            
            const fulfillmentAcceptedEl = document.getElementById('override-fulfillment-accepted');
            if (fulfillmentAcceptedEl && inv.fulfillment_accepted_at) {
                const date = new Date(inv.fulfillment_accepted_at);
                fulfillmentAcceptedEl.value = date.toISOString().slice(0, 16);
            }
            
            const fulfillmentIssueEl = document.getElementById('override-fulfillment-issue');
            if (fulfillmentIssueEl && inv.fulfillment_issue_reported_at) {
                const date = new Date(inv.fulfillment_issue_reported_at);
                fulfillmentIssueEl.value = date.toISOString().slice(0, 16);
            }
            
            const manifestCreatedEl = document.getElementById('override-manifest-created');
            if (manifestCreatedEl && inv.manifest_created_at) {
                const date = new Date(inv.manifest_created_at);
                manifestCreatedEl.value = date.toISOString().slice(0, 16);
            }
            
            console.log('Invoice preview loaded successfully');
        } else {
            console.warn('API returned success but no invoice data:', data);
            if (data.error) {
                alert('Error: ' + data.error);
            }
        }
    } catch (error) {
        console.error('Error loading invoice preview:', error);
        alert('Error loading invoice data: ' + error.message);
    }
}

async function handleAdminOverride(e) {
    e.preventDefault();
    
    const status = document.getElementById('override-status').value;
    const manifestNumbers = document.getElementById('override-manifest-numbers').value;
    const transportation = document.getElementById('override-transportation').value;
    const fulfillmentAccepted = document.getElementById('override-fulfillment-accepted').value;
    const fulfillmentIssue = document.getElementById('override-fulfillment-issue').value;
    const manifestCreated = document.getElementById('override-manifest-created').value;
    const reason = document.getElementById('override-reason').value.trim();
    const ticketNumber = document.getElementById('override-ticket-number').value.trim();
    
    // Validation
    if (reason.length < 20) {
        alert('Reason must be at least 20 characters');
        return;
    }
    
    if (!ticketNumber) {
        alert('Approval ticket number is required');
        return;
    }
    
    // Parse JSON fields
    let parsedManifestNumbers = null;
    if (manifestNumbers) {
        try {
            parsedManifestNumbers = JSON.parse(manifestNumbers);
        } catch (e) {
            alert('Invalid JSON format for manifest numbers');
            return;
        }
    }
    
    let parsedTransportation = null;
    if (transportation) {
        try {
            parsedTransportation = JSON.parse(transportation);
        } catch (e) {
            alert('Invalid JSON format for transportation details');
            return;
        }
    }
    
    try {
        const response = await fetch(`/api/v1/admin/override/invoice/${invoiceId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                status: status || undefined,
                metrc_manifest_numbers: parsedManifestNumbers,
                transportation_details: parsedTransportation,
                fulfillment_accepted_at: fulfillmentAccepted || null,
                fulfillment_issue_reported_at: fulfillmentIssue || null,
                manifest_created_at: manifestCreated || null,
                reason: reason,
                approval_ticket_number: ticketNumber
            })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            throw new Error(data.error || 'Failed to apply override');
        }
        
        // Close the modal first
        closeAdminOverrideModal();
        
        // Show success message and reload page to show updated data
        alert('Invoice fields updated successfully');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

