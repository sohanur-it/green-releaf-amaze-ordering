/**
 * Utility: Show loading state on button
 */
function setButtonLoading(button, isLoading) {
    if (!button) return;
    
    if (isLoading) {
        button.classList.add('btn-loading');
        button.disabled = true;
        button.dataset.originalText = button.innerHTML;
        // Keep the button text structure but make it transparent
        const icon = button.querySelector('i');
        if (icon) {
            icon.style.opacity = '0';
        }
    } else {
        button.classList.remove('btn-loading');
        button.disabled = false;
        if (button.dataset.originalText) {
            button.innerHTML = button.dataset.originalText;
            delete button.dataset.originalText;
        }
        const icon = button.querySelector('i');
        if (icon) {
            icon.style.opacity = '1';
        }
    }
}

// Initialize page - ensure "Kick Back to Fulfillment" button is visible if invoice is in Fulfillment_Issue status
document.addEventListener('DOMContentLoaded', () => {
    if (invoiceStatus === 'Fulfillment_Issue') {
        const kickBackBtn = document.getElementById('kick-back-btn');
        if (kickBackBtn) {
            // Button should already be visible from server-side rendering, but ensure it's shown
            kickBackBtn.style.display = 'inline-block';
        }
    }
    
    // Load manifest statuses if manifest numbers exist
    loadManifestStatuses();
});

/**
 * Load manifest statuses from API and update UI
 */
async function loadManifestStatuses() {
    const manifestNumbersDisplay = document.getElementById('manifest-numbers-display');
    if (!manifestNumbersDisplay) return;
    
    try {
        const response = await fetch(`/api/v1/manifests/invoice/${invoiceId}/statuses`);
        const data = await response.json();
        
        if (data.success && data.manifests && data.manifests.length > 0) {
            updateManifestStatusDisplay(data.manifests);
        } else {
            console.warn('No manifest statuses found or error:', data.error);
        }
    } catch (error) {
        console.error('Error loading manifest statuses:', error);
    }
}

/**
 * Update manifest status display in UI
 */
function updateManifestStatusDisplay(manifests) {
    const statusDetails = document.getElementById('manifest-status-details');
    const statusMessages = [];
    
    manifests.forEach(manifest => {
        const badge = document.querySelector(`[data-manifest-number="${manifest.manifestNumber}"]`);
        if (!badge) return;
        
        const indicator = badge.querySelector('.manifest-status-indicator');
        if (!indicator) return;
        
        let statusColor = '#9e9e9e'; // default gray
        let statusText = manifest.message || 'Unknown';
        let statusLabel = manifest.status;
        
        switch (manifest.status) {
            case 'active':
                statusColor = '#4caf50'; // green
                statusText = 'Active - Has not shipped yet';
                statusLabel = 'Active';
                break;
            case 'voided':
                statusColor = '#f44336'; // red
                statusText = 'Voided';
                statusLabel = 'Voided';
                break;
            case 'accepted':
                statusColor = '#2196f3'; // blue
                statusText = 'Accepted by dispensary';
                statusLabel = 'Accepted';
                break;
            case 'not_found':
                statusColor = '#ff9800'; // orange
                statusText = 'Not found in METRC';
                statusLabel = 'Not Found';
                break;
            case 'error':
                statusColor = '#9e9e9e'; // gray
                statusText = `Error: ${manifest.error || 'Unknown error'}`;
                statusLabel = 'Error';
                break;
        }
        
        indicator.style.background = statusColor;
        indicator.title = statusText;
        
        statusMessages.push(`${manifest.manifestNumber}: ${statusText}`);
    });
    
    if (statusDetails && statusMessages.length > 0) {
        statusDetails.innerHTML = '<strong>Status Details:</strong> ' + statusMessages.join(' • ');
    }
}

async function cloneInvoice() {
    if (!confirm('Create a duplicate of this invoice? This will copy all products and amounts.')) {
        return;
    }
    
    try {
        const response = await fetch(`/admin/invoices/${invoiceId}/clone`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        if (data.success) {
            let message = `Invoice cloned successfully! New Invoice: ${data.invoice_number}`;
            if (data.allocation_failures && data.allocation_failures.length > 0) {
                const failureCount = data.allocation_failures.length;
                const productNames = data.allocation_failures.map(f => f.product_name || 'Unknown').join(', ');
                message += `\n\n⚠️ ${failureCount} item(s) could not be cloned:\n${productNames}`;
                message += '\n\nPlease review the new invoice and adjust quantities or select different batches.';
            } else if (data.errors && data.errors.length > 0) {
                // Legacy support for old error format
                message += ' (Warnings: ' + data.errors.join(', ') + ')';
            }
            if (typeof showNotification === 'function') {
                showNotification(message, data.allocation_failures && data.allocation_failures.length > 0 ? 'warning' : 'success');
            } else {
                alert(message);
            }
            setTimeout(() => {
                window.location.href = `/admin/invoices/${data.invoice_id}`;
            }, 1500);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('Error: ' + (data.error || 'Failed to clone invoice'), 'error');
            } else {
                alert('Error: ' + (data.error || 'Failed to clone invoice'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to clone invoice. Please try again.', 'error');
        } else {
            alert('Failed to clone invoice. Please try again.');
        }
    }
}

