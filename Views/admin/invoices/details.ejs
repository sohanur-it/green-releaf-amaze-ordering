/**
 * View manifest PDF in modal
 */
async function viewManifestPDF(manifestNumber, invoiceId = null) {
    console.log('Opening PDF modal for manifest:', manifestNumber);
    
    const modal = document.getElementById('manifest-pdf-modal');
    const content = document.getElementById('manifest-pdf-content');
    const title = document.getElementById('pdf-modal-title');
    
    if (!modal || !content || !title) {
        console.error('Modal elements not found', { modal: !!modal, content: !!content, title: !!title });
        alert('Error: Could not find PDF modal elements. Please refresh the page.');
        return;
    }
    
    // Show modal with explicit display
    modal.style.display = 'flex';
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
    
    console.log('Modal displayed, setting title and loading state');
    title.textContent = `Manifest ${manifestNumber}`;
    
    // Clear and show loading state
    content.style.background = '#f8f9fa';
    content.style.minHeight = '500px';
    content.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: center; height: 100%; min-height: 500px; padding: 2rem;">
            <div style="text-align: center;">
                <i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: #1976d2; margin-bottom: 1rem;"></i>
                <p style="color: var(--text-color); font-weight: 500; margin: 0;">Loading PDF...</p>
                <p style="color: var(--text-light); font-size: 0.875rem; margin-top: 0.5rem;">Manifest: ${manifestNumber}</p>
            </div>
        </div>
    `;
    
    try {
        // Get the PDF URL from our API endpoint
        let pdfUrl = `/api/v1/manifests/${encodeURIComponent(manifestNumber)}/pdf`;
        if (invoiceId) {
            pdfUrl += `?invoiceId=${encodeURIComponent(invoiceId)}`;
        }
        console.log('Fetching PDF from:', pdfUrl);
        
        // Fetch the PDF with explicit error handling
        let response;
        try {
            response = await fetch(pdfUrl);
            console.log('PDF endpoint response status:', response.status);
            console.log('PDF endpoint response headers:', response.headers.get('content-type'));
        } catch (fetchError) {
            console.error('Fetch error:', fetchError);
            throw new Error(`Network error: ${fetchError.message}`);
        }
        
        const contentType = response.headers.get('content-type') || '';
        const isPDF = contentType.includes('application/pdf') || contentType.includes('pdf');
        
        if (!response.ok) {
            // It's an error response, try to get error message
            let errorMessage = `Server returned status ${response.status}`;
            try {
                const errorText = await response.text();
                console.log('Error response text:', errorText);
                try {
                    const errorData = JSON.parse(errorText);
                    errorMessage = errorData.error || errorData.message || errorMessage;
                } catch (e) {
                    errorMessage = errorText || errorMessage;
                }
            } catch (e) {
                // Not JSON, use status message
                errorMessage = `${response.status}: ${response.statusText}`;
            }
            throw new Error(errorMessage);
        }
        
        // Check if response is actually a PDF
        if (!isPDF) {
            // Might be JSON error disguised as success
            const responseText = await response.text();
            console.log('Response is not PDF, content:', responseText.substring(0, 200));
            try {
                const errorData = JSON.parse(responseText);
                throw new Error(errorData.error || errorData.message || 'The response is not a PDF file');
            } catch (e) {
                if (e.message && !e.message.includes('Unexpected token') && !e.message.includes('JSON')) {
                    throw e;
                }
                throw new Error(`The server response is not a PDF file. Content-Type: ${contentType}. Response: ${responseText.substring(0, 100)}`);
            }
        }
        
        // Re-fetch as blob (since we already consumed the response)
        const blobResponse = await fetch(pdfUrl);
        const blob = await blobResponse.blob();
        console.log('Created blob from response, size:', blob.size, 'bytes, type:', blob.type);
        
        if (blob.size === 0) {
            throw new Error('PDF file is empty (0 bytes)');
        }
        
        // Verify it's actually a PDF by checking first bytes
        const firstBytes = await blob.slice(0, 4).arrayBuffer();
        const pdfSignature = new Uint8Array(firstBytes);
        const isPDFFile = pdfSignature[0] === 0x25 && pdfSignature[1] === 0x50 && pdfSignature[2] === 0x44 && pdfSignature[3] === 0x46; // %PDF
        
        if (!isPDFFile) {
            const text = await blob.text();
            console.error('Not a valid PDF file, content:', text.substring(0, 200));
            throw new Error('The downloaded file is not a valid PDF. It may be an error message.');
        }
        
        const blobUrl = URL.createObjectURL(blob);
        console.log('Created blob URL for PDF:', blobUrl);
        
        // Create iframe to display PDF inline
        console.log('Creating iframe for PDF');
        content.style.background = 'white';
        
        // Simple iframe approach
        content.innerHTML = `
            <iframe 
                id="pdf-iframe"
                src="${blobUrl}" 
                style="width: 100%; height: 100%; border: none; min-height: 600px; display: block; background: white;"
                title="Manifest PDF Viewer"
                type="application/pdf"
                allowfullscreen
            ></iframe>
        `;
        
        // Handle iframe load events
        const iframe = document.getElementById('pdf-iframe');
        
        if (!iframe) {
            throw new Error('Failed to create PDF iframe');
        }
        
        // Show fallback if iframe doesn't load
        setTimeout(() => {
            // Check if iframe has loaded anything
            try {
                // If we can't detect load, show a fallback link
                const fallbackDiv = document.createElement('div');
                fallbackDiv.style.cssText = 'position: absolute; bottom: 1rem; right: 1rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.95); border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 10001;';
                fallbackDiv.innerHTML = `
                    <a href="${blobUrl}" target="_blank" style="color: #3b82f6; text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <i class="fas fa-external-link-alt"></i> Open PDF in new tab
                    </a>
                `;
                content.appendChild(fallbackDiv);
                
                // Remove after 5 seconds if PDF loaded
                setTimeout(() => {
                    if (fallbackDiv.parentNode) {
                        fallbackDiv.style.opacity = '0';
                        fallbackDiv.style.transition = 'opacity 0.3s';
                        setTimeout(() => fallbackDiv.remove(), 300);
                    }
                }, 5000);
            } catch (e) {
                console.error('Error creating fallback:', e);
            }
        }, 3000);
        
        // Clean up blob URL when modal is closed
        const cleanupBlob = () => {
            console.log('Cleaning up blob URL');
            URL.revokeObjectURL(blobUrl);
        };
        
        // Store cleanup function on modal for later
        modal._cleanupBlob = cleanupBlob;
        
    } catch (error) {
        console.error('Error loading manifest PDF:', error);
        console.error('Error stack:', error.stack);
        showPDFError(content, `/api/v1/manifests/${encodeURIComponent(manifestNumber)}/pdf`, error.message || 'An error occurred while loading the manifest PDF.');
    }
}

/**
 * Show PDF error message
 */
function showPDFError(content, pdfUrl, errorMessage) {
    if (!content) return;
    
    content.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: center; height: 100%; padding: 2rem;">
            <div style="text-align: center; max-width: 500px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #ef4444; margin-bottom: 1rem;"></i>
                <h4 style="color: var(--text-color); margin-bottom: 0.5rem;">Failed to Load PDF</h4>
                <p style="color: var(--text-light); margin-bottom: 1rem; font-size: 0.9rem;">
                    ${errorMessage || 'The manifest PDF could not be loaded. It may not be available yet or there was an error fetching it from METRC.'}
                </p>
                <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
                    <button onclick="window.open('${pdfUrl}', '_blank')" class="btn btn-primary" style="padding: 0.5rem 1rem; border-radius: 4px; border: none; cursor: pointer; background: #3b82f6; color: white;">
                        <i class="fas fa-external-link-alt"></i> Open in New Tab
                    </button>
                    <button onclick="closeManifestPDFModal()" class="btn btn-secondary" style="padding: 0.5rem 1rem; border-radius: 4px; border: none; cursor: pointer; background: #6c757d; color: white;">
                        Close
                    </button>
                </div>
                <div style="margin-top: 1rem; padding: 1rem; background: var(--bg-color, #f8f9fa); border-radius: 8px; text-align: left; font-size: 0.875rem; color: var(--text-light);">
                    <strong>Debug Info:</strong><br>
                    URL: <code style="font-size: 0.8rem; word-break: break-all;">${pdfUrl}</code>
                </div>
            </div>
        </div>
    `;
}

/**
 * Close manifest PDF modal
 */
function closeManifestPDFModal() {
    const modal = document.getElementById('manifest-pdf-modal');
    const content = document.getElementById('manifest-pdf-content');
    
    if (!modal || !content) return;
    
    // Cleanup blob URL if stored
    if (modal._cleanupBlob && typeof modal._cleanupBlob === 'function') {
        modal._cleanupBlob();
        delete modal._cleanupBlob;
    }
    
    // Cleanup any blob URLs from iframes
    const iframe = content.querySelector('#pdf-iframe');
    if (iframe && iframe.src && iframe.src.startsWith('blob:')) {
        URL.revokeObjectURL(iframe.src);
    }
    
    // Hide modal
    modal.style.display = 'none';
    modal.classList.remove('show');
    document.body.style.overflow = '';
    
    // Reset content
    content.style.background = '#f8f9fa';
    content.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: center; height: 100%; min-height: 500px; padding: 2rem;">
            <div style="text-align: center;">
                <i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--text-light); margin-bottom: 1rem;"></i>
                <p style="color: var(--text-light);">Loading PDF...</p>
            </div>
        </div>
    `;
}
</script>

<!-- Include notification system -->
<script src="/public/js/shared/notifications.js"></script>
<script>
// Ensure showNotification is available globally
if (typeof showNotification === 'undefined' && typeof NotificationSystem !== 'undefined') {
    window.showNotification = function(message, type = 'info', duration = 3000) {
        NotificationSystem.show(message, type, duration);
    };
}

// Request Global Issue
async function requestGlobalIssue() {
    const reason = prompt('Enter reason for requesting return to sales:');
    if (!reason) return;
    
    try {
        const response = await fetch('/api/v1/fulfillment/issues/request-global', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ invoice_id: invoiceId, reason: reason })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to request global issue');
        alert('Return request sent to fulfillment');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Acknowledge Global Issue
async function acknowledgeGlobalIssue() {
    if (!confirm('Acknowledge this return request? Order will be returned to sales.')) return;
    
    try {
        const response = await fetch(`/api/v1/fulfillment/issues/acknowledge-global/${invoiceId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to acknowledge');
        alert('Return request acknowledged');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Cancel Shipment
async function cancelShipment() {
    const reason = prompt('Enter cancellation reason:');
    if (!reason) return;
    
    if (!confirm('Cancel this shipment? Packages will need to be verified upon return.')) return;
    
    try {
        const response = await fetch('/api/v1/fulfillment/cancelled-shipments/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ invoice_id: invoiceId, cancellation_reason: reason, incident_type: 'customer_cancel' })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to cancel shipment');
        alert('Shipment cancelled. Awaiting package return confirmation.');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Confirm Packages Returned
async function confirmPackagesReturned() {
    if (!confirm('Confirm packages have returned to inventory? This will verify packages in METRC.')) return;
    
    try {
        const response = await fetch('/api/v1/fulfillment/cancelled-shipments/confirm-return', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ invoice_id: invoiceId })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to confirm return');
        alert(`${data.verified_count || 0} package(s) verified. ${data.not_found_count || 0} not yet found.`);
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Report Driver Incident
async function reportDriverIncident() {
    const description = prompt('Enter incident description:');
    if (!description) return;
    
    const notes = prompt('Additional notes (optional):') || '';
    
    try {
        const response = await fetch('/api/v1/fulfillment/cancelled-shipments/report-incident', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                invoice_id: invoiceId,
                incident_details: { description: description, notes: notes }
            })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to report incident');
        alert('Incident reported. Admin team will verify package status.');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

// Finalize Destroyed Packages
async function finalizeDestroyedPackages() {
    const packageLabels = prompt('Enter package labels to mark as destroyed (comma-separated):');
    if (!packageLabels) return;
    
    const reason = prompt('Enter destruction reason:');
    if (!reason) return;
    
    const labels = packageLabels.split(',').map(l => l.trim()).filter(l => l);
    const destroyedPackages = labels.map(label => ({
        package_label: label,
        destruction_reason: reason
    }));
    
    if (!confirm(`Mark ${labels.length} package(s) as permanently destroyed?`)) return;
    
    try {
        const response = await fetch(`/api/v1/admin/cancelled-shipments/${invoiceId}/finalize-destroyed`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ destroyed_packages: destroyedPackages })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to finalize destroyed packages');
        alert(`${data.packages_finalized} package(s) finalized. ${data.total_quantity_destroyed} units destroyed.`);
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}
</script>

