async function handleManuallyAddPackage(e) {
    e.preventDefault();
    
    const packageLabel = document.getElementById('package-label-input').value.trim().toUpperCase();
    const lineItemId = document.getElementById('line-item-select').value;
    const reason = document.getElementById('package-add-reason').value.trim();
    
    // Validation
    if (!packageLabel.match(/^[A-Z0-9]{24}$/)) {
        alert('Package label must be exactly 24 alphanumeric characters');
        return;
    }
    
    if (!lineItemId) {
        alert('Please select a line item');
        return;
    }
    
    if (reason.length < 20) {
        alert('Reason must be at least 20 characters');
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/admin/override/invoice/${invoiceId}/manually-add-package`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                package_label: packageLabel,
                line_item_id: parseInt(lineItemId),
                reason: reason
            })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            throw new Error(data.error || 'Failed to add package');
        }
        
        alert('Package added successfully');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

