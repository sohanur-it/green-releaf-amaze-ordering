/**
 * Show edit manifest modal with current manifest data from METRC
 */
async function showEditManifestModal(manifestNumber, invoiceId) {
    try {
        // Create or get modal
        let modal = document.getElementById('edit-manifest-modal');
        if (!modal) {
            modal = createEditManifestModal();
        }
        
        // Show loading state
        const modalContent = modal.querySelector('.modal-content');
        const originalContent = modalContent.innerHTML;
        modalContent.innerHTML = `
            <div style="padding: 2rem; text-align: center;">
                <i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--text-light); margin-bottom: 1rem;"></i>
                <p style="color: var(--text-light);">Loading manifest data...</p>
            </div>
        `;
        modal.classList.add('active');
        
        // Fetch current manifest data from API
        const response = await fetch(`/api/v1/fulfillment/manifest/edit/${invoiceId}`);
        const result = await response.json();
        
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to load manifest data');
        }
        
        const manifestData = result.data;
        
        // Restore modal content
        modalContent.innerHTML = originalContent;
        
        // Re-attach event listener (since we replaced the HTML)
        // Wait a moment for DOM to update
        setTimeout(() => {
            const form = modal.querySelector('#edit-manifest-form');
            if (form) {
                // Remove any existing listeners
                const newForm = form.cloneNode(true);
                form.parentNode.replaceChild(newForm, form);
                // Attach new listener
                document.getElementById('edit-manifest-form').addEventListener('submit', handleEditManifestSubmit);
            }
        }, 100);
        
        // Populate form with current manifest values from METRC
        document.getElementById('edit-driver-name').value = manifestData.driverName || '';
        document.getElementById('edit-driver-license').value = manifestData.driverLicense || '';
        document.getElementById('edit-driver-occupational-license').value = manifestData.driverOccupationalLicense || '';
        document.getElementById('edit-vehicle-make').value = manifestData.vehicleMake || '';
        document.getElementById('edit-vehicle-model').value = manifestData.vehicleModel || '';
        document.getElementById('edit-vehicle-plate').value = manifestData.vehiclePlate || '';
        
        // Set estimated times (convert ISO to datetime-local format)
        if (manifestData.estimatedDeparture) {
            const depDate = new Date(manifestData.estimatedDeparture);
            document.getElementById('edit-departure').value = depDate.toISOString().slice(0, 16);
        } else {
            document.getElementById('edit-departure').value = '';
        }
        
        if (manifestData.estimatedArrival) {
            const arrDate = new Date(manifestData.estimatedArrival);
            document.getElementById('edit-arrival').value = arrDate.toISOString().slice(0, 16);
        } else {
            document.getElementById('edit-arrival').value = '';
        }
        
        // Store manifest number and invoice ID for form submission
        modal.dataset.manifestNumber = manifestNumber;
        modal.dataset.invoiceId = invoiceId;
    } catch (error) {
        console.error('Error loading edit manifest modal:', error);
        alert(`Error loading manifest data: ${error.message}`);
        
        // Close modal on error
        const modal = document.getElementById('edit-manifest-modal');
        if (modal) {
            modal.classList.remove('active');
        }
    }
}

