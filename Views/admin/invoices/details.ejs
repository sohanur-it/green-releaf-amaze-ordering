        return;
    }
    
    if (!confirm('Are you sure you want to force release this allocation? This action cannot be undone.')) {
        return;
    }
    
    try {
        const response = await fetch('/api/v1/admin/override/force-release-allocation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                invoice_id: invoiceId,
                line_item_id: parseInt(lineItemId),
                batch_id: parseInt(batchId),
                reason: reason
            })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            throw new Error(data.error || 'Failed to release allocation');
        }
        
        alert('Allocation released successfully');
        window.location.reload();
    } catch (error) {
        alert('Error: ' + error.message);
    }
}
</script>

