async function saveLineItemChanges() {
    const changes = [];
    document.querySelectorAll('.line-item-quantity').forEach(input => {
        const lineItemId = input.dataset.lineItemId;
        const newQuantity = parseFloat(input.value);
        if (newQuantity && newQuantity > 0) {
            changes.push({
                lineItemId: parseInt(lineItemId),
                quantity: newQuantity
            });
        }
    });
    
    if (changes.length === 0) {
        if (typeof showNotification === 'function') {
            showNotification('No changes to save', 'info');
        } else {
            alert('No changes to save');
        }
        return;
    }

    // Get the save button and show loading state
    const saveButton = document.querySelector('button[onclick="saveLineItemChanges()"]');
    setButtonLoading(saveButton, true);

    try {
        // Update each line item
        for (const change of changes) {
            const response = await fetch(`/api/v1/invoices/${invoiceId}/line-items/${change.lineItemId}`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ quantity: change.quantity })
            });
            
            const data = await response.json();
            if (!data.success) {
                throw new Error(data.error || 'Failed to update line item');
            }
        }
        
        if (typeof showNotification === 'function') {
            showNotification('Line items updated successfully!', 'success');
        } else {
            alert('Line items updated successfully!');
        }
        
        // "Kick Back to Fulfillment" button should already be visible from server-side rendering
        // No need to show/hide it - it's always visible when invoice is in Fulfillment_Issue status
        
        // Don't reload immediately - let user click "Kick Back to Fulfillment" if needed
        // setTimeout(() => window.location.reload(), 1000);
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to update line items: ' + error.message, 'error');
        } else {
            alert('Failed to update line items: ' + error.message);
        }
    } finally {
        setButtonLoading(saveButton, false);
    }
}

/**
 * Edit line item price (for Fulfillment_Accepted status - price only updates)
 * For partial packages, sets line_total; for full packages, sets unit_price
 */
async function editLineItemPrice(lineItemId, currentPrice, isPartialPackage) {
    const isPartial = isPartialPackage === 'true' || isPartialPackage === true;
    const priceLabel = isPartial ? 'total price (line total)' : 'unit price';
    const newPrice = prompt(`Enter new ${priceLabel} (must be > 0 for METRC compliance):`, currentPrice);
    
    if (newPrice === null) {
        return; // User cancelled
    }
    
    const priceValue = parseFloat(newPrice);
    
    if (isNaN(priceValue) || priceValue <= 0) {
        if (typeof showNotification === 'function') {
            showNotification('Price must be a number greater than 0', 'error');
        } else {
            alert('Price must be a number greater than 0');
        }
        return;
    }
    
    try {
        const requestBody = {};
        if (isPartial) {
            // For partial packages, send line_total
            requestBody.line_total = priceValue;
        } else {
            // For full packages, send unit_price
            requestBody.unit_price = priceValue;
        }
        // Note: quantity is not sent, so backend treats this as price-only update
        
        const response = await fetch(`/api/v1/invoices/${invoiceId}/line-items/${lineItemId}`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestBody)
        });
        
        const data = await response.json();
        if (!data.success) {
            throw new Error(data.error || 'Failed to update price');
        }
        
        if (typeof showNotification === 'function') {
            showNotification('Price updated successfully!', 'success');
        } else {
            alert('Price updated successfully!');
        }
        
        // Reload page after a short delay to show updated totals
        setTimeout(() => window.location.reload(), 1000);
    } catch (error) {
        console.error('Error updating price:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to update price: ' + error.message, 'error');
        } else {
            alert('Failed to update price: ' + error.message);
        }
    }
}

/**
 * Report fulfillment issue to enable editing
 */
async function reportFulfillmentIssue() {
    const reason = prompt('Please describe the issue that requires changes to this invoice:');
    if (!reason || reason.trim().length < 10) {
        if (reason) {
            alert('Issue description must be at least 10 characters long.');
        }
        return;
    }
    
    if (!confirm('This will report a fulfillment issue and return the invoice to you for editing. Continue?')) {
        return;
    }
    
    // Get the button and show loading state
    const button = document.getElementById('report-issue-btn');
    setButtonLoading(button, true);
    
    try {
        // Create a generic issue for the entire invoice
        const issues = [{
            type: 'general',
            description: reason.trim(),
            batch_name: 'All items',
            batch_id: null
        }];
        
        const response = await fetch(`/api/v1/invoices/${invoiceId}/fulfillment/issue`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                issues: issues,
                note: reason.trim()
            })
        });
        
        const data = await response.json();
        
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Failed to report fulfillment issue');
        }
        
        if (typeof showNotification === 'function') {
            showNotification('Fulfillment issue reported successfully. You can now edit the invoice.', 'success');
        } else {
            alert('Fulfillment issue reported successfully. You can now edit the invoice.');
        }
        
        // Reload page to show updated status
        setTimeout(() => window.location.reload(), 1000);
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to report fulfillment issue: ' + error.message, 'error');
        } else {
            alert('Failed to report fulfillment issue: ' + error.message);
        }
    } finally {
        setButtonLoading(button, false);
    }
}

/**
 * Kick back invoice to fulfillment after fixing issues
 */
async function kickBackToFulfillment() {
    // Allow kick back to fulfillment without requiring line item modifications
    // Status can be changed when issues are resolved through other means
    // (e.g., clarification, note updates, etc.) without inventory changes
    
    if (!confirm('Are you sure you want to kick this invoice back to fulfillment? This will change the status from Fulfillment_Issue to Approved.')) {
        return;
    }
    
    // Get the button and show loading state
    const button = document.getElementById('kick-back-btn');
    setButtonLoading(button, true);
    
    try {
        const response = await fetch(`/api/v1/invoices/${invoiceId}/transition`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                status: 'Approved',
                reason: 'Sales rep fixed fulfillment issues and kicked back to fulfillment'
            })
        });
        
        const data = await response.json();
        
        if (!data.success) {
            throw new Error(data.error || 'Failed to kick back to fulfillment');
        }
        
        if (typeof showNotification === 'function') {
            showNotification('Invoice kicked back to fulfillment successfully!', 'success');
        } else {
            alert('Invoice kicked back to fulfillment successfully!');
        }
        
        setTimeout(() => window.location.reload(), 1000);
    } catch (error) {
        console.error('Error:', error);
        setButtonLoading(button, false);
        if (typeof showNotification === 'function') {
            showNotification('Failed to kick back to fulfillment: ' + error.message, 'error');
        } else {
            alert('Failed to kick back to fulfillment: ' + error.message);
        }
    }
}

/**
 * Show all history in modal
 */
async function showAllHistory() {
    const modal = document.getElementById('history-modal');
    const content = document.getElementById('full-history-content');
    
    // Show modal
    modal.classList.add('show');
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
    
    content.innerHTML = '<p style="text-align: center; color: var(--text-light);">Loading history...</p>';
    
    try {
        const response = await fetch(`/api/v1/invoices/${invoiceId}/history`);
        const data = await response.json();
        
        if (!data.success || !data.history) {
            throw new Error(data.error || 'Failed to load history');
        }
        
        if (data.history.length === 0) {
            content.innerHTML = '<p style="text-align: center; color: var(--text-light);">No history available</p>';
            return;
        }
        
        content.innerHTML = data.history.map(entry => {
            const changedBy = entry.changed_by_user_id 
                ? `Changed by <strong>${entry.changed_by_name || 'User #' + entry.changed_by_user_id}</strong>${entry.changed_by_email ? ' (' + entry.changed_by_email + ')' : ''}`
                : entry.changed_by_system 
                    ? 'Changed by <strong>System</strong>'
                    : 'Changed by <strong>Unknown</strong>';
            
            return `
                <div class="history-item">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <strong style="color: var(--text-color); text-transform: capitalize;">${entry.modification_type.replace(/_/g, ' ')}</strong>
                        <span style="font-size: 0.8rem; color: var(--text-light);">${new Date(entry.changed_at).toLocaleString()}</span>
                    </div>
                    <div style="color: var(--text-light); font-size: 0.9rem; margin-top: 4px;">
                        ${entry.reason || 'No additional details provided.'}
                    </div>
                    <div style="margin-top: 6px; font-size: 0.8rem; color: #6366f1;">
                        ${changedBy}
                    </div>
                </div>
            `;
        }).join('');
    } catch (error) {
        console.error('Error loading history:', error);
        content.innerHTML = `<p style="text-align: center; color: #ef4444;">Error loading history: ${error.message}</p>`;
    }
}

