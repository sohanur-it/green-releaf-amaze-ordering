/**
 * Void a manifest (only if still active/not shipped)
 */
async function voidManifest(manifestNumber, invoiceId) {
    // First check if manifest is still active (not shipped)
    try {
        const statusResponse = await fetch(`/api/v1/manifests/${encodeURIComponent(manifestNumber)}/status`);
        const statusData = await statusResponse.json();
        
        // Check the response structure
        // API should return: {success: true, status: 'active', data: {...}}
        // But might also return: {success: true, data: {isVoided: false, ...}}
        let manifestStatus = statusData.status;
        
        // If status is not at top level, check data object
        if (!manifestStatus && statusData.data) {
            // If data has isVoided, determine status from that
            if (statusData.data.isVoided === true) {
                manifestStatus = 'voided';
            } else if (statusData.data.isVoided === false) {
                // If in active transfers, status is 'active'
                // If in inactive transfers, status is 'accepted'
                // We can't tell from data alone, so assume 'active' if isVoided is false
                manifestStatus = 'active';
            }
        }
        
        // Only block if manifest is already voided
        if (manifestStatus === 'voided') {
            alert(`Cannot void manifest: Manifest is already voided.`);
            return;
        }
        
        // Warn user if manifest is accepted (not active), but allow them to proceed
        // METRC API will validate if the manifest can actually be voided
        if (manifestStatus === 'accepted') {
            if (!confirm(`Manifest is accepted (not active). METRC will validate if it can be voided. Do you want to proceed?`)) {
                return;
            }
        }
        
        // If status is still undefined, warn but allow proceeding (backend will validate)
        if (!manifestStatus) {
            console.warn('Could not determine manifest status from API response:', statusData);
            if (!confirm('Could not verify manifest status. Do you want to proceed with voiding? METRC will validate if the manifest can be voided.')) {
                return;
            }
        }
    } catch (error) {
        console.error('Error checking manifest status:', error);
        if (!confirm('Could not verify manifest status. Do you want to proceed with voiding? (Only proceed if manifest has not shipped)')) {
            return;
        }
    }
    
    // Get void reason from user
    const reason = prompt('Please provide a reason for voiding this manifest (minimum 20 characters):');
    if (!reason || reason.trim().length < 20) {
        alert('Void reason is required and must be at least 20 characters.');
        return;
    }
    
    if (!confirm(`Are you sure you want to void manifest ${manifestNumber}? This action cannot be undone.`)) {
        return;
    }
    
    try {
        const response = await fetch('/api/v1/fulfillment/manifest/void', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                invoice_id: invoiceId,
                reason: reason,
                target_manifest_or_license: manifestNumber
            })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
            // Check if it's a timeout/service error (503/504)
            if (response.status === 503 || response.status === 504) {
                const errorMsg = data.error || 'METRC API timeout. The server took too long to respond.';
                const retryMsg = data.retryable ? '\n\nThis is a temporary issue. Please try again in a few moments.' : '';
                throw new Error(`${errorMsg}${retryMsg}`);
            }
            throw new Error(data.error || 'Failed to void manifest');
        }
        
        alert(`Manifest ${manifestNumber} voided successfully. ${data.message || ''}`);
        // Reload page to show updated status
        window.location.reload();
    } catch (error) {
        console.error('Error voiding manifest:', error);
        alert(`Error: ${error.message}`);
    }
}

/**
 * Edit a manifest (only if still active/not shipped)
 */
async function editManifest(manifestNumber, invoiceId) {
    // First check if manifest is still active (not shipped)
    try {
        const statusResponse = await fetch(`/api/v1/manifests/${encodeURIComponent(manifestNumber)}/status`);
        const statusData = await statusResponse.json();
        
        // Check the response structure
        // API should return: {success: true, status: 'active', data: {...}}
        // But might also return: {success: true, data: {isVoided: false, ...}}
        let manifestStatus = statusData.status;
        
        // If status is not at top level, check data object
        if (!manifestStatus && statusData.data) {
            // If data has isVoided, determine status from that
            if (statusData.data.isVoided === true) {
                manifestStatus = 'voided';
            } else if (statusData.data.isVoided === false) {
                // If in active transfers, status is 'active'
                // If in inactive transfers, status is 'accepted'
                // We can't tell from data alone, so assume 'active' if isVoided is false
                manifestStatus = 'active';
            }
        }
        
        if (manifestStatus && manifestStatus !== 'active') {
            alert(`Cannot edit manifest: Manifest is ${manifestStatus}. Only active manifests (not yet shipped) can be edited.`);
            return;
        }
        
