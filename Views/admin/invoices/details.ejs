}

function closeBatchModalForEdit() {
    const existing = document.getElementById('batch-selection-modal-edit');
    if (existing) {
        existing.remove();
        document.body.style.overflow = '';
    }
}

async function addProductToInvoice(productId, batchId, productName, batchName, unitPrice, quantity = null) {
    // Close batch modal
    closeBatchModalForEdit();
    
    // Use provided quantity or prompt
    let finalQuantity = quantity;
    if (!finalQuantity || finalQuantity <= 0) {
        const qtyInput = prompt(`Enter quantity for ${productName} (Batch: ${batchName}):`, '1');
        if (!qtyInput || isNaN(qtyInput) || parseInt(qtyInput) <= 0) {
            return;
        }
        finalQuantity = parseInt(qtyInput);
    }
    
    try {
        const response = await fetch(`/api/v1/invoices/${invoiceId}/line-items`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                fk_batch_id: batchId,
                quantity: finalQuantity
            })
        });
        
        const data = await response.json();
        if (data.success) {
            if (typeof showNotification === 'function') {
                showNotification('Product added successfully!', 'success');
            } else {
                alert('Product added successfully!');
            }
            setTimeout(() => window.location.reload(), 1000);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('Error: ' + (data.error || 'Failed to add product'), 'error');
            } else {
                alert('Error: ' + (data.error || 'Failed to add product'));
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (typeof showNotification === 'function') {
            showNotification('Failed to add product. Please try again.', 'error');
        } else {
            alert('Failed to add product. Please try again.');
        }
    }
}

function cancelEditLineItems() {
