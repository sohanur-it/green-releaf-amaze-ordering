// Line items editing functions
<% if (typeof invoice !== 'undefined' && invoice.fk_location_id) { %>
const locationId = <%= invoice.fk_location_id %>;
<% } else { %>
const locationId = null;
<% } %>
let productSearchTimeout;
let productCache = [];

function toggleEditMode() {
    isEditMode = !isEditMode;
    if (isEditMode) {
        document.getElementById('line-items-view').style.display = 'none';
        document.getElementById('line-items-edit').style.display = 'block';
        document.getElementById('edit-line-items-btn').innerHTML = '<i class="fas fa-times"></i> Cancel Edit';
        document.getElementById('edit-line-items-btn').classList.remove('btn-primary');
        document.getElementById('edit-line-items-btn').classList.add('btn-secondary');
        document.getElementById('edit-line-items-btn').setAttribute('onclick', 'cancelEditLineItems()');
        
        // Add event listeners for quantity changes
        document.querySelectorAll('.line-item-quantity').forEach(input => {
            input.addEventListener('input', updateLineItemTotal);
        });
        
        // Setup product search
        setupProductSearch();
    } else {
        cancelEditLineItems();
    }
}

function setupProductSearch() {
    const searchInput = document.getElementById('product-search-edit');
    if (!searchInput) return;
    
    // Clear any existing listeners
    searchInput.removeEventListener('input', handleProductSearch);
    searchInput.addEventListener('input', handleProductSearch);
    
    // Close search results on outside click
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#product-search-edit') && !e.target.closest('#product-search-results-edit')) {
            const resultsDiv = document.getElementById('product-search-results-edit');
            if (resultsDiv) resultsDiv.style.display = 'none';
        }
    });
}

function handleProductSearch(e) {
    clearTimeout(productSearchTimeout);
    const query = e.target.value.trim();
    const resultsDiv = document.getElementById('product-search-results-edit');
    
    if (query.length === 0) {
        if (resultsDiv) resultsDiv.style.display = 'none';
        return;
    }
    
    productSearchTimeout = setTimeout(() => {
        searchProductsForEdit(query);
    }, 300);
}

async function searchProductsForEdit(query) {
    if (!locationId) {
        if (typeof showNotification === 'function') {
            showNotification('Location ID not found. Cannot search products.', 'error');
        } else {
            alert('Location ID not found. Cannot search products.');
        }
        return;
    }
    
    try {
        const searchParam = query.trim().length > 0 ? `&search=${encodeURIComponent(query)}` : '';
        const response = await fetch(`/api/v1/invoices/products?location_id=${locationId}${searchParam}`);
        const data = await response.json();
        
        const resultsDiv = document.getElementById('product-search-results-edit');
        if (!resultsDiv) return;
        
        if (data.success && data.products && data.products.length > 0) {
            // Cache products
            productCache = data.products;
            
            resultsDiv.innerHTML = data.products.map(product => {
                // Products don't include batches - we'll fetch them when clicked
                const productName = escapeHtml((product.brand_name || 'AMAZE') + ' ' + product.name);
                return `
                    <div class="product-result-item" onclick="selectProductForEdit(${product.product_id})" style="padding: 0.75rem; border-bottom: 1px solid var(--border-color, #eee); cursor: pointer; transition: background-color 0.2s; color: var(--text-color);" onmouseover="this.style.backgroundColor='var(--bg-hover, #f8f9fa)'" onmouseout="this.style.backgroundColor='var(--card-bg, white)'">
                        <strong>${productName}</strong>
                        <div style="font-size: 0.9rem; color: var(--text-light, #666);">
                            ${product.product_type_name || ''} | $${parseFloat(product.default_price || 0).toFixed(2)}
                        </div>
                    </div>
                `;
            }).join('');
            resultsDiv.style.display = 'block';
        } else {
            resultsDiv.innerHTML = '<div class="product-result-item" style="padding: 0.75rem; color: var(--text-color);">No products found. Try a different search term.</div>';
            resultsDiv.style.display = 'block';
        }
    } catch (error) {
        console.error('Error searching products:', error);
        const resultsDiv = document.getElementById('product-search-results-edit');
        if (resultsDiv) {
            resultsDiv.innerHTML = '<div class="product-result-item" style="padding: 0.75rem; color: var(--error-color, #dc3545);">Error loading products. Please try again.</div>';
            resultsDiv.style.display = 'block';
        }
    }
}

function escapeHtml(str = '') {
    return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

async function selectProductForEdit(productId) {
    // Hide search results
    const resultsDiv = document.getElementById('product-search-results-edit');
    if (resultsDiv) resultsDiv.style.display = 'none';
    
    // Clear search input
    const searchInput = document.getElementById('product-search-edit');
    if (searchInput) searchInput.value = '';
    
    const productInfo = productCache.find(p => p.product_id === productId);
    const productLabel = productInfo
        ? `${productInfo.brand_name || 'AMAZE'} ${productInfo.name}`
        : 'Selected Product';
    
    // Load batches for this product
    try {
        const response = await fetch(`/api/v1/invoices/products/${productId}/batches?location_id=${locationId}`);
        const data = await response.json();
        
        if (data.success && data.batches && data.batches.length > 0) {
            showBatchSelectionModalForEdit(productId, productLabel, data.batches);
        } else {
            if (typeof showNotification === 'function') {
                showNotification('No available batches found for this product', 'warning');
            } else {
                alert('No available batches found for this product');
            }
        }
    } catch (error) {
        console.error('Error loading batches:', error);
        if (typeof showNotification === 'function') {
            showNotification('Error loading batches. Please try again.', 'error');
        } else {
            alert('Error loading batches. Please try again.');
        }
    }
}

