<div class="page-header discount-header discount-header--bar">
    <div class="discount-header-left">
        <h2 class="discount-title">
            <span class="discount-title-icon" aria-hidden="true">
                <!-- Percentage tag icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 7h.01M17 17h.01M8 16l8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M21 11.5V7a2 2 0 0 0-2-2h-4.5a2 2 0 0 0-1.414.586l-7.5 7.5A2 2 0 0 0 5 14.5V19a2 2 0 0 0 2 2h4.5a2 2 0 0 0 1.414-.586l7.5-7.5A2 2 0 0 0 21 11.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            <span class="discount-title-text"><%= mode === 'assignments' ? 'Buyer Assignments' : 'Discount Pricing Engine' %></span>
        </h2>
    </div>
    <div class="discount-header-right">
        <a href="/admin" class="btn btn-outline-secondary" title="Back to Dashboard">
            ← Back
        </a>
        <button type="button" class="btn btn-outline-secondary" id="discountThemeToggle" title="Toggle Theme">
            <i class="fas fa-lightbulb"></i>
        </button>
        <div class="discount-mode-switch">
        <a href="/admin/discounts"
           class="btn <%= mode === 'builder' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Discount Builder
        </a>
        <a href="/admin/discounts/assignments"
           class="btn <%= mode === 'assignments' ? 'btn-primary' : 'btn-outline-secondary' %>">
            Buyer Assignments
        </a>
        </div>
    </div>
</div>

<% if (schemaMissing) { %>
<div class="alert alert-warning" role="alert" style="margin-top:20px;">
    <strong>Heads up:</strong> Discount builder tables are missing in this environment.
    Run <code>node scripts/add-discount-builder-schema.js</code> (using the appropriate env)
    to create <code>ORDERS-discount-codes</code>, <code>ORDERS-discount-rules</code>, and
    related tables, then refresh this page.
</div>
<% } %>

<% if (connectionError) { %>
<div class="alert alert-danger" role="alert" style="margin-top:20px;">
    <strong>Unable to connect:</strong> <%= connectionError %>.
    Check database connectivity/credentials and refresh the page once resolved.
</div>
<% } %>

<% if (!schemaMissing && !connectionError) { %>
<div id="discountFlash" class="inline-flash" style="display:none;"></div>
<div id="discountApp"
     class="discount-app"
     data-mode="<%= mode %>">
    <!-- Global loader for discount app -->
    <div class="sim-loading" id="discountGlobalLoading" style="display:none; position: fixed; top: 70px; left: 0; right: 0; bottom: 0; z-index: 4000;">
        <div class="spinner"></div>
    </div>
    <% if (mode === 'builder') { %>
    <div class="discount-column discount-library">
        <div class="panel-header panel-header--bar">
            <h4 class="discount-title-text-2">Discount Library</h4>
            <button class="btn btn-sm-2 btn-primary" id="createDiscountBtn">
                <i class="fas fa-plus"></i> Create New
            </button>
        </div>
        <div class="library-search">
            <input type="text" id="discountSearch" placeholder="Search codes...">
        </div>
        <ul class="discount-list" id="discountList"></ul>
    </div>

    <div class="discount-column discount-editor">
        <div class="panel-header panel-header--bar">
            <h3 id="editorTitle" class="discount-title-text-2">Editor</h3>
            <div class="editor-actions">
                <label class="switch">
                    <input type="checkbox" id="discountActiveToggle" checked>
                    <span class="slider"></span>
                </label>
                <span id="activeStatusText" class="toggle-status-text">Active</span>
                <button class="btn btn-danger btn-sm" id="deleteDiscountBtn">Delete</button>
                <button class="btn btn-primary btn-sm" id="saveDiscountBtn">Save Changes</button>
            </div>
        </div>
        <form class="styled-form" id="discountForm">
            <div class="form-group">
                <label>Display Name</label>
                <input type="text" name="display_name" required>
            </div>
            <div class="form-group">
                <label>Code Name (Unique ID)</label>
                <input type="text" name="code_name" required>
            </div>
            <div class="form-group">
                <label>Internal Notes</label>
                <textarea name="internal_notes" rows="2"></textarea>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Stacking Behavior</label>
                    <select name="stacking_behavior">
                        <option value="Current_Price">Current Price (stacks sequentially)</option>
                        <option value="Best_Price">Best Price (ignores previous discounts)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Minimum Quantity</label>
                    <input type="number" name="minimum_quantity" min="0" class="form-input-modern-2" placeholder="0">
                </div>
            </div>
        </form>

        <div class="logic-rules">
            <div class="panel-header panel-header--bar">
                <h4>Logic Rules</h4>
                <button class="btn btn-sm btn-outline-primary" id="addRuleBtn">+ Add Rule Group</button>
            </div>
            <div id="ruleList" class="rule-list empty-state">
                Select a discount to view rules.
            </div>
        </div>

        <div class="conflict-manager">
            <div class="panel-header panel-header--bar">
                <h4>Stacking Behavior & Conflicts</h4>
            </div>
            <div class="form-group">
                <label>Cannot Stack With</label>
                <select id="conflictSelect" multiple></select>
            </div>
            <button class="btn btn-outline-secondary btn-sm mt-2" id="saveConflictsBtn">Save Conflicts</button>
        </div>
    </div>

    <div class="discount-column discount-simulator">
        <div class="panel-header panel-header--bar">
            <h3 class="discount-title-text-2">Live Pricing Simulator</h3>
            <div class="editor-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="simRefreshBtn" title="Refresh latest discounts and rules">Refresh</button>
            </div>
        </div>
        <form id="simulatorForm" class="styled-form">
            <div class="form-group">
                <label>Simulate for Buyer</label>
                <select id="simBuyerSelect">
                    <option value="">Select a buyer…</option>
                    <% buyers.forEach(buyer => { %>
                        <option value="<%= buyer.entry_id %>"><%= buyer.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group sim-controls">
                <div class="sim-controls-left">
                    <label class="sim-controls-title">Test Cart</label>
                </div>
                <div class="sim-controls-right">
                    <button type="button" class="btn btn-outline-secondary btn-sm sim-action" id="fillSampleCart">Fill with Sample Products</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm sim-action" id="clearCartBtn">Clear Cart</button>
                </div>
            </div>
            <div id="simCart" class="sim-cart empty-state">
                Cart is empty
            </div>
            <button type="button" class="btn btn-primary btn-block" id="addItemBtn">+ Add Item</button>
        </form>

        <div class="calculation-breakdown">
            <div id="calcBreakdown" class="empty-state"></div>
        </div>
        <div class="totals-panel">
            <div><span>Subtotal (before discounts):</span><strong id="subtotalDisplay">$0.00</strong></div>
            <div><span>Total Discounts:</span><strong id="discountDisplay">-$0.00</strong></div>
            <div><span>Grand Total:</span><strong id="grandTotalDisplay">$0.00</strong></div>
        </div>
        <div class="sim-loading" id="simLoading" style="display:none;">
            <div class="spinner"></div>
        </div>
    </div>
    <% } else { %>
    <div class="discount-column discount-library">
        <div class="panel-header">
            <h3>Buyer Directory</h3>
        </div>
        <div class="library-search">
            <input type="text" id="buyerSearch" placeholder="Search buyers...">
        </div>
        <ul class="buyer-list" id="buyerList"></ul>
    </div>

    <div class="discount-column discount-editor">
        <div class="panel-header">
            <h3>Assigned Discounts</h3>
            <div class="editor-actions">
                <select id="assignDiscountSelect">
                    <option value="">Select discount to assign…</option>
                    <% discounts.forEach(discount => { %>
                        <option value="<%= discount.id %>"><%= discount.display_name %></option>
                    <% }) %>
                </select>
                <button class="btn btn-primary btn-sm" id="assignDiscountBtn">Assign</button>
            </div>
        </div>
        <div id="assignmentList" class="assignment-list empty-state">
            Select a buyer to view their discount stack.
        </div>
        <p class="text-muted" style="margin-top:12px;">
            Drag and drop discounts to reorder priority. Top items are applied first.
        </p>
    </div>

    <div class="discount-column discount-simulator">
        <div class="panel-header">
            <h3>Buyer Simulator</h3>
        </div>
        <form id="assignmentSimulatorForm" class="styled-form">
            <div class="form-group">
                <label>Simulate for Buyer</label>
                <select id="assignmentBuyerSelect">
                    <option value="">Select buyer…</option>
                    <% buyers.forEach(buyer => { %>
                        <option value="<%= buyer.entry_id %>"><%= buyer.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label>Cart Items</label>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="assignmentSampleCart">Sample Cart</button>
            </div>
            <div id="assignmentCart" class="sim-cart empty-state">Cart is empty</div>
            <button type="button" class="btn btn-primary btn-block" id="assignmentSimulateBtn">Run Simulation</button>
        </form>
        <div class="calculation-breakdown">
            <h5>Calculation Breakdown</h5>
            <div id="assignmentCalcBreakdown" class="empty-state">
                Select a buyer and run simulation to view calculations.
            </div>
        </div>
        <div class="totals-panel">
            <div><span>Subtotal (before discounts):</span><strong id="assignmentSubtotal">$0.00</strong></div>
            <div><span>Total Discounts:</span><strong id="assignmentDiscounts">-$0.00</strong></div>
            <div><span>Grand Total:</span><strong id="assignmentGrandTotal">$0.00</strong></div>
        </div>
    </div>
    <% } %>
</div>
<% } %>

<!-- Modals -->
<div class="modal-overlay" id="addItemModal" aria-hidden="true" style="display:none;">
    <div class="modal-dialog" role="dialog" aria-modal="true">
        <form id="addItemForm" class="styled-form">
            <div class="modal-header">
                <h3>Add Item to Cart</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <div class="discount-modal-grid">
                    <div class="form-group span-2">
                        <label>Product</label>
                        <select id="addItemProductSelect" required>
                            <option value="">Select a product…</option>
                        </select>
                    </div>
                    <div class="form-group span-2">
                        <label>Quantity (units)</label>
                        <input type="number" id="addItemQty" min="1" step="1" inputmode="numeric" value="1" required class="form-input-modern">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Add to Cart</button>
            </div>
        </form>
    </div>
    </div>

<div class="modal-overlay" id="discountModal" aria-hidden="true" style="display:none;">
    <div class="modal-dialog" role="dialog" aria-modal="true">
        <form id="newDiscountForm" class="styled-form">
            <div class="modal-header">
                <h3>New Discount Code</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <div class="discount-modal-grid">
                    <div class="form-group">
                        <label>Display Name</label>
                        <input type="text" name="display_name" required>
                    </div>
                    <div class="form-group">
                        <label>Code Name</label>
                        <input type="text" name="code_name" required>
                    </div>
                    <div class="form-group span-2">
                        <label>Internal Notes</label>
                        <textarea name="internal_notes" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Stacking Behavior</label>
                        <select name="stacking_behavior">
                            <option value="Current_Price">Current Price (stacks sequentially)</option>
                            <option value="Best_Price">Best Price (ignore previous discounts)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Minimum Quantity</label>
                        <input type="number" name="minimum_quantity" min="0" class="form-control-modern">
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select name="is_active">
                            <option value="true" selected>Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Create Discount</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="ruleModal" aria-hidden="true" style="display:none;">
    <div class="modal-dialog" role="dialog" aria-modal="true">
        <form id="ruleForm" class="styled-form">
            <div class="modal-header">
                <h3>Add Rule Group</h3>
                <button type="button" class="modal-close-btn" data-close-modal>&times;</button>
            </div>
            <div class="modal-body">
                <div class="discount-modal-grid">
                    <input type="hidden" name="discount_id" id="ruleDiscountId">
                    <div class="form-group span-2">
                        <label>Applies To</label>
                        <select name="applies_to" id="ruleAppliesTo" required>
                            <option value="Entire_Order">Entire Order</option>
                            <option value="Specific_Category">Specific Category</option>
                            <option value="Specific_Product">Specific Product</option>
                        </select>
                    </div>
                    <div class="form-group span-2" id="ruleCategoryField" style="display:none;">
                        <label>Category</label>
                        <select name="category_name">
                            <option value="">Select category…</option>
                        </select>
                    </div>
                    <div class="form-group span-2" id="ruleProductField" style="display:none;">
                        <label>Product</label>
                        <select name="fk_master_product_id">
                            <option value="">Select product…</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Action</label>
                        <select name="action" required>
                            <option value="Percentage_Off">Percentage Off</option>
                            <option value="Fixed_Amount_Off">Fixed Amount Off</option>
                            <option value="Set_Fixed_Price">Set Fixed Price</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Value</label>
                        <input type="number" name="value" min="0" step="1" inputmode="numeric" required class="form-input-modern-2">
                    </div>
                    <div class="form-group span-2">
                        <label>Notes / Metadata</label>
                        <textarea name="metadata" rows="2" placeholder='Optional JSON, e.g. {"unit":"gram"}'></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
                <button type="submit" class="btn btn-primary">Add Rule</button>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="discountAppPayload">
<%- JSON.stringify({
    mode,
    discounts: discounts || [],
    buyers: buyers || [],
    categories: categories || [],
    products: products || [],
    schemaMissing: !!schemaMissing,
    connectionError: connectionError || null
}).replace(/</g, '\\u003c') %>
</script>
<script>
    (function() {
        const el = document.getElementById('discountAppPayload');
        try {
            window.DISCOUNT_APP_DATA = el ? JSON.parse(el.textContent || '{}') : {};
        } catch (err) {
            console.error('Failed to parse discount payload', err);
            window.DISCOUNT_APP_DATA = {};
        }
    })();
</script>
<% if (!schemaMissing && !connectionError) { %>
<script src="/public/js/admin/discounts.js"></script>
<% } %>

