<!-- Modern Audit Logs with Chart.js Visualizations -->
<style>
.dashboard-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    margin-bottom: 1.5rem;
}

.stats-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 15px;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.stats-card h3 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0.5rem 0;
}

.stats-card p {
    margin: 0;
    opacity: 0.9;
    font-size: 0.875rem;
}

.modern-table {
    margin: 0;
}

.modern-table thead {
    background: #f8f9fa;
}

.modern-table th {
    font-weight: 600;
    color: #4b5563;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 1rem;
    border: none;
}

.modern-table td {
    padding: 0.75rem 1rem;
    vertical-align: middle;
    border-bottom: 1px solid #f3f4f6;
}

.modern-table tbody tr:hover {
    background: #f9fafb;
    cursor: pointer;
}

.action-code {
    background: #e0e7ff;
    color: #4f46e5;
    padding: 0.25rem 0.75rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: monospace;
}

.modern-filter {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    margin-bottom: 1.5rem;
}

.filter-badge {
    display: inline-block;
    background: #667eea;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    margin: 0.25rem;
    font-size: 0.875rem;
}

.filter-badge .remove {
    margin-left: 0.5rem;
    cursor: pointer;
    opacity: 0.8;
}

.filter-badge .remove:hover {
    opacity: 1;
}
</style>

<div class="container-fluid p-4">
    <!-- Refresh Button -->
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary" onclick="refreshData()">
            <i class="fas fa-sync me-1"></i> Refresh
        </button>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <i class="fas fa-clipboard-list fa-2x mb-2"></i>
                <h3 id="totalLogs">0</h3>
                <p>Total Logs</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <i class="fas fa-check-circle fa-2x mb-2"></i>
                <h3 id="successLogs">0</h3>
                <p>Successful Actions</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <i class="fas fa-exclamation-circle fa-2x mb-2"></i>
                <h3 id="failureLogs">0</h3>
                <p>Failed Actions</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                <i class="fas fa-calendar-day fa-2x mb-2"></i>
                <h3 id="todayLogs">0</h3>
                <p>Today's Activity</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="modern-filter">
        <h5 class="mb-3"><i class="fas fa-filter me-2"></i>Filters</h5>
        <div class="row">
            <div class="col-md-3">
                <select class="form-select" id="filterAction" onchange="applyFilters()">
                    <option value="">All Actions</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterResource" onchange="applyFilters()">
                    <option value="">All Resources</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterStatus" onchange="applyFilters()">
                    <option value="">All Statuses</option>
                    <option value="success">Success</option>
                    <option value="failure">Failure</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterUser" onchange="applyFilters()">
                    <option value="">All Users</option>
                </select>
            </div>
        </div>
        <div class="mt-3" id="activeFilters"></div>
    </div>

    <!-- Logs Table -->
    <div class="dashboard-card">
        <h5 class="mb-3"><i class="fas fa-list me-2"></i>Recent Activity</h5>
        <div class="table-responsive">
            <table class="table table-hover modern-table" id="logsTable">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Resource</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody id="logsTableBody">
                    <!-- Logs will be loaded here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="modal-title"><i class="fas fa-info-circle me-2"></i>Log Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="detailsContent">
                <!-- Details will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script>
let allLogs = [];
let filteredLogs = [];
let stats = {};

document.addEventListener('DOMContentLoaded', function() {
    loadStats();
    loadLogs();
    loadFilterOptions();
    
    // Fix modal positioning on window resize
    window.addEventListener('resize', function() {
        const modals = document.querySelectorAll('.modal.show');
        modals.forEach(modal => {
            const modalInstance = bootstrap.Modal.getInstance(modal);
            if (modalInstance) {
                // Force modal to recalculate position
                modalInstance._adjustDialog();
            }
        });
    });
    
    // Ensure modals are properly centered when shown
    document.addEventListener('shown.bs.modal', function(event) {
        const modal = event.target;
        const modalDialog = modal.querySelector('.modal-dialog');
        if (modalDialog) {
            // Force centering
            modalDialog.style.margin = '1.75rem auto';
        }
    });
});

async function loadStats() {
    try {
        const response = await fetch('/api/v1/admin/audit-logs/stats');
        const data = await response.json();
        
        if (data.success) {
            stats = data.data || data.stats;
            updateStatsDisplay();
        }
    } catch (error) {
        console.error('Error:', error);
    }
}

function updateStatsDisplay() {
    document.getElementById('totalLogs').textContent = stats.totalLogs || 0;
    
    const successCount = stats.statusBreakdown?.find(s => s.status === 'success')?.count || 0;
    const failureCount = stats.statusBreakdown?.find(s => s.status === 'failure')?.count || 0;
    
    document.getElementById('successLogs').textContent = successCount;
    document.getElementById('failureLogs').textContent = failureCount;
    
    // Calculate today's logs
    const today = new Date().toISOString().split('T')[0];
    const todayLog = stats.dailyActivity?.find(d => d.date?.startsWith(today));
    document.getElementById('todayLogs').textContent = todayLog?.count || 0;
}

async function loadLogs() {
    try {
        const params = new URLSearchParams({
            page: 1,
            limit: 100
        });
        
        const response = await fetch(`/api/v1/admin/audit-logs?${params}`);
        const data = await response.json();
        
        if (data.success) {
            allLogs = data.data?.logs || data.logs || [];
            filteredLogs = allLogs;
            renderLogs();
        }
    } catch (error) {
        console.error('Error:', error);
    }
}

async function loadFilterOptions() {
    try {
        const response = await fetch('/api/v1/admin/audit-logs/filters');
        const data = await response.json();
        
        if (data.success) {
            const filters = data.data || data.filters;
            populateFilterSelects(filters);
        }
    } catch (error) {
        console.error('Error:', error);
    }
}

function populateFilterSelects(filters) {
    // Actions
    const actionSelect = document.getElementById('filterAction');
    filters.actions?.forEach(action => {
        const option = document.createElement('option');
        option.value = action;
        option.textContent = action;
        actionSelect.appendChild(option);
    });
    
    // Resources
    const resourceSelect = document.getElementById('filterResource');
    filters.resourceTypes?.forEach(resource => {
        const option = document.createElement('option');
        option.value = resource;
        option.textContent = resource;
        resourceSelect.appendChild(option);
    });
    
    // Users
    const userSelect = document.getElementById('filterUser');
    filters.users?.forEach(user => {
        const option = document.createElement('option');
        option.value = user.id;
        option.textContent = user.fullName || user.username;
        userSelect.appendChild(option);
    });
}

function renderLogs() {
    const tbody = document.getElementById('logsTableBody');
    
    tbody.innerHTML = filteredLogs.map(log => `
        <tr onclick="showDetails(${log.id})">
            <td>
                <small>${new Date(log.timestamp).toLocaleString()}</small>
            </td>
            <td>
                <i class="fas fa-user me-1"></i>${log.userFullName || 'System'}
            </td>
            <td>
                <span class="action-code">${log.action}</span>
            </td>
            <td>
                ${log.resourceType ? `<i class="fas fa-cube me-1"></i>${log.resourceType}` : '<span class="text-muted">-</span>'}
            </td>
            <td>
                <span class="badge bg-${log.status === 'success' ? 'success' : 'danger'}">
                    ${log.status}
                </span>
            </td>
            <td>
                <button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); showDetails(${log.id})">
                    <i class="fas fa-eye"></i> View
                </button>
            </td>
        </tr>
    `).join('');
}

function applyFilters() {
    const action = document.getElementById('filterAction').value;
    const resource = document.getElementById('filterResource').value;
    const status = document.getElementById('filterStatus').value;
    const user = document.getElementById('filterUser').value;
    
    filteredLogs = allLogs.filter(log => {
        if (action && log.action !== action) return false;
        if (resource && log.resourceType !== resource) return false;
        if (status && log.status !== status) return false;
        if (user && log.userId != user) return false;
        return true;
    });
    
    currentPage = 1;
    renderLogs();
    updateActiveFilters();
}

function updateActiveFilters() {
    const container = document.getElementById('activeFilters');
    const filters = [];
    
    const action = document.getElementById('filterAction').value;
    const resource = document.getElementById('filterResource').value;
    const status = document.getElementById('filterStatus').value;
    
    if (action) filters.push({ type: 'action', value: action });
    if (resource) filters.push({ type: 'resource', value: resource });
    if (status) filters.push({ type: 'status', value: status });
    
    if (filters.length > 0) {
        container.innerHTML = filters.map(f => `
            <span class="filter-badge">
                ${f.type}: ${f.value}
                <span class="remove" onclick="removeFilter('${f.type}')">&times;</span>
            </span>
        `).join('');
    } else {
        container.innerHTML = '';
    }
}

function removeFilter(type) {
    document.getElementById(`filter${type.charAt(0).toUpperCase() + type.slice(1)}`).value = '';
    applyFilters();
}

async function showDetails(logId) {
    try {
        const response = await fetch(`/api/v1/admin/audit-logs/${logId}`);
        const data = await response.json();
        
        if (data.success) {
            const log = data.data;
            const content = document.getElementById('detailsContent');
            
            content.innerHTML = `
                <div class="mb-4">
                    <h6>Basic Information</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">User</small>
                                <div class="fw-bold">${log.userFullName || 'System'}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">Action</small>
                                <div class="fw-bold">${log.action}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted">Status</small>
                                <div><span class="badge bg-${log.status === 'success' ? 'success' : 'danger'}">${log.status}</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <h6>Details</h6>
                    <pre class="bg-light p-3 rounded">${JSON.stringify(log.details, null, 2)}</pre>
                </div>
            `;
            
            new bootstrap.Modal(document.getElementById('detailsModal')).show();
        }
    } catch (error) {
        console.error('Error:', error);
    }
}

function refreshData() {
    loadStats();
    loadLogs();
}
</script>

