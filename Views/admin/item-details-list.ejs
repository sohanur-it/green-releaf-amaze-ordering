<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/main.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main class="admin-container">
        <div class="page-header">
            <h1>Manage Product Details</h1>
            <p class="subtitle">Review batches and add product details for items missing information</p>
        </div>

        <div class="stats-cards">
            <div class="stat-card">
                <div class="stat-value" id="total-items">-</div>
                <div class="stat-label">Total Items</div>
            </div>
            <div class="stat-card success">
                <div class="stat-value" id="items-with-details">-</div>
                <div class="stat-label">With Details</div>
            </div>
            <div class="stat-card warning">
                <div class="stat-value" id="items-without-details">-</div>
                <div class="stat-label">Missing Details</div>
            </div>
        </div>

        <!-- items without details - priority section -->
        <div class="section-container">
            <div class="section-header">
                <h2>⚠️ Items Missing Details</h2>
                <p class="section-subtitle">These items need details before they can be listed on the order page</p>
            </div>
            <div id="without-details-list" class="batch-list">
                <!-- populated by JS -->
            </div>
        </div>

        <!-- items with details -->
        <div class="section-container">
            <div class="section-header">
                <h2>✅ Items With Details</h2>
                <button class="btn-collapse" onclick="toggleSection('with-details-list')">Collapse All</button>
            </div>
            <div id="with-details-list" class="batch-list">
                <!-- populated by JS -->
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts') %>

    <script src="/public/js/admin-item-details.js"></script>
</body>
</html>