<style>
.sessions-container {
    padding: 2rem;
}

.sessions-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.sessions-table {
    width: 100%;
    background: var(--card-bg, white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
}

.sessions-table table {
    width: 100%;
    border-collapse: collapse;
}

.sessions-table th {
    background: var(--bg-color, #f9fafb);
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--text-color);
    border-bottom: 2px solid var(--border-color);
}

.sessions-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-color);
}

.sessions-table tr:hover {
    background: var(--bg-color, #f9fafb);
}

.btn-action {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    margin-right: 0.5rem;
    font-size: 0.875rem;
}

.btn-force-complete {
    background: #ef4444;
    color: white;
}

.btn-view {
    background: #3b82f6;
    color: white;
}

.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
}

.filter-bar {
    background: var(--card-bg, white);
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
}
</style>

<div class="sessions-container">
    <div class="sessions-header">
        <div>
            <h1>Active Scanning Sessions</h1>
            <p style="color: var(--text-light); margin: 0.5rem 0 0 0;">Monitor and manage active scanning sessions</p>
        </div>
        <button class="btn btn-secondary" onclick="loadSessions()">
            <i class="fas fa-sync-alt"></i> Refresh
        </button>
    </div>

    <!-- 3.4.3: Abandoned Sessions Count Dashboard -->
    <div class="stats-cards" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div class="stat-card" style="background: var(--card-bg, white); padding: 1.5rem; border-radius: 12px; box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1)); border-left: 4px solid #3b82f6;">
            <h3 id="stat-active-sessions" style="margin: 0 0 0.5rem 0; font-size: 2rem; font-weight: 700; color: var(--text-color);">0</h3>
            <p style="margin: 0; color: var(--text-light); font-size: 0.9rem;">Active Sessions</p>
        </div>
        <div class="stat-card" style="background: var(--card-bg, white); padding: 1.5rem; border-radius: 12px; box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1)); border-left: 4px solid #f59e0b;">
            <h3 id="stat-abandoned-sessions" style="margin: 0 0 0.5rem 0; font-size: 2rem; font-weight: 700; color: var(--text-color);">0</h3>
            <p style="margin: 0; color: var(--text-light); font-size: 0.9rem;">Abandoned (Last 7 Days)</p>
        </div>
    </div>

    <div class="filter-bar">
        <div class="filter-group">
            <label>Worker</label>
            <select id="worker-filter" onchange="applyFilters()">
                <option value="">All Workers</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Duration (minutes)</label>
            <input type="number" id="duration-filter" placeholder="Greater than" onchange="applyFilters()">
        </div>
        <!-- 3.6.3: Add sort options -->
        <div class="filter-group">
            <label>Sort By</label>
            <select id="sort-by" onchange="applyFilters()">
                <option value="last_activity">Last Activity</option>
                <option value="duration">Duration</option>
                <option value="invoice_number">Invoice Number</option>
                <option value="worker">Worker</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Order</label>
            <select id="sort-order" onchange="applyFilters()">
                <option value="desc">Descending</option>
                <option value="asc">Ascending</option>
            </select>
        </div>
    </div>

    <div class="sessions-table">
        <table>
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Worker</th>
                    <th>Duration</th>
                    <th>Progress</th>
                    <th>Last Activity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="sessions-tbody">
                <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem;">
                        <i class="fas fa-spinner fa-spin"></i> Loading sessions...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Force Complete Modal -->
<div class="modal-overlay" id="force-complete-modal">
    <div class="modal-content">
        <h3>Force Complete Session</h3>
        <form id="force-complete-form">
            <div class="form-group">
                <label>Reason *</label>
                <textarea id="force-complete-reason" required rows="4" placeholder="Enter reason for force completing this session..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-back" onclick="closeForceCompleteModal()">Cancel</button>
                <button type="submit" class="btn-force-complete">Force Complete</button>
            </div>
        </form>
    </div>
</div>

<!-- 3.6.4 & 3.6.5: JSON Editor Modal with Validation Warning -->
<div class="modal-overlay" id="json-editor-modal">
    <div class="modal-content" style="max-width: 800px;">
        <h3><i class="fas fa-code"></i> Edit Session Data (JSON)</h3>
        <!-- 3.6.5: Validation warning modal -->
        <div id="json-warning-banner" style="background: #fef3c7; border: 2px solid #f59e0b; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
            <div style="display: flex; align-items: start; gap: 0.75rem;">
                <i class="fas fa-exclamation-triangle" style="color: #f59e0b; font-size: 1.5rem; margin-top: 0.25rem;"></i>
                <div>
                    <strong style="color: #92400e; display: block; margin-bottom: 0.5rem;">⚠️ Warning: This bypasses normal validation. Use with caution.</strong>
                    <p style="margin: 0; color: #78350f; font-size: 0.875rem;">
                        Manual JSON edits will not be validated through the normal scanning pipeline. 
                        Only modify session data if you understand the structure and implications.
                    </p>
                </div>
            </div>
        </div>
        <form id="json-editor-form">
            <div class="form-group">
                <label>Session ID</label>
                <input type="text" id="json-session-id" readonly style="background: #f3f4f6; cursor: not-allowed;">
            </div>
            <div class="form-group">
                <label>Currently Locked Packages (JSON) *</label>
                <textarea id="json-locked-packages" required rows="8" style="font-family: 'Courier New', monospace; font-size: 0.875rem;" placeholder='["1A40E0100000067000001234", "1A40E0100000067000001235"]'></textarea>
                <small style="color: var(--text-light); font-size: 0.75rem; margin-top: 0.25rem; display: block;">
                    Enter a valid JSON array of package labels (24 alphanumeric characters each)
                </small>
            </div>
            <div class="form-group">
                <label>Reason for Adjustment *</label>
                <textarea id="json-adjustment-reason" required rows="3" placeholder="Enter reason for this manual adjustment..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-back" onclick="closeJsonEditorModal()">Cancel</button>
                <button type="button" class="btn-action" style="background: #6b7280; color: white;" onclick="validateJsonEditor()">
                    <i class="fas fa-check-circle"></i> Validate JSON
                </button>
                <button type="submit" class="btn-action" style="background: #8b5cf6; color: white;">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/public/js/admin/fulfillment-sessions-admin.js"></script>

