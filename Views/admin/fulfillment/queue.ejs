<style>
.fulfillment-queue-container {
    padding: 2rem;
}

.queue-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.queue-stats {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: var(--card-bg, white);
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
    flex: 1;
    min-width: 200px;
}

.stat-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
}

.stat-card p {
    margin: 0;
    color: var(--text-light);
    font-size: 0.9rem;
}

.stat-card.pending {
    border-left: 4px solid #f59e0b;
}

.stat-card.in-progress {
    border-left: 4px solid #3b82f6;
}

.stat-card.issues {
    border-left: 4px solid #ef4444;
}

.order-card {
    background: var(--card-bg, white);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
}

.order-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow, 0 4px 12px rgba(0,0,0,0.15));
}

.order-card.claimed {
    border-left: 4px solid #3b82f6;
}

.order-card.available {
    border-left: 4px solid #10b981;
}

.order-card.issue {
    border-left: 4px solid #ef4444;
}

.order-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1rem;
}

.order-title {
    flex: 1;
}

.order-title h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-color);
}

.order-title p {
    margin: 0;
    color: var(--text-light);
    font-size: 0.875rem;
}

.order-status {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
}

.order-status.approved {
    background: #dbeafe;
    color: #1e40af;
}

.order-status.accepted {
    background: #dbeafe;
    color: #1e40af;
}

.order-status.issue {
    background: #fee2e2;
    color: #991b1b;
}

.order-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.order-detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.order-detail label {
    font-size: 0.75rem;
    color: var(--text-light);
    text-transform: uppercase;
    font-weight: 600;
}

.order-detail span {
    font-size: 0.9rem;
    color: var(--text-color);
    font-weight: 500;
}

.order-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
}

.btn-claim {
    background: #10b981;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-claim:hover {
    background: #059669;
}

.btn-claim:disabled {
    background: #9ca3af;
    cursor: not-allowed;
}

.btn-view {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-view:hover {
    background: #2563eb;
}

.filter-bar {
    background: var(--card-bg, white);
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-color);
}

.filter-group select,
.filter-group input {
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.9rem;
    min-width: 150px;
}

.loading {
    text-align: center;
    padding: 3rem;
    color: var(--text-light);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-light);
}

.empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.empty-state h3 {
    margin: 0.5rem 0;
    color: var(--text-color);
}

/* Modern Modal Styles */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 1;
    animation: fadeIn 0.2s ease-out;
}

.modal-overlay.closing {
    animation: fadeOut 0.2s ease-out forwards;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

/* Ensure modal is visible even if animation doesn't trigger */
.modal-overlay:not(.closing) {
    opacity: 1 !important;
}

@keyframes fadeOut {
    from {
        opacity: 1;
    }
    to {
        opacity: 0;
    }
}

.modal-container {
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    transform: scale(1) translateY(0);
    animation: modalSlideIn 0.3s ease-out;
}

.modal-overlay.closing .modal-container {
    animation: modalSlideOut 0.2s ease-out forwards;
}

@keyframes modalSlideIn {
    from {
        transform: scale(0.95) translateY(20px);
        opacity: 0;
    }
    to {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
}

@keyframes modalSlideOut {
    from {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
    to {
        transform: scale(0.95) translateY(20px);
        opacity: 0;
    }
}

.modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-color);
}

.modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: #6b7280;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all 0.2s;
}

.modal-close:hover {
    background: #f3f4f6;
    color: #374151;
}

.modal-body {
    padding: 1.5rem;
}

.modal-body p {
    margin: 0 0 1rem 0;
    color: var(--text-color);
    line-height: 1.6;
}

.modal-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 1rem;
    margin-top: 0.5rem;
    transition: border-color 0.2s;
}

.modal-input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.modal-footer {
    padding: 1.5rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
}

.modal-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
}

.modal-btn-primary {
    background: #3b82f6;
    color: white;
}

.modal-btn-primary:hover:not(:disabled) {
    background: #2563eb;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.modal-btn-secondary {
    background: #f3f4f6;
    color: #374151;
}

.modal-btn-secondary:hover:not(:disabled) {
    background: #e5e7eb;
}

.modal-btn-danger {
    background: #ef4444;
    color: white;
}

.modal-btn-danger:hover:not(:disabled) {
    background: #dc2626;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.modal-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* Loading Spinner */
.modal-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    gap: 1rem;
}

.spinner {
    width: 48px;
    height: 48px;
    border: 4px solid #f3f4f6;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.modal-loader p {
    margin: 0;
    color: var(--text-light);
    font-size: 0.875rem;
}

/* Success/Error Icons */
.modal-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 2rem;
    animation: scaleIn 0.3s ease-out;
}

@keyframes scaleIn {
    from {
        transform: scale(0);
    }
    to {
        transform: scale(1);
    }
}

.modal-icon-success {
    background: #d1fae5;
    color: #10b981;
}

.modal-icon-error {
    background: #fee2e2;
    color: #ef4444;
}

.modal-icon-warning {
    background: #fef3c7;
    color: #f59e0b;
}

.modal-icon-info {
    background: #dbeafe;
    color: #3b82f6;
}
</style>

<div class="fulfillment-queue-container">
    <div class="queue-header">
        <div>
            <h1>Fulfillment Queue</h1>
            <p style="color: var(--text-light); margin: 0.5rem 0 0 0;">Orders ready for fulfillment</p>
        </div>
        <div>
            <button class="btn btn-secondary" onclick="refreshQueue()">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="queue-stats">
        <div class="stat-card pending">
            <h3 id="stat-pending">0</h3>
            <p>Pending Orders</p>
        </div>
        <div class="stat-card in-progress">
            <h3 id="stat-in-progress">0</h3>
            <p>In Progress</p>
        </div>
        <div class="stat-card issues">
            <h3 id="stat-issues">0</h3>
            <p>Issues</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <div class="filter-group">
            <label>Status</label>
            <select id="status-filter" onchange="applyFilters()">
                <option value="">All</option>
                <option value="Approved">Approved</option>
                <option value="Fulfillment_Accepted">In Progress</option>
                <option value="Fulfillment_Issue">Issues</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Location</label>
            <input type="text" id="location-filter" placeholder="City or State" onchange="applyFilters()">
        </div>
        <div class="filter-group">
            <label>Customer</label>
            <input type="text" id="customer-filter" placeholder="Customer name" onchange="applyFilters()">
        </div>
        <div class="filter-group">
            <label>Delivery Zone</label>
            <select id="delivery-zone-filter" onchange="applyFilters()">
                <option value="">All Zones</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Sort By</label>
            <select id="sort-by" onchange="applyFilters()">
                <option value="age">Age (Oldest First)</option>
                <option value="value">Value (Highest First)</option>
                <option value="destination">Destination</option>
                <option value="customer">Customer</option>
                <option value="delivery_zone">Delivery Zone</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Items Per Page</label>
            <select id="page-size-select" onchange="changePageSize(this.value)">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <!-- Queue List -->
    <div id="queue-list">
        <div class="loading">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Loading queue...</p>
        </div>
    </div>

    <!-- Pagination -->
    <div id="pagination" style="display: none; margin-top: 2rem; text-align: center;">
        <button class="btn btn-secondary" id="prev-page" onclick="changePage(-1)">Previous</button>
        <span id="page-info" style="margin: 0 1rem;"></span>
        <button class="btn btn-secondary" id="next-page" onclick="changePage(1)">Next</button>
    </div>
</div>

<script>
    // Set current user ID for JavaScript (needed to show "Start Scanning" button)
    <% if (typeof currentUserId !== 'undefined' && currentUserId) { %>
    window.currentUserId = <%= currentUserId %>;
    <% } else { %>
    window.currentUserId = null;
    <% } %>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    window.isAdmin = true;
    <% } else { %>
    window.isAdmin = false;
    <% } %>
    <% if (typeof userRoles !== 'undefined' && userRoles && userRoles.includes('fulfillment_admin')) { %>
    window.isFulfillmentAdmin = true;
    <% } else { %>
    window.isFulfillmentAdmin = false;
    <% } %>
    <% if (typeof isSalesUser !== 'undefined' && isSalesUser) { %>
    window.isSalesUser = true;
    <% } else { %>
    window.isSalesUser = false;
    <% } %>
    <% if (typeof isFulfillmentUser !== 'undefined' && isFulfillmentUser) { %>
    window.isFulfillmentUser = true;
    <% } else { %>
    window.isFulfillmentUser = false;
    <% } %>
    console.log('Current User ID:', window.currentUserId); // Debug: check if it's set
    console.log('Is Sales User (Read-Only):', window.isSalesUser);
    console.log('Is Fulfillment User:', window.isFulfillmentUser);
</script>
<script src="/public/js/admin/fulfillment-queue.js"></script>

