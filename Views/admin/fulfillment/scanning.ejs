<style>
.scanning-container {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

.scanning-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.scanning-main {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 2rem;
}

.scanning-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.scanner-section {
    background: var(--card-bg, white);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
}

.scanner-input-container {
    position: relative;
    margin-bottom: 1.5rem;
}

.scanner-input {
    width: 100%;
    padding: 1rem 1.5rem;
    font-size: 1.5rem;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    text-align: center;
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
}

.scanner-input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.scanner-status {
    text-align: center;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-weight: 600;
}

.scanner-status.success {
    background: #d1fae5;
    color: #065f46;
}

.scanner-status.error {
    background: #fee2e2;
    color: #991b1b;
}

.scanner-status.warning {
    background: #fef3c7;
    color: #92400e;
}

.progress-overview {
    background: var(--card-bg, white);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
}

.progress-header {
    text-align: center;
    margin-bottom: 2rem;
}

.progress-count {
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0.5rem 0;
}

.progress-bar-container {
    width: 100%;
    height: 20px;
    background: var(--bg-color, #f3f4f6);
    border-radius: 10px;
    overflow: hidden;
    margin: 1rem 0;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #059669);
    transition: width 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
}

.line-items-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.line-item-card {
    background: var(--card-bg, white);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
}

.line-item-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1rem;
}

.line-item-title h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-color);
}

.line-item-title p {
    margin: 0;
    color: var(--text-light);
    font-size: 0.875rem;
}

.line-item-status {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
}

.line-item-status.not-started {
    background: #f3f4f6;
    color: #6b7280;
}

.line-item-status.in-progress {
    background: #dbeafe;
    color: #1e40af;
}

.line-item-status.complete {
    background: #d1fae5;
    color: #065f46;
}

.line-item-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
}

.line-item-progress-bar {
    flex: 1;
    height: 8px;
    background: var(--bg-color, #f3f4f6);
    border-radius: 4px;
    overflow: hidden;
}

.line-item-progress-fill {
    height: 100%;
    background: #3b82f6;
    transition: width 0.3s ease;
}

.scanned-packages {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
}

.scanned-packages h5 {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-color);
    text-transform: uppercase;
}

.package-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.package-tag {
    background: #e0e7ff;
    color: #3730a3;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-family: 'Courier New', monospace;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.package-tag .remove-btn {
    background: none;
    border: none;
    color: #6366f1;
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
}

.package-tag .remove-btn:hover {
    color: #4f46e5;
}

.action-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-color);
}

.btn-complete {
    background: #10b981;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    flex: 1;
    transition: background 0.2s;
}

.btn-complete:hover:not(:disabled) {
    background: #059669;
}

.btn-complete:disabled {
    background: #9ca3af;
    cursor: not-allowed;
}

.btn-cancel {
    background: #ef4444;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-cancel:hover {
    background: #dc2626;
}

.rejection-alert-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.rejection-alert-modal.active {
    display: flex;
}

.rejection-alert-content {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

.rejection-alert-content h3 {
    margin: 0 0 1rem 0;
    color: #991b1b;
}

.rejection-alert-content .alert-details {
    background: #fee2e2;
    padding: 1rem;
    border-radius: 8px;
    margin: 1rem 0;
}

.rejection-alert-content .alert-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
}

.btn-verify {
    background: #10b981;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    flex: 1;
}

.btn-skip {
    background: #6b7280;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    flex: 1;
}
</style>

<div class="scanning-container">
    <div class="scanning-header">
        <div>
            <h1>Package Scanning</h1>
            <p style="color: var(--text-light); margin: 0.5rem 0 0 0;">Invoice: <span id="invoice-number">Loading...</span></p>
        </div>
        <div>
            <button class="btn btn-secondary" onclick="window.location.href='/admin/fulfillment/queue'">
                <i class="fas fa-arrow-left"></i> Back to Queue
            </button>
        </div>
    </div>

    <div class="scanning-main">
        <div class="scanning-content">
            <!-- Scanner Input -->
            <div class="scanner-section">
                <h2 style="margin: 0 0 1.5rem 0;">Scan Package</h2>
                <div class="scanner-input-container">
                    <input 
                        type="text" 
                        id="scanner-input" 
                        class="scanner-input" 
                        placeholder="Scan barcode here..."
                        autocomplete="off"
                        autofocus
                    >
                </div>
                <div id="scanner-status" class="scanner-status" style="display: none;"></div>
            </div>

            <!-- Line Items -->
            <div id="line-items-container">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading order details...</p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="btn-cancel" onclick="cancelScanning()">
                    <i class="fas fa-times"></i> Cancel Scanning
                </button>
                <button class="btn btn-warning" onclick="showIssueModal()" style="background: #f59e0b; color: white; border: none; padding: 1rem 2rem; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    <i class="fas fa-exclamation-triangle"></i> Report Issue
                </button>
                <button class="btn-complete" id="btn-complete" onclick="completeScanning()" disabled>
                    <i class="fas fa-check"></i> Complete Scanning
                </button>
            </div>
        </div>

        <!-- Progress Sidebar -->
        <div class="progress-overview">
            <div class="progress-header">
                <h2>Overall Progress</h2>
                <div class="progress-count" id="progress-count">0 / 0</div>
                <div class="progress-bar-container">
                    <div class="progress-bar" id="progress-bar" style="width: 0%">0%</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Issue Reporting Modal -->
<div class="rejection-alert-modal" id="issue-modal">
    <div class="rejection-alert-content">
        <h3><i class="fas fa-exclamation-triangle"></i> Report Fulfillment Issue</h3>
        <form id="issue-form">
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Issue Type</label>
                <select id="issue-type" required style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px;">
                    <option value="">Select Issue Type</option>
                    <option value="batch_unavailable">Batch Unavailable</option>
                    <option value="package_damaged">Package Damaged</option>
                    <option value="package_quantity_mismatch">Quantity Mismatch</option>
                    <option value="package_missing_from_metrc">Package Missing from METRC</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Line Item ID (optional)</label>
                <input type="number" id="issue-line-item" placeholder="Leave blank for general issue" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Description <span style="color: #ef4444;">*</span></label>
                <textarea id="issue-description" required rows="4" placeholder="Describe the issue..." style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 6px; resize: vertical;"></textarea>
            </div>
            <div class="alert-actions">
                <button type="button" class="btn-skip" onclick="closeIssueModal()">Cancel</button>
                <button type="submit" class="btn-verify">Report Issue</button>
            </div>
        </form>
    </div>
</div>

<!-- Rejection Alert Modal -->
<div class="rejection-alert-modal" id="rejection-modal">
    <div class="rejection-alert-content">
        <h3><i class="fas fa-exclamation-triangle"></i> Rejection Alert</h3>
        <p>This package was previously rejected. Please verify it is ready for sale before continuing.</p>
        <div class="alert-details" id="alert-details"></div>
        <div class="alert-actions">
            <button class="btn-verify" onclick="verifyRejectedPackage()">
                <i class="fas fa-check"></i> Verify & Continue
            </button>
            <button class="btn-skip" onclick="skipRejectedPackage()">
                <i class="fas fa-times"></i> Skip Package
            </button>
        </div>
    </div>
</div>

<script>
    // Pass invoice ID to JavaScript
    window.invoiceId = <%= invoiceId %>;
    window.sessionId = null;
    window.currentPackageLabel = null;
    window.rejectionAlert = null;
</script>
<script src="/public/js/admin/fulfillment-scanning.js"></script>

