<style>
.manifest-container {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.manifest-header {
    margin-bottom: 2rem;
}

.manifest-preview {
    background: var(--card-bg, white);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--card-shadow, 0 2px 8px rgba(0,0,0,0.1));
}

.manifest-preview h2 {
    margin: 0 0 1.5rem 0;
    font-size: 1.5rem;
    color: var(--text-color);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.75rem;
}

.manifest-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.summary-item label {
    font-size: 0.875rem;
    color: var(--text-light);
    font-weight: 600;
    text-transform: uppercase;
}

.summary-item span {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-color);
}

.manifest-warning {
    background: #fef3c7;
    border: 1px solid #f59e0b;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 2rem;
    color: #92400e;
}

.manifest-warning i {
    margin-right: 0.5rem;
}

.packages-list {
    margin-top: 2rem;
}

.packages-list h3 {
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
    color: var(--text-color);
}

.package-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--bg-color, #f9fafb);
    border-radius: 8px;
    margin-bottom: 0.5rem;
}

.package-item .package-label {
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: var(--text-color);
}

.package-item .package-details {
    display: flex;
    gap: 2rem;
    color: var(--text-light);
    font-size: 0.9rem;
}

.manifest-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-color);
}

.btn-create {
    background: #10b981;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    flex: 1;
    transition: background 0.2s;
}

.btn-create:hover:not(:disabled) {
    background: #059669;
}

.btn-create:disabled {
    background: #9ca3af;
    cursor: not-allowed;
}

.btn-back {
    background: #6b7280;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-back:hover {
    background: #4b5563;
}

.loading-manifest {
    text-align: center;
    padding: 3rem;
    color: var(--text-light);
}

.manifest-success {
    background: #d1fae5;
    border: 1px solid #10b981;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
    text-align: center;
}

.manifest-success h3 {
    margin: 0 0 1rem 0;
    color: #065f46;
}

.manifest-success .manifest-numbers {
    margin: 1rem 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: #065f46;
    font-family: 'Courier New', monospace;
}

.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-content h3 {
    margin: 0 0 1.5rem 0;
    color: var(--text-color);
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--text-color);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.9rem;
}

.modal-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    justify-content: flex-end;
}

.btn-void {
    background: #ef4444;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
}

.btn-update {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
}

/* Section 17.2.2: Dry Run Validation Modal Styles */
.validation-success {
    background: #d1fae5;
    border: 2px solid #10b981;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    margin: 1rem 0;
}

.validation-success i {
    font-size: 3rem;
    color: #10b981;
    margin-bottom: 1rem;
}

.validation-success h3 {
    margin: 0.5rem 0;
    color: #065f46;
}

.validation-errors {
    background: #fee2e2;
    border: 2px solid #ef4444;
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1rem 0;
}

.validation-errors i {
    font-size: 2rem;
    color: #ef4444;
    margin-bottom: 0.5rem;
}

.validation-errors h3 {
    margin: 0.5rem 0;
    color: #991b1b;
}

.validation-details {
    margin-top: 1.5rem;
}

.license-validation {
    background: white;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    border-left: 4px solid #9ca3af;
}

.license-validation.success {
    border-left-color: #10b981;
}

.license-validation.error {
    border-left-color: #ef4444;
}

.license-validation h4 {
    margin: 0 0 0.75rem 0;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.license-validation h4 i {
    font-size: 1rem;
}

.license-validation.success h4 i {
    color: #10b981;
}

.license-validation.error h4 i {
    color: #ef4444;
}

.error-list, .warning-list {
    margin: 0.5rem 0 0 1.5rem;
    padding: 0;
    list-style: disc;
}

.error-list li {
    color: #991b1b;
    margin: 0.5rem 0;
}

.warning-list li {
    color: #92400e;
    margin: 0.5rem 0;
}

.error-list strong, .warning-list strong {
    font-family: 'Courier New', monospace;
}
</style>

<div class="manifest-container">
    <div class="manifest-header">
        <h1>Create METRC Manifest</h1>
        <p style="color: var(--text-light); margin: 0.5rem 0 0 0;">Invoice: <span id="invoice-number">Loading...</span></p>
    </div>

    <div id="manifest-content">
        <div class="loading-manifest">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Loading manifest preview...</p>
        </div>
    </div>
</div>

<script>
    window.invoiceId = <%= invoiceId %>;
</script>
<script src="/public/js/admin/fulfillment-manifest.js"></script>

