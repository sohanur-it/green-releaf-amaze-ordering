<%- include('../layouts/main', { 
    title: 'Cancelled Packages Verification',
    page: 'fulfillment',
    user: user,
    userRoles: userRoles || []
}) %>

<div class="container-fluid">
    <div class="page-header">
        <h1><i class="fas fa-box-open"></i> Cancelled Packages Verification</h1>
        <p class="text-muted">Verify and manage packages from cancelled shipments</p>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form id="filterForm" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Invoice Number</label>
                    <input type="text" class="form-control" id="filterInvoice" placeholder="Search invoice...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Incident Type</label>
                    <select class="form-select" id="filterIncidentType">
                        <option value="">All Types</option>
                        <option value="customer_cancel">Customer Cancellation</option>
                        <option value="driver_accident">Driver Accident</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="filterStatus">
                        <option value="">All Statuses</option>
                        <option value="unverified">Unverified</option>
                        <option value="verified">Verified</option>
                        <option value="missing">Missing/Destroyed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Days Since Cancellation</label>
                    <select class="form-select" id="filterDays">
                        <option value="">All</option>
                        <option value="1">Last 24 hours</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" onclick="loadPackages()">
                        <i class="fas fa-search"></i> Apply Filters
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                        <i class="fas fa-times"></i> Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bulk Actions -->
    <div class="card mb-4" id="bulkActionsCard" style="display: none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <span id="selectedCount">0 packages selected</span>
                <div>
                    <button type="button" class="btn btn-success" onclick="bulkVerify()">
                        <i class="fas fa-check"></i> Mark as Verified
                    </button>
                    <button type="button" class="btn btn-danger" onclick="bulkMarkMissing()">
                        <i class="fas fa-times"></i> Mark as Missing
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Packages Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="packagesTable">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                            </th>
                            <th>Invoice #</th>
                            <th>Package Label</th>
                            <th>Batch ID</th>
                            <th>Incident Type</th>
                            <th>Days Since</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="packagesTableBody">
                        <tr>
                            <td colspan="8" class="text-center">
                                <i class="fas fa-spinner fa-spin"></i> Loading packages...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div id="pagination" class="mt-3"></div>
        </div>
    </div>
</div>

<!-- Verify Modal -->
<div class="modal fade" id="verifyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Verify Package Return</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Package: <strong id="verifyPackageLabel"></strong></p>
                <p>Invoice: <strong id="verifyInvoiceNumber"></strong></p>
                <p>This will verify the package has returned to inventory in METRC.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmVerify()">Verify Package</button>
            </div>
        </div>
    </div>
</div>

<!-- Mark Missing Modal -->
<div class="modal fade" id="missingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark Package as Missing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Package: <strong id="missingPackageLabel"></strong></p>
                <p>Invoice: <strong id="missingInvoiceNumber"></strong></p>
                <div class="mb-3">
                    <label class="form-label">Reason (required)</label>
                    <textarea class="form-control" id="missingReason" rows="3" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmMarkMissing()">Mark as Missing</button>
            </div>
        </div>
    </div>
</div>

<script src="/public/js/admin/cancelled-packages-verification.js"></script>

