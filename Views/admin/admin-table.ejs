<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
    <link rel="stylesheet" href="/public/css/main.css">
    <!-- TinyMCE WYSIWYG Editor for description modal -->
    <script src="/public/lib/tinymce/tinymce.min.js"></script>
</head>
<body>
    <%- include('../partials/header') %>

    <main class="admin-container">
        <div class="order-container">
            <!-- Filters Sidebar -->
            <aside class="filters-sidebar">
                <div class="filters-header">
                    <h2>Filters</h2>
                    <button class="btn-clear-filters" onclick="clearAllFilters()">Clear All</button>
                </div>

                <!-- Active Filters Display -->
                <div id="active-filters"></div>

                <!-- Search -->
                <div class="filter-section">
                    <h3 class="filter-title">Search</h3>
                    <input type="text" id="filter-search" placeholder="Search products..." class="search-input">
                </div>

                <!-- Completion Filter -->
                <div class="filter-section">
                    <h3 class="filter-title">Completion Status</h3>
                    <div id="completion-filters" class="filter-options">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Has Photos Filter -->
                <div class="filter-section">
                    <h3 class="filter-title">Photos</h3>
                    <div id="has-photos-filter" class="filter-options">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Has Description Filter -->
                <div class="filter-section">
                    <h3 class="filter-title">Description</h3>
                    <div id="has-description-filter" class="filter-options">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="filter-section">
                    <h3 class="filter-title">Category</h3>
                    <div id="category-filters" class="filter-options">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Brand Filter -->
                <div class="filter-section">
                    <h3 class="filter-title">Brand</h3>
                    <div id="brand-filters" class="filter-options">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </aside>

            <!-- Table Container -->
            <div class="products-main">
                <div class="admin-table-container">
                    <table id="admin-table" class="admin-table">
                        <thead>
                            <tr>
                                <th data-sort="display_name">Display Name</th>
                                <th data-sort="original_name">Original Name</th>
                                <th data-sort="completion">Completion</th>
                                <th data-sort="category">Category</th>
                                <th data-sort="brand">Brand</th>
                                <th data-sort="price">Price</th>
                                <th>Photos</th>
                                <th>Description</th>
                                <th data-sort="batches"># Batches</th>
                                <th data-sort="packages">Packages</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="admin-table-body">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Description Edit Modal -->
    <div id="description-modal" class="modal" style="display: none;">
        <div class="modal-overlay" onclick="closeDescriptionModal()"></div>
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h2>Edit Product Description</h2>
                <button class="btn-close-modal" onclick="closeDescriptionModal()">×</button>
            </div>
            <div class="modal-body">
                <textarea id="description-editor"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeDescriptionModal()">Cancel</button>
                <button class="btn btn-primary" onclick="saveDescription()">Save Description</button>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <%- include('../partials/scripts') %>

    <script src="/public/js/admin/filters.js"></script>
    <script src="/public/js/admin/inline-editor.js"></script>
    <script src="/public/js/admin/product-pairing-modal.js"></script>
    <script src="/public/js/admin/admin-table.js"></script>
</body>
</html>
