<!-- Views/admin/user-management.ejs -->
<style>
.permissions-display {
    max-width: 300px;
    max-height: 100px;
    overflow-y: auto;
    font-size: 0.8em;
}

.permissions-display .badge {
    font-size: 0.7em;
    margin: 1px;
    display: inline-block;
}

.role-badges .badge {
    font-size: 0.8em;
    margin: 1px;
}

.table td {
    vertical-align: middle;
}
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <!-- <h1 class="h2">User Management</h1> -->
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshUsers()">
                <i class="fas fa-sync"></i> Refresh
            </button>
        </div>
    </div>
</div>

<!-- User Management Content -->
<div class="row">
    <div class="col-12">
        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs" id="userTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="all-users-tab" data-bs-toggle="tab" data-bs-target="#all-users" type="button" role="tab" aria-controls="all-users" aria-selected="true">
                    All Users
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pending-users-tab" data-bs-toggle="tab" data-bs-target="#pending-users" type="button" role="tab" aria-controls="pending-users" aria-selected="false">
                    Pending Approval
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="active-users-tab" data-bs-toggle="tab" data-bs-target="#active-users" type="button" role="tab" aria-controls="active-users" aria-selected="false">
                    Active Users
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="userTabsContent">
            <!-- All Users Tab -->
            <div class="tab-pane fade show active" id="all-users" role="tabpanel" aria-labelledby="all-users-tab">
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="allUsersTable">
                                <thead>
                                    <tr>
                                        <th>Username</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Roles</th>
                                        <th>Permissions</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Users will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Users Tab -->
            <div class="tab-pane fade" id="pending-users" role="tabpanel" aria-labelledby="pending-users-tab">
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="pendingUsersTable">
                                <thead>
                                    <tr>
                                        <th>Username</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Pending users will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Users Tab -->
            <div class="tab-pane fade" id="active-users" role="tabpanel" aria-labelledby="active-users-tab">
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="activeUsersTable">
                                <thead>
                                    <tr>
                                        <th>Username</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Roles</th>
                                        <th>Permissions</th>
                                        <th>Last Login</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Active users will be loaded here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Role Assignment Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roleModalLabel">Assign Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="userId" name="userId">
                    <div class="mb-3">
                        <label for="availableRoles" class="form-label">Available Roles</label>
                        <select class="form-select" id="availableRoles" name="roleId" onchange="loadRolePermissions()">
                            <option value="">Select a role...</option>
                        </select>
                    </div>
                    <div class="mb-3" id="permissionsSection" style="display: none;">
                        <label class="form-label">Role Permissions</label>
                        <div id="rolePermissions" class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            <!-- Permissions will be loaded here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="assignRole()">Assign Role</button>
            </div>
        </div>
    </div>
</div>

<script>
// User Management JavaScript
let allUsers = [];
let pendingUsers = [];
let activeUsers = [];
let availableRoles = [];

// Load users on page load
document.addEventListener('DOMContentLoaded', function() {
    loadUsers();
    loadRoles();
});

async function loadUsers() {
    try {
        const response = await fetch('/api/v1/admin/users');
        const data = await response.json();
        
        if (data.success) {
            allUsers = data.data || data.users || [];
            pendingUsers = allUsers.filter(user => user.status === 'pending');
            activeUsers = allUsers.filter(user => user.status === 'active');
            
            renderUsers();
        } else {
            showAlert('Error loading users: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error loading users: ' + error.message, 'danger');
    }
}

async function loadRoles() {
    try {
        const response = await fetch('/api/v1/admin/users/roles');
        const data = await response.json();
        
        if (data.success) {
            availableRoles = data.data || data.roles || [];
            populateRoleSelect();
        } else {
            showAlert('Error loading roles: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error loading roles: ' + error.message, 'danger');
    }
}

function populateRoleSelect() {
    const select = document.getElementById('availableRoles');
    select.innerHTML = '<option value="">Select a role...</option>';
    
    availableRoles.forEach(role => {
        const option = document.createElement('option');
        option.value = role.id;
        option.textContent = role.name;
        select.appendChild(option);
    });
}

function renderUsers() {
    renderAllUsers();
    renderPendingUsers();
    renderActiveUsers();
}

function renderAllUsers() {
    const tbody = document.querySelector('#allUsersTable tbody');
    tbody.innerHTML = '';
    
    allUsers.forEach(user => {
        const row = createUserRow(user, true);
        tbody.appendChild(row);
    });
}

function renderPendingUsers() {
    const tbody = document.querySelector('#pendingUsersTable tbody');
    tbody.innerHTML = '';
    
    pendingUsers.forEach(user => {
        const row = createUserRow(user, false);
        tbody.appendChild(row);
    });
}

function renderActiveUsers() {
    const tbody = document.querySelector('#activeUsersTable tbody');
    tbody.innerHTML = '';
    
    activeUsers.forEach(user => {
        const row = createUserRow(user, true);
        tbody.appendChild(row);
    });
}

function createUserRow(user, showRoles = true) {
    const row = document.createElement('tr');
    
    const statusBadge = user.status === 'active' ? 
        '<span class="badge bg-success">Active</span>' : 
        '<span class="badge bg-warning">Pending</span>';
    
    const rolesHtml = showRoles ? 
        `<div class="role-badges">${user.roles ? user.roles.map(role => `<span class="badge bg-primary me-1">${role.name}</span>`).join('') : '<span class="text-muted">No roles</span>'}</div>` : 
        '';
    
    // Create permissions display
    const permissionsHtml = showRoles ? 
        `<div class="permissions-display">${user.permissions ? user.permissions.map(perm => `<span class="badge bg-secondary me-1" title="${perm.resource}: ${perm.action}">${perm.permission}</span>`).join('') : '<span class="text-muted">No permissions</span>'}</div>` : 
        '';
    
    const actionsHtml = user.status === 'pending' ? 
        `<button class="btn btn-sm btn-success me-1" onclick="approveUser(${user.id})">Approve</button>
         <button class="btn btn-sm btn-danger" onclick="revokeUser(${user.id})">Reject</button>` :
        `<button class="btn btn-sm btn-primary me-1 mb-2" onclick="openRoleModal(${user.id})">Assign Role</button>
         <button class="btn btn-sm btn-warning me-1" onclick="revokeUser(${user.id})">Revoke</button>`;
    
    row.innerHTML = `
        <td>${user.username}</td>
        <td>${user.firstname} ${user.lastname}</td>
        <td>${user.email}</td>
        ${showRoles ? `<td>${statusBadge}</td>` : ''}
        ${showRoles ? `<td>${rolesHtml}</td>` : ''}
        ${showRoles ? `<td>${permissionsHtml}</td>` : ''}
        <td>${new Date(user.created_at).toLocaleDateString()}</td>
        <td>${actionsHtml}</td>
    `;
    
    return row;
}

async function approveUser(userId) {
    try {
        const response = await fetch(`/api/v1/admin/users/${userId}/approve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            showAlert('User approved successfully', 'success');
            loadUsers();
        } else {
            showAlert('Error approving user: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error approving user: ' + error.message, 'danger');
    }
}

async function revokeUser(userId) {
    if (!confirm('Are you sure you want to revoke this user?')) {
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/admin/users/${userId}/revoke`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            showAlert('User revoked successfully', 'success');
            loadUsers();
        } else {
            showAlert('Error revoking user: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error revoking user: ' + error.message, 'danger');
    }
}

function openRoleModal(userId) {
    document.getElementById('userId').value = userId;
    document.getElementById('availableRoles').value = '';
    new bootstrap.Modal(document.getElementById('roleModal')).show();
}

async function assignRole() {
    const userId = document.getElementById('userId').value;
    const roleId = document.getElementById('availableRoles').value;
    
    if (!roleId) {
        showAlert('Please select a role', 'warning');
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/admin/users/${userId}/roles`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ roles: [parseInt(roleId)] })
        });
        
        const data = await response.json();
        
        if (data.success) {
            showAlert('Role assigned successfully', 'success');
            bootstrap.Modal.getInstance(document.getElementById('roleModal')).hide();
            loadUsers();
        } else {
            showAlert('Error assigning role: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error assigning role: ' + error.message, 'danger');
    }
}

async function loadRolePermissions() {
    const roleId = document.getElementById('availableRoles').value;
    const permissionsSection = document.getElementById('permissionsSection');
    const rolePermissions = document.getElementById('rolePermissions');
    
    if (!roleId) {
        permissionsSection.style.display = 'none';
        return;
    }
    
    try {
        const response = await fetch(`/api/v1/admin/users/roles/${roleId}/permissions`);
        const data = await response.json();
        
        if (data.success) {
            const permissions = data.data || [];
            
            if (permissions.length > 0) {
                // Group permissions by resource
                const groupedPermissions = permissions.reduce((acc, perm) => {
                    if (!acc[perm.resource]) {
                        acc[perm.resource] = [];
                    }
                    acc[perm.resource].push(perm.action);
                    return acc;
                }, {});
                
                let html = '<div class="row">';
                Object.keys(groupedPermissions).forEach(resource => {
                    html += `
                        <div class="col-md-6 mb-2">
                            <strong>${resource}:</strong><br>
                            <small class="text-muted">${groupedPermissions[resource].join(', ')}</small>
                        </div>
                    `;
                });
                html += '</div>';
                
                rolePermissions.innerHTML = html;
                permissionsSection.style.display = 'block';
            } else {
                rolePermissions.innerHTML = '<p class="text-muted">No permissions assigned to this role.</p>';
                permissionsSection.style.display = 'block';
            }
        } else {
            showAlert('Error loading role permissions: ' + data.error, 'danger');
        }
    } catch (error) {
        showAlert('Error loading role permissions: ' + error.message, 'danger');
    }
}

function refreshUsers() {
    loadUsers();
}

function showAlert(message, type) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    const container = document.querySelector('.content-body');
    container.insertBefore(alertDiv, container.firstChild);
    
    setTimeout(() => {
        alertDiv.remove();
    }, 5000);
}
</script>