# Local Development Environment Variables
# This file is used for Docker-based local development
# Production uses the remote RDS database

# Database Configuration (Local Docker)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=dev_password_123
DB_PORT=5432
DB_DATABASE=green_releaf_dev

# METRC T3 API Configuration
T3_HOSTNAME=mo.metrc.com
T3_USERNAME=AGT007392
T3_PASSWORD=Metalhead4!
SYNC_LICENSE=CUL000063

# Application Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=green-releaf-dev-secret-key-change-in-production

# Redis Configuration (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Sync Configuration
MAX_CONCURRENT_API_REQUESTS=3
API_REQUEST_TIMEOUT=180000
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Configuration
BCRYPT_ROUNDS=12
JWT_SECRET=green-releaf-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Email Configuration (Development)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@greenreleaf.com

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Scheduler Configuration
# Set to 'true' to enable METRC sync scheduler in development
ENABLE_SCHEDULER=false

# Inventory Monitoring Configuration
# Set to 'true' to enable inventory monitoring in development
ENABLE_INVENTORY_MONITORING=false


# config/local.env
WEBSOCKET_PORT=8080
ENABLE_WEBSOCKET=true

# Cart Expiry Configuration (in seconds)
# Default: 86400 (24 hours)
CART_EXPIRY_TIME=86400

EMAIL_SERVICE_ENABLED=true
EMAIL_FROM=noreply@greenreleaf.com
EMAIL_FROM_NAME=Green Releaf
SENDGRID_API_KEY=your_api_key_here
EMAIL_TEMPLATE_PENDING_APPROVAL=template_id
EMAIL_TEMPLATE_ORDER_APPROVED=template_id
EMAIL_TEMPLATE_ORDER_CANCELLED=template_id
EMAIL_TEMPLATE_ORDER_SHIPPED=template_id
EMAIL_TEMPLATE_ORDER_DELIVERED=template_id