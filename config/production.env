# Production Environment Variables
# This file is used for production RDS database connection
# Using actual credentials from .ENV file

# Database Configuration (Production RDS)
DB_HOST=n8nstorage.c9c2iugeyzfa.us-east-2.rds.amazonaws.com
DB_USER=master
DB_PASSWORD=GreenReleaf123!
DB_PORT=5432
DB_DATABASE=postgres

# METRC T3 API Configuration
T3_API_BASE_URL=https://api.trackandtrace.tools/v2
T3_HOSTNAME=mo.metrc.com
T3_USERNAME=AGT007392
T3_PASSWORD=Metalhead4!
T3_LICENSE_NUMBER=CUL000063

# Application Configuration
NODE_ENV=production
PORT=3000
SESSION_SECRET=metrc-secret

# Redis Configuration (Production)
# Update with your actual Redis endpoint
REDIS_HOST=your-redis-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Sync Configuration
MAX_CONCURRENT_API_REQUESTS=5
API_REQUEST_TIMEOUT=300000
SYNC_RETRY_ATTEMPTS=5
SYNC_RETRY_DELAY=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security Configuration
BCRYPT_ROUNDS=12
JWT_SECRET=green-releaf-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Email Configuration (Production)
# Update with your actual SMTP settings
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@greenreleaf.com

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Scheduler Configuration
# Enabled by default in production (NODE_ENV=production will auto-enable)
ENABLE_SCHEDULER=true
# Timezone for cron schedules (America/Chicago for Central, America/New_York for Eastern, America/Los_Angeles for Pacific)
SYNC_TIMEZONE=America/Chicago
#SYNC_TIMEZONE=Asia/Dhaka

# Inventory Monitoring Configuration
# Enabled by default in production (NODE_ENV=production will auto-enable)
ENABLE_INVENTORY_MONITORING=true

# config/production.env
WEBSOCKET_PORT=8080
ENABLE_WEBSOCKET=true

# Cart Expiry Configuration (in seconds)
# Default: 86400 (24 hours)
CART_EXPIRY_TIME=86400