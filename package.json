{
  "name": "green-releaf-amaze-ordering",
  "version": "1.0.0",
  "description": "Green Releaf Amaze Ordering System",
  "main": "Server/server.js",
  "scripts": {
    "start": "node Server/server.js",
    "dev": "NODE_ENV=production nodemon Server/server.js",
    "dev:prod": "NODE_ENV=production nodemon Server/server.js",
    "scheduler": "node scripts/sync/master-scheduler.js",
    "scheduler:prod": "NODE_ENV=production node scripts/sync/master-scheduler.js",
    "start:prod": "./start-production.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "env:local": "node scripts/utils/switch-env.js local",
    "env:production": "node scripts/utils/switch-env.js production",
    "env:status": "node scripts/utils/switch-env.js",
    "db:init": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < docker/postgres/init/01-init-database.sql",
    "db:rbac": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < Queries/create-rbac-schema.sql",
    "db:metrc": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < docker/postgres/init/02-create-metrc-tables.sql",
    "db:crm": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < docker/postgres/init/05-create-crm-tables.sql",
    "db:backup": "docker exec green-releaf-postgres pg_dump -U postgres green_releaf_dev > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < backup.sql",
    "db:backup-schema": "./scripts/backup-schema.sh",
    "db:backup-schema-node": "node scripts/backup-production-schema.js",
    "db:setup-local": "node scripts/setup-local-database.js",
    "db:setup-local-with-data": "node scripts/setup-local-database.js --with-data",
    "db:add-kicked-back-enum": "node scripts/add-kicked-back-to-fulfillment-enum.js",
    "db:add-kicked-back-enum:prod": "NODE_ENV=production node scripts/add-kicked-back-to-fulfillment-enum.js",
    "db:backup-production-with-data": "./scripts/backup-production-with-data.sh",
    "test:metrc": "node tests/api/test-metrc-apis.js",
    "test:production": "node tests/integration/test-production-sync.js",
    "test:all-sync:prod": "NODE_ENV=production node scripts/test-all-sync-prod.js",
    "sync:active": "NODE_ENV=development node scripts/sync/sync-active-packages.js",
    "sync:active:prod": "NODE_ENV=production node scripts/sync/sync-active-packages.js",
    "sync:outgoing:prod": "NODE_ENV=production node scripts/sync/sync-outgoing-transfers.js",
    "sync:strains:prod": "NODE_ENV=production node scripts/sync/sync-strains.js",
    "sync:items:prod": "NODE_ENV=production node scripts/sync/sync-items.js",
    "sync:transferred:prod": "NODE_ENV=production node scripts/sync/sync-transferred-packages.js",
    "sync:transferred:prod:5": "MAX_PAGES=5 NODE_ENV=production node scripts/sync/sync-transferred-packages.js",
    "sync:transferred:prod:10": "MAX_PAGES=10 NODE_ENV=production node scripts/sync/sync-transferred-packages.js",
    "sync:transferred:prod:test": "DRY_RUN=true MAX_PAGES=10 NODE_ENV=production node scripts/sync/sync-transferred-packages.js",
    "recover:transferred": "NODE_ENV=production node scripts/sync/recover-transferred-packages.js",
    "recover:transferred:test": "MAX_PAGES=10 NODE_ENV=production node scripts/sync/recover-transferred-packages.js",
    "sync:intransit:prod": "NODE_ENV=production node scripts/sync/sync-intransit-packages.js",
    "sync:all:prod": "npm run sync:active:prod && npm run sync:outgoing:prod && npm run sync:strains:prod && npm run sync:items:prod && npm run sync:transferred:prod && npm run sync:intransit:prod",
    "sync:transferred": "NODE_ENV=development node scripts/sync/sync-transferred-packages.js",
    "sync:intransit": "NODE_ENV=development node scripts/sync/sync-intransit-packages.js",
    "sync:outgoing": "NODE_ENV=development node scripts/sync/sync-outgoing-transfers.js",
    "sync:items": "NODE_ENV=development node scripts/sync/sync-items.js",
    "sync:strains": "NODE_ENV=development node scripts/sync/sync-strains.js",
    "sync:all": "npm run sync:active && npm run sync:transferred && npm run sync:intransit && npm run sync:outgoing && npm run sync:items && npm run sync:strains",
    "sync:batches": "NODE_ENV=development node scripts/sync/sync-batches.js",
    "sync:batches:prod": "NODE_ENV=production node scripts/sync/sync-batches.js",
    "module3:setup": "node scripts/setup-module3.js",
    "module3:setup:prod": "NODE_ENV=production node scripts/setup-module3.js",
    "scheduler:start": "node scripts/sync/master-scheduler.js",
    "scheduler:status": "node -e \"const scheduler = require('./scripts/sync/master-scheduler'); console.log(JSON.stringify(scheduler.getStatus(), null, 2)); process.exit(0);\"",
    "schema:setup": "docker exec -i green-releaf-postgres psql -U postgres -d green_releaf_dev < docker/postgres/init/06-update-schema-to-production.sql",
    "schema:prod": "node scripts/utils/update-production-schema.js",
    "schema:check": "node scripts/utils/check-production-schema.js",
    "tables:list": "node scripts/utils/list-production-tables.js",
    "schema:items": "node scripts/utils/check-items-schema.js",
    "schema:transferred": "node scripts/utils/check-transferred-schema.js",
    "schema:intransit": "node scripts/utils/check-intransit-schema.js",
    "test:sync-data": "node scripts/utils/test-sync-data.js",
    "test:api": "node scripts/utils/test-api-endpoints.js",
    "test:sync-api": "node scripts/utils/test-sync-api.js",
    "test:audit": "node scripts/test-audit-logging.js",
    "swagger:serve": "NODE_ENV=production npm start",
    "superuser": "NODE_ENV=development node scripts/utils/create-superuser.js",
    "superuser:prod": "NODE_ENV=production node scripts/utils/create-superuser.js",
    "admin:create": "node scripts/create-admin-user.js",
    "admin:check": "node scripts/check-admin-user.js",
    "db:test": "node scripts/test-db-connection.js",
    "db:monitor": "node scripts/monitor-db-connections.js",
    "db:monitor:prod": "NODE_ENV=production node scripts/monitor-db-connections.js",
    "db:rename-outgoing": "node scripts/rename-outgoing-transfers-table.js",
    "db:rename-outgoing:prod": "NODE_ENV=production node scripts/rename-outgoing-transfers-table.js",
    "db:update-references": "node scripts/update-outgoing-transfers-references.js",
    "db:add-metrcid-constraint": "NODE_ENV=production node scripts/add-metrcid-unique-constraint.js",
    "db:add-zone-to-buyers": "node scripts/apply-zone-to-buyers.js",
    "db:add-zone-to-buyers:prod": "NODE_ENV=production node scripts/apply-zone-to-buyers.js",
    "db:setup-failure-tracking": "NODE_ENV=production node scripts/setup-sync-failure-tracking.js",
    "test:alert-system": "NODE_ENV=production node scripts/test-alert-system.js",
    "setup:full": "npm run docker:up && sleep 10 && npm run db:init && npm run db:rbac && npm run db:metrc && npm run db:crm && npm run schema:setup && npm run superuser",
    "setup:quick": "npm run docker:up && sleep 5 && npm run schema:setup"
  },
  "private": true,
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.9",
    "env": "^0.0.2",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
