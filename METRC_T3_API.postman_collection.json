  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token if needed",
          "const accessToken = pm.collectionVariables.get('accessToken');",
          "if (!accessToken) {",
          "    console.log('No access token found. Please run \"Get Access Token\" first.');",
          "}"
        ]
